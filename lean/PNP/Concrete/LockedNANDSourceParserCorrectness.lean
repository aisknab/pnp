private theorem circuitTokenFailure_bounded_exact
    {tokens : List Token}
    (failure : CircuitTokenFailure tokens) :
    ∃ steps final,
      steps ≤ circuitFailureEnvelope tokens ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells tokens))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases failure with
  | missingVersion =>
      exact circuitMissingVersion_bounded_exact
  | wrongVersion token suffix notVersion =>
      exact circuitWrongVersion_bounded_exact
        token suffix notVersion
  | inputCount failure =>
      exact circuitInputCountFailure_bounded_exact
        failure
  | gateCount inputs failure =>
      exact circuitGateCountFailure_bounded_exact
        inputs failure
  | gates inputs gateCount failure =>
      exact circuitGatesFailure_bounded_exact
        inputs gateCount failure
  | missingProgramEnd inputs gates =>
      exact circuitMissingProgramEnd_bounded_exact
        inputs gates
  | wrongProgramEnd inputs gates token suffix
      notProgramEnd =>
      exact circuitWrongProgramEnd_bounded_exact
        inputs gates token suffix notProgramEnd
  | output inputs gates failure =>
      exact circuitOutputFailure_bounded_exact
        inputs gates failure
  | missingOutputsEnd inputs gates output =>
      exact circuitMissingOutputsEnd_bounded_exact
        inputs gates output
  | wrongOutputsEnd inputs gates output token suffix
      notOutputsEnd =>
      exact circuitWrongOutputsEnd_bounded_exact
        inputs gates output token suffix notOutputsEnd
  | missingInstanceEnd inputs gates output =>
      exact circuitMissingInstanceEnd_bounded_exact
        inputs gates output
  | wrongInstanceEnd inputs gates output token suffix
      notInstanceEnd =>
      exact circuitWrongInstanceEnd_bounded_exact
        inputs gates output token suffix notInstanceEnd
  | trailingToken inputs gates output token suffix =>
      exact circuitTrailingToken_bounded_exact
        inputs gates output token suffix

private theorem failureSpanCube_mono
    {left right : Nat} (bound : left ≤ right) :
    failureSpanCube left ≤ failureSpanCube right := by
  have successorBound :
      left + 1 ≤ right + 1 := by omega
  unfold failureSpanCube
  exact Nat.mul_le_mul successorBound
    (failureSpanSquare_mono bound)

private theorem circuitFailureEnvelope_le_validWorkBound_encodeTokens
    (tokens : List Token) :
    circuitFailureEnvelope tokens ≤
      validWorkBound (encodeTokens tokens).length := by
  let span := circuitTokenFailureSpan tokens
  let bitLength := (encodeTokens tokens).length
  have spanLe : span ≤ bitLength := by
    unfold span circuitTokenFailureSpan
    unfold bitLength
    rw [packedTokenCells_length,
      encodeTokens_length]
    omega
  have cubeLe := failureSpanCube_mono spanLe
  have scaled :=
    Nat.mul_le_mul_left 1024 cubeLe
  have coefficient :
      1024 * failureSpanCube bitLength ≤
        4096 * failureSpanCube bitLength :=
    Nat.mul_le_mul_right
      (failureSpanCube bitLength)
      (show 1024 ≤ 4096 by omega)
  calc
    circuitFailureEnvelope tokens =
        1024 * failureSpanCube span := rfl
    _ ≤ 1024 * failureSpanCube bitLength := scaled
    _ ≤ 4096 * failureSpanCube bitLength :=
      coefficient
    _ = validWorkBound
        (encodeTokens tokens).length := by
      unfold failureSpanCube failureSpanSquare
        validWorkBound
      dsimp [bitLength]
      ac_rfl

