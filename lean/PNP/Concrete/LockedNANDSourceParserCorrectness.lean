              _ =
                  (32 + 32) *
                    failureSpanSquare
                      (grammarWorkFailureSpan
                        inputs done (remaining + 1)
                        word) :=
                (Nat.add_mul 32 32
                  (failureSpanSquare
                    (grammarWorkFailureSpan
                      inputs done (remaining + 1)
                      word))).symm
              _ ≤
                  256 *
                    failureSpanSquare
                      (grammarWorkFailureSpan
                        inputs done (remaining + 1)
                        word) :=
                Nat.mul_le_mul_right
                  (failureSpanSquare
                    (grammarWorkFailureSpan
                      inputs done (remaining + 1)
                      word))
                  (show 32 + 32 ≤ 256 by decide)
          refine
            ⟨leftSteps + rightSteps, final,
              grammarSingleGateBound256
                remaining _ _ localBound,
              ?_, finalState, outputEmpty⟩
          simpa [word, delimiterTail, tailWord,
            List.append_assoc] using all
      | true =>
          rcases
              grammarGateRightValid_exact
                inputs done remaining left right
                delimiterTail rightEq with
            ⟨rightSteps, rightBound, rightRun⟩
          have rightBoundCanonical :
              rightSteps ≤
                16 *
                  failureSpanSquare
                    (grammarWorkFailureSpan
                      inputs done (remaining + 1)
                      word) := by
            simpa [word, List.append_assoc] using
              rightBound
          have endRun :=
            grammarGateEndSuccess_exact
              inputs done gate remaining tailWord
          rcases tailResult with
            ⟨tailSteps, final, tailBound, tailRun,
              finalState, outputEmpty⟩
          have spanEq :=
            grammarWorkFailureSpan_gate_step
              inputs done remaining left right tailWord
          rw [spanEq] at tailBound
          have throughRight :=
            exactRun_add leftSteps rightSteps
              _ _ _ leftRun rightRun
          have throughEnd :=
            exactRun_add
              (leftSteps + rightSteps) 2
              _ _ _ throughRight
              (by simpa [gate, delimiterTail] using
                endRun)
          have all :=
            exactRun_add
              ((leftSteps + rightSteps) + 2)
              tailSteps _ _ _ throughEnd tailRun
          have one :=
            one_le_failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1)
                word)
          have headBound :
              (leftSteps + rightSteps) + 2 ≤
                256 *
                  failureSpanSquare
                    (grammarWorkFailureSpan
                      inputs done (remaining + 1)
                      word) := by
            omega
          have tailBoundCanonical :
              tailSteps ≤
                remaining *
                  (256 *
                    failureSpanSquare
                      (grammarWorkFailureSpan
                        inputs done (remaining + 1)
                        word)) := by
            simpa [word, delimiterTail,
              List.append_assoc] using tailBound
          refine
            ⟨((leftSteps + rightSteps) + 2) +
                tailSteps,
              final,
              grammarRecursiveGateBound256
                remaining _ _ _
                headBound tailBoundCanonical,
              ?_, finalState, outputEmpty⟩
          simpa [gate, word, delimiterTail,
            packedTokenCells, tokenCells,
            List.append_assoc] using all

private theorem grammarNGatesTokenFailureWithFramingTail_bounded_exact
    (inputs : Nat) (done : List RawGate)
    {count : Nat} {tokens : List Token}
    (failure : NGatesTokenFailure count tokens)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    ∃ steps final,
      steps ≤
          count *
            (256 *
              failureSpanSquare
                (grammarWorkFailureSpan
                  inputs done count
                  (packedTokenCells tokens ++
                    workTail))) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix inputs done count)
            (packedTokenCells tokens ++ workTail)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  induction failure generalizing done with
  | left failure =>
      rcases
          grammarGateLeftFailureWithFramingTail_bounded_exact
            inputs done _ failure malformed with
        ⟨steps, final, bound, run,
          finalState, outputEmpty⟩
      refine
        ⟨steps, final, ?_,
          run, finalState, outputEmpty⟩
      exact grammarSingleGateBound256 _ _ _ bound
  | right count left failure =>
      simpa [packedTokenCells_append,
        packedTokenCells_encodeSourceTokens,
        List.append_assoc] using
        (grammarNGatesRightFailureWithFramingTail_bounded_exact
          inputs done count left failure malformed)
  | missingGateEnd count left right =>
      simpa [packedTokenCells_append,
        packedTokenCells_encodeSourceTokens,
        List.append_assoc] using
        (grammarNGatesMissingGateEndWithFramingTail_bounded_exact
          inputs done count left right malformed)
  | wrongGateEnd count left right token suffix
      notGateEnd =>
      simpa [packedTokenCells_append,
        packedTokenCells_encodeSourceTokens,
        List.append_assoc] using
        (grammarNGatesWrongGateEndWithFramingTail_bounded_exact
          inputs done count left right token suffix
          notGateEnd malformed)
  | rest count left right failure ih =>
      have tail :=
        ih
          (done ++
            [{ left := left, right := right }])
      simpa [packedTokenCells_append,
        packedTokenCells_encodeSourceTokens,
        packedTokenCells, tokenCells,
        List.append_assoc] using
        (grammarNGatesRestWithFramingTail_bounded_exact
          inputs done count left right _
          malformed tail)

private theorem circuitFramingCubicComposition_bound
    (word : List WorkSymbol)
    (headerSteps tailSteps count span : Nat)
    (headerBound :
      headerSteps ≤
        8 * (word.length + 1))
    (countBound :
      count ≤ word.length + 1)
    (spanBound :
      span + 1 ≤
        2 * (word.length + 1))
    (tailBound :
      tailSteps ≤
        count *
          (256 * failureSpanSquare span)) :
    headerSteps + tailSteps ≤
      rawFailureEnvelope word := by
  have squareRaw :=
    Nat.mul_le_mul spanBound spanBound
  have squareBound :
      failureSpanSquare span ≤
        4 * failureSpanSquare word.length := by
    calc
      failureSpanSquare span ≤
          (2 * (word.length + 1)) *
            (2 * (word.length + 1)) := by
        simpa [failureSpanSquare] using squareRaw
      _ =
          (2 * 2) *
            failureSpanSquare word.length := by
        unfold failureSpanSquare
        ac_rfl
      _ = 4 * failureSpanSquare word.length := by
        rfl
  have productRaw :=
    Nat.mul_le_mul countBound squareBound
  have productBound :
      count * failureSpanSquare span ≤
        4 * failureSpanCube word.length := by
    simpa [failureSpanCube,
      Nat.mul_assoc, Nat.mul_comm,
      Nat.mul_left_comm] using productRaw
  have scaled :=
    Nat.mul_le_mul_left 256 productBound
  have tailEnvelope :
      tailSteps ≤
        1024 * failureSpanCube word.length := by
    calc
      tailSteps ≤
          count *
            (256 * failureSpanSquare span) :=
        tailBound
      _ = 256 *
          (count * failureSpanSquare span) := by
        ac_rfl
      _ ≤ 256 *
          (4 * failureSpanCube word.length) :=
        scaled
      _ =
          1024 * failureSpanCube word.length := by
        omega
  have squarePositive :
      1 ≤ failureSpanSquare word.length :=
    one_le_failureSpanSquare word.length
  have wordLeCube :
      word.length + 1 ≤
        failureSpanCube word.length := by
    have product :=
      Nat.mul_le_mul_left
        (word.length + 1) squarePositive
    simpa [failureSpanCube] using product
  have headerEnvelope :
      headerSteps ≤
        8 * failureSpanCube word.length :=
    Nat.le_trans headerBound
      (Nat.mul_le_mul_left 8 wordLeCube)
  have combined :=
    Nat.add_le_add headerEnvelope tailEnvelope
  calc
    headerSteps + tailSteps ≤
        8 * failureSpanCube word.length +
          1024 * failureSpanCube word.length :=
      combined
    _ = 1032 * failureSpanCube word.length := by
      omega
    _ ≤ 2048 * failureSpanCube word.length :=
      Nat.mul_le_mul_right
        (failureSpanCube word.length) (by omega)
    _ = rawFailureEnvelope word := by
      rfl

private theorem circuitGatesFailureWithFramingTail_bounded_exact
    (inputs gateCount : Nat)
    {tokens : List Token}
    (failure :
      NGatesTokenFailure gateCount tokens)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    let allTokens :=
      circuitHeaderTokens inputs gateCount ++ tokens
    let word :=
      packedTokenCells allTokens ++ workTail
    ∃ steps final,
      steps ≤ rawFailureEnvelope word ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols word)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let allTokens :=
    circuitHeaderTokens inputs gateCount ++ tokens
  let suffixCells :=
    packedTokenCells tokens ++ workTail
  let word :=
    packedTokenCells allTokens ++ workTail
  let initial :=
    workStartConfiguration machine
      (WorkTape.ofSymbols word)
  let headerSteps :=
    2 * inputs + 2 * gateCount + 8
  have cellsEq :
      word =
        [cell00, cell00] ++ natCells inputs ++
          natCells gateCount ++ suffixCells := by
    dsimp [word, allTokens, suffixCells]
    rw [packedCircuitHeaderTokens_append]
    simp [List.append_assoc]
  have header :
      workRunExact? machine headerSteps initial =
        some
          (guardedConfig State.gateStart
            (grammarGatePrefix inputs [] gateCount)
            suffixCells) := by
    dsimp [headerSteps, initial]
    rw [cellsEq]
    exact circuitHeaderToGateStart_exact
      inputs gateCount suffixCells
  rcases
      grammarNGatesTokenFailureWithFramingTail_bounded_exact
        inputs [] failure malformed with
    ⟨tailSteps, final, tailBound, tail,
      finalState, outputEmpty⟩
  have all :=
    exactRun_add headerSteps tailSteps
      _ _ _ header
      (by simpa [suffixCells] using tail)
  have spanEq :
      grammarWorkFailureSpan
          inputs [] gateCount suffixCells =
        word.length + 2 := by
    unfold grammarWorkFailureSpan
      grammarGatePrefix
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length, countCells_length,
      markedGateListCells]
    omega
  have headerBound :
      headerSteps ≤
        8 * (word.length + 1) := by
    dsimp [headerSteps]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length]
    omega
  have countBound :
      gateCount ≤ word.length + 1 := by
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length]
    omega
  have spanBound :
      grammarWorkFailureSpan
            inputs [] gateCount suffixCells + 1 ≤
        2 * (word.length + 1) := by
    rw [spanEq]
    have wordPositive : 1 ≤ word.length := by
      rw [cellsEq]
      simp
    omega
  have scheduleBound :=
    circuitFramingCubicComposition_bound
      word headerSteps tailSteps gateCount
      (grammarWorkFailureSpan
        inputs [] gateCount suffixCells)
      headerBound countBound spanBound
      (by simpa [suffixCells] using tailBound)
  exact
    ⟨headerSteps + tailSteps, final,
      scheduleBound,
      by simpa [initial] using all,
      finalState, outputEmpty⟩

private theorem circuitInvalidGatesWithFramingTail_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    (tokens : List Token)
    (gatesInvalid :
      rawGatesWellFormed inputs 0 gates = false)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
