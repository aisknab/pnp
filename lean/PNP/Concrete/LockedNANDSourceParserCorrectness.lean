private def sourceWorkFailureSpan
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before word : List WorkSymbol) : Nat :=
  (sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before).length +
    word.length + 2

private theorem sourceBoundaryCleanupWork_bounded_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before word : List WorkSymbol)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (wordSourcePacked :
      ∀ symbol, symbol ∈ word →
        SourcePackedCell symbol)
    (wordNonempty : word ≠ [])
    (launch :
      BoundaryCleanupLaunch
        (State.sourceStart continuation)
        (sourceContextPrefix
          inputs gateCountUsed gateCountRemaining
          priorGates before)
        word) :
    ∃ steps final,
      steps ≤
          128 *
            failureSpanSquare
              (sourceWorkFailureSpan
                inputs gateCountUsed gateCountRemaining
                priorGates before word) ∧
      workRunExact? machine steps
          (guardedConfig
            (State.sourceStart continuation)
            (sourceContextPrefix
              inputs gateCountUsed gateCountRemaining
              priorGates before)
            word) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  have contextOrdinary :
      ∀ symbol, symbol ∈ context →
        ordinaryCell symbol :=
    sourceContextPrefix_allOrdinary
      inputs gateCountUsed gateCountRemaining
      priorGates before beforeOrdinary
  rcases
      boundaryCleanupLaunch_square_bounded_exact
        (State.sourceStart continuation)
        context word contextOrdinary
        wordSourcePacked wordNonempty
        (by simpa [context] using launch) with
    ⟨steps, final, bound, run,
      finalState, outputEmpty⟩
  have lengthBound :
      (context ++ word).length ≤
        sourceWorkFailureSpan
          inputs gateCountUsed gateCountRemaining
          priorGates before word := by
    dsimp [context, sourceWorkFailureSpan]
    simp only [List.length_append]
    omega
  have squareBound :=
    failureSpanSquare_mono lengthBound
  have scaled :=
    Nat.mul_le_mul_left 16 squareBound
  refine
    ⟨steps, final, ?_, ?_,
      finalState, outputEmpty⟩
  · exact Nat.le_trans bound
      (Nat.le_trans scaled (by omega))
  · simpa [context] using run

private theorem sourceInputIndexTerminal_bounded_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining units : Nat)
    (priorGates : List RawGate)
    (before terminal : List WorkSymbol)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (terminalSourcePacked :
      ∀ symbol, symbol ∈ terminal →
        SourcePackedCell symbol)
    (terminalNonempty : terminal ≠ [])
    (terminalLaunch :
      ∀ parsedPrefix,
        BoundaryCleanupLaunch
          (State.indexFirst .input continuation)
          parsedPrefix terminal) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    let sourceWord :=
      [cell00, cell11] ++
        unaryUnitCells units ++ terminal
    ∃ steps final,
      steps ≤
          128 *
            failureSpanSquare
              (sourceWorkFailureSpan
                inputs gateCountUsed gateCountRemaining
                priorGates before sourceWord) ∧
      workRunExact? machine steps
          (guardedConfig
            (State.sourceStart continuation)
            context sourceWord) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  let between :=
    inputSourceFailureBetween
      gateCountUsed gateCountRemaining
      priorGates before
  let indexTail :=
    unaryUnitCells units ++ terminal
  let sourceWord :=
    [cell00, cell11] ++ indexTail
  let referencePrefix :=
    [cell00, cell00] ++
      countCells 0 inputs ++ between
  let referenceWhole :=
    referencePrefix ++ indexTail
  have betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol := by
    unfold between inputSourceFailureBetween
    apply ordinaryCells_append
    · apply ordinaryCells_append
      · apply ordinaryCells_append
        · exact countCells_allOrdinary
            gateCountUsed gateCountRemaining
        · exact markedGateListCells_allOrdinary
            priorGates
      · exact beforeOrdinary
    · intro symbol member
      simp only [List.mem_cons,
        List.not_mem_nil] at member
      rcases member with rfl | rfl | impossible
      · exact ordinaryCell_cell00
      · exact ordinaryCell_cell11
      · contradiction
  have launch :=
    sourceInputTag_exact
      continuation context indexTail
  have launchCanonical :
      workRunExact? machine 2
          (guardedConfig
            (State.sourceStart continuation)
            context sourceWord) =
        some
          (guardedConfig
            (State.indexFirst .input continuation)
            (context ++ [cell00, cell11])
            indexTail) := by
    simpa [sourceWord] using launch
  rcases
      inputReferenceTerminal_bounded_exact
        continuation 0 inputs units between terminal
        betweenOrdinary terminalSourcePacked
        terminalNonempty terminalLaunch with
    ⟨tailSteps, final, tailBound, tail,
      finalState, outputEmpty⟩
  have tailCanonical :
      workRunExact? machine tailSteps
          (guardedConfig
            (State.indexFirst .input continuation)
            (context ++ [cell00, cell11])
            indexTail) =
        some final := by
    simpa [context, sourceContextPrefix,
      gateReferenceHeader, between,
      inputSourceFailureBetween, countCells,
      indexTail, List.append_assoc] using tail
  have tailBoundCanonical :
      tailSteps ≤
        64 *
          failureSpanSquare
            referenceWhole.length := by
    simpa [referenceWhole, referencePrefix,
      indexTail] using tailBound
  have referenceLength :
      referenceWhole.length =
        (context ++ sourceWord).length := by
    dsimp [referenceWhole, referencePrefix,
      context, sourceWord, indexTail,
      sourceContextPrefix, gateReferenceHeader,
      between, inputSourceFailureBetween]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      countCells_length, natCells_length,
      markedGateListCells_length,
      unaryUnitCells_length]
    omega
  have referenceLe :
      referenceWhole.length ≤
        sourceWorkFailureSpan
          inputs gateCountUsed gateCountRemaining
          priorGates before sourceWord := by
    rw [referenceLength]
    unfold sourceWorkFailureSpan
    dsimp [context]
    simp only [List.length_append]
    omega
  have squareLe :=
    failureSpanSquare_mono referenceLe
  have tailBound' :=
    Nat.le_trans tailBoundCanonical
      (Nat.mul_le_mul_left 64 squareLe)
  have one :=
    one_le_failureSpanSquare
      (sourceWorkFailureSpan
        inputs gateCountUsed gateCountRemaining
        priorGates before sourceWord)
  have all :=
    exactRun_add 2 tailSteps
      _ _ _ launchCanonical tailCanonical
  have scheduleBound :
      2 + tailSteps ≤
        128 *
          failureSpanSquare
            (sourceWorkFailureSpan
              inputs gateCountUsed gateCountRemaining
              priorGates before sourceWord) := by
    exact Nat.le_trans
      (Nat.add_le_add_left tailBound' 2)
      (by omega)
  refine
    ⟨2 + tailSteps, final, ?_, ?_,
      finalState, outputEmpty⟩
  · simpa [sourceWord, indexTail] using
      scheduleBound
  · simpa [context, sourceWord,
      indexTail] using all

private theorem sourceGateIndexTerminal_bounded_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining units : Nat)
    (priorGates : List RawGate)
    (before terminal : List WorkSymbol)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (beforeNoGateMark :
      ∀ symbol, symbol ∈ before →
        symbol ≠ gateMark)
    (terminalSourcePacked :
      ∀ symbol, symbol ∈ terminal →
        SourcePackedCell symbol)
    (terminalNonempty : terminal ≠ [])
    (terminalLaunch :
      ∀ parsedPrefix,
        BoundaryCleanupLaunch
          (State.indexFirst .priorGate continuation)
          parsedPrefix terminal) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    let sourceWord :=
      [cell01, cell10] ++
        unaryUnitCells units ++ terminal
    ∃ steps final,
      steps ≤
          128 *
            failureSpanSquare
              (sourceWorkFailureSpan
                inputs gateCountUsed gateCountRemaining
                priorGates before sourceWord) ∧
      workRunExact? machine steps
          (guardedConfig
            (State.sourceStart continuation)
            context sourceWord) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  let header :=
    gateReferenceHeader
      inputs gateCountUsed gateCountRemaining
  let between := gateSourceFailureBetween before
  let indexTail :=
    unaryUnitCells units ++ terminal
  let sourceWord :=
    [cell01, cell10] ++ indexTail
  let referencePrefix :=
    header ++ borrowedGateListCells [] ++
      markedGateListCells priorGates ++ between
  let referenceWhole :=
    referencePrefix ++ indexTail
  have headerOrdinary :
      ∀ symbol, symbol ∈ header →
        ordinaryCell symbol :=
    gateReferenceHeader_allOrdinary
      inputs gateCountUsed gateCountRemaining
  have headerNoGateMark :
      ∀ symbol, symbol ∈ header →
        symbol ≠ gateMark :=
    gateReferenceHeader_no_gateMark
      inputs gateCountUsed gateCountRemaining
  have betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol := by
    unfold between gateSourceFailureBetween
    apply ordinaryCells_append
    · exact beforeOrdinary
    · intro symbol member
      simp only [List.mem_cons,
        List.not_mem_nil] at member
      rcases member with rfl | rfl | impossible
      · exact ordinaryCell_cell01
      · exact ordinaryCell_cell10
      · contradiction
  have betweenNoGateMark :
      ∀ symbol, symbol ∈ between →
        symbol ≠ gateMark := by
    intro symbol member
    unfold between gateSourceFailureBetween at member
    rcases List.mem_append.mp member with
        inBefore | inTag
    · exact beforeNoGateMark symbol inBefore
    · simp only [List.mem_cons,
        List.not_mem_nil] at inTag
      rcases inTag with rfl | rfl | impossible
      · decide
      · decide
      · contradiction
  have launch :=
    sourceGateTag_exact
      continuation context indexTail
  have launchCanonical :
      workRunExact? machine 2
          (guardedConfig
            (State.sourceStart continuation)
            context sourceWord) =
        some
          (guardedConfig
            (State.indexFirst .priorGate continuation)
            (context ++ [cell01, cell10])
            indexTail) := by
    simpa [sourceWord] using launch
  rcases
      gateReferenceTerminal_bounded_exact
        continuation header [] priorGates
        between units terminal headerOrdinary
        headerNoGateMark betweenOrdinary
        betweenNoGateMark terminalSourcePacked
        terminalNonempty terminalLaunch with
    ⟨tailSteps, final, tailBound, tail,
      finalState, outputEmpty⟩
  have tailCanonical :
      workRunExact? machine tailSteps
          (guardedConfig
            (State.indexFirst .priorGate continuation)
            (context ++ [cell01, cell10])
            indexTail) =
        some final := by
    simpa [context, sourceContextPrefix,
      header, between, gateSourceFailureBetween,
      borrowedGateListCells, indexTail,
      List.append_assoc] using tail
  have tailBoundCanonical :
      tailSteps ≤
        64 *
          failureSpanSquare
            referenceWhole.length := by
    simpa [referenceWhole, referencePrefix,
      indexTail] using tailBound
  have referenceLength :
      referenceWhole.length =
        (context ++ sourceWord).length := by
    dsimp [referenceWhole, referencePrefix,
      context, sourceWord, indexTail,
      sourceContextPrefix, header, between,
      gateSourceFailureBetween]
    simp only [borrowedGateListCells,
      List.length_append, List.length_cons,
      List.length_nil, unaryUnitCells_length]
    omega
  have referenceLe :
      referenceWhole.length ≤
        sourceWorkFailureSpan
          inputs gateCountUsed gateCountRemaining
          priorGates before sourceWord := by
    rw [referenceLength]
    unfold sourceWorkFailureSpan
    dsimp [context]
    simp only [List.length_append]
    omega
  have squareLe :=
    failureSpanSquare_mono referenceLe
  have tailBound' :=
    Nat.le_trans tailBoundCanonical
      (Nat.mul_le_mul_left 64 squareLe)
  have one :=
    one_le_failureSpanSquare
      (sourceWorkFailureSpan
        inputs gateCountUsed gateCountRemaining
        priorGates before sourceWord)
  have all :=
    exactRun_add 2 tailSteps
      _ _ _ launchCanonical tailCanonical
  have scheduleBound :
      2 + tailSteps ≤
        128 *
          failureSpanSquare
            (sourceWorkFailureSpan
              inputs gateCountUsed gateCountRemaining
              priorGates before sourceWord) := by
    exact Nat.le_trans
      (Nat.add_le_add_left tailBound' 2)
      (by omega)
  refine
    ⟨2 + tailSteps, final, ?_, ?_,
      finalState, outputEmpty⟩
  · simpa [sourceWord, indexTail] using
      scheduleBound
  · simpa [context, sourceWord,
      indexTail] using all

private theorem sourceTokenFailureWithFramingTail_bounded_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    {tokens : List Token}
    (failure : SourceTokenFailure tokens)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (beforeNoGateMark :
      ∀ symbol, symbol ∈ before →
        symbol ≠ gateMark)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    let word :=
      packedTokenCells tokens ++ workTail
    ∃ steps final,
      steps ≤
          128 *
            failureSpanSquare
              (sourceWorkFailureSpan
                inputs gateCountUsed gateCountRemaining
                priorGates before word) ∧
      workRunExact? machine steps
          (guardedConfig
            (State.sourceStart continuation)
            context word) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  let word :=
    packedTokenCells tokens ++ workTail
  cases failure with
  | missing =>
      have launch :
          BoundaryCleanupLaunch
            (State.sourceStart continuation)
            context workTail := by
        simpa [SimpleMalformedBoundary.state] using
          (simpleMalformedBoundary_launch
            (.source continuation) context malformed)
      have run :=
        sourceBoundaryCleanupWork_bounded_exact
          continuation inputs gateCountUsed
          gateCountRemaining priorGates before
          workTail beforeOrdinary
          malformed.allSourcePacked
          malformed.nonempty launch
      simpa [context, word, packedTokenCells] using run
  | wrongHead token suffix
      notInput notFalse notTrue notGate =>
      let after :=
        packedTokenCells suffix ++ workTail
      let boundaryWord :=
        tokenCells token ++ after
      have boundarySourcePacked :
          ∀ symbol, symbol ∈ boundaryWord →
            SourcePackedCell symbol := by
        intro symbol member
        apply
          tokenPrefixMalformedTail_allSourcePacked
            (token :: suffix) malformed symbol
        simpa [boundaryWord, after,
          packedTokenCells, List.append_assoc] using member
      have boundaryNonempty :
          boundaryWord ≠ [] := by
        intro empty
        have lengthEq := congrArg List.length empty
        dsimp [boundaryWord] at lengthEq
        simp only [List.length_append,
          tokenCells_length] at lengthEq
        omega
      have launch :=
        sourceWrongTokenWork_launch
          continuation context token after
          notInput notFalse notTrue notGate
      have run :=
        sourceBoundaryCleanupWork_bounded_exact
          continuation inputs gateCountUsed
          gateCountRemaining priorGates before
          boundaryWord beforeOrdinary
          boundarySourcePacked boundaryNonempty
          (by simpa [boundaryWord] using launch)
      simpa [context, word, boundaryWord, after,
        packedTokenCells, List.append_assoc] using run
  | inputIndex natFailure =>
      cases natFailure with
      | missingEnd units =>
          have terminalLaunch :
              ∀ parsedPrefix,
                BoundaryCleanupLaunch
                  (State.indexFirst .input continuation)
                  parsedPrefix workTail := by
            intro parsedPrefix
            simpa [SimpleMalformedBoundary.state] using
              (simpleMalformedBoundary_launch
                (.index .input continuation)
                parsedPrefix malformed)
          have run :=
            sourceInputIndexTerminal_bounded_exact
              continuation inputs gateCountUsed
              gateCountRemaining units priorGates
              before workTail beforeOrdinary
              malformed.allSourcePacked
              malformed.nonempty terminalLaunch
          simpa [context, word, packedTokenCells,
            tokenCells,
            packedTokenCells_replicate_unit,
            List.append_assoc] using run
      | wrongToken units token suffix
          notUnit notNatEnd =>
          let after :=
            packedTokenCells suffix ++ workTail
          let terminal :=
            tokenCells token ++ after
          have terminalSourcePacked :
              ∀ symbol, symbol ∈ terminal →
                SourcePackedCell symbol := by
            intro symbol member
            apply
              tokenPrefixMalformedTail_allSourcePacked
                (token :: suffix) malformed symbol
            simpa [terminal, after,
              packedTokenCells, List.append_assoc] using member
          have terminalNonempty :
              terminal ≠ [] := by
            intro empty
            have lengthEq := congrArg List.length empty
            dsimp [terminal] at lengthEq
            simp only [List.length_append,
              tokenCells_length] at lengthEq
            omega
          have terminalLaunch :
              ∀ parsedPrefix,
                BoundaryCleanupLaunch
                  (State.indexFirst .input continuation)
                  parsedPrefix terminal := by
            intro parsedPrefix
            have launch :=
              referenceWrongTokenWork_launch
                .input continuation parsedPrefix
                token after notUnit notNatEnd
            simpa [terminal] using launch
          have run :=
            sourceInputIndexTerminal_bounded_exact
              continuation inputs gateCountUsed
              gateCountRemaining units priorGates
              before terminal beforeOrdinary
              terminalSourcePacked terminalNonempty
              terminalLaunch
          have wordShape :
              word =
                [cell00, cell11] ++
                  unaryUnitCells units ++ terminal := by
            dsimp [word]
            rw [packedTokenCells]
            rw [packedTokenCells_append,
              packedTokenCells_replicate_unit]
            simp [terminal, after,
              packedTokenCells, tokenCells,
              List.append_assoc]
          have wordShapeCanonical :
              packedTokenCells
                    (.input ::
                      (List.replicate units .unit ++
                        token :: suffix)) ++
                  workTail =
                [cell00, cell11] ++
                  unaryUnitCells units ++ terminal := by
            simpa [word] using wordShape
          rw [wordShapeCanonical]
          simpa [context] using run
  | gateIndex natFailure =>
      cases natFailure with
      | missingEnd units =>
          have terminalLaunch :
              ∀ parsedPrefix,
                BoundaryCleanupLaunch
                  (State.indexFirst
                    .priorGate continuation)
                  parsedPrefix workTail := by
            intro parsedPrefix
            simpa [SimpleMalformedBoundary.state] using
              (simpleMalformedBoundary_launch
                (.index .priorGate continuation)
                parsedPrefix malformed)
          have run :=
            sourceGateIndexTerminal_bounded_exact
              continuation inputs gateCountUsed
              gateCountRemaining units priorGates
              before workTail beforeOrdinary
              beforeNoGateMark
              malformed.allSourcePacked
              malformed.nonempty terminalLaunch
          simpa [context, word, packedTokenCells,
            tokenCells,
            packedTokenCells_replicate_unit,
            List.append_assoc] using run
      | wrongToken units token suffix
          notUnit notNatEnd =>
          let after :=
            packedTokenCells suffix ++ workTail
          let terminal :=
            tokenCells token ++ after
          have terminalSourcePacked :
              ∀ symbol, symbol ∈ terminal →
                SourcePackedCell symbol := by
            intro symbol member
            apply
              tokenPrefixMalformedTail_allSourcePacked
                (token :: suffix) malformed symbol
            simpa [terminal, after,
              packedTokenCells, List.append_assoc] using member
          have terminalNonempty :
              terminal ≠ [] := by
            intro empty
            have lengthEq := congrArg List.length empty
            dsimp [terminal] at lengthEq
            simp only [List.length_append,
              tokenCells_length] at lengthEq
            omega
          have terminalLaunch :
              ∀ parsedPrefix,
                BoundaryCleanupLaunch
                  (State.indexFirst
                    .priorGate continuation)
                  parsedPrefix terminal := by
            intro parsedPrefix
            have launch :=
              referenceWrongTokenWork_launch
                .priorGate continuation parsedPrefix
                token after notUnit notNatEnd
            simpa [terminal] using launch
          have run :=
            sourceGateIndexTerminal_bounded_exact
              continuation inputs gateCountUsed
              gateCountRemaining units priorGates
              before terminal beforeOrdinary
              beforeNoGateMark terminalSourcePacked
              terminalNonempty terminalLaunch
          have wordShape :
              word =
                [cell01, cell10] ++
                  unaryUnitCells units ++ terminal := by
            dsimp [word]
            rw [packedTokenCells]
            rw [packedTokenCells_append,
              packedTokenCells_replicate_unit]
            simp [terminal, after,
              packedTokenCells, tokenCells,
              List.append_assoc]
          have wordShapeCanonical :
              packedTokenCells
                    (.gate ::
                      (List.replicate units .unit ++
                        token :: suffix)) ++
                  workTail =
                [cell01, cell10] ++
                  unaryUnitCells units ++ terminal := by
            simpa [word] using wordShape
          rw [wordShapeCanonical]
          simpa [context] using run

