          Nat.add_assoc] using bound
      refine
        ⟨steps, final, ?_, ?_,
          finalState, output⟩
      · apply grammarSingleGateBound remaining
        exact
          Nat.le_trans boundCanonical
            (Nat.mul_le_mul_right
              (failureSpanSquare
                (grammarTokenFailureSpan
                  inputs done (remaining + 1)
                  (encodeSourceTokens left ++
                    encodeSourceTokens right ++
                    .gateEnd :: tokens)))
              (show 32 ≤ 64 by decide))
      · simpa [tailCells,
          packedTokenCells_append,
          packedTokenCells_encodeSourceTokens,
          packedTokenCells, tokenCells,
          List.append_assoc] using run
  | true =>
      rcases
          grammarGateLeftValid_exact
            inputs done remaining left
            (sourceCells right ++ tailCells)
            leftEq with
        ⟨leftSteps, leftBound, leftRun⟩
      have leftBoundCanonical :
          leftSteps ≤
            32 *
              failureSpanSquare
                (grammarTokenFailureSpan
                  inputs done (remaining + 1)
                  (encodeSourceTokens left ++
                    encodeSourceTokens right ++
                    .gateEnd :: tokens)) := by
        simpa [grammarTokenFailureSpan,
          grammarWorkFailureSpan, tailCells,
          packedTokenCells_append,
          packedTokenCells_encodeSourceTokens,
