              List.length_append,
              Nat.add_assoc] using rightBound
          have all :=
            exactRun_add leftSteps rightSteps
              _ _ _ leftRun rightRun
          have headBound :
              leftSteps + rightSteps ≤
                64 *
                  failureSpanSquare
                    (grammarTokenFailureSpan
                      inputs done (remaining + 1)
                      (encodeSourceTokens left ++
                        encodeSourceTokens right ++
