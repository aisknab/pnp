    rw [guardedConfig_eq_crossed]
    dsimp [prefixSteps, initial, word,
      suffixCells, tokens, parsedCells]
    rw [canonicalShape]
    simpa [parsedCells,
      List.append_assoc] using
      (gateCountUnitsPrefix_exact
        inputs units
        (tokenCells token ++
          (packedTokenCells suffix ++ workTail)))
  apply
    natWrongTokenWithFramingTail_bounded_exact
      word State.gateCountFirst parsedCells
      token suffix workTail initial prefixSteps
      wordShape wordOrdinary prefixRun
  · intro current rest wrong
    rw [guardedConfig_eq_crossed]
    exact gateCountFirstFailure_exact
      parsedCells current rest wrong
  · intro current rest notUnitCell notEndCell
    rw [guardedConfig_eq_crossed]
    exact gateCountSecondFailure_exact
      parsedCells current rest
      notUnitCell notEndCell
  · exact notUnit
  · exact notNatEnd
  · have lengthEq :=
      congrArg List.length wordShape
    dsimp [prefixSteps, parsedCells,
      suffixCells] at lengthEq
    simp only [List.length_append,
      natCells_length,
      unaryUnitCells_length,
      tokenCells_length] at lengthEq
    omega

/-! ### Complete circuit prefixes followed by an arbitrary work tail -/

private theorem circuitValidGatesWord_exact
    (inputs : Nat) (gates : List RawGate)
    (after : List WorkSymbol)
    (gatesValid :
      rawGatesWellFormed inputs 0 gates = true) :
    workRunExact? machine
        ((2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates)
        (workStartConfiguration machine
          (WorkTape.ofSymbols
            ([cell00, cell00] ++ natCells inputs ++
              natCells gates.length ++
              gateListCells gates ++ after))) =
      some
        (guardedConfig State.gateStart
          (gatePrefix inputs gates []) after) := by
  have header :=
    circuitHeaderToGateStart_exact
      inputs gates.length
      (gateListCells gates ++ after)
  have gatesRun :=
    gates_exact inputs [] gates after gatesValid
  have all :=
    exactRun_add
      (2 * inputs + 2 * gates.length + 8)
      (gatesSteps inputs [] gates)
      _ _ _ header gatesRun
  simpa [gatePrefix, grammarGatePrefix,
    List.append_assoc] using all

private theorem circuitProgramPrefixWord_exact
    (inputs : Nat) (gates : List RawGate)
    (after : List WorkSymbol)
    (gatesValid :
      rawGatesWellFormed inputs 0 gates = true) :
    workRunExact? machine
        (((2 * inputs + 2 * gates.length + 8) +
            gatesSteps inputs [] gates) +
          programEndSteps inputs gates)
        (workStartConfiguration machine
          (WorkTape.ofSymbols
            ([cell00, cell00] ++ natCells inputs ++
              natCells gates.length ++
              gateListCells gates ++
              [cell10, cell00] ++ after))) =
      some
        (guardedConfig (State.sourceStart .output)
          (sourceContextPrefix
            inputs 0 gates.length gates
            [cell10, cell00])
          after) := by
  have gatesRun :=
    circuitValidGatesWord_exact inputs gates
      (cell10 :: cell00 :: after) gatesValid
  have program :=
    programEnd_exact inputs gates after
  have all :=
    exactRun_add
      ((2 * inputs + 2 * gates.length + 8) +
        gatesSteps inputs [] gates)
      (programEndSteps inputs gates)
      _ _ _ gatesRun program
  simpa [List.append_assoc] using all

private def circuitProgramPrefixTokens
    (inputs : Nat) (gates : List RawGate) :
    List Token :=
  circuitGatesPrefixTokens inputs gates ++
    [.programEnd]

private def circuitProgramRawPrefixCells
    (inputs : Nat) (gates : List RawGate) :
    List WorkSymbol :=
  [cell00, cell00] ++ natCells inputs ++
    natCells gates.length ++
    gateListCells gates ++ [cell10, cell00]

private def circuitProgramParsedPrefix
    (inputs : Nat) (gates : List RawGate) :
    List WorkSymbol :=
  sourceContextPrefix
    inputs 0 gates.length gates [cell10, cell00]

private theorem packedCircuitProgramPrefixTokens_eq_rawPrefixCells
    (inputs : Nat) (gates : List RawGate) :
    packedTokenCells
        (circuitProgramPrefixTokens inputs gates) =
      circuitProgramRawPrefixCells inputs gates := by
  have cellsEq :=
    packedCircuitGatesPrefixTokens_append
      inputs gates [.programEnd]
  simpa [circuitProgramPrefixTokens,
    circuitProgramRawPrefixCells,
    packedTokenCells, tokenCells,
    List.append_assoc] using cellsEq

private theorem circuitProgramRawPrefixCells_length_eq_parsed
    (inputs : Nat) (gates : List RawGate) :
    (circuitProgramRawPrefixCells inputs gates).length =
      (circuitProgramParsedPrefix
        inputs gates).length := by
  unfold circuitProgramRawPrefixCells
    circuitProgramParsedPrefix
    sourceContextPrefix gateReferenceHeader
  simp only [List.length_append,
    List.length_cons, List.length_nil,
    natCells_length, countCells_length,
    markedGateListCells_length]
  omega

private theorem circuitProgramPackedPrefixWord_exact
    (inputs : Nat) (gates : List RawGate)
    (after : List WorkSymbol)
    (gatesValid :
      rawGatesWellFormed inputs 0 gates = true) :
    workRunExact? machine
        (((2 * inputs + 2 * gates.length + 8) +
            gatesSteps inputs [] gates) +
          programEndSteps inputs gates)
        (workStartConfiguration machine
          (WorkTape.ofSymbols
            (packedTokenCells
                (circuitProgramPrefixTokens
                  inputs gates) ++
              after))) =
      some
        (guardedConfig (State.sourceStart .output)
          (circuitProgramParsedPrefix
            inputs gates)
          after) := by
  rw [
    packedCircuitProgramPrefixTokens_eq_rawPrefixCells]
  simpa [circuitProgramRawPrefixCells,
    circuitProgramParsedPrefix] using
    (circuitProgramPrefixWord_exact
      inputs gates after gatesValid)

private theorem circuitProgramPackedPrefixWordSteps_bound
    (inputs : Nat) (gates : List RawGate)
    (after : List WorkSymbol) :
    ((2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates) +
        programEndSteps inputs gates ≤
      160 *
        failureSpanCube
          (packedTokenCells
              (circuitProgramPrefixTokens
                inputs gates) ++
            after).length := by
  let tokens :=
    circuitProgramPrefixTokens inputs gates
  have base :
      ((2 * inputs + 2 * gates.length + 8) +
            gatesSteps inputs [] gates) +
          programEndSteps inputs gates ≤
        160 *
          failureSpanCube
            (circuitTokenFailureSpan tokens) := by
    simpa [tokens, circuitProgramPrefixTokens] using
      (circuitProgramPrefixSteps_bound
        inputs gates [])
  have spanEq :
      circuitTokenFailureSpan tokens =
        (packedTokenCells tokens).length := rfl
  rw [spanEq] at base
  have lengthBound :
      (packedTokenCells tokens).length ≤
        (packedTokenCells tokens ++ after).length := by
    simp
  have cubeBound :=
    failureSpanCube_mono_work lengthBound
  exact Nat.le_trans base
    (by
      simpa [tokens] using
        Nat.mul_le_mul_left 160 cubeBound)

private theorem sourceWrongTokenWork_launch
    (continuation : SourceContinuation)
    (parsedPrefix : List WorkSymbol)
    (token : Token) (after : List WorkSymbol)
    (notInput : token ≠ .input)
    (notFalse : token ≠ .constantFalse)
    (notTrue : token ≠ .constantTrue)
    (notGate : token ≠ .gate) :
    BoundaryCleanupLaunch
      (State.sourceStart continuation)
      parsedPrefix (tokenCells token ++ after) := by
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq : tokenCells token = [current, next])
      (not00 : current ≠ cell00)
      (not01 : current ≠ cell01) :
      BoundaryCleanupLaunch
        (State.sourceStart continuation)
        parsedPrefix (tokenCells token ++ after) := by
    rw [cellsEq]
    apply boundaryCleanupLaunch_immediate
    simpa using
      sourceStartFirstFailure_exact
        continuation parsedPrefix current
        (next :: after) not00 not01
  have rejectAfter00
      (current : WorkSymbol)
      (cellsEq :
        tokenCells token = [cell00, current])
      (not11 : current ≠ cell11) :
      BoundaryCleanupLaunch
        (State.sourceStart continuation)
        parsedPrefix (tokenCells token ++ after) := by
    rw [cellsEq]
    apply boundaryCleanupLaunch_afterOne_retained
    · exact ordinaryCell_cleanupSafe
        ordinaryCell_cell00
    · simpa using
        sourceAfter00Failure_exact
          continuation parsedPrefix current
          after not11
  have rejectAfter01
      (current : WorkSymbol)
      (cellsEq :
        tokenCells token = [cell01, current])
      (not00 : current ≠ cell00)
      (not01 : current ≠ cell01)
      (not10 : current ≠ cell10) :
      BoundaryCleanupLaunch
        (State.sourceStart continuation)
        parsedPrefix (tokenCells token ++ after) := by
    rw [cellsEq]
    apply boundaryCleanupLaunch_afterOne_retained
    · exact ordinaryCell_cleanupSafe
        ordinaryCell_cell01
    · simpa using
        sourceAfter01Failure_exact
          continuation parsedPrefix current after
          not00 not01 not10
  cases token with
  | version0 =>
      exact rejectAfter00 cell00 rfl (by decide)
  | unit =>
      exact rejectAfter00 cell01 rfl (by decide)
  | natEnd =>
      exact rejectAfter00 cell10 rfl (by decide)
  | input =>
      exact False.elim (notInput rfl)
  | constantFalse =>
      exact False.elim (notFalse rfl)
  | constantTrue =>
      exact False.elim (notTrue rfl)
  | gate =>
      exact False.elim (notGate rfl)
  | gateEnd =>
      exact rejectAfter01 cell11 rfl
        (by decide) (by decide) (by decide)
  | programEnd =>
      exact rejectFirst cell10 cell00 rfl
        (by decide) (by decide)
  | outputsEnd =>
      exact rejectFirst cell10 cell01 rfl
        (by decide) (by decide)
  | threshold =>
      exact rejectFirst cell10 cell10 rfl
        (by decide) (by decide)
  | instanceEnd =>
      exact rejectFirst cell10 cell11 rfl
        (by decide) (by decide)

private theorem missingOutputWithFramingTail_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    (gatesValid :
      rawGatesWellFormed inputs 0 gates = true)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    let tokens :=
      circuitProgramPrefixTokens inputs gates
    let word :=
      packedTokenCells tokens ++ workTail
    ∃ steps final,
      steps ≤ rawFailureEnvelope word ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols word)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let tokens :=
    circuitProgramPrefixTokens inputs gates
  let parsedPrefix :=
    circuitProgramParsedPrefix inputs gates
  let word :=
    packedTokenCells tokens ++ workTail
  let initial :=
    workStartConfiguration machine
      (WorkTape.ofSymbols word)
  let prefixSteps :=
    ((2 * inputs + 2 * gates.length + 8) +
        gatesSteps inputs [] gates) +
      programEndSteps inputs gates
  have prefixRun :
      workRunExact? machine prefixSteps initial =
        some
          (guardedConfig (State.sourceStart .output)
            parsedPrefix workTail) := by
    simpa [prefixSteps, initial, word, tokens,
      parsedPrefix] using
      (circuitProgramPackedPrefixWord_exact
        inputs gates workTail gatesValid)
  have prefixCubic :
      prefixSteps ≤
        160 * failureSpanCube word.length := by
    simpa [prefixSteps, word, tokens] using
      (circuitProgramPackedPrefixWordSteps_bound
        inputs gates workTail)
  have prefixLength :
      (packedTokenCells tokens).length =
        parsedPrefix.length := by
    dsimp [tokens, parsedPrefix]
    rw [
      packedCircuitProgramPrefixTokens_eq_rawPrefixCells]
    exact
      circuitProgramRawPrefixCells_length_eq_parsed
        inputs gates
  have wholeLength :
      word.length =
        (parsedPrefix ++ workTail).length := by
    dsimp [word]
    simp only [List.length_append]
    rw [prefixLength]
  have launch :=
    simpleMalformedBoundary_launch
      (.source .output) parsedPrefix malformed
  apply
    cubicPrefixBoundaryCleanup_bounded_exact
      word parsedPrefix workTail
      (State.sourceStart .output) initial
      prefixSteps 160 wholeLength
  · exact sourceContextPrefix_allOrdinary
      inputs 0 gates.length gates
      [cell10, cell00]
      (by
        intro symbol member
        simp only [List.mem_cons,
          List.not_mem_nil] at member
        rcases member with rfl | rfl | impossible
        · exact ordinaryCell_cell10
        · exact ordinaryCell_cell00
        · contradiction)
  · exact malformed.allSourcePacked
  · exact malformed.nonempty
  · exact prefixRun
  · exact prefixCubic
  · omega
  · exact launch

private theorem wrongOutputHeadWithFramingTail_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    (token : Token) (suffix : List Token)
    (notInput : token ≠ .input)
    (notFalse : token ≠ .constantFalse)
    (notTrue : token ≠ .constantTrue)
    (notGate : token ≠ .gate)
    (gatesValid :
      rawGatesWellFormed inputs 0 gates = true)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    let tokens :=
      circuitProgramPrefixTokens inputs gates ++
        token :: suffix
    let word :=
      packedTokenCells tokens ++ workTail
    ∃ steps final,
      steps ≤ rawFailureEnvelope word ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols word)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let prefixTokens :=
    circuitProgramPrefixTokens inputs gates
  let tokens := prefixTokens ++ token :: suffix
  let parsedPrefix :=
    circuitProgramParsedPrefix inputs gates
  let suffixCells :=
    packedTokenCells suffix ++ workTail
  let boundaryTail :=
    tokenCells token ++ suffixCells
  let word :=
    packedTokenCells tokens ++ workTail
  let initial :=
    workStartConfiguration machine
      (WorkTape.ofSymbols word)
  let prefixSteps :=
    ((2 * inputs + 2 * gates.length + 8) +
        gatesSteps inputs [] gates) +
      programEndSteps inputs gates
  have wordShape :
      word =
        packedTokenCells prefixTokens ++
          boundaryTail := by
    dsimp [word, tokens, boundaryTail,
      suffixCells]
    rw [packedTokenCells_append]
    simp [packedTokenCells, List.append_assoc]
  have prefixRun :
      workRunExact? machine prefixSteps initial =
        some
          (guardedConfig (State.sourceStart .output)
            parsedPrefix boundaryTail) := by
    dsimp [prefixSteps, initial]
    rw [wordShape]
    simpa [prefixTokens, parsedPrefix] using
      (circuitProgramPackedPrefixWord_exact
        inputs gates boundaryTail gatesValid)
  have prefixCubic :
      prefixSteps ≤
        160 * failureSpanCube word.length := by
    have raw :=
      circuitProgramPackedPrefixWordSteps_bound
        inputs gates boundaryTail
    rw [wordShape]
    simpa [prefixSteps, prefixTokens] using raw
  have prefixLength :
      (packedTokenCells prefixTokens).length =
        parsedPrefix.length := by
    dsimp [prefixTokens, parsedPrefix]
    rw [
      packedCircuitProgramPrefixTokens_eq_rawPrefixCells]
    exact
      circuitProgramRawPrefixCells_length_eq_parsed
        inputs gates
  have wholeLength :
      word.length =
        (parsedPrefix ++ boundaryTail).length := by
    rw [wordShape]
    simp only [List.length_append]
    rw [prefixLength]
  have boundarySourcePacked :
      ∀ symbol, symbol ∈ boundaryTail →
        SourcePackedCell symbol := by
    intro symbol member
    apply
      tokenPrefixMalformedTail_allSourcePacked
        (token :: suffix) malformed symbol
    simpa [boundaryTail, suffixCells,
      packedTokenCells, List.append_assoc] using member
  have boundaryNonempty :
      boundaryTail ≠ [] := by
    intro empty
    have lengthEq := congrArg List.length empty
    dsimp [boundaryTail] at lengthEq
    simp only [List.length_append,
      tokenCells_length] at lengthEq
    omega
  have launch :=
    sourceWrongTokenWork_launch
      .output parsedPrefix token suffixCells
      notInput notFalse notTrue notGate
  apply
    cubicPrefixBoundaryCleanup_bounded_exact
      word parsedPrefix boundaryTail
      (State.sourceStart .output) initial
      prefixSteps 160 wholeLength
  · exact sourceContextPrefix_allOrdinary
      inputs 0 gates.length gates
      [cell10, cell00]
      (by
        intro symbol member
        simp only [List.mem_cons,
          List.not_mem_nil] at member
        rcases member with rfl | rfl | impossible
        · exact ordinaryCell_cell10
        · exact ordinaryCell_cell00
        · contradiction)
  · exact boundarySourcePacked
  · exact boundaryNonempty
  · exact prefixRun
  · exact prefixCubic
  · omega
  · exact launch

private theorem referenceWrongTokenWork_launch
    (bound : ReferenceBound)
    (continuation : SourceContinuation)
    (parsedPrefix : List WorkSymbol)
    (token : Token) (after : List WorkSymbol)
    (notUnit : token ≠ .unit)
    (notNatEnd : token ≠ .natEnd) :
    BoundaryCleanupLaunch
      (State.indexFirst bound continuation)
      parsedPrefix (tokenCells token ++ after) := by
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq : tokenCells token = [current, next])
      (wrong : current ≠ cell00) :
      BoundaryCleanupLaunch
        (State.indexFirst bound continuation)
        parsedPrefix (tokenCells token ++ after) := by
    rw [cellsEq]
    apply boundaryCleanupLaunch_immediate
    simpa using
      referenceIndexFirstFailure_exact
        bound continuation parsedPrefix current
        (next :: after) wrong
  have rejectSecond
      (current : WorkSymbol)
      (cellsEq :
        tokenCells token = [cell00, current])
      (notUnitCell : current ≠ cell01)
      (notEndCell : current ≠ cell10) :
      BoundaryCleanupLaunch
        (State.indexFirst bound continuation)
        parsedPrefix (tokenCells token ++ after) := by
    rw [cellsEq]
    apply boundaryCleanupLaunch_afterOne_retained
    · exact ordinaryCell_cleanupSafe
        ordinaryCell_cell00
    · simpa using
        referenceIndexSecondFailure_exact
          bound continuation parsedPrefix current
          after notUnitCell notEndCell
  cases token with
  | version0 =>
      exact rejectSecond cell00 rfl
        (by decide) (by decide)
  | unit =>
      exact False.elim (notUnit rfl)
  | natEnd =>
      exact False.elim (notNatEnd rfl)
  | input =>
      exact rejectSecond cell11 rfl
        (by decide) (by decide)
  | constantFalse =>
      exact rejectFirst cell01 cell00 rfl (by decide)
  | constantTrue =>
      exact rejectFirst cell01 cell01 rfl (by decide)
  | gate =>
      exact rejectFirst cell01 cell10 rfl (by decide)
  | gateEnd =>
      exact rejectFirst cell01 cell11 rfl (by decide)
  | programEnd =>
      exact rejectFirst cell10 cell00 rfl (by decide)
  | outputsEnd =>
      exact rejectFirst cell10 cell01 rfl (by decide)
  | threshold =>
      exact rejectFirst cell10 cell10 rfl (by decide)
  | instanceEnd =>
      exact rejectFirst cell10 cell11 rfl (by decide)

private theorem inputReferenceTerminal_linear_bounded_exact
    (continuation : SourceContinuation)
    (used remaining units : Nat)
    (between terminal : List WorkSymbol)
    (betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol)
    (terminalSourcePacked :
      ∀ symbol, symbol ∈ terminal →
        SourcePackedCell symbol)
    (terminalNonempty : terminal ≠ [])
    (terminalLaunch :
      ∀ parsedPrefix,
        BoundaryCleanupLaunch
          (State.indexFirst .input continuation)
          parsedPrefix terminal) :
    let parsedPrefix :=
      [cell00, cell00] ++
        countCells used remaining ++ between
    let indexWord :=
      unaryUnitCells units ++ terminal
    let wholeWord := parsedPrefix ++ indexWord
    ∃ steps final,
      steps ≤
          64 * (units + 1) *
            (wholeWord.length + 1) ∧
      workRunExact? machine steps
          (guardedConfig
            (State.indexFirst .input continuation)
            parsedPrefix indexWord) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  induction units generalizing used remaining between with
  | zero =>
      let parsedPrefix :=
        [cell00, cell00] ++
          countCells used remaining ++ between
      let wholeWord := parsedPrefix ++ terminal
      have parsedOrdinary :
          ∀ symbol, symbol ∈ parsedPrefix →
            ordinaryCell symbol :=
        inputReferencePrefix_allOrdinary
          used remaining between betweenOrdinary
      rcases
          boundaryCleanupLaunch_linear_bounded_exact
            (State.indexFirst .input continuation)
            parsedPrefix terminal parsedOrdinary
            terminalSourcePacked terminalNonempty
            (terminalLaunch parsedPrefix) with
        ⟨steps, final, bound, run,
          finalState, outputEmpty⟩
      refine
        ⟨steps, final, ?_, ?_,
          finalState, outputEmpty⟩
      · have widened :
            4 * (wholeWord.length + 1) ≤
              64 * (0 + 1) *
                (wholeWord.length + 1) := by
          omega
        exact Nat.le_trans
          (by simpa [wholeWord] using bound)
          widened
      · simpa [parsedPrefix, unaryUnitCells] using run
  | succ units ih =>
      cases remaining with
      | zero =>
          let parsedPrefix :=
            [cell00, cell00] ++
              countCells used 0 ++ between
          let indexTail :=
            unaryUnitCells units ++ terminal
          let indexWord :=
            cell00 :: cell01 :: indexTail
          let wholeWord := parsedPrefix ++ indexWord
          let failurePrefix :=
            [cell00, cell00] ++
              borrowedCountCells used ++ [cell00]
          let failureSuffix :=
            between ++ [cell00, cursorMark] ++
              indexTail
          let scan :=
            cell10 :: pushCrossed failurePrefix []
          let steps :=
            inputReferenceExhaustedSteps used between +
              guardedCleanupSteps scan failureSuffix
          let final :=
            cleanupRejectConfiguration
              [] scan failureSuffix []
          have exhausted :=
            inputReferenceConsumeExhaustedTail_exact
              continuation used between indexTail
              betweenOrdinary
          have failurePrefixOrdinary :
              ∀ symbol, symbol ∈ failurePrefix →
                ordinaryCell symbol := by
            intro symbol member
            dsimp [failurePrefix] at member
            simp only [List.mem_cons] at member
            rcases member with rfl | member
            · exact ordinaryCell_cell00
            · rcases member with rfl | member
              · exact ordinaryCell_cell00
              · rcases List.mem_append.mp member with
                  inBorrowed | inFinal
                · exact borrowedCountCells_allOrdinary
                    used symbol inBorrowed
                · simp only [List.mem_cons,
                    List.not_mem_nil] at inFinal
                  rcases inFinal with rfl | impossible
                  · exact ordinaryCell_cell00
                  · contradiction
          have indexTailSafe :
              ∀ symbol, symbol ∈ indexTail →
                cleanupSafeCell symbol := by
            intro symbol member
            rcases List.mem_append.mp member with
                inUnits | inTerminal
            · exact ordinaryCell_cleanupSafe
                (unaryUnitCells_allOrdinary
                  units symbol inUnits)
            · exact ordinaryCell_cleanupSafe
                (sourcePackedCell_ordinary
                  (terminalSourcePacked
                    symbol inTerminal))
          have safe :
              ∀ symbol,
                symbol ∈
                    failurePrefix ++
                      cell10 :: failureSuffix →
                  cleanupSafeCell symbol := by
            intro symbol member
            simp only [List.mem_append,
              List.mem_cons] at member
            rcases member with
                inPrefix | atHead | inFailureSuffix
            · exact ordinaryCell_cleanupSafe
                (failurePrefixOrdinary symbol inPrefix)
            · subst symbol
              exact ordinaryCell_cleanupSafe
                ordinaryCell_cell10
            · have normalized :
                  symbol ∈
                    (between ++ [cell00, cursorMark]) ++
                      indexTail := by
                simpa [failureSuffix,
                  List.append_assoc] using inFailureSuffix
              rcases List.mem_append.mp normalized with
                  inLeading | inTail
              · rcases List.mem_append.mp inLeading with
                  inBetween | inMarkers
                · exact ordinaryCell_cleanupSafe
                    (betweenOrdinary symbol inBetween)
                · simp only [List.mem_cons,
                    List.not_mem_nil] at inMarkers
                  rcases inMarkers with
                      rfl | rfl | impossible
                  · exact ordinaryCell_cleanupSafe
                      ordinaryCell_cell00
                  · exact cursorMark_cleanupSafe
                  · contradiction
              · exact indexTailSafe symbol inTail
          have cleanup :=
            safeGuardedCleanup_exact
              failurePrefix cell10 failureSuffix safe
          have run :=
            exactRun_add
              (inputReferenceExhaustedSteps used between)
              (guardedCleanupSteps scan failureSuffix)
              _ _ _ exhausted cleanup
          have linear :
              steps ≤ 16 * (wholeWord.length + 1) := by
            dsimp [steps, wholeWord, parsedPrefix,
              indexWord, indexTail, scan,
              failurePrefix, failureSuffix]
            unfold inputReferenceExhaustedSteps
            rw [guardedCleanupSteps_eq]
            simp only [List.length_append,
              List.length_cons, List.length_nil,
              countCells_length,
              borrowedCountCells_length,
              unaryUnitCells_length,
              pushCrossed_length]
            omega
          have scheduleBound :
              steps ≤
                64 * (units + 1 + 1) *
                  (wholeWord.length + 1) :=
            Nat.le_trans linear
              (Nat.mul_le_mul_right
                (wholeWord.length + 1)
                (show 16 ≤
                    64 * (units + 1 + 1) by
                  omega))
          refine
            ⟨steps, final, ?_, ?_,
              rfl,
              cleanupRejectConfiguration_output_empty
                [] scan failureSuffix⟩
          · simpa [steps, wholeWord, parsedPrefix,
              indexWord, indexTail, unaryUnitCells] using
              scheduleBound
          · simpa [steps, final, parsedPrefix,
              indexWord, indexTail, wholeWord,
              scan, failurePrefix, failureSuffix,
              unaryUnitCells] using run
      | succ remaining =>
          let parsedPrefix :=
            [cell00, cell00] ++
              countCells used (remaining + 1) ++
                between
          let indexTail :=
            unaryUnitCells units ++ terminal
          let indexWord :=
            cell00 :: cell01 :: indexTail
          let wholeWord := parsedPrefix ++ indexWord
          let nextBetween :=
            between ++ [cell00, cell01]
          let nextPrefix :=
            [cell00, cell00] ++
              countCells (used + 1) remaining ++
                nextBetween
          let nextWhole :=
            nextPrefix ++ indexTail
          have first :=
            inputReferenceConsumeUnitTail_exact
              continuation used remaining between
              indexTail betweenOrdinary
          have nextBetweenOrdinary :
              ∀ symbol, symbol ∈ nextBetween →
                ordinaryCell symbol := by
            dsimp [nextBetween]
            apply ordinaryCells_append
            · exact betweenOrdinary
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | rfl | impossible
              · exact ordinaryCell_cell00
              · exact ordinaryCell_cell01
              · contradiction
          rcases
              ih (used + 1) remaining
                nextBetween nextBetweenOrdinary with
            ⟨tailSteps, final, tailBound, tail,
              finalState, outputEmpty⟩
          have wholeLength :
              nextWhole.length = wholeWord.length := by
            dsimp [nextWhole, nextPrefix, nextBetween,
              wholeWord, parsedPrefix, indexWord,
              indexTail]
            simp only [List.length_append,
              List.length_cons, List.length_nil,
              countCells_length,
              unaryUnitCells_length]
            omega
          have tailBound' :
              tailSteps ≤
                64 * (units + 1) *
                  (wholeWord.length + 1) := by
            have canonical :
                tailSteps ≤
                  64 * (units + 1) *
                    (nextWhole.length + 1) := by
              simpa [nextWhole, nextPrefix, nextBetween,
                indexTail] using tailBound
            rwa [wholeLength] at canonical
          have firstLinear :
              inputReferenceConsumeUnitSteps
                    used remaining between ≤
                16 * (wholeWord.length + 1) := by
            dsimp [wholeWord, parsedPrefix,
              indexWord, indexTail]
            unfold inputReferenceConsumeUnitSteps
            simp only [List.length_append,
              List.length_cons, List.length_nil,
              countCells_length,
              unaryUnitCells_length, natCells_length]
            omega
          have combined :=
            Nat.add_le_add firstLinear tailBound'
          have scheduleBound :
              inputReferenceConsumeUnitSteps
                    used remaining between + tailSteps ≤
                64 * (units + 1 + 1) *
                  (wholeWord.length + 1) := by
            calc
              inputReferenceConsumeUnitSteps
                      used remaining between + tailSteps ≤
                  16 * (wholeWord.length + 1) +
                    (64 * (units + 1)) *
                      (wholeWord.length + 1) :=
                combined
              _ =
                  (16 + 64 * (units + 1)) *
                    (wholeWord.length + 1) := by
                rw [Nat.add_mul]
              _ ≤
                  (64 * (units + 1 + 1)) *
                    (wholeWord.length + 1) :=
                Nat.mul_le_mul_right
                  (wholeWord.length + 1)
                  (by omega)
          have run :=
            exactRun_add
              (inputReferenceConsumeUnitSteps
                used remaining between)
              tailSteps _ _ _ first tail
          refine
            ⟨inputReferenceConsumeUnitSteps
                used remaining between + tailSteps,
              final, ?_, ?_,
              finalState, outputEmpty⟩
          · simpa [wholeWord, parsedPrefix,
              indexWord, indexTail, unaryUnitCells] using
              scheduleBound
          · simpa [parsedPrefix, indexWord,
              indexTail, nextPrefix, nextBetween,
              nextWhole, unaryUnitCells] using run

private theorem inputReferenceTerminal_bounded_exact
    (continuation : SourceContinuation)
    (used remaining units : Nat)
    (between terminal : List WorkSymbol)
    (betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol)
    (terminalSourcePacked :
      ∀ symbol, symbol ∈ terminal →
        SourcePackedCell symbol)
    (terminalNonempty : terminal ≠ [])
    (terminalLaunch :
      ∀ parsedPrefix,
        BoundaryCleanupLaunch
          (State.indexFirst .input continuation)
          parsedPrefix terminal) :
    let parsedPrefix :=
      [cell00, cell00] ++
        countCells used remaining ++ between
    let indexWord :=
      unaryUnitCells units ++ terminal
    let wholeWord := parsedPrefix ++ indexWord
    ∃ steps final,
      steps ≤
          64 *
            failureSpanSquare wholeWord.length ∧
      workRunExact? machine steps
          (guardedConfig
            (State.indexFirst .input continuation)
            parsedPrefix indexWord) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  rcases
      inputReferenceTerminal_linear_bounded_exact
        continuation used remaining units
        between terminal betweenOrdinary
        terminalSourcePacked terminalNonempty
        terminalLaunch with
    ⟨steps, final, linear, run,
      finalState, outputEmpty⟩
  let parsedPrefix :=
    [cell00, cell00] ++
      countCells used remaining ++ between
  let indexWord :=
    unaryUnitCells units ++ terminal
  let wholeWord := parsedPrefix ++ indexWord
  have unitsBound :
      units + 1 ≤ wholeWord.length + 1 := by
    dsimp [wholeWord, parsedPrefix, indexWord]
    simp only [List.length_append,
      unaryUnitCells_length]
    omega
  have productBound :=
    Nat.mul_le_mul unitsBound
      (Nat.le_refl (wholeWord.length + 1))
  have scaled :=
    Nat.mul_le_mul_left 64 productBound
  have scheduleBound :
      64 * (units + 1) *
            (wholeWord.length + 1) ≤
        64 *
          failureSpanSquare wholeWord.length := by
    simpa [failureSpanSquare,
      Nat.mul_assoc] using scaled
  exact
    ⟨steps, final,
      Nat.le_trans
        (by simpa [wholeWord, parsedPrefix,
          indexWord] using linear)
        scheduleBound,
      by simpa [wholeWord, parsedPrefix,
        indexWord] using run,
      finalState, outputEmpty⟩

private theorem gateReferenceTerminal_linear_bounded_exact
    (continuation : SourceContinuation)
    (header : List WorkSymbol)
    (borrowed available : List RawGate)
    (between : List WorkSymbol) (units : Nat)
    (terminal : List WorkSymbol)
    (headerOrdinary :
      ∀ symbol, symbol ∈ header →
        ordinaryCell symbol)
    (headerNoGateMark :
      ∀ symbol, symbol ∈ header →
        symbol ≠ gateMark)
    (betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol)
    (betweenNoGateMark :
      ∀ symbol, symbol ∈ between →
        symbol ≠ gateMark)
    (terminalSourcePacked :
      ∀ symbol, symbol ∈ terminal →
        SourcePackedCell symbol)
    (terminalNonempty : terminal ≠ [])
    (terminalLaunch :
      ∀ parsedPrefix,
        BoundaryCleanupLaunch
          (State.indexFirst .priorGate continuation)
          parsedPrefix terminal) :
    let parsedPrefix :=
      header ++ borrowedGateListCells borrowed ++
        markedGateListCells available ++ between
    let indexWord :=
      unaryUnitCells units ++ terminal
    let wholeWord := parsedPrefix ++ indexWord
    ∃ steps final,
      steps ≤
          64 * (units + 1) *
            (wholeWord.length + 1) ∧
      workRunExact? machine steps
          (guardedConfig
            (State.indexFirst .priorGate continuation)
            parsedPrefix indexWord) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  induction units generalizing
      borrowed available between with
  | zero =>
      let parsedPrefix :=
        header ++ borrowedGateListCells borrowed ++
          markedGateListCells available ++ between
      let wholeWord := parsedPrefix ++ terminal
      have parsedOrdinary :
          ∀ symbol, symbol ∈ parsedPrefix →
            ordinaryCell symbol := by
        dsimp [parsedPrefix]
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact headerOrdinary
            · exact borrowedGateListCells_allOrdinary
                borrowed
          · exact markedGateListCells_allOrdinary
              available
        · exact betweenOrdinary
      rcases
          boundaryCleanupLaunch_linear_bounded_exact
            (State.indexFirst .priorGate continuation)
            parsedPrefix terminal parsedOrdinary
            terminalSourcePacked terminalNonempty
            (terminalLaunch parsedPrefix) with
        ⟨steps, final, bound, run,
          finalState, outputEmpty⟩
      refine
        ⟨steps, final, ?_, ?_,
          finalState, outputEmpty⟩
      · exact Nat.le_trans
          (by simpa [wholeWord] using bound)
          (Nat.mul_le_mul_right
            (wholeWord.length + 1)
            (show 4 ≤ 64 * (0 + 1) by omega))
      · simpa [parsedPrefix, unaryUnitCells] using run
  | succ units ih =>
      cases available with
      | nil =>
          let parsedPrefix :=
            header ++ borrowedGateListCells borrowed ++
              markedGateListCells [] ++ between
          let indexTail :=
            unaryUnitCells units ++ terminal
          let indexWord :=
            cell00 :: cell01 :: indexTail
          let wholeWord := parsedPrefix ++ indexWord
          let failurePrefix :=
            (header ++ borrowedGateListCells borrowed ++
              between) ++ [cell00]
          let scan :=
            cursorMark :: pushCrossed failurePrefix []
          let steps :=
            gateReferenceExhaustedSteps
                header borrowed between +
              guardedCleanupSteps scan indexTail
          let final :=
            cleanupRejectConfiguration
              [] scan indexTail []
          have exhausted :=
            gateReferenceConsumeExhaustedTail_exact
              continuation header borrowed between
              indexTail headerOrdinary
              headerNoGateMark betweenOrdinary
              betweenNoGateMark
          have failurePrefixOrdinary :
              ∀ symbol, symbol ∈ failurePrefix →
                ordinaryCell symbol := by
            dsimp [failurePrefix]
            apply ordinaryCells_append
            · apply ordinaryCells_append
              · apply ordinaryCells_append
                · exact headerOrdinary
                · exact borrowedGateListCells_allOrdinary
                    borrowed
              · exact betweenOrdinary
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | impossible
              · exact ordinaryCell_cell00
              · contradiction
          have indexTailSafe :
              ∀ symbol, symbol ∈ indexTail →
                cleanupSafeCell symbol := by
            intro symbol member
            rcases List.mem_append.mp member with
                inUnits | inTerminal
            · exact ordinaryCell_cleanupSafe
                (unaryUnitCells_allOrdinary
                  units symbol inUnits)
            · exact ordinaryCell_cleanupSafe
                (sourcePackedCell_ordinary
                  (terminalSourcePacked
                    symbol inTerminal))
          have safe :
              ∀ symbol,
                symbol ∈
                    failurePrefix ++
                      cursorMark :: indexTail →
                  cleanupSafeCell symbol := by
            intro symbol member
            simp only [List.mem_append,
              List.mem_cons] at member
            rcases member with
                inPrefix | atCursor | inTail
            · exact ordinaryCell_cleanupSafe
                (failurePrefixOrdinary symbol inPrefix)
            · subst symbol
              exact cursorMark_cleanupSafe
            · exact indexTailSafe symbol inTail
          have cleanup :=
            safeGuardedCleanup_exact
              failurePrefix cursorMark indexTail safe
          have run :=
            exactRun_add
              (gateReferenceExhaustedSteps
                header borrowed between)
              (guardedCleanupSteps scan indexTail)
              _ _ _ exhausted cleanup
          have linear :
              steps ≤ 16 * (wholeWord.length + 1) := by
            dsimp [steps, wholeWord, parsedPrefix,
              indexWord, indexTail, scan,
              failurePrefix]
            unfold gateReferenceExhaustedSteps
            rw [guardedCleanupSteps_eq]
            simp only [List.length_append,
              List.length_cons, List.length_nil,
              borrowedGateListCells_length,
              markedGateListCells,
              unaryUnitCells_length,
              pushCrossed_length]
            omega
          have scheduleBound :
              steps ≤
                64 * (units + 1 + 1) *
                  (wholeWord.length + 1) :=
            Nat.le_trans linear
              (Nat.mul_le_mul_right
                (wholeWord.length + 1)
                (show 16 ≤
                    64 * (units + 1 + 1) by
                  omega))
          refine
            ⟨steps, final, ?_, ?_,
              rfl,
              cleanupRejectConfiguration_output_empty
                [] scan indexTail⟩
          · simpa [steps, wholeWord, parsedPrefix,
              indexWord, indexTail, unaryUnitCells] using
              scheduleBound
          · simpa [steps, final, parsedPrefix,
              indexWord, indexTail, wholeWord,
              scan, failurePrefix,
              markedGateListCells, List.append_nil,
              unaryUnitCells] using run
      | cons gate available =>
          let parsedPrefix :=
            header ++ borrowedGateListCells borrowed ++
              markedGateListCells (gate :: available) ++
                between
          let indexTail :=
            unaryUnitCells units ++ terminal
          let indexWord :=
            cell00 :: cell01 :: indexTail
          let wholeWord := parsedPrefix ++ indexWord
          let nextBorrowed := borrowed ++ [gate]
          let nextBetween :=
            between ++ [cell00, cell01]
          let nextPrefix :=
            header ++
              borrowedGateListCells nextBorrowed ++
              markedGateListCells available ++
              nextBetween
          let nextWhole :=
            nextPrefix ++ indexTail
          have first :=
            gateReferenceConsumeUnitTail_exact
              continuation header borrowed gate available
              between indexTail headerOrdinary
              headerNoGateMark betweenOrdinary
          have nextBetweenOrdinary :
              ∀ symbol, symbol ∈ nextBetween →
                ordinaryCell symbol := by
            dsimp [nextBetween]
            apply ordinaryCells_append
            · exact betweenOrdinary
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | rfl | impossible
              · exact ordinaryCell_cell00
              · exact ordinaryCell_cell01
              · contradiction
          have nextBetweenNoGateMark :
              ∀ symbol, symbol ∈ nextBetween →
                symbol ≠ gateMark := by
            intro symbol member
            dsimp [nextBetween] at member
            rcases List.mem_append.mp member with
                inBetween | inUnit
            · exact betweenNoGateMark symbol inBetween
            · simp only [List.mem_cons,
                List.not_mem_nil] at inUnit
              rcases inUnit with rfl | rfl | impossible
              · decide
              · decide
              · contradiction
          rcases
              ih nextBorrowed available nextBetween
                nextBetweenOrdinary
                nextBetweenNoGateMark with
            ⟨tailSteps, final, tailBound, tail,
              finalState, outputEmpty⟩
          have wholeLength :
              nextWhole.length = wholeWord.length := by
            dsimp [nextWhole, nextPrefix,
              nextBorrowed, nextBetween,
              wholeWord, parsedPrefix,
              indexWord, indexTail]
            simp only [List.length_append,
              List.length_cons, List.length_nil,
              borrowedGateListCells_length,
              markedGateListCells_length,
              gateListCells_length_snoc,
              gateListCells, gateCells,
              unaryUnitCells_length]
            omega
          have tailBound' :
              tailSteps ≤
                64 * (units + 1) *
                  (wholeWord.length + 1) := by
            have canonical :
                tailSteps ≤
                  64 * (units + 1) *
                    (nextWhole.length + 1) := by
              simpa [nextWhole, nextPrefix,
                nextBorrowed, nextBetween,
                indexTail] using tailBound
            rwa [wholeLength] at canonical
          have firstLinear :
              gateReferenceConsumeUnitSteps
                    header borrowed gate available
                    between ≤
                16 * (wholeWord.length + 1) := by
            dsimp [wholeWord, parsedPrefix,
              indexWord, indexTail]
            unfold gateReferenceConsumeUnitSteps
            simp only [List.length_append,
              List.length_cons, List.length_nil,
              borrowedGateListCells_length,
              markedGateListCells_length,
              gateListCells, gateCells,
              unaryUnitCells_length]
            omega
          have combined :=
            Nat.add_le_add firstLinear tailBound'
          have scheduleBound :
              gateReferenceConsumeUnitSteps
                    header borrowed gate available
                    between + tailSteps ≤
                64 * (units + 1 + 1) *
                  (wholeWord.length + 1) := by
            calc
              gateReferenceConsumeUnitSteps
                      header borrowed gate available
                      between + tailSteps ≤
                  16 * (wholeWord.length + 1) +
                    (64 * (units + 1)) *
                      (wholeWord.length + 1) :=
                combined
              _ =
                  (16 + 64 * (units + 1)) *
                    (wholeWord.length + 1) := by
                rw [Nat.add_mul]
              _ ≤
                  (64 * (units + 1 + 1)) *
                    (wholeWord.length + 1) :=
                Nat.mul_le_mul_right
                  (wholeWord.length + 1)
                  (by omega)
          have run :=
            exactRun_add
              (gateReferenceConsumeUnitSteps
                header borrowed gate available between)
              tailSteps _ _ _ first tail
          refine
            ⟨gateReferenceConsumeUnitSteps
                header borrowed gate available between +
                tailSteps,
              final, ?_, ?_,
              finalState, outputEmpty⟩
          · simpa [wholeWord, parsedPrefix,
              indexWord, indexTail, unaryUnitCells] using
              scheduleBound
          · simpa [parsedPrefix, indexWord,
              indexTail, nextPrefix, nextBorrowed,
              nextBetween, nextWhole,
              unaryUnitCells] using run

