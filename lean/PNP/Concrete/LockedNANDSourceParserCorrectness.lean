          (workStartConfiguration machine
            (WorkTape.ofSymbols word)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let allTokens :=
    circuitGatesPrefixTokens inputs gates ++ tokens
  let after :=
    packedTokenCells tokens ++ workTail
  let word :=
    packedTokenCells allTokens ++ workTail
  let headerSteps :=
    2 * inputs + 2 * gates.length + 8
  have cellsEq :
      word =
        [cell00, cell00] ++ natCells inputs ++
          natCells gates.length ++
          gateListCells gates ++ after := by
    dsimp [word, allTokens, after]
    rw [packedCircuitGatesPrefixTokens_append]
    simp [List.append_assoc]
  have header :
      workRunExact? machine headerSteps
          (workStartConfiguration machine
            (WorkTape.ofSymbols word)) =
        some
          (guardedConfig State.gateStart
            (gatePrefix inputs [] gates)
            (gateListCells gates ++ after)) := by
    dsimp [headerSteps]
    rw [cellsEq]
    simpa [gatePrefix, grammarGatePrefix] using
      (circuitHeaderToGateStart_exact
        inputs gates.length
        (gateListCells gates ++ after))
  have failure :=
    (rawGatesWellFormed_false_iff_failure
      inputs 0 gates).mp gatesInvalid
  have afterOrdinary :
      ∀ symbol, symbol ∈ after →
        ordinaryCell symbol := by
    intro symbol member
    exact
      tokenPrefixMalformedWord_allOrdinary
        tokens malformed symbol
        (by simpa [after] using member)
  rcases
      decodedGateListBoundFailure_bounded_exact
        inputs 0 [] gates after rfl
        failure afterOrdinary with
    ⟨tailSteps, final, tailBound, tail,
      finalState, outputEmpty⟩
  have all :=
    exactRun_add headerSteps tailSteps
      _ _ _ header tail
  let inner :=
    decodedGateListFailureSpan
      inputs [] gates after
  have innerEq :
      inner = word.length := by
    unfold inner decodedGateListFailureSpan
      gateWorkspace gatePrefix
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length, countCells_length,
      markedGateListCells]
    omega
  have headerBound :
      headerSteps ≤
        8 * (word.length + 1) := by
    dsimp [headerSteps]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length]
    omega
  have countBound :
      gates.length ≤ word.length + 1 := by
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length]
    omega
  have innerBound :
      inner + 1 ≤
        2 * (word.length + 1) := by
    rw [innerEq]
    omega
  have tailBound256 :
      tailSteps ≤
        gates.length *
          (256 * failureSpanSquare inner) := by
    exact Nat.le_trans
      (by simpa [inner] using tailBound)
      (Nat.mul_le_mul_left gates.length
        (Nat.mul_le_mul_right
          (failureSpanSquare inner)
          (show 64 ≤ 256 by omega)))
  have scheduleBound :=
    circuitFramingCubicComposition_bound
      word headerSteps tailSteps gates.length
      inner headerBound countBound
      innerBound tailBound256
  exact
    ⟨headerSteps + tailSteps, final,
      scheduleBound,
      by simpa using all,
      finalState, outputEmpty⟩

private theorem circuitInvalidOutputWithFramingTail_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource) (tokens : List Token)
    (outputInvalid :
      output.wellFormed inputs gates.length = false)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    let allTokens :=
      circuitOutputPrefixTokens
        inputs gates output ++ tokens
    let word :=
      packedTokenCells allTokens ++ workTail
    ∃ steps final,
      steps ≤ rawFailureEnvelope word ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols word)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let allTokens :=
    circuitOutputPrefixTokens
      inputs gates output ++ tokens
  let boundaryTail :=
    packedTokenCells tokens ++ workTail
  let word :=
    packedTokenCells allTokens ++ workTail
  cases gatesEq :
      rawGatesWellFormed inputs 0 gates with
  | false =>
      simpa [allTokens, word,
        circuitOutputPrefixTokens,
        List.append_assoc] using
        (circuitInvalidGatesWithFramingTail_bounded_exact
          inputs gates
          (.programEnd ::
            (encodeSourceTokens output ++ tokens))
          gatesEq malformed)
  | true =>
      let prefixSteps :=
        ((2 * inputs + 2 * gates.length + 8) +
            gatesSteps inputs [] gates) +
          programEndSteps inputs gates
      have wordShape :
          word =
            packedTokenCells
                (circuitProgramPrefixTokens
                  inputs gates) ++
              sourceCells output ++ boundaryTail := by
        dsimp [word, allTokens, boundaryTail]
        unfold circuitOutputPrefixTokens
          circuitProgramPrefixTokens
        repeat rw [packedTokenCells_append]
        rw [packedTokenCells_encodeSourceTokens]
        simp [packedTokenCells, tokenCells,
          List.append_assoc]
      have prefixRun :
          workRunExact? machine prefixSteps
              (workStartConfiguration machine
                (WorkTape.ofSymbols word)) =
            some
              (guardedConfig
                (State.sourceStart .output)
                (sourceContextPrefix
                  inputs 0 gates.length gates
                  [cell10, cell00])
                (sourceCells output ++
                  boundaryTail)) := by
        rw [wordShape]
        simpa [prefixSteps,
          circuitProgramParsedPrefix,
          List.append_assoc] using
          (circuitProgramPackedPrefixWord_exact
            inputs gates
            (sourceCells output ++ boundaryTail)
            gatesEq)
      have prefixBound :
          prefixSteps ≤
            160 *
              failureSpanCube word.length := by
        have raw :=
          circuitProgramPackedPrefixWordSteps_bound
            inputs gates
            (sourceCells output ++ boundaryTail)
        rw [wordShape]
        simpa [prefixSteps, List.append_assoc] using raw
      have sourceFailure :=
        (source_wellFormed_false_iff_failure
          inputs gates.length output).mp outputInvalid
      have boundaryOrdinary :
          ∀ symbol, symbol ∈ boundaryTail →
            ordinaryCell symbol := by
        intro symbol member
        exact
          tokenPrefixMalformedWord_allOrdinary
            tokens malformed symbol
            (by simpa [boundaryTail] using member)
      rcases
          sourceBoundFailure_bounded_exact
            .output inputs 0 gates.length gates
            [cell10, cell00] output boundaryTail
            sourceFailure
            (by
              intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with
                  rfl | rfl | impossible
              · exact ordinaryCell_cell10
              · exact ordinaryCell_cell00
              · contradiction)
            (by
              intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with
                  rfl | rfl | impossible
              · decide
              · decide
              · contradiction)
            boundaryOrdinary with
        ⟨tailSteps, final, tailBound, tailRun,
          finalState, outputEmpty⟩
      have all :=
        exactRun_add prefixSteps tailSteps
          _ _ _ prefixRun tailRun
      have cellsEqCanonical :
          word =
            [cell00, cell00] ++ natCells inputs ++
              natCells gates.length ++
              gateListCells gates ++
              cell10 :: cell00 ::
                sourceCells output ++ boundaryTail := by
        rw [wordShape]
        rw [
          packedCircuitProgramPrefixTokens_eq_rawPrefixCells]
        simp [circuitProgramRawPrefixCells,
          List.append_assoc]
      let inner :=
        sourceFailureSpan
          inputs 0 gates.length gates
          [cell10, cell00] output boundaryTail
      have innerBound :
          inner ≤ word.length := by
        unfold inner sourceFailureSpan sourceSpan
          sourceContextPrefix gateReferenceHeader
        rw [cellsEqCanonical]
        simp only [List.length_append,
          List.length_cons, List.length_nil,
          countCells_length, natCells_length,
          markedGateListCells_length]
        omega
      have squareBound :=
        failureSpanSquare_mono innerBound
      have squareCube :=
        failureSpanSquare_le_cube word.length
      have tailSquare :
          tailSteps ≤
            2 + 16 *
              failureSpanSquare inner := by
        simpa [inner, failureSpanSquare] using
          tailBound
      have oneCube :
          1 ≤ failureSpanCube word.length :=
        Nat.le_trans
          (one_le_failureSpanSquare word.length)
          squareCube
      have tailEnvelope :
          tailSteps ≤
            18 * failureSpanCube word.length := by
        have twoBound :
            2 ≤
              2 * failureSpanCube word.length := by
          simpa using
            Nat.mul_le_mul_left 2 oneCube
        have squareEnvelope :
            16 * failureSpanSquare inner ≤
              16 * failureSpanCube word.length :=
          Nat.le_trans
            (Nat.mul_le_mul_left 16 squareBound)
            (Nat.mul_le_mul_left 16 squareCube)
        exact Nat.le_trans tailSquare (by omega)
      have combined :=
        Nat.add_le_add prefixBound tailEnvelope
      have scheduleBound :
          prefixSteps + tailSteps ≤
            rawFailureEnvelope word := by
        calc
          prefixSteps + tailSteps ≤
              160 * failureSpanCube word.length +
                18 * failureSpanCube word.length :=
            combined
          _ = 178 * failureSpanCube word.length := by
            omega
          _ ≤ 2048 * failureSpanCube word.length :=
            Nat.mul_le_mul_right
              (failureSpanCube word.length) (by omega)
          _ = rawFailureEnvelope word := by
            rfl
      exact
        ⟨prefixSteps + tailSteps, final,
          scheduleBound, all,
          finalState, outputEmpty⟩

