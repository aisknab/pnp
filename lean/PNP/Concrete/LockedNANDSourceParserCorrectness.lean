private theorem malformedGateCountCells_shape
    (inputs units : Nat) (token : Token)
    (suffix : List Token) :
    packedTokenCells
        (.version0 ::
          (encodeNatTokens inputs ++
            List.replicate units .unit ++
            token :: suffix)) =
      ([cell00, cell00] ++ natCells inputs ++
        unaryUnitCells units) ++
        tokenCells token ++ packedTokenCells suffix := by
  change
    [cell00, cell00] ++
        packedTokenCells
          (encodeNatTokens inputs ++
            List.replicate units .unit ++
            token :: suffix) =
      ([cell00, cell00] ++ natCells inputs ++
        unaryUnitCells units) ++
        tokenCells token ++ packedTokenCells suffix
  calc
    _ =
        [cell00, cell00] ++
          packedTokenCells
            (encodeNatTokens inputs ++
              (List.replicate units .unit ++
                token :: suffix)) := by
      exact congrArg
        (fun tokens =>
          [cell00, cell00] ++ packedTokenCells tokens)
        (List.append_assoc
          (encodeNatTokens inputs)
          (List.replicate units .unit)
          (token :: suffix))
    _ =
        [cell00, cell00] ++
          (packedTokenCells (encodeNatTokens inputs) ++
            packedTokenCells
              (List.replicate units .unit ++
                token :: suffix)) := by
      exact congrArg
        (fun cells => [cell00, cell00] ++ cells)
        (packedTokenCells_append
          (encodeNatTokens inputs)
          (List.replicate units .unit ++ token :: suffix))
    _ = _ := by
      rw [packedTokenCells_encodeNatTokens,
        packedTokenCells_append
          (List.replicate units .unit)
          (token :: suffix),
        packedTokenCells_replicate_unit]
      simp [packedTokenCells, List.append_assoc]

private theorem gateCountTokenFailure_exact
    (inputs : Nat) {tokens : List Token}
    (failure : NatTokenFailure tokens) :
    ∃ steps final,
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells
                (.version0 ::
                  (encodeNatTokens inputs ++ tokens))))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases failure with
  | missingEnd units =>
      simpa [packedTokenCells, tokenCells,
        packedTokenCells_append,
        packedTokenCells_encodeNatTokens,
        packedTokenCells_replicate_unit,
        List.append_assoc] using
        (gateCountMissingEnd_exact inputs units)
  | wrongToken units token suffix notUnit notNatEnd =>
      let allTokens : List Token :=
        .version0 ::
          (encodeNatTokens inputs ++
            List.replicate units .unit ++ token :: suffix)
      let parsedCells : List WorkSymbol :=
        [cell00, cell00] ++ natCells inputs ++
          unaryUnitCells units
      let suffixCells := packedTokenCells suffix
      let initial :=
        workStartConfiguration machine
          (WorkTape.ofSymbols
            (packedTokenCells allTokens))
      let prefixSteps :=
        4 + 2 * (inputs + 1) + 2 * units
      have wordShape :=
        malformedGateCountCells_shape
          inputs units token suffix
      have prefixRun :
          workRunExact? machine prefixSteps initial =
            some
              (configAtWord State.gateCountFirst
                (pushCrossed parsedCells [] ++ [leftGuard])
                (tokenCells token ++ suffixCells)) := by
        dsimp [prefixSteps, initial, allTokens,
          parsedCells, suffixCells]
        rw [wordShape]
        change
          workRunExact? machine
              (4 + 2 * (inputs + 1) + 2 * units)
              (workStartConfiguration machine
                (WorkTape.ofSymbols
                  (([cell00, cell00] ++ natCells inputs ++
                      unaryUnitCells units) ++
                    tokenCells token ++
                    packedTokenCells suffix))) =
            some
              (configAtWord State.gateCountFirst
                (pushCrossed
                    ([cell00, cell00] ++ natCells inputs ++
                      unaryUnitCells units) [] ++
                  [leftGuard])
                (tokenCells token ++
                  packedTokenCells suffix))
        simpa only [List.append_assoc] using
          (gateCountUnitsPrefix_exact
            inputs units
            (tokenCells token ++ packedTokenCells suffix))
      have rejectFirst
          (current next : WorkSymbol)
          (cellsEq :
            tokenCells token = [current, next])
          (wrong : current ≠ cell00) :
          ∃ steps final,
            workRunExact? machine steps initial =
              some final ∧
            final.state = State.reject ∧
            (encodeWorkTape final.tape).outputBits = [] := by
        have prefixRun' := prefixRun
        rw [cellsEq] at prefixRun'
        have failed :=
          gateCountFirstFailure_exact
            parsedCells current
            (next :: suffixCells) wrong
        have launch :=
          exactRun_add prefixSteps 1
            _ _ _ prefixRun' failed
        have shape :
            packedTokenCells allTokens =
              parsedCells ++ current :: next :: suffixCells := by
          have shaped := wordShape
          rw [cellsEq] at shaped
          change
            packedTokenCells
                (Token.version0 ::
                  (encodeNatTokens inputs ++
                    List.replicate units Token.unit ++
                    token :: suffix)) =
              parsedCells ++ current :: next :: suffixCells
          simpa [parsedCells, suffixCells,
            List.append_assoc] using shaped
        exact packedExplicitFailure_exact
          allTokens parsedCells current
          (next :: suffixCells) initial
          (prefixSteps + 1) shape launch
      have rejectSecond
          (current : WorkSymbol)
          (cellsEq :
            tokenCells token = [cell00, current])
          (notUnitCell : current ≠ cell01)
          (notEndCell : current ≠ cell10) :
          ∃ steps final,
            workRunExact? machine steps initial =
              some final ∧
            final.state = State.reject ∧
            (encodeWorkTape final.tape).outputBits = [] := by
        have prefixRun' := prefixRun
        rw [cellsEq] at prefixRun'
        have failed :=
          gateCountSecondFailure_exact
            parsedCells current suffixCells
            notUnitCell notEndCell
        have launch :=
          exactRun_add prefixSteps 2
            _ _ _ prefixRun' failed
        have shape :
            packedTokenCells allTokens =
              (parsedCells ++ [cell00]) ++
                current :: suffixCells := by
          have shaped := wordShape
          rw [cellsEq] at shaped
          change
            packedTokenCells
                (Token.version0 ::
                  (encodeNatTokens inputs ++
                    List.replicate units Token.unit ++
                    token :: suffix)) =
              (parsedCells ++ [cell00]) ++
                current :: suffixCells
          simpa [parsedCells, suffixCells,
            List.append_assoc] using shaped
        exact packedExplicitFailure_exact
          allTokens (parsedCells ++ [cell00])
          current suffixCells initial
          (prefixSteps + 2) shape launch
      cases token with
      | version0 =>
          simpa [allTokens, initial] using
            (rejectSecond cell00 rfl
              (by decide) (by decide))
      | unit =>
          exact False.elim (notUnit rfl)
      | natEnd =>
          exact False.elim (notNatEnd rfl)
      | input =>
          simpa [allTokens, initial] using
            (rejectSecond cell11 rfl
              (by decide) (by decide))
      | constantFalse =>
          simpa [allTokens, initial] using
            (rejectFirst cell01 cell00 rfl (by decide))
      | constantTrue =>
          simpa [allTokens, initial] using
            (rejectFirst cell01 cell01 rfl (by decide))
      | gate =>
          simpa [allTokens, initial] using
            (rejectFirst cell01 cell10 rfl (by decide))
      | gateEnd =>
          simpa [allTokens, initial] using
            (rejectFirst cell01 cell11 rfl (by decide))
      | programEnd =>
          simpa [allTokens, initial] using
            (rejectFirst cell10 cell00 rfl (by decide))
      | outputsEnd =>
          simpa [allTokens, initial] using
            (rejectFirst cell10 cell01 rfl (by decide))
      | threshold =>
          simpa [allTokens, initial] using
            (rejectFirst cell10 cell10 rfl (by decide))
      | instanceEnd =>
          simpa [allTokens, initial] using
            (rejectFirst cell10 cell11 rfl (by decide))

/-! ### Complete early-failure traces -/

private theorem wrongFirstVersionCell_exact
    (first : WorkSymbol) (rest : List WorkSymbol)
    (wrong : first ≠ cell00)
    (noGuard :
      ∀ symbol, symbol ∈ first :: rest →
        symbol ≠ leftGuard)
    (nonblank :
      ∀ symbol, symbol ∈ first :: rest →
        symbol ≠ cellBlank) :
    workRunExact? machine
        (3 + guardedCleanupSteps [first] rest)
        (workStartConfiguration machine
          (WorkTape.ofSymbols (first :: rest))) =
      some
        (cleanupRejectConfiguration
          [] [first] rest []) := by
  have boot := bootInstallGuard_exact first rest
  have failure :=
    versionFirst_failure_exact first rest wrong
  have prefixRun := exactRun_add 2 1 _ _ _ boot failure
  have cleanupRun :=
    guardedCleanupFinite_exact [] [first] rest
      (by
        intro symbol member
        have symbolEq : symbol = first := by
          simpa using member
        subst symbol
        exact noGuard first (List.Mem.head rest))
      (by
        intro symbol member
        exact nonblank symbol (by
          simpa [pushCleanupScan] using member))
  exact exactRun_add 3
    (guardedCleanupSteps [first] rest)
    _ _ _ prefixRun cleanupRun

private theorem wrongSecondVersionCell_exact
    (second : WorkSymbol) (rest : List WorkSymbol)
    (wrong : second ≠ cell00)
    (noGuard :
      ∀ symbol, symbol ∈ cell00 :: second :: rest →
        symbol ≠ leftGuard)
    (nonblank :
      ∀ symbol, symbol ∈ cell00 :: second :: rest →
        symbol ≠ cellBlank) :
    workRunExact? machine
        (4 + guardedCleanupSteps [second, cell00] rest)
        (workStartConfiguration machine
          (WorkTape.ofSymbols
            (cell00 :: second :: rest))) =
      some
        (cleanupRejectConfiguration
          [] [second, cell00] rest []) := by
  have header := bootVersionFirst_exact second rest
  have failure :=
    versionSecond_failure_exact second rest wrong
  have prefixRun := exactRun_add 3 1 _ _ _ header failure
  have cleanupRun :=
    guardedCleanupFinite_exact [] [second, cell00] rest
      (by
        intro symbol member
        simp only [List.mem_cons, List.not_mem_nil,
          or_false] at member
        rcases member with symbolEq | symbolEq
        · subst symbol
          exact noGuard second
            (List.Mem.tail cell00
              (List.Mem.head rest))
        · subst symbol
          exact noGuard cell00
            (List.Mem.head (second :: rest)))
      (by
        intro symbol member
        exact nonblank symbol (by
          simpa [pushCleanupScan] using member))
  exact exactRun_add 4
    (guardedCleanupSteps [second, cell00] rest)
    _ _ _ prefixRun cleanupRun

/-! ### Canonical bound-failure normal forms -/

private inductive SourceBoundFailure
    (inputs priorGates : Nat) : RawSource → Prop where
  | input (index : Nat) (outOfRange : ¬ index < inputs) :
      SourceBoundFailure inputs priorGates (.input index)
  | gate (index : Nat) (outOfRange : ¬ index < priorGates) :
      SourceBoundFailure inputs priorGates (.gate index)

private theorem source_wellFormed_false_iff_failure
    (inputs priorGates : Nat) (source : RawSource) :
    source.wellFormed inputs priorGates = false ↔
      SourceBoundFailure inputs priorGates source := by
  cases source with
  | input index =>
      constructor
      · intro rejected
        by_cases inRange : index < inputs
        · simp [RawSource.wellFormed, inRange] at rejected
        · exact .input index inRange
      · intro failure
        cases failure with
        | input _ outOfRange =>
            simp [RawSource.wellFormed, outOfRange]
  | constant value =>
      constructor
      · intro rejected
        simp [RawSource.wellFormed] at rejected
      · intro failure
        cases failure
  | gate index =>
      constructor
      · intro rejected
        by_cases inRange : index < priorGates
        · simp [RawSource.wellFormed, inRange] at rejected
        · exact .gate index inRange
      · intro failure
        cases failure with
        | gate _ outOfRange =>
            simp [RawSource.wellFormed, outOfRange]

private inductive GateBoundFailure
    (inputs priorGates : Nat) : RawGate → Prop where
  | left (left right : RawSource)
      (failure :
        SourceBoundFailure inputs priorGates left) :
      GateBoundFailure inputs priorGates
        { left := left, right := right }
  | right (left right : RawSource)
      (leftValid :
        left.wellFormed inputs priorGates = true)
      (failure :
        SourceBoundFailure inputs priorGates right) :
      GateBoundFailure inputs priorGates
        { left := left, right := right }

private theorem gate_wellFormed_false_iff_failure
    (inputs priorGates : Nat) (gate : RawGate) :
    gate.wellFormed inputs priorGates = false ↔
      GateBoundFailure inputs priorGates gate := by
  cases gate with
  | mk left right =>
      cases leftEq :
          left.wellFormed inputs priorGates with
      | false =>
          constructor
          · intro _
            exact .left left right
              ((source_wellFormed_false_iff_failure
                inputs priorGates left).mp leftEq)
          · intro _
            simp [RawGate.wellFormed, leftEq]
      | true =>
          cases rightEq :
              right.wellFormed inputs priorGates with
          | false =>
              constructor
              · intro _
                exact .right left right leftEq
                  ((source_wellFormed_false_iff_failure
                    inputs priorGates right).mp rightEq)
              · intro _
                simp [RawGate.wellFormed, leftEq, rightEq]
          | true =>
              constructor
              · intro rejected
                simp [RawGate.wellFormed,
                  leftEq, rightEq] at rejected
              · intro failure
                cases failure with
                | left _ _ sourceFailure =>
                    have impossible :=
                      (source_wellFormed_false_iff_failure
                        inputs priorGates left).mpr
                        sourceFailure
                    rw [leftEq] at impossible
                    contradiction
                | right _ _ _ sourceFailure =>
                    have impossible :=
                      (source_wellFormed_false_iff_failure
                        inputs priorGates right).mpr
                        sourceFailure
                    rw [rightEq] at impossible
                    contradiction

private inductive GateListBoundFailure
    (inputs : Nat) :
    (priorGates : Nat) → List RawGate → Prop where
  | head (priorGates : Nat) (gate : RawGate)
      (rest : List RawGate)
      (failure :
        GateBoundFailure inputs priorGates gate) :
      GateListBoundFailure inputs priorGates (gate :: rest)
  | rest (priorGates : Nat) (gate : RawGate)
      (remaining : List RawGate)
      (gateValid :
        gate.wellFormed inputs priorGates = true)
      (failure :
        GateListBoundFailure inputs
          (priorGates + 1) remaining) :
      GateListBoundFailure inputs priorGates
        (gate :: remaining)

private theorem rawGatesWellFormed_false_iff_failure
    (inputs priorGates : Nat) (gates : List RawGate) :
    rawGatesWellFormed inputs priorGates gates = false ↔
      GateListBoundFailure inputs priorGates gates := by
  induction gates generalizing priorGates with
  | nil =>
      constructor
      · intro rejected
        simp [rawGatesWellFormed] at rejected
      · intro failure
        cases failure
  | cons gate rest ih =>
      cases gateEq :
          gate.wellFormed inputs priorGates with
      | false =>
          constructor
          · intro _
            exact .head priorGates gate rest
              ((gate_wellFormed_false_iff_failure
                inputs priorGates gate).mp gateEq)
          · intro _
            simp [rawGatesWellFormed, gateEq]
      | true =>
          cases restEq :
              rawGatesWellFormed inputs
                (priorGates + 1) rest with
          | false =>
              constructor
              · intro _
                exact .rest priorGates gate rest gateEq
                  ((ih (priorGates + 1)).mp restEq)
              · intro _
                simp [rawGatesWellFormed, gateEq, restEq]
          | true =>
              constructor
              · intro rejected
                simp [rawGatesWellFormed,
                  gateEq, restEq] at rejected
              · intro failure
                cases failure with
                | head _ _ _ gateFailure =>
                    have impossible :=
                      (gate_wellFormed_false_iff_failure
                        inputs priorGates gate).mpr
                        gateFailure
                    rw [gateEq] at impossible
                    contradiction
                | rest _ _ _ _ restFailure =>
                    have impossible :=
                      (ih (priorGates + 1)).mpr
                        restFailure
                    rw [restEq] at impossible
                    contradiction

private inductive CircuitBoundFailure :
    RawCircuit → Prop where
  | gate (inputs : Nat) (gates : List RawGate)
      (output : RawSource)
      (failure :
        GateListBoundFailure inputs 0 gates) :
      CircuitBoundFailure
        { inputCount := inputs
          gates := gates
          output := output }
  | output (inputs : Nat) (gates : List RawGate)
      (output : RawSource)
      (gatesValid :
        rawGatesWellFormed inputs 0 gates = true)
      (failure :
        SourceBoundFailure inputs gates.length output) :
      CircuitBoundFailure
        { inputCount := inputs
          gates := gates
          output := output }

private theorem circuit_wellFormed_false_iff_failure
    (raw : RawCircuit) :
    raw.wellFormed = false ↔ CircuitBoundFailure raw := by
  cases raw with
  | mk inputs gates output =>
      cases gatesEq :
          rawGatesWellFormed inputs 0 gates with
      | false =>
          constructor
          · intro _
            exact .gate inputs gates output
              ((rawGatesWellFormed_false_iff_failure
                inputs 0 gates).mp gatesEq)
          · intro _
            simp [RawCircuit.wellFormed, gatesEq]
      | true =>
          cases outputEq :
              output.wellFormed inputs gates.length with
          | false =>
              constructor
              · intro _
                exact .output inputs gates output gatesEq
                  ((source_wellFormed_false_iff_failure
                    inputs gates.length output).mp outputEq)
              · intro _
                simp [RawCircuit.wellFormed,
                  gatesEq, outputEq]
          | true =>
              constructor
              · intro rejected
                simp [RawCircuit.wellFormed,
                  gatesEq, outputEq] at rejected
              · intro failure
                cases failure with
                | gate _ _ _ gateFailure =>
                    have impossible :=
                      (rawGatesWellFormed_false_iff_failure
                        inputs 0 gates).mpr gateFailure
                    rw [gatesEq] at impossible
                    contradiction
                | output _ _ _ _ sourceFailure =>
                    have impossible :=
                      (source_wellFormed_false_iff_failure
                        inputs gates.length output).mpr
                        sourceFailure
                    rw [outputEq] at impossible
                    contradiction

/-- Any nonempty raw input whose first packed version cell is not `00`
reaches the rejecting halt after erasing the complete input. -/
private theorem wrongFirstVersionCell_rejects
    (bits : BitString) (first : WorkSymbol)
    (rest : List WorkSymbol)
    (packed :
      packedInputWord bits = first :: rest)
    (wrong : first ≠ cell00) :
    ∃ steps final,
      workRunExact? machine steps
          (workStartConfiguration machine
            (rawInputWorkTape bits)) =
        some final ∧
      final.state = machine.rejectState ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  have noGuard :
      ∀ symbol, symbol ∈ first :: rest →
        symbol ≠ leftGuard := by
    intro symbol member
    exact packedInputWord_no_leftGuard bits symbol
      (by rw [packed]; exact member)
  have nonblank :
      ∀ symbol, symbol ∈ first :: rest →
        symbol ≠ cellBlank := by
    intro symbol member
    exact packedInputWord_no_blank bits symbol
      (by rw [packed]; exact member)
  let steps := 3 + guardedCleanupSteps [first] rest
  let final :=
    cleanupRejectConfiguration [] [first] rest []
  refine ⟨steps, final, ?_, rfl, ?_⟩
  · rw [rawInputWorkTape_eq_packedInputWord, packed]
    exact wrongFirstVersionCell_exact
      first rest wrong noGuard nonblank
  · exact cleanupRejectConfiguration_output_empty
      [] [first] rest

/-- If the first packed version cell is `00` but the second is not, the
machine likewise erases the complete raw input and rejects. -/
private theorem wrongSecondVersionCell_rejects
    (bits : BitString) (second : WorkSymbol)
    (rest : List WorkSymbol)
    (packed :
      packedInputWord bits = cell00 :: second :: rest)
    (wrong : second ≠ cell00) :
    ∃ steps final,
      workRunExact? machine steps
          (workStartConfiguration machine
            (rawInputWorkTape bits)) =
        some final ∧
      final.state = machine.rejectState ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  have noGuard :
      ∀ symbol,
        symbol ∈ cell00 :: second :: rest →
          symbol ≠ leftGuard := by
    intro symbol member
    exact packedInputWord_no_leftGuard bits symbol
      (by rw [packed]; exact member)
  have nonblank :
      ∀ symbol,
        symbol ∈ cell00 :: second :: rest →
          symbol ≠ cellBlank := by
    intro symbol member
    exact packedInputWord_no_blank bits symbol
      (by rw [packed]; exact member)
  let steps :=
    4 + guardedCleanupSteps [second, cell00] rest
  let final :=
    cleanupRejectConfiguration
      [] [second, cell00] rest []
  refine ⟨steps, final, ?_, rfl, ?_⟩
  · rw [rawInputWorkTape_eq_packedInputWord, packed]
    exact wrongSecondVersionCell_exact
      second rest wrong noGuard nonblank
  · exact cleanupRejectConfiguration_output_empty
      [] [second, cell00] rest

/-! ### Exact empty and one-bit regressions -/

def emptyRejectConfiguration : WorkConfiguration :=
  { state := State.reject
    tape :=
      { left := [cellBlank]
        head := cellBlank
        right := [] } }

def oneBitRejectConfiguration : WorkConfiguration :=
  { state := State.reject
    tape :=
      { left := [cellBlank, cellBlank]
        head := cellBlank
        right := [] } }

def twoCellRejectConfiguration : WorkConfiguration :=
  { state := State.reject
    tape :=
      { left := [cellBlank, cellBlank, cellBlank]
        head := cellBlank
        right := [] } }

set_option maxRecDepth 100000 in
theorem emptyInput_exact :
    workRunExact? machine 6
        (workStartConfiguration machine
          (rawInputWorkTape [])) =
      some emptyRejectConfiguration := by
  rfl

set_option maxRecDepth 100000 in
theorem oneBitFalse_exact :
    workRunExact? machine 7
        (workStartConfiguration machine
          (rawInputWorkTape [false])) =
      some oneBitRejectConfiguration := by
  rfl

set_option maxRecDepth 100000 in
theorem oneBitTrue_exact :
    workRunExact? machine 7
        (workStartConfiguration machine
          (rawInputWorkTape [true])) =
      some oneBitRejectConfiguration := by
  rfl

set_option maxRecDepth 100000 in
theorem twoBitVersionPrefix_exact :
    workRunExact? machine 9
        (workStartConfiguration machine
          (rawInputWorkTape [false, false])) =
      some oneBitRejectConfiguration := by
  rfl

set_option maxRecDepth 100000 in
theorem threeBitFalseSuffix_exact :
    workRunExact? machine 10
        (workStartConfiguration machine
          (rawInputWorkTape [false, false, false])) =
      some twoCellRejectConfiguration := by
  rfl

set_option maxRecDepth 100000 in
theorem threeBitTrueSuffix_exact :
    workRunExact? machine 10
        (workStartConfiguration machine
          (rawInputWorkTape [false, false, true])) =
      some twoCellRejectConfiguration := by
  rfl

theorem emptyRejectConfiguration_output_empty :
    (encodeWorkTape emptyRejectConfiguration.tape).outputBits = [] := by
  rfl

theorem oneBitRejectConfiguration_output_empty :
    (encodeWorkTape oneBitRejectConfiguration.tape).outputBits = [] := by
  rfl

theorem twoCellRejectConfiguration_output_empty :
    (encodeWorkTape twoCellRejectConfiguration.tape).outputBits = [] := by
  rfl

/-! ### Token-level version failure -/

private theorem missingVersionToken_exact :
    ∃ steps final,
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells []))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  refine ⟨6, emptyRejectConfiguration, ?_, rfl, ?_⟩
  · simpa [packedTokenCells,
      rawInputWorkTape, packWorkSymbols] using
        emptyInput_exact
  · exact emptyRejectConfiguration_output_empty

private theorem wrongVersionToken_exact
    (token : Token) (suffix : List Token)
    (notVersion : token ≠ .version0) :
    ∃ steps final,
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells (token :: suffix)))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let allTokens := token :: suffix
  let suffixCells := packedTokenCells suffix
  let initial :=
    workStartConfiguration machine
      (WorkTape.ofSymbols (packedTokenCells allTokens))
  have wordShape :
      packedTokenCells allTokens =
        tokenCells token ++ suffixCells := by
    rfl
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq : tokenCells token = [current, next])
      (wrong : current ≠ cell00) :
      ∃ steps final,
        workRunExact? machine steps initial = some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have boot :=
      bootInstallGuard_exact current
        (next :: suffixCells)
    have failed :=
      versionFirst_failure_exact current
        (next :: suffixCells) wrong
    have launch :=
      exactRun_add 2 1 _ _ _ boot failed
    have shape :
        packedTokenCells allTokens =
          [] ++ current :: next :: suffixCells := by
      rw [wordShape, cellsEq]
      simp [List.cons_append]
    have launch' :
        workRunExact? machine 3 initial =
          some
            (cleanupSeekConfiguration
              [] (current :: pushCrossed [] [])
              (next :: suffixCells)) := by
      simpa [initial, allTokens, wordShape,
        cellsEq, pushCrossed] using launch
    exact packedExplicitFailure_exact
      allTokens [] current (next :: suffixCells)
      initial 3 shape launch'
  have rejectSecond
      (current : WorkSymbol)
      (cellsEq : tokenCells token = [cell00, current])
      (wrong : current ≠ cell00) :
      ∃ steps final,
        workRunExact? machine steps initial = some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have boot :=
      bootVersionFirst_exact current suffixCells
    have failed :=
      versionSecond_failure_exact current
        suffixCells wrong
    have launch :=
      exactRun_add 3 1 _ _ _ boot failed
    have shape :
        packedTokenCells allTokens =
          [cell00] ++ current :: suffixCells := by
      rw [wordShape, cellsEq]
      simp [List.cons_append]
    have launch' :
        workRunExact? machine 4 initial =
          some
            (cleanupSeekConfiguration
              []
              (current :: pushCrossed [cell00] [])
              suffixCells) := by
      simpa [initial, allTokens, wordShape,
        cellsEq, pushCrossed] using launch
    exact packedExplicitFailure_exact
      allTokens [cell00] current suffixCells
      initial 4 shape launch'
  cases token with
  | version0 =>
      exact False.elim (notVersion rfl)
  | unit =>
      simpa [allTokens, initial] using
        (rejectSecond cell01 rfl (by decide))
  | natEnd =>
      simpa [allTokens, initial] using
        (rejectSecond cell10 rfl (by decide))
  | input =>
      simpa [allTokens, initial] using
        (rejectSecond cell11 rfl (by decide))
  | constantFalse =>
      simpa [allTokens, initial] using
        (rejectFirst cell01 cell00 rfl (by decide))
  | constantTrue =>
      simpa [allTokens, initial] using
        (rejectFirst cell01 cell01 rfl (by decide))
  | gate =>
      simpa [allTokens, initial] using
        (rejectFirst cell01 cell10 rfl (by decide))
  | gateEnd =>
      simpa [allTokens, initial] using
        (rejectFirst cell01 cell11 rfl (by decide))
  | programEnd =>
