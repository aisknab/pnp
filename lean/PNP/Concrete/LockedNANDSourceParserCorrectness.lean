          (grammarGatePrefix
            inputs (done ++ [gate]) remaining)
          suffix) := by
  have base :=
    grammarGateEndWord_exact
      (pushCrossed
        (grammarGateParsingPrefix
            inputs done remaining ++
          sourceCells gate.left ++
          sourceCells gate.right)
        [leftGuard])
      suffix
  have endpointEq :
      cell11 :: gateMark ::
          pushCrossed
            (grammarGateParsingPrefix
                inputs done remaining ++
              sourceCells gate.left ++
              sourceCells gate.right)
            [leftGuard] =
        pushCrossed
          (grammarGateParsingPrefix
              inputs done remaining ++
            ((sourceCells gate.left ++
                sourceCells gate.right) ++
              [gateMark, cell11]))
          [leftGuard] := by
    simp only [pushCrossed_append,
      pushCrossed]
  rw [grammarSourceContext_eq]
  rw [grammarGatePrefix_snoc]
  unfold guardedConfig markedGateCells
  rw [← endpointEq]
  simpa only [List.append_assoc] using base

private theorem grammarGateEndFirstFailure_exact
