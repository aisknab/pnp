          encodeSourceTokens right ++
          .gateEnd :: tokens) := by
  unfold grammarTokenFailureSpan grammarGatePrefix
  rw [grammarMarkedGateListCells_append]
  rw [packedTokenCells_append,
    packedTokenCells_append,
    packedTokenCells_encodeSourceTokens,
    packedTokenCells_encodeSourceTokens]
  simp only [markedGateListCells,
