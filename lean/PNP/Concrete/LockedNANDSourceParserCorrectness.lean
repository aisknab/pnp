private theorem grammarGateForwardWord_exact
    (firstWas01 : Bool) (inputs : Nat)
    (done : List RawGate) (remaining : Nat)
    (word : List WorkSymbol) :
    ∃ steps,
      steps =
          (grammarGatePrefix
            inputs done (remaining + 1)).length + 1 ∧
      workRunExact? machine steps
          (configAtWord
            (State.gateDecrementVersionFirst firstWas01)
            [leftGuard]
            (grammarGatePrefix
                inputs done (remaining + 1) ++
              cursorMark :: word)) =
        some
          (guardedConfig
            (afterFirstSourceState
              firstWas01 .gateLeft)
            (grammarGateParsingPrefix
              inputs done remaining ++
              [firstSourceCell firstWas01])
            word) := by
  let afterCount :=
    natCells remaining ++
      markedGateListCells done
  let afterHeader :=
    countCells done.length (remaining + 1) ++
      markedGateListCells done ++
      cursorMark :: word
  have version :=
    grammarGateVersion_exact firstWas01
      [leftGuard] (natCells inputs ++ afterHeader)
  have input :=
    grammarGateInput_exact firstWas01 inputs
      (cell00 :: cell00 :: [leftGuard])
      afterHeader
  have count :=
    grammarGateCount_exact firstWas01
      done.length
      (pushCrossed (natCells inputs)
        (cell00 :: cell00 :: [leftGuard]))
      (afterCount ++ cursorMark :: word)
  have countCanonical :
      workRunExact? machine
          (2 * (done.length + 1))
          (configAtWord
            (State.gateDecrementCountFirst firstWas01)
            (pushCrossed (natCells inputs)
              (cell00 :: cell00 :: [leftGuard]))
            afterHeader) =
        some
          (configAtWord
            (State.gateDecrementSeekCursor firstWas01)
            (pushCrossed
              (borrowedCountCells
                (done.length + 1))
              (pushCrossed (natCells inputs)
                (cell00 :: cell00 :: [leftGuard])))
            (afterCount ++ cursorMark :: word)) := by
    simpa [afterHeader, afterCount,
      grammarCountCells_succ_remaining,
      List.append_assoc] using count
  have scan :=
    grammarScanRight_exact
      (State.gateDecrementSeekCursor firstWas01)
      ordinaryCell
      (grammarGateSeekCursor_step firstWas01)
      afterCount (cursorMark :: word)
      (pushCrossed
        (borrowedCountCells (done.length + 1))
        (pushCrossed (natCells inputs)
          (cell00 :: cell00 :: [leftGuard])))
      (ordinaryCells_append
        (natCells_allOrdinary remaining)
        (markedGateListCells_allOrdinary done))
  have cursor :=
    grammarGateCursorWord_exact firstWas01
      (pushCrossed afterCount
        (pushCrossed
          (borrowedCountCells (done.length + 1))
          (pushCrossed (natCells inputs)
            (cell00 :: cell00 :: [leftGuard]))))
      word
  have throughInput :=
    exactRun_add 2 (2 * (inputs + 1))
      _ _ _ version input
  have throughCount :=
    exactRun_add
      (2 + 2 * (inputs + 1))
      (2 * (done.length + 1))
      _ _ _ throughInput countCanonical
  have throughScan :=
    exactRun_add
      ((2 + 2 * (inputs + 1)) +
        2 * (done.length + 1))
      afterCount.length
      _ _ _ throughCount scan
  have all :=
    exactRun_add
      (((2 + 2 * (inputs + 1)) +
          2 * (done.length + 1)) +
        afterCount.length)
      1 _ _ _ throughScan cursor
  let steps :=
    (((2 + 2 * (inputs + 1)) +
        2 * (done.length + 1)) +
      afterCount.length) + 1
  have costEq :
      steps =
        (grammarGatePrefix
          inputs done (remaining + 1)).length + 1 := by
    simp only [steps, grammarGatePrefix,
      afterCount, List.length_append,
      List.length_cons, List.length_nil,
      natCells_length,
      grammarCountCells_succ_remaining,
      borrowedCountCells_length,
      markedGateListCells_length]
    omega
  have endpointEq :
      firstSourceCell firstWas01 ::
          pushCrossed (markedGateListCells done)
            (pushCrossed (natCells remaining)
              (pushCrossed
                (borrowedCountCells
                  (done.length + 1))
                (pushCrossed (natCells inputs)
                  [cell00, cell00, leftGuard]))) =
        pushCrossed
          (grammarGateParsingPrefix
              inputs done remaining ++
            [firstSourceCell firstWas01])
          [leftGuard] := by
    unfold grammarGateParsingPrefix
    rw [grammarCountCells_eq_borrowed_append]
    repeat rw [pushCrossed_append]
    rfl
  refine ⟨steps, costEq, ?_⟩
  unfold guardedConfig
  rw [← endpointEq]
  simpa [steps, afterHeader, afterCount,
    grammarGatePrefix,
    grammarCountCells_succ_remaining,
    pushCrossed_append,
    List.append_assoc] using all

