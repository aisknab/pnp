  have version :=
    grammarGateVersion_exact firstWas01
      [leftGuard]
      (natCells inputs ++ afterHeader)
  have input :=
    grammarGateInput_exact firstWas01 inputs
      (cell00 :: cell00 :: [leftGuard])
      afterHeader
  have count :=
    grammarGateCountBorrowedPrefix_exact
