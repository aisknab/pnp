/-
Copyright (c) 2026 PNP Labs.

All-input correctness layers for the strict-v0 locked-NAND source parser.

The first operational layer below handles malformed inputs before the circuit
grammar begins: empty input, one-bit input, and every packed word whose
version token is absent or wrong.  Later sections compose the same guarded
cleanup theorem with the decoder-failure normal forms and the canonical
ill-formed-reference traces.
-/

import PNP.Concrete.LockedNANDSourceParserTotalTrace
import PNP.Concrete.LockedNANDSourceParserFailureShapes

namespace PNP.Concrete.LockedNAND.SourceParser

/-! ### Raw packed words contain no parser marker or blank cell -/

private def packedInputWord (bits : BitString) : List WorkSymbol :=
  packWorkSymbols (bits.map TapeSymbol.ofBool)

private theorem packedInputWord_eq_packedRawBits
    (bits : BitString) :
    packedInputWord bits = packedRawBits bits := by
  rfl

private theorem sourcePackedCell_ordinary
    {symbol : WorkSymbol}
    (sourcePacked : SourcePackedCell symbol) :
    ordinaryCell symbol := by
  simpa [SourcePackedCell, ordinaryCell,
    cell00, cell01, countMark, gateMark,
    cell10, cell11] using sourcePacked

private theorem malformedWorkTail_allOrdinary
    {rawTail : BitString} {workTail : List WorkSymbol}
    (malformed : MalformedWorkTail rawTail workTail)
    (symbol : WorkSymbol) (member : symbol ∈ workTail) :
    ordinaryCell symbol :=
  sourcePackedCell_ordinary
    (malformed.allSourcePacked symbol member)

private theorem ofBool_ne_blank (value : Bool) :
    TapeSymbol.ofBool value ≠ TapeSymbol.blank := by
  cases value <;> decide

private theorem packedInputWord_first_ne_blank :
    ∀ (bits : BitString) (symbol : WorkSymbol),
      symbol ∈ packedInputWord bits →
        symbol.first ≠ TapeSymbol.blank
  | [], symbol, member => by
      contradiction
  | first :: [], symbol, member => by
      simp only [packedInputWord, List.map,
        packWorkSymbols, List.mem_cons,
        List.not_mem_nil, or_false] at member
      subst symbol
      exact ofBool_ne_blank first
  | first :: second :: rest, symbol, member => by
      simp only [packedInputWord, List.map,
        packWorkSymbols, List.mem_cons] at member
      rcases member with head | inRest
      · subst symbol
        exact ofBool_ne_blank first
      · exact packedInputWord_first_ne_blank
          rest symbol inRest

private theorem packedInputWord_no_blank
    (bits : BitString) (symbol : WorkSymbol)
    (member : symbol ∈ packedInputWord bits) :
    symbol ≠ cellBlank := by
  intro symbolEq
  have firstEq :=
    congrArg WorkSymbol.first symbolEq
  have notBlank :=
    packedInputWord_first_ne_blank bits symbol member
  apply notBlank
  simpa [cellBlank, WorkSymbol.blank] using firstEq

private theorem packedInputWord_no_leftGuard
    (bits : BitString) (symbol : WorkSymbol)
    (member : symbol ∈ packedInputWord bits) :
    symbol ≠ leftGuard := by
  intro symbolEq
  have firstEq :=
    congrArg WorkSymbol.first symbolEq
  have notBlank :=
    packedInputWord_first_ne_blank bits symbol member
  apply notBlank
  simpa [leftGuard, WorkSymbol.blankZero] using firstEq

private theorem packedTokenCells_no_blank
    (tokens : List Token) (symbol : WorkSymbol)
    (member : symbol ∈ packedTokenCells tokens) :
    symbol ≠ cellBlank := by
  apply packedInputWord_no_blank
    (encodeTokens tokens) symbol
  change
    symbol ∈
      packWorkSymbols
        ((encodeTokens tokens).map TapeSymbol.ofBool)
  rw [pack_encodeTokens]
  exact member

private theorem packedTokenCells_no_leftGuard
    (tokens : List Token) (symbol : WorkSymbol)
    (member : symbol ∈ packedTokenCells tokens) :
    symbol ≠ leftGuard := by
  apply packedInputWord_no_leftGuard
    (encodeTokens tokens) symbol
  change
    symbol ∈
      packWorkSymbols
        ((encodeTokens tokens).map TapeSymbol.ofBool)
  rw [pack_encodeTokens]
  exact member

private theorem packedTokenCells_append
    (first second : List Token) :
    packedTokenCells (first ++ second) =
      packedTokenCells first ++
        packedTokenCells second := by
  induction first with
  | nil =>
      rfl
  | cons token rest ih =>
      change
        tokenCells token ++
            packedTokenCells (rest ++ second) =
          (tokenCells token ++ packedTokenCells rest) ++
            packedTokenCells second
      rw [ih, List.append_assoc]

private theorem packedInputWord_token_prefix
    (token : Token) (tail : BitString) :
    packedInputWord (token.bits ++ tail) =
      tokenCells token ++ packedInputWord tail := by
  cases token <;> rfl

private theorem packedInputWord_encodeTokens_append
    (tokens : List Token) (tail : BitString) :
    packedInputWord (encodeTokens tokens ++ tail) =
      packedTokenCells tokens ++
        packedInputWord tail := by
  induction tokens with
  | nil =>
      rfl
  | cons token rest ih =>
      unfold encodeTokens packedTokenCells
      rw [List.append_assoc,
        packedInputWord_token_prefix, ih,
        List.append_assoc]

private theorem packedInputWord_tokenPrefix_malformedTail
    (bits : BitString) (tokens : List Token)
    (rawTail : BitString) (workTail : List WorkSymbol)
    (bitsEq :
      bits = encodeTokens tokens ++ rawTail)
    (malformed : MalformedWorkTail rawTail workTail) :
    packedInputWord bits =
      packedTokenCells tokens ++ workTail := by
  rw [bitsEq, packedInputWord_encodeTokens_append,
    packedInputWord_eq_packedRawBits,
    ← malformed.workTail_eq_packedRawBits]

private theorem rawInputWorkTape_eq_packedInputWord
    (bits : BitString) :
    rawInputWorkTape bits =
      WorkTape.ofSymbols (packedInputWord bits) := by
  rfl

/-! ### Exact-run composition -/

private theorem exactRun_add (first second : Nat)
    (initial middle final : WorkConfiguration)
    (hFirst : workRunExact? machine first initial = some middle)
    (hSecond : workRunExact? machine second middle = some final) :
    workRunExact? machine (first + second) initial = some final := by
  induction first generalizing initial with
  | zero =>
      have initialEq : initial = middle :=
        Option.some.inj hFirst
      cases initialEq
      simpa using hSecond
  | succ first ih =>
      cases stepEq : workStep? machine initial with
      | none =>
          change
            (match workStep? machine initial with
             | none => none
             | some next =>
                 workRunExact? machine first next) =
              some middle at hFirst
          rw [stepEq] at hFirst
          contradiction
      | some next =>
          have tailRun :
              workRunExact? machine first next =
                some middle := by
            change
              (match workStep? machine initial with
               | none => none
               | some found =>
                   workRunExact? machine first found) =
                some middle at hFirst
            rw [stepEq] at hFirst
            exact hFirst
          rw [Nat.succ_add]
          change
            (match workStep? machine initial with
             | none => none
             | some found =>
                 workRunExact? machine
                   (first + second) found) =
              some final
          rw [stepEq]
          exact ih next tailRun

/-! ### Guard installation and version failures -/

private def versionFirstConfiguration
    (first : WorkSymbol) (rest : List WorkSymbol) :
    WorkConfiguration :=
  { state := State.versionFirst
    tape :=
      { left := [leftGuard]
        head := first
        right := rest } }

private theorem bootInstallGuard_exact
    (first : WorkSymbol) (rest : List WorkSymbol) :
    workRunExact? machine 2
        (workStartConfiguration machine
          (WorkTape.ofSymbols (first :: rest))) =
      some (versionFirstConfiguration first rest) := by
  set_option maxRecDepth 100000 in
    rcases first with ⟨firstBit, secondBit⟩
    cases firstBit <;> cases secondBit <;> rfl

private theorem versionFirst_failure_exact
    (first : WorkSymbol) (rest : List WorkSymbol)
    (wrong : first ≠ cell00) :
    workRunExact? machine 1
        (versionFirstConfiguration first rest) =
      some
        (cleanupSeekConfiguration [] [first] rest) := by
  set_option maxRecDepth 100000 in
    rcases first with ⟨firstBit, secondBit⟩
    cases firstBit <;> cases secondBit <;>
      first
      | rfl
      | exact False.elim (wrong rfl)

private def versionSecondConfiguration
    (second : WorkSymbol) (rest : List WorkSymbol) :
    WorkConfiguration :=
  { state := State.versionSecond
    tape :=
      { left := [cell00, leftGuard]
        head := second
        right := rest } }

private theorem bootVersionFirst_exact
    (second : WorkSymbol) (rest : List WorkSymbol) :
    workRunExact? machine 3
        (workStartConfiguration machine
          (WorkTape.ofSymbols (cell00 :: second :: rest))) =
      some (versionSecondConfiguration second rest) := by
  rfl

private theorem versionSecond_failure_exact
    (second : WorkSymbol) (rest : List WorkSymbol)
    (wrong : second ≠ cell00) :
    workRunExact? machine 1
        (versionSecondConfiguration second rest) =
      some
        (cleanupSeekConfiguration
          [] [second, cell00] rest) := by
  set_option maxRecDepth 100000 in
    rcases second with ⟨firstBit, secondBit⟩
    cases firstBit <;> cases secondBit <;>
      first
      | rfl
      | exact False.elim (wrong rfl)

/-! ### Unary-count prefixes and missing input-count terminators -/

private def unaryUnitCells : Nat → List WorkSymbol
  | 0 => []
  | units + 1 => cell00 :: cell01 :: unaryUnitCells units

private theorem packedTokenCells_replicate_unit
    (units : Nat) :
    packedTokenCells
        (List.replicate units Token.unit) =
      unaryUnitCells units := by
  induction units with
  | zero =>
      rfl
  | succ units ih =>
      simp [List.replicate_succ, packedTokenCells,
        tokenCells, unaryUnitCells, ih]

private theorem pushCleanupScan_mem_iff
    (scan right : List WorkSymbol)
    (symbol : WorkSymbol) :
    symbol ∈ pushCleanupScan scan right ↔
      symbol ∈ scan ∨ symbol ∈ right := by
  induction scan generalizing right with
  | nil =>
      simp [pushCleanupScan]
  | cons first rest ih =>
      rw [pushCleanupScan]
      rw [ih (first :: right)]
      simp only [List.mem_cons]
      constructor
      · rintro (inRest | atHead | inRight)
        · exact Or.inl (Or.inr inRest)
        · exact Or.inl (Or.inl atHead)
        · exact Or.inr inRight
      · rintro ((atHead | inRest) | inRight)
        · exact Or.inr (Or.inl atHead)
        · exact Or.inl inRest
        · exact Or.inr (Or.inr inRight)

private theorem pushCrossed_append_suffix
    (word first second : List WorkSymbol) :
    pushCrossed word (first ++ second) =
      pushCrossed word first ++ second := by
  induction word generalizing first with
  | nil =>
      rfl
  | cons symbol rest ih =>
      change
        pushCrossed rest (symbol :: (first ++ second)) =
          pushCrossed rest (symbol :: first) ++ second
      exact ih (symbol :: first)

private theorem pushCrossed_eq_pushCleanupScan
    (word accumulator : List WorkSymbol) :
    pushCrossed word accumulator =
      pushCleanupScan word accumulator := by
  induction word generalizing accumulator with
  | nil =>
      rfl
  | cons symbol rest ih =>
      exact ih (symbol :: accumulator)

private theorem bootVersion_exact
    (word : List WorkSymbol) :
    workRunExact? machine 4
        (workStartConfiguration machine
          (WorkTape.ofSymbols
            (cell00 :: cell00 :: word))) =
      some
        (configAtWord State.inputCountFirst
          [cell00, cell00, leftGuard] word) := by
  cases word <;> rfl

private theorem inputCountUnit_exact
    (left rest : List WorkSymbol) :
    workRunExact? machine 2
        (configAtWord State.inputCountFirst left
          (cell00 :: cell01 :: rest)) =
      some
        (configAtWord State.inputCountFirst
          (cell01 :: cell00 :: left) rest) := by
  rfl

private theorem inputCountUnits_exact
    (units : Nat) (left suffix : List WorkSymbol) :
    workRunExact? machine (2 * units)
        (configAtWord State.inputCountFirst left
          (unaryUnitCells units ++ suffix)) =
      some
        (configAtWord State.inputCountFirst
          (pushCrossed (unaryUnitCells units) left)
          suffix) := by
  induction units generalizing left with
  | zero =>
      rfl
  | succ units ih =>
      have first :=
        inputCountUnit_exact left
          (unaryUnitCells units ++ suffix)
      have restRun :=
        ih (cell01 :: cell00 :: left)
      have composed := exactRun_add 2 (2 * units)
        _ _ _ first restRun
      simpa [unaryUnitCells, Nat.mul_succ,
        Nat.add_comm, Nat.add_left_comm,
        Nat.add_assoc, pushCrossed] using composed

private theorem pushCrossed_append
    (first second accumulator : List WorkSymbol) :
    pushCrossed (first ++ second) accumulator =
      pushCrossed second
        (pushCrossed first accumulator) := by
  induction first generalizing accumulator with
  | nil =>
      rfl
  | cons symbol rest ih =>
      exact ih (symbol :: accumulator)

private theorem natCells_eq_unaryUnitCells_append
    (value : Nat) :
    natCells value =
      unaryUnitCells value ++ [cell00, cell10] := by
  induction value with
  | zero =>
      rfl
  | succ value ih =>
      change
        cell00 :: cell01 :: natCells value =
          cell00 :: cell01 ::
            (unaryUnitCells value ++ [cell00, cell10])
      rw [ih]

private theorem inputCountEnd_exact
    (left suffix : List WorkSymbol) :
    workRunExact? machine 2
        (configAtWord State.inputCountFirst left
          (cell00 :: cell10 :: suffix)) =
      some
        (configAtWord State.gateCountFirst
          (cell10 :: cell00 :: left) suffix) := by
  rfl

private theorem inputCountValue_exact
    (value : Nat) (left suffix : List WorkSymbol) :
    workRunExact? machine (2 * (value + 1))
        (configAtWord State.inputCountFirst left
          (natCells value ++ suffix)) =
      some
        (configAtWord State.gateCountFirst
          (pushCrossed (natCells value) left)
          suffix) := by
  have unitsRun :=
    inputCountUnits_exact value left
      (cell00 :: cell10 :: suffix)
  have ending :=
    inputCountEnd_exact
      (pushCrossed (unaryUnitCells value) left)
      suffix
  have composed := exactRun_add (2 * value) 2
    _ _ _ unitsRun ending
  rw [natCells_eq_unaryUnitCells_append]
  simpa [pushCrossed_append, pushCrossed,
    List.append_assoc, Nat.mul_add,
    Nat.add_assoc] using composed

private theorem gateCountUnit_exact
    (left rest : List WorkSymbol) :
    workRunExact? machine 2
        (configAtWord State.gateCountFirst left
          (cell00 :: cell01 :: rest)) =
      some
        (configAtWord State.gateCountFirst
          (cell01 :: cell00 :: left) rest) := by
  rfl

private theorem gateCountUnits_exact
    (units : Nat) (left suffix : List WorkSymbol) :
    workRunExact? machine (2 * units)
        (configAtWord State.gateCountFirst left
          (unaryUnitCells units ++ suffix)) =
      some
        (configAtWord State.gateCountFirst
          (pushCrossed (unaryUnitCells units) left)
          suffix) := by
  induction units generalizing left with
  | zero =>
      rfl
  | succ units ih =>
      have first :=
        gateCountUnit_exact left
          (unaryUnitCells units ++ suffix)
      have restRun :=
        ih (cell01 :: cell00 :: left)
      have composed := exactRun_add 2 (2 * units)
        _ _ _ first restRun
      simpa [unaryUnitCells, Nat.mul_succ,
        Nat.add_comm, Nat.add_left_comm,
        Nat.add_assoc, pushCrossed] using composed

private theorem inputCountMissingEnd_failure_exact
    (units : Nat) :
    workRunExact? machine 1
        (configAtWord State.inputCountFirst
          (pushCrossed (unaryUnitCells units)
            [cell00, cell00] ++ [leftGuard]) []) =
      some
        (cleanupSeekConfiguration
          []
          (cellBlank ::
            pushCrossed (unaryUnitCells units)
              [cell00, cell00])
          []) := by
  change
    (match workStep? machine
        (configAtWord State.inputCountFirst
          (pushCrossed (unaryUnitCells units)
            [cell00, cell00] ++ [leftGuard]) []) with
     | none => none
     | some next => some next) =
      some
        (cleanupSeekConfiguration
          []
          (cellBlank ::
            pushCrossed (unaryUnitCells units)
              [cell00, cell00])
          [])
  set_option maxRecDepth 100000 in
    rfl

private theorem unaryUnitCells_no_leftGuard
    (units : Nat) (symbol : WorkSymbol)
    (member : symbol ∈ unaryUnitCells units) :
    symbol ≠ leftGuard := by
  induction units with
  | zero =>
      contradiction
  | succ units ih =>
      simp only [unaryUnitCells, List.mem_cons] at member
      rcases member with firstEq | member
      · subst symbol
        decide
      · rcases member with secondEq | member
        · subst symbol
          decide
        · exact ih member

private theorem unaryUnitCells_no_blank
    (units : Nat) (symbol : WorkSymbol)
    (member : symbol ∈ unaryUnitCells units) :
    symbol ≠ cellBlank := by
  induction units with
  | zero =>
      contradiction
  | succ units ih =>
      simp only [unaryUnitCells, List.mem_cons] at member
      rcases member with firstEq | member
      · subst symbol
        decide
      · rcases member with secondEq | member
        · subst symbol
          decide
        · exact ih member

private theorem inputCountMissingEnd_exact
    (units : Nat) :
    ∃ steps final,
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (cell00 :: cell00 ::
                unaryUnitCells units))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let crossed :=
    pushCrossed (unaryUnitCells units)
      [cell00, cell00]
  let eraseWord :=
    pushCleanupScan crossed []
  let cleanupScan := cellBlank :: crossed
  have boot :=
    bootVersion_exact (unaryUnitCells units)
  have unitsRun :
      workRunExact? machine (2 * units)
          (configAtWord State.inputCountFirst
            [cell00, cell00, leftGuard]
            (unaryUnitCells units)) =
        some
          (configAtWord State.inputCountFirst
            (pushCrossed (unaryUnitCells units)
              [cell00, cell00, leftGuard])
            []) := by
    simpa using
      (inputCountUnits_exact units
        [cell00, cell00, leftGuard] [])
  have crossedGuard :
      pushCrossed (unaryUnitCells units)
          [cell00, cell00, leftGuard] =
        crossed ++ [leftGuard] := by
    dsimp [crossed]
    exact pushCrossed_append_suffix
      (unaryUnitCells units)
      [cell00, cell00] [leftGuard]
  rw [crossedGuard] at unitsRun
  have throughUnits :=
    exactRun_add 4 (2 * units)
      _ _ _ boot unitsRun
  have failure :=
    inputCountMissingEnd_failure_exact units
  have throughFailure :=
    exactRun_add (4 + 2 * units) 1
      _ _ _ throughUnits failure
  have forwardShape :
      pushCleanupScan cleanupScan [] =
        eraseWord ++ cellBlank :: [] := by
    dsimp [cleanupScan, eraseWord]
    rw [pushCleanupScan]
    simpa using
      (pushCleanupScan_append crossed []
        [cellBlank])
  have noGuard :
      ∀ symbol, symbol ∈ cleanupScan →
        symbol ≠ leftGuard := by
    intro symbol member
    dsimp [cleanupScan] at member
    simp only [List.mem_cons] at member
    rcases member with blankEq | crossedMember
    · subst symbol
      decide
    · have sourceMember :
          symbol ∈ unaryUnitCells units ∨
            symbol = cell00 := by
        have crossedShape :=
          pushCleanupScan_mem_iff
            (unaryUnitCells units)
            [cell00, cell00] symbol
        have crossedAsCleanup :
            crossed =
              pushCleanupScan
                (unaryUnitCells units)
                [cell00, cell00] := by
          dsimp [crossed]
          exact pushCrossed_eq_pushCleanupScan
            (unaryUnitCells units)
            [cell00, cell00]
        rw [crossedAsCleanup] at crossedMember
        have split := crossedShape.mp crossedMember
        rcases split with unitMember | headerMember
        · exact Or.inl unitMember
        · simp at headerMember
          exact Or.inr headerMember
      rcases sourceMember with unitMember | headerEq
      · exact unaryUnitCells_no_leftGuard
          units symbol unitMember
      · subst symbol
        decide
  have eraseNonblank :
      ∀ symbol, symbol ∈ eraseWord →
        symbol ≠ cellBlank := by
    intro symbol member
    dsimp [eraseWord] at member
    have split :=
      (pushCleanupScan_mem_iff crossed []
        symbol).mp member
    have crossedMember := split.resolve_right (by simp)
    have crossedAsCleanup :
        crossed =
          pushCleanupScan
            (unaryUnitCells units)
            [cell00, cell00] := by
      dsimp [crossed]
      exact pushCrossed_eq_pushCleanupScan
        (unaryUnitCells units)
        [cell00, cell00]
    rw [crossedAsCleanup] at crossedMember
    have sourceSplit :=
      (pushCleanupScan_mem_iff
        (unaryUnitCells units)
        [cell00, cell00] symbol).mp
        crossedMember
    rcases sourceSplit with unitMember | headerMember
    · exact unaryUnitCells_no_blank
        units symbol unitMember
    · simp only [List.mem_cons, List.not_mem_nil,
        or_false] at headerMember
      rcases headerMember with headerEq | headerEq
      · subst symbol
        decide
      · subst symbol
        decide
  have cleanup :=
    guardedCleanupExplicit_exact
      [] cleanupScan [] eraseWord []
      noGuard forwardShape eraseNonblank
  let steps :=
    (4 + 2 * units + 1) +
      guardedCleanupExplicitSteps cleanupScan eraseWord
  let final :=
    cleanupExplicitRejectConfiguration
      [] eraseWord []
  refine ⟨steps, final, ?_, rfl, ?_⟩
  · exact exactRun_add (4 + 2 * units + 1)
      (guardedCleanupExplicitSteps cleanupScan eraseWord)
      _ _ _ throughFailure cleanup
  · rfl

private def missingEndScan
    (crossed : List WorkSymbol) : List WorkSymbol :=
  cellBlank :: crossed

private def missingEndEraseWord
    (crossed : List WorkSymbol) : List WorkSymbol :=
  pushCleanupScan crossed []

private def missingEndTailSteps
    (crossed : List WorkSymbol) : Nat :=
  1 + guardedCleanupExplicitSteps
    (missingEndScan crossed)
    (missingEndEraseWord crossed)

private theorem missingEndTail_exact
    (state : Nat) (prefixCells crossed : List WorkSymbol)
    (crossedEq :
      crossed = pushCrossed prefixCells [])
    (noGuard :
      ∀ symbol, symbol ∈ prefixCells →
        symbol ≠ leftGuard)
    (nonblank :
      ∀ symbol, symbol ∈ prefixCells →
        symbol ≠ cellBlank)
    (failure :
      workRunExact? machine 1
          (configAtWord state
            (crossed ++ [leftGuard]) []) =
        some
          (cleanupSeekConfiguration
            [] (missingEndScan crossed) [])) :
    workRunExact? machine
        (missingEndTailSteps crossed)
        (configAtWord state
          (crossed ++ [leftGuard]) []) =
      some
        (cleanupExplicitRejectConfiguration
          [] (missingEndEraseWord crossed) []) := by
  have scanNoGuard :
      ∀ symbol, symbol ∈ missingEndScan crossed →
        symbol ≠ leftGuard := by
    intro symbol member
    simp only [missingEndScan, List.mem_cons] at member
    rcases member with blankEq | crossedMember
    · subst symbol
      decide
    · rw [crossedEq] at crossedMember
      rw [pushCrossed_eq_pushCleanupScan] at crossedMember
      have split :=
        (pushCleanupScan_mem_iff prefixCells []
          symbol).mp crossedMember
      exact noGuard symbol
        (split.resolve_right (by simp))
  have eraseNonblank :
      ∀ symbol,
        symbol ∈ missingEndEraseWord crossed →
          symbol ≠ cellBlank := by
    intro symbol member
    unfold missingEndEraseWord at member
    have firstSplit :=
      (pushCleanupScan_mem_iff crossed []
        symbol).mp member
    have crossedMember :=
      firstSplit.resolve_right (by simp)
    rw [crossedEq] at crossedMember
    rw [pushCrossed_eq_pushCleanupScan] at crossedMember
    have secondSplit :=
      (pushCleanupScan_mem_iff prefixCells []
        symbol).mp crossedMember
    exact nonblank symbol
      (secondSplit.resolve_right (by simp))
  have forwardShape :
      pushCleanupScan (missingEndScan crossed) [] =
        missingEndEraseWord crossed ++
          cellBlank :: [] := by
    unfold missingEndScan missingEndEraseWord
    rw [pushCleanupScan]
    simpa using
      (pushCleanupScan_append crossed []
        [cellBlank])
  have cleanup :=
    guardedCleanupExplicit_exact
      [] (missingEndScan crossed) []
      (missingEndEraseWord crossed) []
      scanNoGuard forwardShape eraseNonblank
  unfold missingEndTailSteps
  exact exactRun_add 1
    (guardedCleanupExplicitSteps
      (missingEndScan crossed)
      (missingEndEraseWord crossed))
    _ _ _ failure cleanup

/-! ### Explicit malformed-cell cleanup -/

private theorem pushCleanupScan_pushCrossed
    (word accumulator right : List WorkSymbol) :
    pushCleanupScan (pushCrossed word accumulator) right =
      pushCleanupScan accumulator (word ++ right) := by
  induction word generalizing accumulator with
  | nil =>
      rfl
  | cons symbol rest ih =>
      change
        pushCleanupScan
            (pushCrossed rest (symbol :: accumulator)) right =
          pushCleanupScan accumulator
            (symbol :: (rest ++ right))
      simpa [pushCleanupScan] using
        ih (symbol :: accumulator)

private theorem explicitFailureForward_eq
    (parsedPrefix : List WorkSymbol) (current : WorkSymbol)
    (rest : List WorkSymbol) :
    pushCleanupScan
        (current :: pushCrossed parsedPrefix []) rest =
      parsedPrefix ++ current :: rest := by
  rw [pushCleanupScan]
  exact pushCleanupScan_pushCrossed
    parsedPrefix [] (current :: rest)

private theorem packedExplicitFailure_exact
    (tokens : List Token)
    (parsedPrefix : List WorkSymbol) (current : WorkSymbol)
    (rest : List WorkSymbol)
    (initial : WorkConfiguration) (launchSteps : Nat)
    (shape :
      packedTokenCells tokens =
        parsedPrefix ++ current :: rest)
    (launch :
      workRunExact? machine launchSteps initial =
        some
          (cleanupSeekConfiguration
            [] (current :: pushCrossed parsedPrefix []) rest)) :
    ∃ steps final,
      workRunExact? machine steps initial = some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let scan := current :: pushCrossed parsedPrefix []
  have forwardEq :
      pushCleanupScan scan rest =
        packedTokenCells tokens := by
    dsimp [scan]
    rw [explicitFailureForward_eq, ← shape]
  have noGuard :
      ∀ symbol, symbol ∈ scan →
        symbol ≠ leftGuard := by
    intro symbol member
    apply packedTokenCells_no_leftGuard tokens symbol
    have forwardMember :
        symbol ∈ pushCleanupScan scan rest :=
      (pushCleanupScan_mem_iff scan rest symbol).mpr
        (Or.inl member)
    rwa [forwardEq] at forwardMember
  have nonblank :
      ∀ symbol,
        symbol ∈ pushCleanupScan scan rest →
          symbol ≠ cellBlank := by
    intro symbol member
    apply packedTokenCells_no_blank tokens symbol
    rwa [forwardEq] at member
  have cleanup :=
    guardedCleanupFinite_exact
      [] scan rest noGuard nonblank
  let steps :=
    launchSteps + guardedCleanupSteps scan rest
  let final :=
    cleanupRejectConfiguration [] scan rest []
  refine ⟨steps, final, ?_, rfl, ?_⟩
  · exact exactRun_add launchSteps
      (guardedCleanupSteps scan rest)
      _ _ _ launch cleanup
  · exact cleanupRejectConfiguration_output_empty
      [] scan rest

private theorem inputCountUnitsPrefix_exact
    (units : Nat) (suffix : List WorkSymbol) :
    let parsedCells :=
      [cell00, cell00] ++ unaryUnitCells units
    workRunExact? machine (4 + 2 * units)
        (workStartConfiguration machine
          (WorkTape.ofSymbols (parsedCells ++ suffix))) =
      some
        (configAtWord State.inputCountFirst
          (pushCrossed parsedCells [] ++ [leftGuard])
          suffix) := by
  dsimp only
  have boot :=
    bootVersion_exact
      (unaryUnitCells units ++ suffix)
  have unitsRun :
      workRunExact? machine (2 * units)
          (configAtWord State.inputCountFirst
            [cell00, cell00, leftGuard]
            (unaryUnitCells units ++ suffix)) =
        some
          (configAtWord State.inputCountFirst
            (pushCrossed (unaryUnitCells units)
              [cell00, cell00, leftGuard])
            suffix) := by
    simpa using
      (inputCountUnits_exact units
        [cell00, cell00, leftGuard] suffix)
  have all :=
    exactRun_add 4 (2 * units)
      _ _ _ boot unitsRun
  have endpointEq :
      pushCrossed (unaryUnitCells units)
          [cell00, cell00, leftGuard] =
        pushCrossed
            ([cell00, cell00] ++
              unaryUnitCells units) [] ++
          [leftGuard] := by
    change
      pushCrossed (unaryUnitCells units)
          ([cell00, cell00] ++ [leftGuard]) =
        pushCrossed (unaryUnitCells units)
            [cell00, cell00] ++
          [leftGuard]
    exact pushCrossed_append_suffix
      (unaryUnitCells units)
      [cell00, cell00] [leftGuard]
  rw [endpointEq] at all
  simpa [List.append_assoc] using all

