private theorem simpleMalformedBoundary_trailingThree
    (boundary : SimpleMalformedBoundary)
    (parsedPrefix : List WorkSymbol)
    (first second third : Bool) :
    BoundaryCleanupLaunch boundary.state parsedPrefix
      [boolPairWorkCell first second,
        danglingWorkCell third] := by
  cases boundary with
  | versionFirst =>
      simp only [SimpleMalformedBoundary.state]
      cases first <;> cases second <;> cases third <;>
        first
        | apply boundaryCleanupLaunch_immediate
          rw [guardedConfig_eq_crossed]
          rfl
        | apply boundaryCleanupLaunch_afterOne_retained
          · constructor <;> decide
          · rw [guardedConfig_eq_crossed]
            rw [pushCrossed_snoc]
            rfl
  | versionSecond =>
      simp only [SimpleMalformedBoundary.state]
      cases first <;> cases second <;> cases third <;>
        first
        | apply boundaryCleanupLaunch_immediate
          rw [guardedConfig_eq_crossed]
          rfl
        | apply boundaryCleanupLaunch_afterOne_retained
          · constructor <;> decide
          · rw [guardedConfig_eq_crossed]
            rw [pushCrossed_snoc]
            rfl
  | inputCount =>
      simp only [SimpleMalformedBoundary.state]
      cases first <;> cases second <;> cases third <;>
        first
        | apply boundaryCleanupLaunch_immediate
          rw [guardedConfig_eq_crossed]
          rfl
        | apply boundaryCleanupLaunch_afterOne_retained
          · constructor <;> decide
          · rw [guardedConfig_eq_crossed]
            rw [pushCrossed_snoc]
            rfl
  | gateCount =>
      simp only [SimpleMalformedBoundary.state]
      cases first <;> cases second <;> cases third <;>
        first
        | apply boundaryCleanupLaunch_immediate
          rw [guardedConfig_eq_crossed]
          rfl
        | apply boundaryCleanupLaunch_afterOne_retained
          · constructor <;> decide
          · rw [guardedConfig_eq_crossed]
            rw [pushCrossed_snoc]
            rfl
  | source continuation =>
      simp only [SimpleMalformedBoundary.state]
      cases continuation <;>
        cases first <;> cases second <;> cases third <;>
        first
        | apply boundaryCleanupLaunch_immediate
          rw [guardedConfig_eq_crossed]
          rfl
        | apply boundaryCleanupLaunch_afterOne_retained
          · constructor <;> decide
          · rw [guardedConfig_eq_crossed]
            rw [pushCrossed_snoc]
            rfl
  | index bound continuation =>
      simp only [SimpleMalformedBoundary.state]
      cases bound <;> cases continuation <;>
        cases first <;> cases second <;> cases third <;>
        first
        | apply boundaryCleanupLaunch_immediate
          rw [guardedConfig_eq_crossed]
          rfl
        | apply boundaryCleanupLaunch_afterOne_retained
          · constructor <;> decide
          · rw [guardedConfig_eq_crossed]
            rw [pushCrossed_snoc]
            rfl
  | gateEnd =>
      simp only [SimpleMalformedBoundary.state]
      cases first <;> cases second <;> cases third <;>
        first
        | apply boundaryCleanupLaunch_immediate
          rw [guardedConfig_eq_crossed]
          rfl
        | apply boundaryCleanupLaunch_afterOne_rewritten
            (stored := gateMark)
          · exact ordinaryCell_cleanupSafe
              ordinaryCell_gateMark
          · rw [guardedConfig_eq_crossed]
            rw [pushCrossed_snoc]
            rfl
  | outputsEnd =>
      simp only [SimpleMalformedBoundary.state]
      cases first <;> cases second <;> cases third <;>
        first
        | apply boundaryCleanupLaunch_immediate
          rw [guardedConfig_eq_crossed]
          rfl
        | apply boundaryCleanupLaunch_afterOne_retained
          · constructor <;> decide
          · rw [guardedConfig_eq_crossed]
            rw [pushCrossed_snoc]
            rfl
  | instanceEnd =>
      simp only [SimpleMalformedBoundary.state]
      cases first <;> cases second <;> cases third <;>
        first
        | apply boundaryCleanupLaunch_immediate
          rw [guardedConfig_eq_crossed]
          rfl
        | apply boundaryCleanupLaunch_afterOne_retained
          · constructor <;> decide
          · rw [guardedConfig_eq_crossed]
            rw [pushCrossed_snoc]
            rfl
  | finalEOF =>
      simp only [SimpleMalformedBoundary.state]
      cases first <;> cases second <;> cases third <;>
        first
        | apply boundaryCleanupLaunch_immediate
          rw [guardedConfig_eq_crossed]
          rfl

private theorem simpleMalformedBoundary_launch
    (boundary : SimpleMalformedBoundary)
    (parsedPrefix : List WorkSymbol)
    {rawTail : BitString} {workTail : List WorkSymbol}
    (malformed : MalformedWorkTail rawTail workTail) :
    BoundaryCleanupLaunch boundary.state
      parsedPrefix workTail := by
  cases malformed with
  | reserved third fourth suffix =>
      apply boundaryCleanupLaunch_immediate
      exact simpleMalformedBoundary_cell11_failure
        boundary parsedPrefix
          (boolPairWorkCell third fourth ::
            packedRawBits suffix)
  | trailingOne first =>
      apply boundaryCleanupLaunch_immediate
      simpa [pushCrossed] using
        (simpleMalformedBoundary_dangling_failure
          boundary parsedPrefix first)
  | trailingTwo first second =>
      exact simpleMalformedBoundary_trailingTwo
        boundary parsedPrefix first second
  | trailingThree first second third =>
      exact simpleMalformedBoundary_trailingThree
        boundary parsedPrefix first second third

private theorem delimiterMissing_bounded_exact
    (state : Nat) (parsedPrefix : List WorkSymbol)
    (parsedOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol)
    (launch :
      workRunExact? machine 1
          (configAtWord state
            (pushCrossed parsedPrefix [] ++
              [leftGuard]) []) =
        some
          (cleanupSeekConfiguration
            [] (missingEndScan
              (pushCrossed parsedPrefix [])) [])) :
    ∃ steps final,
      steps ≤
          16 *
            failureSpanSquare
              (parsedPrefix.length + 2) ∧
      workRunExact? machine steps
          (guardedConfig state parsedPrefix []) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let crossed := pushCrossed parsedPrefix []
  have initialEq :
      guardedConfig state parsedPrefix [] =
        configAtWord state
          (crossed ++ [leftGuard]) [] := by
    simpa [crossed] using
      guardedConfig_eq_crossed
        state parsedPrefix []
  have tail :=
    missingEndTail_exact state parsedPrefix
      crossed rfl
      (by
        intro symbol member
        exact ordinaryCell_not_leftGuard
          (parsedOrdinary symbol member))
      (by
        intro symbol member
        exact ordinaryCell_not_blank
          (parsedOrdinary symbol member))
      (by simpa [crossed] using launch)
  let final :=
    cleanupExplicitRejectConfiguration
      [] (missingEndEraseWord crossed) []
  have linear :=
    sourceMissingTokenSteps_linear_bound
      parsedPrefix
  have scheduleBound :=
    linear_failure_le_square
      (missingEndTailSteps crossed)
      (parsedPrefix.length + 2)
      (by simpa [crossed] using linear)
  refine
    ⟨missingEndTailSteps crossed,
      final, scheduleBound, ?_, rfl, ?_⟩
  · rw [initialEq]
    simpa [final] using tail
  · rfl

private theorem delimiterExplicitFailure_bounded_exact
    (parsedPrefix : List WorkSymbol)
    (current : WorkSymbol) (rest : List WorkSymbol)
    (initial : WorkConfiguration)
    (launchSteps span : Nat)
    (ordinary :
      ∀ symbol,
        symbol ∈ parsedPrefix ++ current :: rest →
          ordinaryCell symbol)
    (launch :
      workRunExact? machine launchSteps initial =
        some
          (cleanupSeekConfiguration
            [] (current ::
              pushCrossed parsedPrefix []) rest))
    (linear :
      launchSteps +
          guardedCleanupSteps
            (current ::
              pushCrossed parsedPrefix []) rest ≤
        4 * (span + 1)) :
    ∃ steps final,
      steps ≤ 16 * failureSpanSquare span ∧
      workRunExact? machine steps initial =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let scan :=
    current :: pushCrossed parsedPrefix []
  let steps :=
    launchSteps +
      guardedCleanupSteps scan rest
  let final :=
    cleanupRejectConfiguration
      [] scan rest []
  have run :=
    ordinaryExplicitFailureRun_exact
      parsedPrefix current rest initial
      launchSteps ordinary launch
  have scheduleBound :=
    linear_failure_le_square
      steps span (by
        simpa [steps, scan] using linear)
  refine
    ⟨steps, final, scheduleBound, ?_, rfl, ?_⟩
  · simpa [steps, scan, final] using run
  · exact cleanupRejectConfiguration_output_empty
      [] scan rest

private theorem safeExplicitFailure_bounded_exact
    (parsedPrefix : List WorkSymbol)
    (current : WorkSymbol) (rest : List WorkSymbol)
    (initial : WorkConfiguration)
    (launchSteps span : Nat)
    (safe :
      ∀ symbol,
        symbol ∈ parsedPrefix ++ current :: rest →
          cleanupSafeCell symbol)
    (launch :
      workRunExact? machine launchSteps initial =
        some
          (cleanupSeekConfiguration
            [] (current ::
              pushCrossed parsedPrefix []) rest))
    (linear :
      launchSteps +
          guardedCleanupSteps
            (current ::
              pushCrossed parsedPrefix []) rest ≤
        4 * (span + 1)) :
    ∃ steps final,
      steps ≤ 16 * failureSpanSquare span ∧
      workRunExact? machine steps initial =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let scan :=
    current :: pushCrossed parsedPrefix []
  have forwardEq :
      pushCleanupScan scan rest =
        parsedPrefix ++ current :: rest := by
    exact explicitFailureForward_eq
      parsedPrefix current rest
  have noGuard :
      ∀ symbol, symbol ∈ scan →
        symbol ≠ leftGuard := by
    intro symbol member
    have forwardMember :
        symbol ∈ pushCleanupScan scan rest :=
      (pushCleanupScan_mem_iff
        scan rest symbol).mpr (Or.inl member)
    rw [forwardEq] at forwardMember
    exact (safe symbol forwardMember).1
  have nonblank :
      ∀ symbol,
        symbol ∈ pushCleanupScan scan rest →
          symbol ≠ cellBlank := by
    intro symbol member
    rw [forwardEq] at member
    exact (safe symbol member).2
  have cleanup :=
    guardedCleanupFinite_exact
      [] scan rest noGuard nonblank
  let steps :=
    launchSteps +
      guardedCleanupSteps scan rest
  let final :=
    cleanupRejectConfiguration
      [] scan rest []
  have run :=
    exactRun_add launchSteps
      (guardedCleanupSteps scan rest)
      _ _ _ launch cleanup
  have scheduleBound :=
    linear_failure_le_square
      steps span (by
        simpa [steps, scan] using linear)
  refine
    ⟨steps, final, scheduleBound, ?_, rfl, ?_⟩
  · simpa [steps, scan, final] using run
  · exact cleanupRejectConfiguration_output_empty
      [] scan rest

private def rawFailureEnvelope
    (word : List WorkSymbol) : Nat :=
  2048 * failureSpanCube word.length

private def rawRejectOutcome
    (word : List WorkSymbol) : Prop :=
  ∃ steps final,
    steps ≤ rawFailureEnvelope word ∧
    workRunExact? machine steps
        (workStartConfiguration machine
          (WorkTape.ofSymbols word)) =
      some final ∧
    final.state = State.reject ∧
    (encodeWorkTape final.tape).outputBits = []

private theorem rawRejectOutcome_transport
    {first second : List WorkSymbol}
    (same : first = second)
    (result : rawRejectOutcome second) :
    rawRejectOutcome first := by
  cases same
  exact result

private theorem squareFailure_le_rawFailureEnvelope
    (word : List WorkSymbol) :
    16 * failureSpanSquare word.length ≤
      rawFailureEnvelope word := by
  have positive : 1 ≤ word.length + 1 := by
    omega
  have squareLeCube :
      failureSpanSquare word.length ≤
        failureSpanCube word.length := by
    have scaled :=
      Nat.mul_le_mul_right
        (failureSpanSquare word.length) positive
    simpa [failureSpanCube] using scaled
  have lifted :=
    Nat.mul_le_mul_left 16 squareLeCube
  have coefficient :
      16 * failureSpanCube word.length ≤
        2048 * failureSpanCube word.length := by
    omega
  exact Nat.le_trans lifted (by
    simpa [rawFailureEnvelope] using coefficient)

private theorem boundaryCleanupLaunch_linear_bounded_exact
    (state : Nat)
    (parsedPrefix word : List WorkSymbol)
    (prefixOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol)
    (wordSourcePacked :
      ∀ symbol, symbol ∈ word →
        SourcePackedCell symbol)
    (wordNonempty : word ≠ [])
    (launch :
      BoundaryCleanupLaunch state parsedPrefix word) :
    ∃ steps final,
      steps ≤
          4 * ((parsedPrefix ++ word).length + 1) ∧
      workRunExact? machine steps
          (guardedConfig state parsedPrefix word) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  rcases launch with
    ⟨launchSteps, consumedCells, storedCells,
      currentCell, restCells, launchBound,
      consumedBound, storedLength, storedSafe,
      wordShape, launchRun⟩
  let wholeWord := parsedPrefix ++ word
  rcases wordShape with explicitShape | implicitShape
  · let cleanupPrefix :=
      parsedPrefix ++ storedCells
    let scan :=
      currentCell ::
        pushCrossed cleanupPrefix []
    have tailSafe :
        ∀ symbol,
          symbol ∈ currentCell :: restCells →
            cleanupSafeCell symbol := by
      intro symbol member
      apply ordinaryCell_cleanupSafe
      apply sourcePackedCell_ordinary
      apply wordSourcePacked symbol
      rw [explicitShape]
      exact List.mem_append.mpr (Or.inr member)
    have safe :
        ∀ symbol,
          symbol ∈
              cleanupPrefix ++
                currentCell :: restCells →
            cleanupSafeCell symbol := by
      intro symbol member
      rcases List.mem_append.mp member with
          inCleanupPrefix | inTail
      · rcases List.mem_append.mp inCleanupPrefix with
          inParsed | inStored
        · exact ordinaryCell_cleanupSafe
            (prefixOrdinary symbol inParsed)
        · exact storedSafe symbol inStored
      · exact tailSafe symbol inTail
    have cleanupRaw :=
      safeGuardedCleanup_exact
        cleanupPrefix currentCell restCells safe
    have cleanupInitialEq :
        guardedConfig State.cleanupSeekGuard
            cleanupPrefix
            (currentCell :: restCells) =
          cleanupSeekConfiguration
            [] scan restCells := by
      rw [guardedConfig_eq_crossed]
      simp [cleanupPrefix, scan,
        cleanupSeekConfiguration,
        configAtWord, tapeAtWord]
    let final :=
      cleanupRejectConfiguration
        [] scan restCells []
    have cleanup :
        workRunExact? machine
            (guardedCleanupSteps scan restCells)
            (cleanupSeekConfiguration
              [] scan restCells) =
          some final := by
      rw [← cleanupInitialEq]
      simpa [scan, final] using cleanupRaw
    let steps :=
      launchSteps +
        guardedCleanupSteps scan restCells
    have run :=
      exactRun_add launchSteps
        (guardedCleanupSteps scan restCells)
        _ _ _ launchRun cleanup
    have wordLength :=
      congrArg List.length explicitShape
    simp only [List.length_append,
      List.length_cons] at wordLength
    have linear :
        steps ≤ 4 * (wholeWord.length + 1) := by
      dsimp [steps]
      rw [guardedCleanupSteps_eq]
      simp only [scan, cleanupPrefix,
        List.length_cons, pushCrossed_length,
        List.length_append, List.length_nil]
      dsimp [wholeWord]
      simp only [List.length_append]
      omega
    refine
      ⟨steps, final,
        (by simpa [wholeWord] using linear),
        ?_, rfl, ?_⟩
    · simpa [steps, final] using run
    · exact cleanupRejectConfiguration_output_empty
        [] scan restCells
  · rcases implicitShape with
      ⟨wordEq, currentEq, restEq⟩
    subst currentCell
    subst restCells
    let cleanupPrefix :=
      parsedPrefix ++ storedCells
    let crossed :=
      pushCrossed cleanupPrefix []
    let scan := missingEndScan crossed
    let eraseWord := missingEndEraseWord crossed
    have cleanupPrefixSafe :
        ∀ symbol, symbol ∈ cleanupPrefix →
          cleanupSafeCell symbol := by
      intro symbol member
      rcases List.mem_append.mp member with
          inParsed | inStored
      · exact ordinaryCell_cleanupSafe
          (prefixOrdinary symbol inParsed)
      · exact storedSafe symbol inStored
    have crossedSafe :
        ∀ symbol, symbol ∈ crossed →
          cleanupSafeCell symbol := by
      intro symbol member
      dsimp [crossed] at member
      rw [pushCrossed_eq_pushCleanupScan] at member
      have split :=
        (pushCleanupScan_mem_iff
          cleanupPrefix [] symbol).mp member
      exact cleanupPrefixSafe symbol
        (split.resolve_right (by simp))
    have scanNoGuard :
        ∀ symbol, symbol ∈ scan →
          symbol ≠ leftGuard := by
      intro symbol member
      simp only [scan, missingEndScan,
        List.mem_cons] at member
      rcases member with blankEq | inCrossed
      · subst symbol
        decide
      · exact (crossedSafe symbol inCrossed).1
    have eraseNonblank :
        ∀ symbol, symbol ∈ eraseWord →
          symbol ≠ cellBlank := by
      intro symbol member
      dsimp [eraseWord, missingEndEraseWord] at member
      have split :=
        (pushCleanupScan_mem_iff
          crossed [] symbol).mp member
      exact
        (crossedSafe symbol
          (split.resolve_right (by simp))).2
    have forwardShape :
        pushCleanupScan scan [] =
          eraseWord ++ cellBlank :: [] := by
      dsimp [scan, eraseWord]
      unfold missingEndScan missingEndEraseWord
      rw [pushCleanupScan]
      simpa using
        (pushCleanupScan_append crossed []
          [cellBlank])
    have cleanup :=
      guardedCleanupExplicit_exact
        [] scan [] eraseWord []
        scanNoGuard forwardShape eraseNonblank
    let final :=
      cleanupExplicitRejectConfiguration
        [] eraseWord []
    let steps :=
      launchSteps +
        guardedCleanupExplicitSteps
          scan eraseWord
    have run :=
      exactRun_add launchSteps
        (guardedCleanupExplicitSteps
          scan eraseWord)
        _ _ _ (by
          simpa [scan, missingEndScan,
            crossed, cleanupPrefix]
            using launchRun) cleanup
    have wordLength :=
      congrArg List.length wordEq
    have wordPositive : 1 ≤ word.length := by
      cases word with
      | nil =>
          exact False.elim (wordNonempty rfl)
      | cons first rest =>
          simp
    have linear :
        steps ≤ 4 * (wholeWord.length + 1) := by
      dsimp [steps]
      rw [guardedCleanupExplicitSteps_eq]
      dsimp [scan, eraseWord, crossed,
        cleanupPrefix]
      unfold missingEndScan missingEndEraseWord
      simp only [List.length_cons,
        List.length_nil, pushCrossed_length,
        pushCleanupScan_length,
        List.length_append]
      dsimp [wholeWord]
      simp only [List.length_append]
      omega
    refine
      ⟨steps, final,
        (by simpa [wholeWord] using linear),
        ?_, rfl, ?_⟩
    · simpa [steps, final] using run
    · rfl

private theorem boundaryCleanupLaunch_square_bounded_exact
    (state : Nat)
    (parsedPrefix word : List WorkSymbol)
    (prefixOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol)
