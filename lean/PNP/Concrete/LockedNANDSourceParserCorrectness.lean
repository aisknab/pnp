private def gateMissingReferenceSteps
    (header : List WorkSymbol)
    (borrowed available : List RawGate)
    (between : List WorkSymbol) :
    Nat → Nat
  | 0 =>
      missingEndTailSteps
        (pushCrossed
          (header ++ borrowedGateListCells borrowed ++
            markedGateListCells available ++ between) [])
  | units + 1 =>
      match available with
      | [] =>
          let failurePrefix :=
            (header ++ borrowedGateListCells borrowed ++
              between) ++ [cell00]
          gateReferenceExhaustedSteps
              header borrowed between +
            guardedCleanupSteps
              (cursorMark ::
                pushCrossed failurePrefix [])
              (unaryUnitCells units)
      | gate :: rest =>
          gateReferenceConsumeUnitSteps
              header borrowed gate rest between +
            gateMissingReferenceSteps
              header (borrowed ++ [gate]) rest
              (between ++ [cell00, cell01]) units

private theorem gateMissingReference_exact
    (continuation : SourceContinuation)
    (header : List WorkSymbol)
    (borrowed available : List RawGate)
    (between : List WorkSymbol) (units : Nat)
    (headerOrdinary :
      ∀ symbol, symbol ∈ header →
        ordinaryCell symbol)
    (headerNoGateMark :
      ∀ symbol, symbol ∈ header →
        symbol ≠ gateMark)
    (betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol)
    (betweenNoGateMark :
      ∀ symbol, symbol ∈ between →
        symbol ≠ gateMark) :
    ∃ final,
      workRunExact? machine
          (gateMissingReferenceSteps
            header borrowed available between units)
          (guardedConfig
            (State.indexFirst .priorGate continuation)
            (header ++ borrowedGateListCells borrowed ++
              markedGateListCells available ++ between)
            (unaryUnitCells units)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  induction units generalizing borrowed available between with
  | zero =>
      let parsedPrefix :=
        header ++ borrowedGateListCells borrowed ++
          markedGateListCells available ++ between
      let crossed := pushCrossed parsedPrefix []
      let final :=
        cleanupExplicitRejectConfiguration
          [] (missingEndEraseWord crossed) []
      have parsedOrdinary :
          ∀ symbol, symbol ∈ parsedPrefix →
            ordinaryCell symbol := by
        dsimp [parsedPrefix]
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact headerOrdinary
            · exact borrowedGateListCells_allOrdinary
                borrowed
          · exact markedGateListCells_allOrdinary
              available
        · exact betweenOrdinary
      have run :=
        referenceIndexMissingEnd_exact
          .priorGate continuation parsedPrefix
          parsedOrdinary
      refine ⟨final, ?_, rfl, ?_⟩
      · simpa [gateMissingReferenceSteps,
          parsedPrefix, crossed, final,
          unaryUnitCells] using run
      · exact cleanupRejectConfiguration_output_empty
          [] (missingEndEraseWord crossed) []
  | succ units ih =>
      cases available with
      | nil =>
          let failurePrefix :=
            (header ++ borrowedGateListCells borrowed ++
              between) ++ [cell00]
          let scan :=
            cursorMark :: pushCrossed failurePrefix []
          let final :=
            cleanupRejectConfiguration
              [] scan (unaryUnitCells units) []
          have exhausted :=
            gateReferenceConsumeExhaustedTail_exact
              continuation header borrowed between
              (unaryUnitCells units)
              headerOrdinary headerNoGateMark
              betweenOrdinary betweenNoGateMark
          have failurePrefixOrdinary :
              ∀ symbol, symbol ∈ failurePrefix →
                ordinaryCell symbol := by
            dsimp [failurePrefix]
            apply ordinaryCells_append
            · apply ordinaryCells_append
              · apply ordinaryCells_append
                · exact headerOrdinary
                · exact borrowedGateListCells_allOrdinary
                    borrowed
              · exact betweenOrdinary
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | impossible
              · exact ordinaryCell_cell00
              · contradiction
          have safe :
              ∀ symbol,
                symbol ∈
                    failurePrefix ++
                      cursorMark :: unaryUnitCells units →
                  cleanupSafeCell symbol := by
            intro symbol member
            simp only [List.mem_append,
              List.mem_cons] at member
            rcases member with
                inPrefix | atCursor | inUnits
            · exact ordinaryCell_cleanupSafe
                (failurePrefixOrdinary symbol inPrefix)
            · subst symbol
              exact cursorMark_cleanupSafe
            · exact ordinaryCell_cleanupSafe
                (unaryUnitCells_allOrdinary
                  units symbol inUnits)
          have cleanup :=
            safeGuardedCleanup_exact
              failurePrefix cursorMark
              (unaryUnitCells units) safe
          have all :=
            exactRun_add
              (gateReferenceExhaustedSteps
                header borrowed between)
              (guardedCleanupSteps
                scan (unaryUnitCells units))
              _ _ _ exhausted cleanup
          refine ⟨final, ?_, rfl, ?_⟩
          · simpa [gateMissingReferenceSteps,
              failurePrefix, scan, final,
              unaryUnitCells,
              markedGateListCells] using all
          · exact cleanupRejectConfiguration_output_empty
              [] scan (unaryUnitCells units)
      | cons gate available =>
          have first :=
            gateReferenceConsumeUnitTail_exact
              continuation header borrowed gate available
              between (unaryUnitCells units)
              headerOrdinary headerNoGateMark
              betweenOrdinary
          have nextBetweenOrdinary :
              ∀ symbol,
                symbol ∈ between ++ [cell00, cell01] →
                  ordinaryCell symbol := by
            apply ordinaryCells_append
            · exact betweenOrdinary
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | rfl | impossible
              · exact ordinaryCell_cell00
              · exact ordinaryCell_cell01
              · contradiction
          have nextBetweenNoGateMark :
              ∀ symbol,
                symbol ∈ between ++ [cell00, cell01] →
                  symbol ≠ gateMark := by
            intro symbol member
            simp only [List.mem_append] at member
            rcases member with inBetween | inUnit
            · exact betweenNoGateMark symbol inBetween
            · simp only [List.mem_cons,
                List.not_mem_nil] at inUnit
              rcases inUnit with rfl | rfl | impossible
              · decide
              · decide
              · contradiction
          rcases ih (borrowed ++ [gate]) available
              (between ++ [cell00, cell01])
              nextBetweenOrdinary nextBetweenNoGateMark with
            ⟨final, tail, finalState, output⟩
          have all :=
            exactRun_add
              (gateReferenceConsumeUnitSteps
                header borrowed gate available between)
              (gateMissingReferenceSteps
                header (borrowed ++ [gate]) available
                (between ++ [cell00, cell01]) units)
              _ _ _ first tail
          refine ⟨final, ?_, finalState, output⟩
          simpa [gateMissingReferenceSteps,
            unaryUnitCells] using all

/-! ### Cost-transparent malformed reference terminals -/

private theorem ordinaryExplicitFailureRun_exact
    (parsedPrefix : List WorkSymbol)
    (current : WorkSymbol) (rest : List WorkSymbol)
    (initial : WorkConfiguration) (launchSteps : Nat)
    (ordinary :
      ∀ symbol,
        symbol ∈ parsedPrefix ++ current :: rest →
          ordinaryCell symbol)
    (launch :
      workRunExact? machine launchSteps initial =
        some
          (cleanupSeekConfiguration
            [] (current :: pushCrossed parsedPrefix []) rest)) :
    let scan := current :: pushCrossed parsedPrefix []
    workRunExact? machine
        (launchSteps + guardedCleanupSteps scan rest)
        initial =
      some
        (cleanupRejectConfiguration
          [] scan rest []) := by
  dsimp only
  let scan := current :: pushCrossed parsedPrefix []
  have forwardEq :
      pushCleanupScan scan rest =
        parsedPrefix ++ current :: rest := by
    exact explicitFailureForward_eq
      parsedPrefix current rest
  have noGuard :
      ∀ symbol, symbol ∈ scan →
        symbol ≠ leftGuard := by
    intro symbol member
    apply ordinaryCell_not_leftGuard
    apply ordinary symbol
    have forwardMember :
        symbol ∈ pushCleanupScan scan rest :=
      (pushCleanupScan_mem_iff scan rest symbol).mpr
        (Or.inl member)
    rwa [forwardEq] at forwardMember
  have nonblank :
      ∀ symbol,
        symbol ∈ pushCleanupScan scan rest →
          symbol ≠ cellBlank := by
    intro symbol member
    apply ordinaryCell_not_blank
    apply ordinary symbol
    rwa [forwardEq] at member
  have cleanup :=
    guardedCleanupFinite_exact
      [] scan rest noGuard nonblank
  exact exactRun_add launchSteps
    (guardedCleanupSteps scan rest)
    _ _ _ launch cleanup

private def referenceWrongTokenSteps
    (parsedPrefix : List WorkSymbol)
    (token : Token) (suffixCells : List WorkSymbol) :
    Nat :=
  match token with
  | .version0 =>
      2 + guardedCleanupSteps
        (cell00 ::
          pushCrossed (parsedPrefix ++ [cell00]) [])
        suffixCells
  | .unit => 0
  | .natEnd => 0
  | .input =>
      2 + guardedCleanupSteps
        (cell11 ::
          pushCrossed (parsedPrefix ++ [cell00]) [])
        suffixCells
  | .constantFalse =>
      1 + guardedCleanupSteps
        (cell01 :: pushCrossed parsedPrefix [])
        (cell00 :: suffixCells)
  | .constantTrue =>
      1 + guardedCleanupSteps
        (cell01 :: pushCrossed parsedPrefix [])
        (cell01 :: suffixCells)
  | .gate =>
      1 + guardedCleanupSteps
        (cell01 :: pushCrossed parsedPrefix [])
        (cell10 :: suffixCells)
  | .gateEnd =>
      1 + guardedCleanupSteps
        (cell01 :: pushCrossed parsedPrefix [])
        (cell11 :: suffixCells)
  | .programEnd =>
      1 + guardedCleanupSteps
        (cell10 :: pushCrossed parsedPrefix [])
        (cell00 :: suffixCells)
  | .outputsEnd =>
      1 + guardedCleanupSteps
        (cell10 :: pushCrossed parsedPrefix [])
        (cell01 :: suffixCells)
  | .threshold =>
      1 + guardedCleanupSteps
        (cell10 :: pushCrossed parsedPrefix [])
        (cell10 :: suffixCells)
  | .instanceEnd =>
      1 + guardedCleanupSteps
        (cell10 :: pushCrossed parsedPrefix [])
        (cell11 :: suffixCells)

private theorem referenceWrongTokenCost_exact
    (bound : ReferenceBound)
    (continuation : SourceContinuation)
    (parsedPrefix : List WorkSymbol)
    (parsedOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol)
    (token : Token) (suffix : List Token)
    (notUnit : token ≠ .unit)
    (notNatEnd : token ≠ .natEnd) :
    ∃ final,
      workRunExact? machine
          (referenceWrongTokenSteps
            parsedPrefix token
            (packedTokenCells suffix))
          (guardedConfig
            (State.indexFirst bound continuation)
            parsedPrefix
            (packedTokenCells (token :: suffix))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let suffixCells := packedTokenCells suffix
  let initial :=
    guardedConfig
      (State.indexFirst bound continuation)
      parsedPrefix (packedTokenCells (token :: suffix))
  have fullOrdinary :
      ∀ symbol,
        symbol ∈
            parsedPrefix ++
              packedTokenCells (token :: suffix) →
          ordinaryCell symbol := by
    intro symbol member
    simp only [List.mem_append] at member
    rcases member with inPrefix | inTokens
    · exact parsedOrdinary symbol inPrefix
    · exact packedTokenCells_ordinary
        (token :: suffix) symbol inTokens
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq : tokenCells token = [current, next])
      (wrong : current ≠ cell00) :
      ∃ final,
        workRunExact? machine
            (1 + guardedCleanupSteps
              (current :: pushCrossed parsedPrefix [])
              (next :: suffixCells))
            initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    let scan := current :: pushCrossed parsedPrefix []
    let final :=
      cleanupRejectConfiguration
        [] scan (next :: suffixCells) []
    have failed :=
      referenceIndexFirstFailure_exact
        bound continuation parsedPrefix current
        (next :: suffixCells) wrong
    have launch :
        workRunExact? machine 1 initial =
          some
            (cleanupSeekConfiguration
              [] scan (next :: suffixCells)) := by
      simpa [initial, suffixCells, scan,
        packedTokenCells, cellsEq] using failed
    have ordinary :
        ∀ symbol,
          symbol ∈
              parsedPrefix ++
                current :: next :: suffixCells →
            ordinaryCell symbol := by
      intro symbol member
      apply fullOrdinary symbol
      simpa [suffixCells, packedTokenCells,
        cellsEq] using member
    have run :=
      ordinaryExplicitFailureRun_exact
        parsedPrefix current (next :: suffixCells)
        initial 1 ordinary launch
    refine ⟨final, ?_, rfl, ?_⟩
    · simpa [scan, final] using run
    · exact cleanupRejectConfiguration_output_empty
        [] scan (next :: suffixCells)
  have rejectSecond
      (current : WorkSymbol)
      (cellsEq : tokenCells token = [cell00, current])
      (notUnitCell : current ≠ cell01)
      (notEndCell : current ≠ cell10) :
      ∃ final,
        workRunExact? machine
            (2 + guardedCleanupSteps
              (current ::
                pushCrossed (parsedPrefix ++ [cell00]) [])
              suffixCells)
            initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    let scan :=
      current ::
        pushCrossed (parsedPrefix ++ [cell00]) []
    let final :=
      cleanupRejectConfiguration [] scan suffixCells []
    have failed :=
      referenceIndexSecondFailure_exact
        bound continuation parsedPrefix current
        suffixCells notUnitCell notEndCell
    have launch :
        workRunExact? machine 2 initial =
          some
            (cleanupSeekConfiguration
              [] scan suffixCells) := by
      simpa [initial, suffixCells, scan,
        packedTokenCells, cellsEq] using failed
    have ordinary :
        ∀ symbol,
          symbol ∈
              (parsedPrefix ++ [cell00]) ++
                current :: suffixCells →
            ordinaryCell symbol := by
      intro symbol member
      apply fullOrdinary symbol
      simpa [suffixCells, packedTokenCells,
        cellsEq, List.append_assoc] using member
    have run :=
      ordinaryExplicitFailureRun_exact
        (parsedPrefix ++ [cell00]) current suffixCells
        initial 2 ordinary launch
    refine ⟨final, ?_, rfl, ?_⟩
    · simpa [scan, final] using run
    · exact cleanupRejectConfiguration_output_empty
        [] scan suffixCells
  cases token with
  | version0 =>
      simpa [referenceWrongTokenSteps,
        initial, suffixCells] using
        (rejectSecond cell00 rfl
          (by decide) (by decide))
  | unit =>
      exact False.elim (notUnit rfl)
  | natEnd =>
      exact False.elim (notNatEnd rfl)
  | input =>
      simpa [referenceWrongTokenSteps,
        initial, suffixCells] using
        (rejectSecond cell11 rfl
          (by decide) (by decide))
  | constantFalse =>
      simpa [referenceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell01 cell00 rfl (by decide))
  | constantTrue =>
      simpa [referenceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell01 cell01 rfl (by decide))
  | gate =>
      simpa [referenceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell01 cell10 rfl (by decide))
  | gateEnd =>
      simpa [referenceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell01 cell11 rfl (by decide))
  | programEnd =>
      simpa [referenceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell10 cell00 rfl (by decide))
  | outputsEnd =>
      simpa [referenceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell10 cell01 rfl (by decide))
  | threshold =>
      simpa [referenceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell10 cell10 rfl (by decide))
  | instanceEnd =>
      simpa [referenceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell10 cell11 rfl (by decide))

private def malformedNatTailCells
    (units : Nat) (token : Token)
    (suffix : List Token) : List WorkSymbol :=
  unaryUnitCells units ++
    tokenCells token ++ packedTokenCells suffix

private theorem malformedNatTailCells_allOrdinary
    (units : Nat) (token : Token)
    (suffix : List Token) :
    ∀ symbol,
      symbol ∈ malformedNatTailCells units token suffix →
        ordinaryCell symbol := by
  apply ordinaryCells_append
  · apply ordinaryCells_append
    · exact unaryUnitCells_allOrdinary units
    · exact tokenCells_ordinary token
  · exact packedTokenCells_ordinary suffix

private def inputWrongReferenceSteps
    (used remaining : Nat) (between : List WorkSymbol)
    (units : Nat) (token : Token)
    (suffix : List Token) : Nat :=
  match units with
  | 0 =>
      referenceWrongTokenSteps
        ([cell00, cell00] ++
          countCells used remaining ++ between)
        token (packedTokenCells suffix)
  | units + 1 =>
      match remaining with
      | 0 =>
          let failurePrefix :=
            [cell00, cell00] ++
              borrowedCountCells used ++ [cell00]
          let failureSuffix :=
            between ++ [cell00, cursorMark] ++
              malformedNatTailCells units token suffix
          inputReferenceExhaustedSteps used between +
            guardedCleanupSteps
              (cell10 :: pushCrossed failurePrefix [])
              failureSuffix
      | rest + 1 =>
          inputReferenceConsumeUnitSteps used rest between +
            inputWrongReferenceSteps
              (used + 1) rest
              (between ++ [cell00, cell01])
              units token suffix

private theorem inputWrongReference_exact
    (continuation : SourceContinuation)
    (used remaining units : Nat)
    (between : List WorkSymbol)
    (token : Token) (suffix : List Token)
    (betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol)
    (notUnit : token ≠ .unit)
    (notNatEnd : token ≠ .natEnd) :
    ∃ final,
      workRunExact? machine
          (inputWrongReferenceSteps
            used remaining between units token suffix)
          (guardedConfig
            (State.indexFirst .input continuation)
            ([cell00, cell00] ++
              countCells used remaining ++ between)
            (malformedNatTailCells
              units token suffix)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  induction units generalizing used remaining between with
  | zero =>
      let parsedPrefix :=
        [cell00, cell00] ++
          countCells used remaining ++ between
      have parsedOrdinary :
          ∀ symbol, symbol ∈ parsedPrefix →
            ordinaryCell symbol := by
        exact inputReferencePrefix_allOrdinary
          used remaining between betweenOrdinary
      have run :=
        referenceWrongTokenCost_exact
          .input continuation parsedPrefix
          parsedOrdinary token suffix
          notUnit notNatEnd
      simpa [inputWrongReferenceSteps,
        malformedNatTailCells, parsedPrefix,
        unaryUnitCells, packedTokenCells,
        List.append_assoc] using run
  | succ units ih =>
      cases remaining with
      | zero =>
          let indexTail :=
            malformedNatTailCells units token suffix
          let failurePrefix :=
            [cell00, cell00] ++
              borrowedCountCells used ++ [cell00]
          let failureSuffix :=
            between ++ [cell00, cursorMark] ++ indexTail
          let scan :=
            cell10 :: pushCrossed failurePrefix []
          let final :=
            cleanupRejectConfiguration
              [] scan failureSuffix []
          have exhausted :=
            inputReferenceConsumeExhaustedTail_exact
              continuation used between indexTail
              betweenOrdinary
          have failurePrefixOrdinary :
              ∀ symbol, symbol ∈ failurePrefix →
                ordinaryCell symbol := by
            intro symbol member
            dsimp [failurePrefix] at member
            simp only [List.mem_cons] at member
            rcases member with rfl | member
            · exact ordinaryCell_cell00
            · rcases member with rfl | member
              · exact ordinaryCell_cell00
              · rcases List.mem_append.mp member with
                  inBorrowed | inFinal
                · exact borrowedCountCells_allOrdinary
                    used symbol inBorrowed
                · simp only [List.mem_cons,
                    List.not_mem_nil] at inFinal
                  rcases inFinal with rfl | impossible
                  · exact ordinaryCell_cell00
                  · contradiction
          have safe :
              ∀ symbol,
                symbol ∈
                    failurePrefix ++
                      cell10 :: failureSuffix →
                  cleanupSafeCell symbol := by
            intro symbol member
            simp only [List.mem_append,
              List.mem_cons] at member
            rcases member with
                inPrefix | atHead | inFailureSuffix
            · exact ordinaryCell_cleanupSafe
                (failurePrefixOrdinary symbol inPrefix)
            · subst symbol
              exact ordinaryCell_cleanupSafe
                ordinaryCell_cell10
            · have normalized :
                  symbol ∈
                    (between ++ [cell00, cursorMark]) ++
                      indexTail := by
                simpa [failureSuffix,
                  List.append_assoc] using inFailureSuffix
              rcases List.mem_append.mp normalized with
                  inLeading | inTail
              · rcases List.mem_append.mp inLeading with
                  inBetween | inMarkers
                · exact ordinaryCell_cleanupSafe
                    (betweenOrdinary symbol inBetween)
                · simp only [List.mem_cons,
                    List.not_mem_nil] at inMarkers
                  rcases inMarkers with
                      rfl | rfl | impossible
                  · exact ordinaryCell_cleanupSafe
                      ordinaryCell_cell00
                  · exact cursorMark_cleanupSafe
                  · contradiction
              · exact ordinaryCell_cleanupSafe
                  (malformedNatTailCells_allOrdinary
                    units token suffix symbol
                    (by
                      simpa [indexTail] using inTail))
          have cleanup :=
            safeGuardedCleanup_exact
              failurePrefix cell10 failureSuffix safe
          have all :=
            exactRun_add
              (inputReferenceExhaustedSteps used between)
              (guardedCleanupSteps scan failureSuffix)
              _ _ _ exhausted cleanup
          refine ⟨final, ?_, rfl, ?_⟩
          · simpa [inputWrongReferenceSteps,
              indexTail, failurePrefix, failureSuffix,
              scan, final, malformedNatTailCells,
              unaryUnitCells] using all
          · exact cleanupRejectConfiguration_output_empty
              [] scan failureSuffix
      | succ remaining =>
          let indexTail :=
            malformedNatTailCells units token suffix
          have first :=
            inputReferenceConsumeUnitTail_exact
              continuation used remaining between
              indexTail betweenOrdinary
          have nextBetweenOrdinary :
              ∀ symbol,
                symbol ∈ between ++ [cell00, cell01] →
                  ordinaryCell symbol := by
            apply ordinaryCells_append
            · exact betweenOrdinary
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | rfl | impossible
              · exact ordinaryCell_cell00
              · exact ordinaryCell_cell01
              · contradiction
          rcases ih (used + 1) remaining
              (between ++ [cell00, cell01])
              nextBetweenOrdinary with
            ⟨final, tail, finalState, output⟩
          have all :=
            exactRun_add
              (inputReferenceConsumeUnitSteps
                used remaining between)
              (inputWrongReferenceSteps
                (used + 1) remaining
                (between ++ [cell00, cell01])
                units token suffix)
              _ _ _ first tail
          refine ⟨final, ?_, finalState, output⟩
          simpa [inputWrongReferenceSteps,
            indexTail, malformedNatTailCells,
            unaryUnitCells] using all

private def gateWrongReferenceSteps
    (header : List WorkSymbol)
    (borrowed available : List RawGate)
    (between : List WorkSymbol)
    (units : Nat) (token : Token)
    (suffix : List Token) : Nat :=
  match units with
  | 0 =>
      referenceWrongTokenSteps
        (header ++ borrowedGateListCells borrowed ++
          markedGateListCells available ++ between)
        token (packedTokenCells suffix)
  | units + 1 =>
      match available with
      | [] =>
          let failurePrefix :=
            (header ++ borrowedGateListCells borrowed ++
              between) ++ [cell00]
          let indexTail :=
            malformedNatTailCells units token suffix
          gateReferenceExhaustedSteps
              header borrowed between +
            guardedCleanupSteps
              (cursorMark ::
                pushCrossed failurePrefix [])
              indexTail
      | gate :: rest =>
          gateReferenceConsumeUnitSteps
              header borrowed gate rest between +
            gateWrongReferenceSteps
              header (borrowed ++ [gate]) rest
              (between ++ [cell00, cell01])
              units token suffix

private theorem gateWrongReference_exact
    (continuation : SourceContinuation)
    (header : List WorkSymbol)
    (borrowed available : List RawGate)
    (between : List WorkSymbol) (units : Nat)
    (token : Token) (suffix : List Token)
    (headerOrdinary :
      ∀ symbol, symbol ∈ header →
        ordinaryCell symbol)
    (headerNoGateMark :
      ∀ symbol, symbol ∈ header →
        symbol ≠ gateMark)
    (betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol)
    (betweenNoGateMark :
      ∀ symbol, symbol ∈ between →
        symbol ≠ gateMark)
    (notUnit : token ≠ .unit)
    (notNatEnd : token ≠ .natEnd) :
    ∃ final,
      workRunExact? machine
          (gateWrongReferenceSteps
            header borrowed available between
            units token suffix)
          (guardedConfig
            (State.indexFirst .priorGate continuation)
            (header ++ borrowedGateListCells borrowed ++
              markedGateListCells available ++ between)
            (malformedNatTailCells
              units token suffix)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  induction units generalizing borrowed available between with
  | zero =>
      let parsedPrefix :=
        header ++ borrowedGateListCells borrowed ++
          markedGateListCells available ++ between
      have parsedOrdinary :
          ∀ symbol, symbol ∈ parsedPrefix →
            ordinaryCell symbol := by
        dsimp [parsedPrefix]
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact headerOrdinary
            · exact borrowedGateListCells_allOrdinary
                borrowed
          · exact markedGateListCells_allOrdinary
              available
        · exact betweenOrdinary
      have run :=
        referenceWrongTokenCost_exact
          .priorGate continuation parsedPrefix
          parsedOrdinary token suffix
          notUnit notNatEnd
      simpa [gateWrongReferenceSteps,
        malformedNatTailCells, parsedPrefix,
        unaryUnitCells, packedTokenCells,
        List.append_assoc] using run
  | succ units ih =>
      cases available with
      | nil =>
          let indexTail :=
            malformedNatTailCells units token suffix
          let failurePrefix :=
            (header ++ borrowedGateListCells borrowed ++
              between) ++ [cell00]
          let scan :=
            cursorMark :: pushCrossed failurePrefix []
          let final :=
            cleanupRejectConfiguration
              [] scan indexTail []
          have exhausted :=
            gateReferenceConsumeExhaustedTail_exact
              continuation header borrowed between
              indexTail headerOrdinary headerNoGateMark
              betweenOrdinary betweenNoGateMark
          have failurePrefixOrdinary :
              ∀ symbol, symbol ∈ failurePrefix →
                ordinaryCell symbol := by
            dsimp [failurePrefix]
            apply ordinaryCells_append
            · apply ordinaryCells_append
              · apply ordinaryCells_append
                · exact headerOrdinary
                · exact borrowedGateListCells_allOrdinary
                    borrowed
              · exact betweenOrdinary
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | impossible
              · exact ordinaryCell_cell00
              · contradiction
          have safe :
              ∀ symbol,
                symbol ∈
                    failurePrefix ++
                      cursorMark :: indexTail →
                  cleanupSafeCell symbol := by
            intro symbol member
            simp only [List.mem_append,
              List.mem_cons] at member
            rcases member with
                inPrefix | atCursor | inTail
            · exact ordinaryCell_cleanupSafe
                (failurePrefixOrdinary symbol inPrefix)
            · subst symbol
              exact cursorMark_cleanupSafe
            · exact ordinaryCell_cleanupSafe
                (malformedNatTailCells_allOrdinary
                  units token suffix symbol
                  (by
                    simpa [indexTail] using inTail))
          have cleanup :=
            safeGuardedCleanup_exact
              failurePrefix cursorMark indexTail safe
          have all :=
            exactRun_add
              (gateReferenceExhaustedSteps
                header borrowed between)
              (guardedCleanupSteps scan indexTail)
              _ _ _ exhausted cleanup
          refine ⟨final, ?_, rfl, ?_⟩
          · simpa [gateWrongReferenceSteps,
              indexTail, failurePrefix, scan, final,
              malformedNatTailCells, unaryUnitCells,
              markedGateListCells] using all
          · exact cleanupRejectConfiguration_output_empty
              [] scan indexTail
      | cons gate available =>
          let indexTail :=
            malformedNatTailCells units token suffix
          have first :=
            gateReferenceConsumeUnitTail_exact
              continuation header borrowed gate available
              between indexTail headerOrdinary
              headerNoGateMark betweenOrdinary
          have nextBetweenOrdinary :
              ∀ symbol,
                symbol ∈ between ++ [cell00, cell01] →
                  ordinaryCell symbol := by
            apply ordinaryCells_append
            · exact betweenOrdinary
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | rfl | impossible
              · exact ordinaryCell_cell00
              · exact ordinaryCell_cell01
              · contradiction
          have nextBetweenNoGateMark :
              ∀ symbol,
                symbol ∈ between ++ [cell00, cell01] →
                  symbol ≠ gateMark := by
            intro symbol member
            simp only [List.mem_append] at member
            rcases member with inBetween | inUnit
            · exact betweenNoGateMark symbol inBetween
            · simp only [List.mem_cons,
                List.not_mem_nil] at inUnit
              rcases inUnit with rfl | rfl | impossible
              · decide
              · decide
              · contradiction
          rcases ih (borrowed ++ [gate]) available
              (between ++ [cell00, cell01])
              nextBetweenOrdinary nextBetweenNoGateMark with
            ⟨final, tail, finalState, output⟩
          have all :=
            exactRun_add
              (gateReferenceConsumeUnitSteps
                header borrowed gate available between)
              (gateWrongReferenceSteps
                header (borrowed ++ [gate]) available
                (between ++ [cell00, cell01])
                units token suffix)
              _ _ _ first tail
          refine ⟨final, ?_, finalState, output⟩
          simpa [gateWrongReferenceSteps,
            indexTail, malformedNatTailCells,
            unaryUnitCells] using all

/-! ### Cost-transparent malformed source heads -/

private def sourceWrongTokenSteps
    (parsedPrefix : List WorkSymbol)
    (token : Token) (suffixCells : List WorkSymbol) :
    Nat :=
  match token with
  | .version0 =>
      2 + guardedCleanupSteps
        (cell00 ::
          pushCrossed (parsedPrefix ++ [cell00]) [])
        suffixCells
  | .unit =>
      2 + guardedCleanupSteps
        (cell01 ::
          pushCrossed (parsedPrefix ++ [cell00]) [])
        suffixCells
  | .natEnd =>
      2 + guardedCleanupSteps
        (cell10 ::
          pushCrossed (parsedPrefix ++ [cell00]) [])
        suffixCells
  | .input => 0
  | .constantFalse => 0
  | .constantTrue => 0
  | .gate => 0
  | .gateEnd =>
      2 + guardedCleanupSteps
        (cell11 ::
          pushCrossed (parsedPrefix ++ [cell01]) [])
        suffixCells
  | .programEnd =>
      1 + guardedCleanupSteps
        (cell10 :: pushCrossed parsedPrefix [])
        (cell00 :: suffixCells)
  | .outputsEnd =>
      1 + guardedCleanupSteps
        (cell10 :: pushCrossed parsedPrefix [])
        (cell01 :: suffixCells)
  | .threshold =>
      1 + guardedCleanupSteps
        (cell10 :: pushCrossed parsedPrefix [])
        (cell10 :: suffixCells)
  | .instanceEnd =>
      1 + guardedCleanupSteps
        (cell10 :: pushCrossed parsedPrefix [])
        (cell11 :: suffixCells)

private theorem sourceWrongTokenCost_exact
    (continuation : SourceContinuation)
    (parsedPrefix : List WorkSymbol)
    (parsedOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol)
    (token : Token) (suffix : List Token)
    (notInput : token ≠ .input)
    (notFalse : token ≠ .constantFalse)
    (notTrue : token ≠ .constantTrue)
    (notGate : token ≠ .gate) :
    ∃ final,
      workRunExact? machine
          (sourceWrongTokenSteps
            parsedPrefix token
            (packedTokenCells suffix))
          (guardedConfig
            (State.sourceStart continuation)
            parsedPrefix
            (packedTokenCells (token :: suffix))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let suffixCells := packedTokenCells suffix
  let initial :=
    guardedConfig
      (State.sourceStart continuation)
      parsedPrefix (packedTokenCells (token :: suffix))
  have fullOrdinary :
      ∀ symbol,
        symbol ∈
            parsedPrefix ++
              packedTokenCells (token :: suffix) →
          ordinaryCell symbol := by
    intro symbol member
    simp only [List.mem_append] at member
    rcases member with inPrefix | inTokens
    · exact parsedOrdinary symbol inPrefix
    · exact packedTokenCells_ordinary
        (token :: suffix) symbol inTokens
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq : tokenCells token = [current, next])
      (not00Cell : current ≠ cell00)
      (not01Cell : current ≠ cell01) :
      ∃ final,
        workRunExact? machine
            (1 + guardedCleanupSteps
              (current :: pushCrossed parsedPrefix [])
              (next :: suffixCells))
            initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    let scan := current :: pushCrossed parsedPrefix []
    let final :=
      cleanupRejectConfiguration
        [] scan (next :: suffixCells) []
    have failed :=
      sourceStartFirstFailure_exact
        continuation parsedPrefix current
        (next :: suffixCells)
        not00Cell not01Cell
    have launch :
        workRunExact? machine 1 initial =
          some
            (cleanupSeekConfiguration
              [] scan (next :: suffixCells)) := by
      simpa [initial, suffixCells, scan,
        packedTokenCells, cellsEq] using failed
    have ordinary :
        ∀ symbol,
          symbol ∈
              parsedPrefix ++
                current :: next :: suffixCells →
            ordinaryCell symbol := by
      intro symbol member
      apply fullOrdinary symbol
      simpa [suffixCells, packedTokenCells,
        cellsEq] using member
    have run :=
      ordinaryExplicitFailureRun_exact
        parsedPrefix current (next :: suffixCells)
        initial 1 ordinary launch
    refine ⟨final, ?_, rfl, ?_⟩
    · simpa [scan, final] using run
    · exact cleanupRejectConfiguration_output_empty
        [] scan (next :: suffixCells)
  have rejectAfter00
      (current : WorkSymbol)
      (cellsEq : tokenCells token = [cell00, current])
      (not11Cell : current ≠ cell11) :
      ∃ final,
        workRunExact? machine
            (2 + guardedCleanupSteps
              (current ::
                pushCrossed (parsedPrefix ++ [cell00]) [])
              suffixCells)
            initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    let scan :=
      current ::
        pushCrossed (parsedPrefix ++ [cell00]) []
    let final :=
      cleanupRejectConfiguration [] scan suffixCells []
    have failed :=
      sourceAfter00Failure_exact
        continuation parsedPrefix current
        suffixCells not11Cell
    have launch :
        workRunExact? machine 2 initial =
          some
            (cleanupSeekConfiguration
              [] scan suffixCells) := by
      simpa [initial, suffixCells, scan,
        packedTokenCells, cellsEq] using failed
    have ordinary :
        ∀ symbol,
          symbol ∈
              (parsedPrefix ++ [cell00]) ++
                current :: suffixCells →
            ordinaryCell symbol := by
      intro symbol member
      apply fullOrdinary symbol
      simpa [suffixCells, packedTokenCells,
        cellsEq, List.append_assoc] using member
    have run :=
      ordinaryExplicitFailureRun_exact
        (parsedPrefix ++ [cell00]) current suffixCells
        initial 2 ordinary launch
    refine ⟨final, ?_, rfl, ?_⟩
    · simpa [scan, final] using run
    · exact cleanupRejectConfiguration_output_empty
        [] scan suffixCells
  have rejectAfter01
      (current : WorkSymbol)
      (cellsEq : tokenCells token = [cell01, current])
      (not00Cell : current ≠ cell00)
      (not01Cell : current ≠ cell01)
      (not10Cell : current ≠ cell10) :
      ∃ final,
        workRunExact? machine
            (2 + guardedCleanupSteps
              (current ::
                pushCrossed (parsedPrefix ++ [cell01]) [])
              suffixCells)
            initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    let scan :=
      current ::
        pushCrossed (parsedPrefix ++ [cell01]) []
    let final :=
      cleanupRejectConfiguration [] scan suffixCells []
    have failed :=
      sourceAfter01Failure_exact
        continuation parsedPrefix current
        suffixCells not00Cell not01Cell not10Cell
    have launch :
        workRunExact? machine 2 initial =
          some
            (cleanupSeekConfiguration
              [] scan suffixCells) := by
      simpa [initial, suffixCells, scan,
        packedTokenCells, cellsEq] using failed
    have ordinary :
        ∀ symbol,
          symbol ∈
              (parsedPrefix ++ [cell01]) ++
                current :: suffixCells →
            ordinaryCell symbol := by
      intro symbol member
      apply fullOrdinary symbol
      simpa [suffixCells, packedTokenCells,
        cellsEq, List.append_assoc] using member
    have run :=
      ordinaryExplicitFailureRun_exact
        (parsedPrefix ++ [cell01]) current suffixCells
        initial 2 ordinary launch
    refine ⟨final, ?_, rfl, ?_⟩
    · simpa [scan, final] using run
    · exact cleanupRejectConfiguration_output_empty
        [] scan suffixCells
  cases token with
  | version0 =>
      simpa [sourceWrongTokenSteps,
        initial, suffixCells] using
        (rejectAfter00 cell00 rfl (by decide))
  | unit =>
      simpa [sourceWrongTokenSteps,
        initial, suffixCells] using
        (rejectAfter00 cell01 rfl (by decide))
  | natEnd =>
      simpa [sourceWrongTokenSteps,
        initial, suffixCells] using
        (rejectAfter00 cell10 rfl (by decide))
  | input =>
      exact False.elim (notInput rfl)
  | constantFalse =>
      exact False.elim (notFalse rfl)
  | constantTrue =>
      exact False.elim (notTrue rfl)
  | gate =>
      exact False.elim (notGate rfl)
  | gateEnd =>
      simpa [sourceWrongTokenSteps,
        initial, suffixCells] using
        (rejectAfter01 cell11 rfl
          (by decide) (by decide) (by decide))
  | programEnd =>
      simpa [sourceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell10 cell00 rfl
          (by decide) (by decide))
  | outputsEnd =>
      simpa [sourceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell10 cell01 rfl
          (by decide) (by decide))
  | threshold =>
      simpa [sourceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell10 cell10 rfl
          (by decide) (by decide))
  | instanceEnd =>
      simpa [sourceWrongTokenSteps,
        initial, suffixCells] using
        (rejectFirst cell10 cell11 rfl
          (by decide) (by decide))

/-! ### Exact malformed source suffixes in canonical parser contexts -/

private theorem countCells_no_gateMark
    (used remaining : Nat) :
    ∀ symbol, symbol ∈ countCells used remaining →
      symbol ≠ gateMark := by
  induction used with
  | zero =>
      exact natCells_no_gateMark remaining
  | succ used ih =>
      intro symbol member
      simp only [countCells, List.mem_cons] at member
      rcases member with rfl | rfl | inRest
      · decide
      · decide
      · exact ih symbol inRest

private theorem gateReferenceHeader_allOrdinary
    (inputs gateCountUsed gateCountRemaining : Nat) :
    ∀ symbol,
      symbol ∈
          gateReferenceHeader
            inputs gateCountUsed gateCountRemaining →
        ordinaryCell symbol := by
  unfold gateReferenceHeader
  apply ordinaryCells_append
  · apply ordinaryCells_append
    · intro symbol member
      simp only [List.mem_cons,
        List.not_mem_nil] at member
      rcases member with rfl | rfl | impossible
      · exact ordinaryCell_cell00
      · exact ordinaryCell_cell00
      · contradiction
    · exact natCells_allOrdinary inputs
  · exact countCells_allOrdinary
      gateCountUsed gateCountRemaining

private theorem gateReferenceHeader_no_gateMark
    (inputs gateCountUsed gateCountRemaining : Nat) :
    ∀ symbol,
      symbol ∈
          gateReferenceHeader
            inputs gateCountUsed gateCountRemaining →
        symbol ≠ gateMark := by
  intro symbol member
  unfold gateReferenceHeader at member
  rcases List.mem_append.mp member with
      inLeading | inCount
  · rcases List.mem_append.mp inLeading with
        inVersion | inInputs
    · simp only [List.mem_cons,
        List.not_mem_nil] at inVersion
      rcases inVersion with rfl | rfl | impossible
      · decide
      · decide
      · contradiction
    · exact natCells_no_gateMark
        inputs symbol inInputs
  · exact countCells_no_gateMark
      gateCountUsed gateCountRemaining
      symbol inCount

private theorem sourceContextPrefix_allOrdinary
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol) :
    ∀ symbol,
      symbol ∈
          sourceContextPrefix
            inputs gateCountUsed gateCountRemaining
            priorGates before →
        ordinaryCell symbol := by
  unfold sourceContextPrefix
  apply ordinaryCells_append
  · apply ordinaryCells_append
    · exact gateReferenceHeader_allOrdinary
        inputs gateCountUsed gateCountRemaining
    · exact markedGateListCells_allOrdinary
        priorGates
  · exact beforeOrdinary

private def inputSourceFailureBetween
    (gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol) :
    List WorkSymbol :=
  countCells gateCountUsed gateCountRemaining ++
    markedGateListCells priorGates ++ before ++
    [cell00, cell11]

private def gateSourceFailureBetween
    (before : List WorkSymbol) :
    List WorkSymbol :=
  before ++ [cell01, cell10]

private theorem sourceTokenFailure_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    {tokens : List Token}
    (failure : SourceTokenFailure tokens)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (beforeNoGateMark :
      ∀ symbol, symbol ∈ before →
        symbol ≠ gateMark) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    ∃ steps final,
      workRunExact? machine
          steps
          (guardedConfig
            (State.sourceStart continuation)
            context (packedTokenCells tokens)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  have contextOrdinary :
      ∀ symbol, symbol ∈ context →
        ordinaryCell symbol := by
    exact sourceContextPrefix_allOrdinary
      inputs gateCountUsed gateCountRemaining
      priorGates before beforeOrdinary
  cases failure with
  | missing =>
      let crossed := pushCrossed context []
      let final :=
        cleanupExplicitRejectConfiguration
          [] (missingEndEraseWord crossed) []
      have run :=
        sourceMissingToken_exact
          continuation context contextOrdinary
      refine
        ⟨missingEndTailSteps crossed, final, ?_, rfl, ?_⟩
      · simpa [context, crossed, final,
          packedTokenCells] using run
      · rfl
  | wrongHead token suffix
      notInput notFalse notTrue notGate =>
      have run :=
        sourceWrongTokenCost_exact
          continuation context contextOrdinary
          token suffix notInput notFalse notTrue notGate
      rcases run with
        ⟨final, trace, finalState, output⟩
      exact
        ⟨sourceWrongTokenSteps context token
            (packedTokenCells suffix),
          final, trace, finalState, output⟩
  | inputIndex failure =>
      let between :=
        inputSourceFailureBetween
          gateCountUsed gateCountRemaining
          priorGates before
      have betweenOrdinary :
          ∀ symbol, symbol ∈ between →
            ordinaryCell symbol := by
        unfold between inputSourceFailureBetween
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact countCells_allOrdinary
                gateCountUsed gateCountRemaining
            · exact markedGateListCells_allOrdinary
                priorGates
          · exact beforeOrdinary
        · intro symbol member
          simp only [List.mem_cons,
            List.not_mem_nil] at member
          rcases member with rfl | rfl | impossible
          · exact ordinaryCell_cell00
          · exact ordinaryCell_cell11
          · contradiction
      cases failure with
      | missingEnd units =>
          let indexTail := unaryUnitCells units
          have launch :=
            sourceInputTag_exact
              continuation context indexTail
          have launchCanonical :
              workRunExact? machine 2
                  (guardedConfig
                    (State.sourceStart continuation)
                    context
                    (packedTokenCells
                      (.input ::
                        List.replicate units .unit))) =
                some
                  (guardedConfig
                    (State.indexFirst .input continuation)
                    (context ++ [cell00, cell11])
                    indexTail) := by
            simpa [indexTail, packedTokenCells,
              tokenCells,
              packedTokenCells_replicate_unit] using launch
          rcases
              inputMissingReference_exact
                continuation 0 inputs units between
                betweenOrdinary with
            ⟨final, tail, finalState, output⟩
          have tailCanonical :
              workRunExact? machine
                  (inputMissingReferenceSteps
                    0 inputs between units)
                  (guardedConfig
                    (State.indexFirst .input continuation)
                    (context ++ [cell00, cell11])
                    indexTail) =
                some final := by
            simpa [context, sourceContextPrefix,
              gateReferenceHeader, between,
              inputSourceFailureBetween,
              countCells, indexTail,
              List.append_assoc] using tail
          have all :=
            exactRun_add 2
              (inputMissingReferenceSteps
                0 inputs between units)
              _ _ _ launchCanonical tailCanonical
          refine
            ⟨2 + inputMissingReferenceSteps
                0 inputs between units,
              final, ?_, finalState, output⟩
          simpa [between, context] using all
      | wrongToken units token suffix
          notUnit notNatEnd =>
          let indexTail :=
            malformedNatTailCells units token suffix
          have packedEq :
              packedTokenCells
                  (List.replicate units .unit ++
                    token :: suffix) =
                indexTail := by
            rw [packedTokenCells_append,
              packedTokenCells_replicate_unit]
            simp [indexTail, malformedNatTailCells,
              packedTokenCells, tokenCells]
          have launch :=
            sourceInputTag_exact
              continuation context indexTail
          have launchCanonical :
              workRunExact? machine 2
                  (guardedConfig
                    (State.sourceStart continuation)
                    context
                    (packedTokenCells
                      (.input ::
                        (List.replicate units .unit ++
                          token :: suffix)))) =
                some
                  (guardedConfig
                    (State.indexFirst .input continuation)
                    (context ++ [cell00, cell11])
                    indexTail) := by
            simpa [packedTokenCells, tokenCells,
              packedEq] using launch
          rcases
              inputWrongReference_exact
                continuation 0 inputs units between
                token suffix betweenOrdinary
                notUnit notNatEnd with
            ⟨final, tail, finalState, output⟩
          have tailCanonical :
              workRunExact? machine
                  (inputWrongReferenceSteps
                    0 inputs between units token suffix)
                  (guardedConfig
                    (State.indexFirst .input continuation)
                    (context ++ [cell00, cell11])
                    indexTail) =
                some final := by
            simpa [context, sourceContextPrefix,
              gateReferenceHeader, between,
              inputSourceFailureBetween,
              countCells, indexTail,
              List.append_assoc] using tail
          have all :=
            exactRun_add 2
              (inputWrongReferenceSteps
                0 inputs between units token suffix)
              _ _ _ launchCanonical tailCanonical
          refine
            ⟨2 + inputWrongReferenceSteps
                0 inputs between units token suffix,
              final, ?_, finalState, output⟩
          simpa [between, context] using all
  | gateIndex failure =>
      let header :=
        gateReferenceHeader
          inputs gateCountUsed gateCountRemaining
      let between := gateSourceFailureBetween before
      have headerOrdinary :
          ∀ symbol, symbol ∈ header →
            ordinaryCell symbol := by
        exact gateReferenceHeader_allOrdinary
          inputs gateCountUsed gateCountRemaining
      have headerNoGateMark :
          ∀ symbol, symbol ∈ header →
            symbol ≠ gateMark := by
        exact gateReferenceHeader_no_gateMark
          inputs gateCountUsed gateCountRemaining
      have betweenOrdinary :
          ∀ symbol, symbol ∈ between →
            ordinaryCell symbol := by
        unfold between gateSourceFailureBetween
        apply ordinaryCells_append
        · exact beforeOrdinary
        · intro symbol member
          simp only [List.mem_cons,
            List.not_mem_nil] at member
          rcases member with rfl | rfl | impossible
          · exact ordinaryCell_cell01
          · exact ordinaryCell_cell10
          · contradiction
      have betweenNoGateMark :
          ∀ symbol, symbol ∈ between →
            symbol ≠ gateMark := by
        intro symbol member
        unfold between gateSourceFailureBetween at member
        rcases List.mem_append.mp member with
            inBefore | inTag
        · exact beforeNoGateMark symbol inBefore
        · simp only [List.mem_cons,
            List.not_mem_nil] at inTag
          rcases inTag with rfl | rfl | impossible
          · decide
          · decide
          · contradiction
      cases failure with
      | missingEnd units =>
          let indexTail := unaryUnitCells units
          have launch :=
            sourceGateTag_exact
              continuation context indexTail
          have launchCanonical :
              workRunExact? machine 2
                  (guardedConfig
                    (State.sourceStart continuation)
                    context
                    (packedTokenCells
                      (.gate ::
                        List.replicate units .unit))) =
                some
                  (guardedConfig
                    (State.indexFirst
                      .priorGate continuation)
                    (context ++ [cell01, cell10])
                    indexTail) := by
            simpa [indexTail, packedTokenCells,
              tokenCells,
              packedTokenCells_replicate_unit] using launch
          rcases
              gateMissingReference_exact
                continuation header [] priorGates
                between units headerOrdinary
                headerNoGateMark betweenOrdinary
                betweenNoGateMark with
            ⟨final, tail, finalState, output⟩
          have tailCanonical :
              workRunExact? machine
                  (gateMissingReferenceSteps
                    header [] priorGates between units)
                  (guardedConfig
                    (State.indexFirst
                      .priorGate continuation)
                    (context ++ [cell01, cell10])
                    indexTail) =
                some final := by
            simpa [context, sourceContextPrefix,
              header, between,
              gateSourceFailureBetween,
              borrowedGateListCells,
              indexTail, List.append_assoc] using tail
          have all :=
            exactRun_add 2
              (gateMissingReferenceSteps
                header [] priorGates between units)
              _ _ _ launchCanonical tailCanonical
          refine
            ⟨2 + gateMissingReferenceSteps
                header [] priorGates between units,
              final, ?_, finalState, output⟩
          simpa [header, between, context] using all
      | wrongToken units token suffix
          notUnit notNatEnd =>
          let indexTail :=
            malformedNatTailCells units token suffix
          have packedEq :
              packedTokenCells
                  (List.replicate units .unit ++
                    token :: suffix) =
                indexTail := by
            rw [packedTokenCells_append,
              packedTokenCells_replicate_unit]
            simp [indexTail, malformedNatTailCells,
              packedTokenCells, tokenCells]
          have launch :=
            sourceGateTag_exact
              continuation context indexTail
          have launchCanonical :
              workRunExact? machine 2
                  (guardedConfig
                    (State.sourceStart continuation)
                    context
                    (packedTokenCells
                      (.gate ::
                        (List.replicate units .unit ++
                          token :: suffix)))) =
                some
                  (guardedConfig
                    (State.indexFirst
                      .priorGate continuation)
                    (context ++ [cell01, cell10])
                    indexTail) := by
            simpa [packedTokenCells, tokenCells,
              packedEq] using launch
          rcases
              gateWrongReference_exact
                continuation header [] priorGates
                between units token suffix
                headerOrdinary headerNoGateMark
                betweenOrdinary betweenNoGateMark
                notUnit notNatEnd with
            ⟨final, tail, finalState, output⟩
          have tailCanonical :
              workRunExact? machine
                  (gateWrongReferenceSteps
                    header [] priorGates between
                    units token suffix)
                  (guardedConfig
                    (State.indexFirst
                      .priorGate continuation)
                    (context ++ [cell01, cell10])
                    indexTail) =
                some final := by
            simpa [context, sourceContextPrefix,
              header, between,
              gateSourceFailureBetween,
              borrowedGateListCells,
              indexTail, List.append_assoc] using tail
          have all :=
            exactRun_add 2
              (gateWrongReferenceSteps
                header [] priorGates between
                units token suffix)
              _ _ _ launchCanonical tailCanonical
          refine
            ⟨2 + gateWrongReferenceSteps
                header [] priorGates between
                units token suffix,
              final, ?_, finalState, output⟩
          simpa [header, between, context] using all

/-! ### Cost-visible decoded input-reference bound failures -/

private def inputBoundFailurePrefix
    (used : Nat) : List WorkSymbol :=
  [cell00, cell00] ++
    borrowedCountCells used ++ [cell00]

private def inputBoundFailureSuffix
    (between tail : List WorkSymbol) :
    List WorkSymbol :=
  between ++ [cell00, cursorMark] ++ tail

private def inputBoundFailureCleanupSteps
    (used : Nat) (between tail : List WorkSymbol) :
    Nat :=
  guardedCleanupSteps
    (cell10 ::
      pushCrossed (inputBoundFailurePrefix used) [])
    (inputBoundFailureSuffix between tail)

private theorem inputBoundFailureCleanup_exact
    (used : Nat) (between tail : List WorkSymbol)
    (betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol)
    (tailOrdinary :
      ∀ symbol, symbol ∈ tail →
        ordinaryCell symbol) :
    let failurePrefix := inputBoundFailurePrefix used
    let failureSuffix :=
      inputBoundFailureSuffix between tail
    let scan :=
      cell10 :: pushCrossed failurePrefix []
    workRunExact? machine
        (inputBoundFailureCleanupSteps
          used between tail)
        (inputReferenceCleanupConfiguration
          failurePrefix failureSuffix) =
      some
        (cleanupRejectConfiguration
          [] scan failureSuffix []) := by
  dsimp only
  let failurePrefix := inputBoundFailurePrefix used
  let failureSuffix :=
    inputBoundFailureSuffix between tail
  let scan :=
    cell10 :: pushCrossed failurePrefix []
  have failurePrefixOrdinary :
      ∀ symbol, symbol ∈ failurePrefix →
        ordinaryCell symbol := by
    intro symbol member
    have normalized :
        symbol ∈
          ([cell00, cell00] ++
            borrowedCountCells used) ++ [cell00] := by
      simpa [failurePrefix,
        inputBoundFailurePrefix] using member
    rcases List.mem_append.mp normalized with
        inLeading | inFinal
    · rcases List.mem_append.mp inLeading with
        inHeader | inBorrowed
      · simp only [List.mem_cons,
          List.not_mem_nil] at inHeader
        rcases inHeader with rfl | rfl | impossible
        · exact ordinaryCell_cell00
        · exact ordinaryCell_cell00
        · contradiction
      · exact borrowedCountCells_allOrdinary
          used symbol inBorrowed
    · simp only [List.mem_cons,
        List.not_mem_nil] at inFinal
      rcases inFinal with rfl | impossible
      · exact ordinaryCell_cell00
      · contradiction
  have safe :
      ∀ symbol,
        symbol ∈
            failurePrefix ++
              cell10 :: failureSuffix →
          cleanupSafeCell symbol := by
    intro symbol member
    simp only [List.mem_append,
      List.mem_cons] at member
    rcases member with
        inPrefix | atHead | inFailureSuffix
    · exact ordinaryCell_cleanupSafe
        (failurePrefixOrdinary symbol inPrefix)
    · subst symbol
      exact ordinaryCell_cleanupSafe
        ordinaryCell_cell10
    · have normalized :
          symbol ∈
            (between ++ [cell00, cursorMark]) ++
              tail := by
        simpa [failureSuffix,
          inputBoundFailureSuffix,
          List.append_assoc] using inFailureSuffix
      rcases List.mem_append.mp normalized with
          inLeading | inTail
      · rcases List.mem_append.mp inLeading with
          inBetween | inMarkers
        · exact ordinaryCell_cleanupSafe
            (betweenOrdinary symbol inBetween)
        · simp only [List.mem_cons,
            List.not_mem_nil] at inMarkers
          rcases inMarkers with
              rfl | rfl | impossible
          · exact ordinaryCell_cleanupSafe
              ordinaryCell_cell00
          · exact cursorMark_cleanupSafe
          · contradiction
      · exact ordinaryCell_cleanupSafe
          (tailOrdinary symbol inTail)
  have cleanup :=
    safeGuardedCleanup_exact
      failurePrefix cell10 failureSuffix safe
  simpa [inputBoundFailureCleanupSteps,
    scan, failurePrefix, failureSuffix,
    inputReferenceCleanupConfiguration] using cleanup

private def inputBoundFailureSteps
    (used remaining : Nat)
    (between : List WorkSymbol) :
    Nat → List WorkSymbol → Nat
  | 0, suffix =>
      match remaining with
      | 0 =>
          inputReferenceExhaustedSteps used between +
            inputBoundFailureCleanupSteps
              used between suffix
      | _ + 1 => 0
  | index + 1, suffix =>
      match remaining with
      | 0 =>
          inputReferenceExhaustedSteps used between +
            inputBoundFailureCleanupSteps
              used between (natCells index ++ suffix)
      | rest + 1 =>
          inputReferenceConsumeUnitSteps
              used rest between +
            inputBoundFailureSteps
              (used + 1) rest
              (between ++ [cell00, cell01])
              index suffix

private theorem inputBoundFailure_exact
    (continuation : SourceContinuation)
    (used remaining index : Nat)
    (between suffix : List WorkSymbol)
    (betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol)
    (suffixOrdinary :
      ∀ symbol, symbol ∈ suffix →
        ordinaryCell symbol)
    (outOfRange : remaining ≤ index) :
    ∃ final,
      workRunExact? machine
          (inputBoundFailureSteps
            used remaining between index suffix)
          (inputReferenceConfiguration
            continuation used remaining
            between index suffix) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  induction index generalizing used remaining between with
  | zero =>
      have remainingEq : remaining = 0 := by
        omega
      subst remaining
      let failurePrefix := inputBoundFailurePrefix used
      let failureSuffix :=
        inputBoundFailureSuffix between suffix
      let scan :=
        cell10 :: pushCrossed failurePrefix []
      let final :=
        cleanupRejectConfiguration
          [] scan failureSuffix []
      have exhausted :=
        inputReferenceFinishExhausted_exact
          continuation used between suffix
          betweenOrdinary
      have exhaustedCanonical :
          workRunExact? machine
              (inputReferenceExhaustedSteps used between)
              (inputReferenceConfiguration
                continuation used 0 between 0 suffix) =
            some
              (inputReferenceCleanupConfiguration
                failurePrefix failureSuffix) := by
        simpa [failurePrefix, failureSuffix,
          inputBoundFailurePrefix,
          inputBoundFailureSuffix] using exhausted
      have cleanup :=
        inputBoundFailureCleanup_exact
          used between suffix
          betweenOrdinary suffixOrdinary
      have cleanupCanonical :
          workRunExact? machine
              (inputBoundFailureCleanupSteps
                used between suffix)
              (inputReferenceCleanupConfiguration
                failurePrefix failureSuffix) =
            some final := by
        simpa [failurePrefix, failureSuffix,
          scan, final] using cleanup
      have all :=
        exactRun_add
          (inputReferenceExhaustedSteps used between)
          (inputBoundFailureCleanupSteps
            used between suffix)
          _ _ _ exhaustedCanonical cleanupCanonical
      refine ⟨final, ?_, rfl, ?_⟩
      · simpa [inputBoundFailureSteps] using all
      · exact cleanupRejectConfiguration_output_empty
          [] scan failureSuffix
  | succ index ih =>
      cases remaining with
      | zero =>
          let tail := natCells index ++ suffix
          let failurePrefix := inputBoundFailurePrefix used
          let failureSuffix :=
            inputBoundFailureSuffix between tail
          let scan :=
            cell10 :: pushCrossed failurePrefix []
          let final :=
            cleanupRejectConfiguration
              [] scan failureSuffix []
          have tailOrdinary :
              ∀ symbol, symbol ∈ tail →
                ordinaryCell symbol := by
            unfold tail
            apply ordinaryCells_append
            · exact natCells_allOrdinary index
            · exact suffixOrdinary
          have exhausted :=
            inputReferenceConsumeExhausted_exact
              continuation used index between suffix
              betweenOrdinary
          have exhaustedCanonical :
              workRunExact? machine
                  (inputReferenceExhaustedSteps used between)
                  (inputReferenceConfiguration
                    continuation used 0 between
                    (index + 1) suffix) =
                some
                  (inputReferenceCleanupConfiguration
                    failurePrefix failureSuffix) := by
            simpa [failurePrefix, failureSuffix,
              inputBoundFailurePrefix,
              inputBoundFailureSuffix, tail] using exhausted
          have cleanup :=
            inputBoundFailureCleanup_exact
              used between tail
              betweenOrdinary tailOrdinary
          have cleanupCanonical :
              workRunExact? machine
                  (inputBoundFailureCleanupSteps
                    used between tail)
                  (inputReferenceCleanupConfiguration
                    failurePrefix failureSuffix) =
                some final := by
            simpa [failurePrefix, failureSuffix,
              scan, final] using cleanup
          have all :=
            exactRun_add
              (inputReferenceExhaustedSteps used between)
              (inputBoundFailureCleanupSteps
                used between tail)
              _ _ _ exhaustedCanonical cleanupCanonical
          refine ⟨final, ?_, rfl, ?_⟩
          · simpa [inputBoundFailureSteps,
              tail] using all
          · exact cleanupRejectConfiguration_output_empty
              [] scan failureSuffix
      | succ rest =>
          have tailOutOfRange : rest ≤ index := by
            omega
          have first :=
            inputReferenceConsumeUnit_exact
              continuation used rest index
              between suffix betweenOrdinary
          have nextBetweenOrdinary :
              ∀ symbol,
                symbol ∈ between ++ [cell00, cell01] →
                  ordinaryCell symbol := by
            apply ordinaryCells_append
            · exact betweenOrdinary
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | rfl | impossible
              · exact ordinaryCell_cell00
              · exact ordinaryCell_cell01
              · contradiction
          rcases ih (used + 1) rest
              (between ++ [cell00, cell01])
              nextBetweenOrdinary tailOutOfRange with
            ⟨final, tail, finalState, output⟩
          have all :=
            exactRun_add
              (inputReferenceConsumeUnitSteps
                used rest between)
              (inputBoundFailureSteps
                (used + 1) rest
                (between ++ [cell00, cell01])
                index suffix)
              _ _ _ first tail
          refine ⟨final, ?_, finalState, output⟩
          simpa [inputBoundFailureSteps] using all

/-! ### Cost-visible decoded prior-gate-reference bound failures -/

private def gateBoundFailurePrefix
    (header : List WorkSymbol)
    (borrowed : List RawGate)
    (between : List WorkSymbol) :
    List WorkSymbol :=
  (header ++ borrowedGateListCells borrowed ++ between) ++
    [cell00]

private def gateBoundFailureCleanupSteps
    (header : List WorkSymbol)
    (borrowed : List RawGate)
    (between tail : List WorkSymbol) :
    Nat :=
  guardedCleanupSteps
    (cursorMark ::
      pushCrossed
        (gateBoundFailurePrefix
          header borrowed between) [])
    tail

private theorem gateBoundFailureCleanup_exact
    (header : List WorkSymbol)
    (borrowed : List RawGate)
    (between tail : List WorkSymbol)
    (headerOrdinary :
      ∀ symbol, symbol ∈ header →
        ordinaryCell symbol)
    (betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol)
    (tailOrdinary :
      ∀ symbol, symbol ∈ tail →
        ordinaryCell symbol) :
    let failurePrefix :=
      gateBoundFailurePrefix header borrowed between
    let scan :=
      cursorMark :: pushCrossed failurePrefix []
    workRunExact? machine
        (gateBoundFailureCleanupSteps
          header borrowed between tail)
        (guardedConfig State.cleanupSeekGuard
          failurePrefix (cursorMark :: tail)) =
      some
        (cleanupRejectConfiguration
          [] scan tail []) := by
  dsimp only
  let failurePrefix :=
    gateBoundFailurePrefix header borrowed between
  let scan :=
    cursorMark :: pushCrossed failurePrefix []
  have failurePrefixOrdinary :
      ∀ symbol, symbol ∈ failurePrefix →
        ordinaryCell symbol := by
    intro symbol member
    have normalized :
        symbol ∈
          (header ++ borrowedGateListCells borrowed ++
            between) ++ [cell00] := by
      simpa [failurePrefix,
        gateBoundFailurePrefix] using member
    rcases List.mem_append.mp normalized with
        inLeading | inFinal
    · rcases List.mem_append.mp inLeading with
        inHeaderBorrowed | inBetween
      · rcases List.mem_append.mp inHeaderBorrowed with
          inHeader | inBorrowed
        · exact headerOrdinary symbol inHeader
        · exact borrowedGateListCells_allOrdinary
            borrowed symbol inBorrowed
      · exact betweenOrdinary symbol inBetween
    · simp only [List.mem_cons,
        List.not_mem_nil] at inFinal
      rcases inFinal with rfl | impossible
      · exact ordinaryCell_cell00
      · contradiction
  have safe :
      ∀ symbol,
        symbol ∈
            failurePrefix ++ cursorMark :: tail →
          cleanupSafeCell symbol := by
    intro symbol member
    simp only [List.mem_append,
      List.mem_cons] at member
    rcases member with
        inPrefix | atCursor | inTail
    · exact ordinaryCell_cleanupSafe
        (failurePrefixOrdinary symbol inPrefix)
    · subst symbol
      exact cursorMark_cleanupSafe
    · exact ordinaryCell_cleanupSafe
        (tailOrdinary symbol inTail)
  have cleanup :=
    safeGuardedCleanup_exact
      failurePrefix cursorMark tail safe
  simpa [gateBoundFailureCleanupSteps,
    scan, failurePrefix] using cleanup

private def gateBoundFailureSteps
    (header : List WorkSymbol)
    (borrowed available : List RawGate)
    (between : List WorkSymbol) :
    Nat → List WorkSymbol → Nat
  | 0, suffix =>
      match available with
      | [] =>
          gateReferenceExhaustedSteps
              header borrowed between +
            gateBoundFailureCleanupSteps
              header borrowed between suffix
      | _ :: _ => 0
  | index + 1, suffix =>
      match available with
      | [] =>
          gateReferenceExhaustedSteps
              header borrowed between +
            gateBoundFailureCleanupSteps
              header borrowed between
              (natCells index ++ suffix)
      | gate :: rest =>
          gateReferenceConsumeUnitSteps
              header borrowed gate rest between +
            gateBoundFailureSteps
              header (borrowed ++ [gate]) rest
              (between ++ [cell00, cell01])
              index suffix

private theorem gateBoundFailure_exact
    (continuation : SourceContinuation)
    (header : List WorkSymbol)
    (borrowed available : List RawGate)
    (between : List WorkSymbol)
    (index : Nat) (suffix : List WorkSymbol)
    (headerOrdinary :
      ∀ symbol, symbol ∈ header →
        ordinaryCell symbol)
    (headerNoGateMark :
      ∀ symbol, symbol ∈ header →
        symbol ≠ gateMark)
    (betweenOrdinary :
      ∀ symbol, symbol ∈ between →
        ordinaryCell symbol)
    (betweenNoGateMark :
      ∀ symbol, symbol ∈ between →
        symbol ≠ gateMark)
    (suffixOrdinary :
      ∀ symbol, symbol ∈ suffix →
        ordinaryCell symbol)
    (outOfRange : available.length ≤ index) :
    ∃ final,
      workRunExact? machine
          (gateBoundFailureSteps
            header borrowed available between
            index suffix)
          (gateReferenceConfiguration
            continuation header borrowed available
            between index suffix) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  induction index generalizing borrowed available between with
  | zero =>
      have availableEq : available = [] := by
        cases available with
        | nil => rfl
        | cons gate rest =>
            simp only [List.length_cons] at outOfRange
            omega
      subst available
      let failurePrefix :=
        gateBoundFailurePrefix header borrowed between
      let scan :=
        cursorMark :: pushCrossed failurePrefix []
      let final :=
        cleanupRejectConfiguration
          [] scan suffix []
      have exhausted :=
        gateReferenceFinishExhausted_exact
          continuation header borrowed between suffix
          headerOrdinary headerNoGateMark
          betweenOrdinary betweenNoGateMark
      have exhaustedCanonical :
          workRunExact? machine
              (gateReferenceExhaustedSteps
                header borrowed between)
              (gateReferenceConfiguration
                continuation header borrowed []
                between 0 suffix) =
            some
              (guardedConfig State.cleanupSeekGuard
                failurePrefix (cursorMark :: suffix)) := by
        simpa [failurePrefix,
          gateBoundFailurePrefix] using exhausted
      have cleanup :=
        gateBoundFailureCleanup_exact
          header borrowed between suffix
          headerOrdinary betweenOrdinary suffixOrdinary
      have cleanupCanonical :
          workRunExact? machine
              (gateBoundFailureCleanupSteps
                header borrowed between suffix)
              (guardedConfig State.cleanupSeekGuard
                failurePrefix (cursorMark :: suffix)) =
            some final := by
        simpa [failurePrefix, scan, final] using cleanup
      have all :=
        exactRun_add
          (gateReferenceExhaustedSteps
            header borrowed between)
          (gateBoundFailureCleanupSteps
            header borrowed between suffix)
          _ _ _ exhaustedCanonical cleanupCanonical
      refine ⟨final, ?_, rfl, ?_⟩
      · simpa [gateBoundFailureSteps] using all
      · exact cleanupRejectConfiguration_output_empty
          [] scan suffix
  | succ index ih =>
      cases available with
      | nil =>
          let tail := natCells index ++ suffix
          let failurePrefix :=
            gateBoundFailurePrefix header borrowed between
          let scan :=
            cursorMark :: pushCrossed failurePrefix []
          let final :=
            cleanupRejectConfiguration
              [] scan tail []
          have tailOrdinary :
              ∀ symbol, symbol ∈ tail →
                ordinaryCell symbol := by
            unfold tail
            apply ordinaryCells_append
            · exact natCells_allOrdinary index
            · exact suffixOrdinary
          have exhausted :=
            gateReferenceConsumeExhausted_exact
              continuation header borrowed between
              index suffix headerOrdinary
              headerNoGateMark betweenOrdinary
              betweenNoGateMark
          have exhaustedCanonical :
              workRunExact? machine
                  (gateReferenceExhaustedSteps
                    header borrowed between)
                  (gateReferenceConfiguration
                    continuation header borrowed []
                    between (index + 1) suffix) =
                some
                  (guardedConfig State.cleanupSeekGuard
                    failurePrefix (cursorMark :: tail)) := by
            simpa [failurePrefix,
              gateBoundFailurePrefix, tail,
              List.append_assoc] using exhausted
          have cleanup :=
            gateBoundFailureCleanup_exact
              header borrowed between tail
              headerOrdinary betweenOrdinary tailOrdinary
          have cleanupCanonical :
              workRunExact? machine
                  (gateBoundFailureCleanupSteps
                    header borrowed between tail)
                  (guardedConfig State.cleanupSeekGuard
                    failurePrefix (cursorMark :: tail)) =
                some final := by
            simpa [failurePrefix, scan, final] using cleanup
          have all :=
            exactRun_add
              (gateReferenceExhaustedSteps
                header borrowed between)
              (gateBoundFailureCleanupSteps
                header borrowed between tail)
              _ _ _ exhaustedCanonical cleanupCanonical
          refine ⟨final, ?_, rfl, ?_⟩
          · simpa [gateBoundFailureSteps, tail] using all
          · exact cleanupRejectConfiguration_output_empty
              [] scan tail
      | cons gate rest =>
          have tailOutOfRange : rest.length ≤ index := by
            simp only [List.length_cons] at outOfRange
            omega
          have first :=
            gateReferenceConsumeUnit_exact
              continuation header borrowed gate rest
              between index suffix headerOrdinary
              headerNoGateMark betweenOrdinary
          have nextBetweenOrdinary :
              ∀ symbol,
                symbol ∈ between ++ [cell00, cell01] →
                  ordinaryCell symbol := by
            apply ordinaryCells_append
            · exact betweenOrdinary
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | rfl | impossible
              · exact ordinaryCell_cell00
              · exact ordinaryCell_cell01
              · contradiction
          have nextBetweenNoGateMark :
              ∀ symbol,
                symbol ∈ between ++ [cell00, cell01] →
                  symbol ≠ gateMark := by
            intro symbol member
            rcases List.mem_append.mp member with
                inBetween | inUnit
            · exact betweenNoGateMark symbol inBetween
            · simp only [List.mem_cons,
                List.not_mem_nil] at inUnit
              rcases inUnit with rfl | rfl | impossible
              · decide
              · decide
              · contradiction
          rcases ih (borrowed ++ [gate]) rest
              (between ++ [cell00, cell01])
              nextBetweenOrdinary nextBetweenNoGateMark
              tailOutOfRange with
            ⟨final, tail, finalState, output⟩
          have all :=
            exactRun_add
              (gateReferenceConsumeUnitSteps
                header borrowed gate rest between)
              (gateBoundFailureSteps
                header (borrowed ++ [gate]) rest
                (between ++ [cell00, cell01])
                index suffix)
              _ _ _ first tail
          refine ⟨final, ?_, finalState, output⟩
          simpa [gateBoundFailureSteps] using all

/-! ### Decoded source bound failures -/

set_option maxRecDepth 100000 in
private theorem sourceFirstRemainder_exact
    (continuation : SourceContinuation)
    (firstWas01 : Bool)
    (guardedPrefix rest : List WorkSymbol) :
    workRunExact? machine 1
        (guardedConfig (State.sourceStart continuation)
          guardedPrefix
          (firstSourceCell firstWas01 :: rest)) =
      some
        (guardedConfig
          (afterFirstSourceState firstWas01 continuation)
          (guardedPrefix ++
            [firstSourceCell firstWas01])
          rest) := by
  cases continuation <;> cases firstWas01 <;>
    unfold guardedConfig <;>
    rw [pushCrossed_append] <;> rfl

set_option maxRecDepth 100000 in
private theorem sourceInputRemainderTag_exact
    (continuation : SourceContinuation)
    (guardedPrefix rest : List WorkSymbol) :
    workRunExact? machine 1
        (guardedConfig
          (State.sourceAfter00 continuation)
          guardedPrefix (cell11 :: rest)) =
      some
        (guardedConfig
          (State.indexFirst .input continuation)
          (guardedPrefix ++ [cell11]) rest) := by
  cases continuation <;>
    unfold guardedConfig <;>
    rw [pushCrossed_append] <;> rfl

set_option maxRecDepth 100000 in
private theorem sourceGateRemainderTag_exact
    (continuation : SourceContinuation)
    (guardedPrefix rest : List WorkSymbol) :
    workRunExact? machine 1
        (guardedConfig
          (State.sourceAfter01 continuation)
          guardedPrefix (cell10 :: rest)) =
      some
        (guardedConfig
          (State.indexFirst .priorGate continuation)
          (guardedPrefix ++ [cell10]) rest) := by
  cases continuation <;>
    unfold guardedConfig <;>
    rw [pushCrossed_append] <;> rfl

private def sourceFailureSpan
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    (source : RawSource)
    (suffix : List WorkSymbol) : Nat :=
  sourceSpan inputs gateCountUsed gateCountRemaining
      priorGates before source +
    suffix.length

private theorem sourceBoundFailureRemainder_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    (source : RawSource) (suffix : List WorkSymbol)
    (failure :
      SourceBoundFailure
        inputs priorGates.length source)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (beforeNoGateMark :
      ∀ symbol, symbol ∈ before →
        symbol ≠ gateMark)
    (suffixOrdinary :
      ∀ symbol, symbol ∈ suffix →
        ordinaryCell symbol) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    ∃ steps final,
      workRunExact? machine steps
          (guardedConfig
            (afterFirstSourceState
              (sourceFirstWas01 source) continuation)
            (context ++
              [firstSourceCell
                (sourceFirstWas01 source)])
            (sourceRemainderCells source ++ suffix)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  cases failure with
  | input index outOfRange =>
      let between :=
        inputSourceFailureBetween
          gateCountUsed gateCountRemaining
          priorGates before
      have betweenOrdinary :
          ∀ symbol, symbol ∈ between →
            ordinaryCell symbol := by
        unfold between inputSourceFailureBetween
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact countCells_allOrdinary
                gateCountUsed gateCountRemaining
            · exact markedGateListCells_allOrdinary
                priorGates
          · exact beforeOrdinary
        · intro symbol member
          simp only [List.mem_cons,
            List.not_mem_nil] at member
          rcases member with rfl | rfl | impossible
          · exact ordinaryCell_cell00
          · exact ordinaryCell_cell11
          · contradiction
      have range : inputs ≤ index := by
        omega
      have launch :=
        sourceInputRemainderTag_exact
          continuation (context ++ [cell00])
          (natCells index ++ suffix)
      have launchCanonical :
          workRunExact? machine 1
              (guardedConfig
                (afterFirstSourceState
                  (sourceFirstWas01
                    (.input index)) continuation)
                (context ++
                  [firstSourceCell
                    (sourceFirstWas01
                      (.input index))])
                (sourceRemainderCells
                    (.input index) ++ suffix)) =
            some
              (guardedConfig
                (State.indexFirst .input continuation)
                (context ++ [cell00, cell11])
                (natCells index ++ suffix)) := by
        simpa [sourceFirstWas01, firstSourceCell,
          afterFirstSourceState, sourceRemainderCells,
          List.append_assoc] using launch
      rcases
          inputBoundFailure_exact
            continuation 0 inputs index between suffix
            betweenOrdinary suffixOrdinary range with
        ⟨final, tail, finalState, output⟩
      have tailCanonical :
          workRunExact? machine
              (inputBoundFailureSteps
                0 inputs between index suffix)
              (guardedConfig
                (State.indexFirst .input continuation)
                (context ++ [cell00, cell11])
                (natCells index ++ suffix)) =
            some final := by
        simpa [inputReferenceConfiguration,
          context, sourceContextPrefix,
          gateReferenceHeader, between,
          inputSourceFailureBetween,
          countCells, List.append_assoc] using tail
      have all :=
        exactRun_add 1
          (inputBoundFailureSteps
            0 inputs between index suffix)
          _ _ _ launchCanonical tailCanonical
      exact
        ⟨1 + inputBoundFailureSteps
            0 inputs between index suffix,
          final, all, finalState, output⟩
  | gate index outOfRange =>
      let header :=
        gateReferenceHeader
          inputs gateCountUsed gateCountRemaining
      let between := gateSourceFailureBetween before
      have headerOrdinary :
          ∀ symbol, symbol ∈ header →
            ordinaryCell symbol := by
        exact gateReferenceHeader_allOrdinary
          inputs gateCountUsed gateCountRemaining
      have headerNoGateMark :
          ∀ symbol, symbol ∈ header →
            symbol ≠ gateMark := by
        exact gateReferenceHeader_no_gateMark
          inputs gateCountUsed gateCountRemaining
      have betweenOrdinary :
          ∀ symbol, symbol ∈ between →
            ordinaryCell symbol := by
        unfold between gateSourceFailureBetween
        apply ordinaryCells_append
        · exact beforeOrdinary
        · intro symbol member
          simp only [List.mem_cons,
            List.not_mem_nil] at member
          rcases member with rfl | rfl | impossible
          · exact ordinaryCell_cell01
          · exact ordinaryCell_cell10
          · contradiction
      have betweenNoGateMark :
          ∀ symbol, symbol ∈ between →
            symbol ≠ gateMark := by
        intro symbol member
        unfold between gateSourceFailureBetween at member
        rcases List.mem_append.mp member with
            inBefore | inTag
        · exact beforeNoGateMark symbol inBefore
        · simp only [List.mem_cons,
            List.not_mem_nil] at inTag
          rcases inTag with rfl | rfl | impossible
          · decide
          · decide
          · contradiction
      have range : priorGates.length ≤ index := by
        omega
      have launch :=
        sourceGateRemainderTag_exact
          continuation (context ++ [cell01])
          (natCells index ++ suffix)
      have launchCanonical :
          workRunExact? machine 1
              (guardedConfig
                (afterFirstSourceState
                  (sourceFirstWas01
                    (.gate index)) continuation)
                (context ++
                  [firstSourceCell
                    (sourceFirstWas01
                      (.gate index))])
                (sourceRemainderCells
                    (.gate index) ++ suffix)) =
            some
              (guardedConfig
                (State.indexFirst
                  .priorGate continuation)
                (context ++ [cell01, cell10])
                (natCells index ++ suffix)) := by
        simpa [sourceFirstWas01, firstSourceCell,
          afterFirstSourceState, sourceRemainderCells,
          List.append_assoc] using launch
      rcases
          gateBoundFailure_exact
            continuation header [] priorGates
            between index suffix headerOrdinary
            headerNoGateMark betweenOrdinary
            betweenNoGateMark suffixOrdinary range with
        ⟨final, tail, finalState, output⟩
      have tailCanonical :
          workRunExact? machine
              (gateBoundFailureSteps
                header [] priorGates between
                index suffix)
              (guardedConfig
                (State.indexFirst
                  .priorGate continuation)
                (context ++ [cell01, cell10])
                (natCells index ++ suffix)) =
            some final := by
        simpa [gateReferenceConfiguration,
          context, sourceContextPrefix,
          header, between,
          gateSourceFailureBetween,
          borrowedGateListCells,
          List.append_assoc] using tail
      have all :=
        exactRun_add 1
          (gateBoundFailureSteps
            header [] priorGates between
            index suffix)
          _ _ _ launchCanonical tailCanonical
      exact
        ⟨1 + gateBoundFailureSteps
            header [] priorGates between
            index suffix,
          final, all, finalState, output⟩

private theorem sourceBoundFailure_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    (source : RawSource) (suffix : List WorkSymbol)
    (failure :
      SourceBoundFailure
        inputs priorGates.length source)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (beforeNoGateMark :
      ∀ symbol, symbol ∈ before →
        symbol ≠ gateMark)
    (suffixOrdinary :
      ∀ symbol, symbol ∈ suffix →
        ordinaryCell symbol) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    ∃ steps final,
      workRunExact? machine steps
          (guardedConfig
            (State.sourceStart continuation)
            context (sourceCells source ++ suffix)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  have first :=
    sourceFirstRemainder_exact
      continuation (sourceFirstWas01 source)
      context (sourceRemainderCells source ++ suffix)
  have firstCanonical :
      workRunExact? machine 1
          (guardedConfig
            (State.sourceStart continuation)
            context (sourceCells source ++ suffix)) =
        some
          (guardedConfig
            (afterFirstSourceState
              (sourceFirstWas01 source) continuation)
            (context ++
              [firstSourceCell
                (sourceFirstWas01 source)])
            (sourceRemainderCells source ++ suffix)) := by
    cases source with
    | input index =>
        simpa [sourceCells, sourceFirstWas01,
          firstSourceCell, sourceRemainderCells,
          List.append_assoc] using first
    | constant value =>
        cases value <;>
          simpa [sourceCells, sourceFirstWas01,
            firstSourceCell, sourceRemainderCells,
            List.append_assoc] using first
    | gate index =>
        simpa [sourceCells, sourceFirstWas01,
          firstSourceCell, sourceRemainderCells,
          List.append_assoc] using first
  rcases
      sourceBoundFailureRemainder_exact
        continuation inputs gateCountUsed
        gateCountRemaining priorGates before
        source suffix failure beforeOrdinary
        beforeNoGateMark suffixOrdinary with
    ⟨steps, final, tail, finalState, output⟩
  have all :=
    exactRun_add 1 steps
      _ _ _ firstCanonical tail
  exact
    ⟨1 + steps, final, all, finalState, output⟩

/-! ### Decoded gate and gate-list bound failures -/

private theorem gateCells_allOrdinary
    (gate : RawGate) :
    ∀ symbol, symbol ∈ gateCells gate →
      ordinaryCell symbol := by
  intro symbol member
  unfold gateCells at member
  rcases List.mem_append.mp member with
      inSources | inEnd
  · rcases List.mem_append.mp inSources with
      inLeft | inRight
    · exact sourceCells_allOrdinary
        gate.left symbol inLeft
    · exact sourceCells_allOrdinary
        gate.right symbol inRight
  · simp only [List.mem_cons,
      List.not_mem_nil] at inEnd
    rcases inEnd with rfl | rfl | impossible
    · exact ordinaryCell_cell01
    · exact ordinaryCell_cell11
    · contradiction

private theorem gateListCells_allOrdinary
    (gates : List RawGate) :
    ∀ symbol, symbol ∈ gateListCells gates →
      ordinaryCell symbol := by
  induction gates with
  | nil =>
      intro symbol member
      contradiction
  | cons gate rest ih =>
      intro symbol member
      simp only [gateListCells] at member
      rcases List.mem_append.mp member with
          inGate | inRest
      · exact gateCells_allOrdinary
          gate symbol inGate
      · exact ih symbol inRest

private theorem decodedGateBoundFailure_exact
    (inputs : Nat) (done : List RawGate)
    (gate : RawGate) (todo : List RawGate)
    (after : List WorkSymbol)
    (failure :
      GateBoundFailure inputs done.length gate)
    (afterOrdinary :
      ∀ symbol, symbol ∈ after →
        ordinaryCell symbol) :
    ∃ steps final,
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (gatePrefix inputs done (gate :: todo))
            (gateCells gate ++
              gateListCells todo ++ after)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases failure with
  | left left right sourceFailure =>
      let currentGate : RawGate :=
        { left := left, right := right }
      let sourceSuffix :=
        sourceCells right ++ [cell01, cell11] ++
          gateListCells todo ++ after
      have sourceSuffixOrdinary :
          ∀ symbol, symbol ∈ sourceSuffix →
            ordinaryCell symbol := by
        unfold sourceSuffix
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact sourceCells_allOrdinary right
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with
                  rfl | rfl | impossible
              · exact ordinaryCell_cell01
              · exact ordinaryCell_cell11
              · contradiction
          · exact gateListCells_allOrdinary todo
        · exact afterOrdinary
      have launch :=
        gateLeftRemainder_exact
          inputs done currentGate todo after
      rcases
          sourceBoundFailureRemainder_exact
            .gateLeft inputs (done.length + 1)
            todo.length done [] left sourceSuffix
            sourceFailure
            (by intro symbol member; contradiction)
            (by intro symbol member; contradiction)
            sourceSuffixOrdinary with
        ⟨tailSteps, final, tail,
          finalState, output⟩
      dsimp [currentGate, sourceSuffix] at launch tail
      have tailCanonical :
          workRunExact? machine tailSteps
              (guardedConfig
                (afterFirstSourceState
                  (sourceFirstWas01 left) .gateLeft)
                (sourceContextPrefix inputs
                    (done.length + 1) todo.length
                    done [] ++
                  [firstSourceCell
                    (sourceFirstWas01 left)])
                (sourceRemainderCells left ++
                  sourceCells right ++
                  [cell01, cell11] ++
                  gateListCells todo ++ after)) =
            some final := by
        simpa only [List.append_assoc] using tail
      have all :=
        exactRun_add
          (gateSourceLaunchSteps
            inputs done currentGate todo)
          tailSteps _ _ _ launch tailCanonical
      refine
        ⟨gateSourceLaunchSteps
            inputs done currentGate todo + tailSteps,
          final, ?_, finalState, output⟩
      simpa [currentGate, sourceSuffix] using all
  | right left right leftValid sourceFailure =>
      let currentGate : RawGate :=
        { left := left, right := right }
      let leftSuffix :=
        sourceCells right ++ [cell01, cell11] ++
          gateListCells todo ++ after
      let rightSuffix :=
        [cell01, cell11] ++
          gateListCells todo ++ after
      have leftSuffixOrdinary :
          ∀ symbol, symbol ∈ leftSuffix →
            ordinaryCell symbol := by
        unfold leftSuffix
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact sourceCells_allOrdinary right
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with
                  rfl | rfl | impossible
              · exact ordinaryCell_cell01
              · exact ordinaryCell_cell11
              · contradiction
          · exact gateListCells_allOrdinary todo
        · exact afterOrdinary
      have rightSuffixOrdinary :
          ∀ symbol, symbol ∈ rightSuffix →
            ordinaryCell symbol := by
        unfold rightSuffix
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · intro symbol member
            simp only [List.mem_cons,
              List.not_mem_nil] at member
            rcases member with
                rfl | rfl | impossible
            · exact ordinaryCell_cell01
            · exact ordinaryCell_cell11
            · contradiction
          · exact gateListCells_allOrdinary todo
        · exact afterOrdinary
      have launch :=
        gateLeftRemainder_exact
          inputs done currentGate todo after
      have leftRun :=
        sourceRemainder_exact
          .gateLeft inputs (done.length + 1)
          todo.length done [] left leftSuffix
          (by intro symbol member; contradiction)
          (by intro symbol member; contradiction)
          leftValid
      rcases
          sourceBoundFailure_exact
            .gateRight inputs (done.length + 1)
            todo.length done (sourceCells left)
            right rightSuffix sourceFailure
            (sourceCells_allOrdinary left)
            (sourceCells_no_gateMark left)
            rightSuffixOrdinary with
        ⟨tailSteps, final, tail,
          finalState, output⟩
      dsimp [currentGate, leftSuffix,
        rightSuffix] at launch leftRun tail
      have leftRunCanonical :
          workRunExact? machine
              (sourceRemainderSteps
                inputs (done.length + 1)
                todo.length done [] left)
              (guardedConfig
                (afterFirstSourceState
                  (sourceFirstWas01 left) .gateLeft)
                (sourceContextPrefix inputs
                    (done.length + 1) todo.length
                    done [] ++
                  [firstSourceCell
                    (sourceFirstWas01 left)])
                (sourceRemainderCells left ++
                  sourceCells right ++
                  [cell01, cell11] ++
                  gateListCells todo ++ after)) =
            some
              (guardedConfig
                (State.sourceStart .gateRight)
                (sourceContextPrefix inputs
                    (done.length + 1) todo.length
                    done [] ++
                  sourceCells left)
                (sourceCells right ++
                  [cell01, cell11] ++
                  gateListCells todo ++ after)) := by
        simpa [sourceDoneState,
          List.append_assoc] using leftRun
      have throughLeft :=
        exactRun_add
          (gateSourceLaunchSteps
            inputs done currentGate todo)
          (sourceRemainderSteps
              inputs (done.length + 1)
              todo.length done [] left)
          _ _ _ launch leftRunCanonical
      have tailCanonical :
          workRunExact? machine tailSteps
              (guardedConfig
                (State.sourceStart .gateRight)
                (sourceContextPrefix inputs
                    (done.length + 1) todo.length
                    done [] ++
                  sourceCells left)
                (sourceCells right ++
                  [cell01, cell11] ++
                  gateListCells todo ++ after)) =
            some final := by
        simpa [sourceContextPrefix,
          List.append_assoc] using tail
      have all :=
        exactRun_add
          (gateSourceLaunchSteps
              inputs done currentGate todo +
            sourceRemainderSteps
              inputs (done.length + 1)
              todo.length done [] left)
          tailSteps _ _ _ throughLeft tailCanonical
      refine
        ⟨(gateSourceLaunchSteps
              inputs done currentGate todo +
            sourceRemainderSteps
              inputs (done.length + 1)
              todo.length done [] left) +
            tailSteps,
          final, ?_, finalState, output⟩
      simpa [currentGate, leftSuffix, rightSuffix,
        sourceContextPrefix, List.append_assoc] using all

private theorem decodedGateListBoundFailure_exact
    (inputs priorGates : Nat)
    (done gates : List RawGate)
    (after : List WorkSymbol)
    (doneLength : done.length = priorGates)
    (failure :
      GateListBoundFailure inputs priorGates gates)
    (afterOrdinary :
      ∀ symbol, symbol ∈ after →
        ordinaryCell symbol) :
    ∃ steps final,
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (gatePrefix inputs done gates)
            (gateListCells gates ++ after)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  induction failure generalizing done with
  | head priorGates gate rest gateFailure =>
      have gateFailureCanonical :
          GateBoundFailure inputs done.length gate := by
        simpa [doneLength] using gateFailure
      simpa [gateListCells] using
        (decodedGateBoundFailure_exact
          inputs done gate rest after
          gateFailureCanonical afterOrdinary)
  | rest priorGates gate remaining
      gateValid restFailure ih =>
      have gateValidCanonical :
          gate.wellFormed inputs done.length = true := by
        simpa [doneLength] using gateValid
      have first :=
        gate_exact inputs done gate remaining
          after gateValidCanonical
      have nextDoneLength :
          (done ++ [gate]).length =
            priorGates + 1 := by
        simp [List.length_append, doneLength]
      rcases ih (done ++ [gate]) nextDoneLength with
        ⟨tailSteps, final, tail,
          finalState, output⟩
      have all :=
        exactRun_add
          (gateSteps inputs done gate remaining)
          tailSteps _ _ _ first tail
      refine
        ⟨gateSteps inputs done gate remaining +
            tailSteps,
          final, ?_, finalState, output⟩
      simpa [gateListCells, List.append_assoc] using all

/-! ### Whole decoded ill-formed circuit traces -/

private theorem circuitAfterHeaderCells_nonempty
    (raw : RawCircuit) :
    circuitAfterHeaderCells raw ≠ [] := by
  simp [circuitAfterHeaderCells]

private theorem canonicalHeaderToGateStart_exact
    (raw : RawCircuit) :
    workRunExact? machine
        (2 * raw.inputCount +
          2 * raw.gates.length + 8)
        (workStartConfiguration machine
          (rawInputWorkTape (encodeCircuit raw))) =
      some
        (guardedConfig State.gateStart
          (gatePrefix raw.inputCount [] raw.gates)
          (circuitAfterHeaderCells raw)) := by
  cases cellsEq : circuitAfterHeaderCells raw with
  | nil =>
      exact False.elim
        (circuitAfterHeaderCells_nonempty raw cellsEq)
  | cons current rest =>
      have header :=
        canonicalHeader_fixed_exact
          raw.inputCount raw.gates.length
          current rest
      have headerLeftEq :
          pushCrossed
              (gatePrefix
                raw.inputCount [] raw.gates)
              [leftGuard] =
            pushCrossed (natCells raw.gates.length)
              (pushCrossed (natCells raw.inputCount)
                [cell00, cell00, leftGuard]) := by
        unfold gatePrefix
        simp only [markedGateListCells, List.append_nil]
        repeat rw [pushCrossed_append]
        rfl
      have afterEq :
          gateListCells raw.gates ++
              [cell10, cell00] ++
              sourceCells raw.output ++
              [cell10, cell01, cell10, cell11] =
            current :: rest := by
        simpa [circuitAfterHeaderCells] using cellsEq
      have circuitEq :
          circuitCells raw =
            [cell00, cell00] ++
              natCells raw.inputCount ++
              natCells raw.gates.length ++
              current :: rest := by
        have lifted :=
          congrArg
            (fun suffix =>
              [cell00, cell00] ++
                natCells raw.inputCount ++
                natCells raw.gates.length ++
                suffix)
            afterEq
        unfold circuitCells
        simpa only [List.append_assoc] using lifted
      rw [rawInputWorkTape_encodeCircuit]
      rw [circuitEq]
      unfold guardedConfig
      rw [headerLeftEq]
      simpa [gatePrefix,
        countCells, markedGateListCells,
        pushCrossed_append,
        List.append_assoc] using header

private theorem rawIllFormed_exact
    (raw : RawCircuit)
    (failure : CircuitBoundFailure raw) :
    ∃ steps final,
      workRunExact? machine steps
          (workStartConfiguration machine
            (rawInputWorkTape (encodeCircuit raw))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases failure with
  | gate inputs gates output gateFailure =>
      let raw : RawCircuit :=
        { inputCount := inputs
          gates := gates
          output := output }
      let afterGates :=
        [cell10, cell00] ++ sourceCells output ++
          [cell10, cell01, cell10, cell11]
      have afterGatesOrdinary :
          ∀ symbol, symbol ∈ afterGates →
            ordinaryCell symbol := by
        unfold afterGates
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · intro symbol member
            simp only [List.mem_cons,
              List.not_mem_nil] at member
            rcases member with
                rfl | rfl | impossible
            · exact ordinaryCell_cell10
            · exact ordinaryCell_cell00
            · contradiction
          · exact sourceCells_allOrdinary output
        · intro symbol member
          simp only [List.mem_cons,
            List.not_mem_nil] at member
          rcases member with
              rfl | rfl | rfl | rfl | impossible
          · exact ordinaryCell_cell10
          · exact ordinaryCell_cell01
          · exact ordinaryCell_cell10
          · exact ordinaryCell_cell11
          · contradiction
      have header :=
        canonicalHeaderToGateStart_exact raw
      rcases
          decodedGateListBoundFailure_exact
            inputs 0 [] gates afterGates rfl
            gateFailure afterGatesOrdinary with
        ⟨tailSteps, final, tail,
          finalState, outputEmpty⟩
      have tailCanonical :
          workRunExact? machine tailSteps
              (guardedConfig State.gateStart
                (gatePrefix inputs [] gates)
                (circuitAfterHeaderCells raw)) =
            some final := by
        simpa [raw, circuitAfterHeaderCells,
          afterGates] using tail
      have all :=
        exactRun_add
          (2 * inputs + 2 * gates.length + 8)
          tailSteps _ _ _ header tailCanonical
      exact
        ⟨2 * inputs + 2 * gates.length + 8 +
            tailSteps,
          final, all, finalState, outputEmpty⟩
  | output inputs gates output gatesValid sourceFailure =>
      let raw : RawCircuit :=
        { inputCount := inputs
          gates := gates
          output := output }
      let afterGates :=
        [cell10, cell00] ++ sourceCells output ++
          [cell10, cell01, cell10, cell11]
      let sourceSuffix :=
        [cell10, cell01, cell10, cell11]
      have sourceSuffixOrdinary :
          ∀ symbol, symbol ∈ sourceSuffix →
            ordinaryCell symbol := by
        intro symbol member
        unfold sourceSuffix at member
        simp only [List.mem_cons,
          List.not_mem_nil] at member
        rcases member with
            rfl | rfl | rfl | rfl | impossible
        · exact ordinaryCell_cell10
        · exact ordinaryCell_cell01
        · exact ordinaryCell_cell10
        · exact ordinaryCell_cell11
        · contradiction
      have header :=
        canonicalHeaderToGateStart_exact raw
      have gatesRun :=
        gates_exact inputs [] gates afterGates
          gatesValid
      have gatesCanonical :
          workRunExact? machine
              (gatesSteps inputs [] gates)
              (guardedConfig State.gateStart
                (gatePrefix inputs [] gates)
                (circuitAfterHeaderCells raw)) =
            some
              (guardedConfig State.gateStart
                (gatePrefix inputs gates [])
                afterGates) := by
        simpa [raw, circuitAfterHeaderCells,
          afterGates] using gatesRun
      have program :=
        programEnd_exact inputs gates
          (sourceCells output ++ sourceSuffix)
      have programCanonical :
          workRunExact? machine
              (programEndSteps inputs gates)
              (guardedConfig State.gateStart
                (gatePrefix inputs gates [])
                afterGates) =
            some
              (guardedConfig
                (State.sourceStart .output)
                (sourceContextPrefix
                  inputs 0 gates.length gates
                  [cell10, cell00])
                (sourceCells output ++
                  sourceSuffix)) := by
        simpa [afterGates, sourceSuffix,
          List.append_assoc] using program
      rcases
          sourceBoundFailure_exact
            .output inputs 0 gates.length gates
            [cell10, cell00] output sourceSuffix
            sourceFailure
            (by
              intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with
                  rfl | rfl | impossible
              · exact ordinaryCell_cell10
              · exact ordinaryCell_cell00
              · contradiction)
            (by
              intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with
                  rfl | rfl | impossible
              · decide
              · decide
              · contradiction)
            sourceSuffixOrdinary with
        ⟨tailSteps, final, tail,
          finalState, outputEmpty⟩
      have throughGates :=
        exactRun_add
          (2 * inputs + 2 * gates.length + 8)
          (gatesSteps inputs [] gates)
          _ _ _ header gatesCanonical
      have throughProgram :=
        exactRun_add
          ((2 * inputs + 2 * gates.length + 8) +
            gatesSteps inputs [] gates)
          (programEndSteps inputs gates)
          _ _ _ throughGates programCanonical
      have all :=
        exactRun_add
          (((2 * inputs + 2 * gates.length + 8) +
              gatesSteps inputs [] gates) +
            programEndSteps inputs gates)
          tailSteps _ _ _ throughProgram tail
      exact
        ⟨((2 * inputs + 2 * gates.length + 8) +
              gatesSteps inputs [] gates) +
            programEndSteps inputs gates +
            tailSteps,
          final, all, finalState, outputEmpty⟩

/-! ### Polynomial bounds for decoded reference failures -/

private def inputFailureFootprint
    (used remaining : Nat)
    (between : List WorkSymbol)
    (index : Nat) (suffix : List WorkSymbol) :
    Nat :=
  inputReferenceFootprint
      used remaining between index +
    suffix.length

private theorem inputFailureFootprint_step
    (used remaining index : Nat)
    (between suffix : List WorkSymbol) :
    inputFailureFootprint
        (used + 1) remaining
        (between ++ [cell00, cell01])
        index suffix =
      inputFailureFootprint
        used (remaining + 1) between
        (index + 1) suffix := by
  unfold inputFailureFootprint
  unfold inputReferenceFootprint
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    natCells_length]
  omega

private theorem inputBoundFailureConsume_bound
    (used remaining index : Nat)
    (between suffix : List WorkSymbol) :
    inputReferenceConsumeUnitSteps
        used remaining between ≤
      8 *
        (inputFailureFootprint
          used (remaining + 1) between
          (index + 1) suffix + 1) := by
  unfold inputReferenceConsumeUnitSteps
  unfold inputFailureFootprint inputReferenceFootprint
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    natCells_length]
  omega

private theorem inputBoundFailureFinish_bound
    (used : Nat)
    (between suffix : List WorkSymbol) :
    inputReferenceExhaustedSteps used between +
        inputBoundFailureCleanupSteps
          used between suffix ≤
      16 *
        (inputFailureFootprint
          used 0 between 0 suffix + 1) := by
  unfold inputReferenceExhaustedSteps
  unfold inputBoundFailureCleanupSteps
  unfold inputBoundFailurePrefix
  unfold inputBoundFailureSuffix
  unfold inputFailureFootprint inputReferenceFootprint
  rw [guardedCleanupSteps_eq]
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    borrowedCountCells_length, natCells_length,
    pushCrossed_length]
  omega

private theorem inputBoundFailureExhaustedUnit_bound
    (used index : Nat)
    (between suffix : List WorkSymbol) :
    inputReferenceExhaustedSteps used between +
        inputBoundFailureCleanupSteps
          used between (natCells index ++ suffix) ≤
      16 *
        (inputFailureFootprint
          used 0 between (index + 1) suffix + 1) := by
  unfold inputReferenceExhaustedSteps
  unfold inputBoundFailureCleanupSteps
  unfold inputBoundFailurePrefix
  unfold inputBoundFailureSuffix
  unfold inputFailureFootprint inputReferenceFootprint
  rw [guardedCleanupSteps_eq]
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    borrowedCountCells_length, natCells_length,
    pushCrossed_length]
  omega

private theorem inputBoundFailureSteps_linear_bound
    (used remaining index : Nat)
    (between suffix : List WorkSymbol) :
    inputBoundFailureSteps
        used remaining between index suffix ≤
      16 * (index + 1) *
        (inputFailureFootprint
          used remaining between index suffix + 1) := by
  induction index generalizing used remaining between with
  | zero =>
      cases remaining with
      | zero =>
          have base :=
            inputBoundFailureFinish_bound
              used between suffix
          simpa [inputBoundFailureSteps] using base
      | succ remaining =>
          simp [inputBoundFailureSteps]
  | succ index ih =>
      cases remaining with
      | zero =>
          have base :=
            inputBoundFailureExhaustedUnit_bound
              used index between suffix
          have factor :
              16 *
                    (inputFailureFootprint
                      used 0 between (index + 1)
                        suffix + 1) ≤
                16 * ((index + 1) + 1) *
                    (inputFailureFootprint
                      used 0 between (index + 1)
                        suffix + 1) := by
            have oneLe : 1 ≤ (index + 1) + 1 := by
              omega
            have scaled :=
              Nat.mul_le_mul_right
                (inputFailureFootprint
                  used 0 between (index + 1)
                    suffix + 1)
                oneLe
            have outer :=
              Nat.mul_le_mul_left 16 scaled
            simpa [Nat.mul_assoc] using outer
          exact (by
            simpa [inputBoundFailureSteps] using
              Nat.le_trans base factor)
      | succ remaining =>
          have atom :=
            inputBoundFailureConsume_bound
              used remaining index between suffix
          have atomWide :
              inputReferenceConsumeUnitSteps
                  used remaining between ≤
                16 *
                  (inputFailureFootprint
                    used (remaining + 1) between
                    (index + 1) suffix + 1) := by
            omega
          have tail :=
            ih (used + 1) remaining
              (between ++ [cell00, cell01])
          rw [inputFailureFootprint_step
            used remaining index between suffix] at tail
          have combined :=
            Nat.add_le_add atomWide tail
          have costEq :
              16 *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (index + 1) suffix + 1) +
                  16 * (index + 1) *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (index + 1) suffix + 1) =
                16 * ((index + 1) + 1) *
                  (inputFailureFootprint
                    used (remaining + 1) between
                    (index + 1) suffix + 1) := by
            calc
              _ =
                  (16 + 16 * (index + 1)) *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (index + 1) suffix + 1) := by
                rw [Nat.add_mul]
              _ = _ := by
                apply congrArg (fun coefficient =>
                  coefficient *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (index + 1) suffix + 1))
                rw [Nat.mul_add, Nat.mul_one]
                exact Nat.add_comm _ _
          rw [costEq] at combined
          change
            inputReferenceConsumeUnitSteps
                  used remaining between +
                inputBoundFailureSteps
                  (used + 1) remaining
                  (between ++ [cell00, cell01])
                  index suffix ≤
              16 * ((index + 1) + 1) *
                (inputFailureFootprint
                  used (remaining + 1) between
                  (index + 1) suffix + 1)
          exact combined

private theorem inputBoundFailureSteps_square_bound
    (used remaining index : Nat)
    (between suffix : List WorkSymbol) :
    inputBoundFailureSteps
        used remaining between index suffix ≤
      16 *
        ((inputFailureFootprint
            used remaining between index suffix + 1) *
          (inputFailureFootprint
            used remaining between index suffix + 1)) := by
  have run :=
    inputBoundFailureSteps_linear_bound
      used remaining index between suffix
  have indexLe :
      index + 1 ≤
        inputFailureFootprint
          used remaining between index suffix + 1 := by
    unfold inputFailureFootprint
    unfold inputReferenceFootprint
    simp only [List.length_append, List.length_cons,
      List.length_nil, countCells_length,
      natCells_length]
    omega
  have scaled :=
    Nat.mul_le_mul_left 16 indexLe
  have squared :=
    Nat.mul_le_mul_right
      (inputFailureFootprint
        used remaining between index suffix + 1)
      scaled
  exact Nat.le_trans run (by
    simpa [Nat.mul_assoc] using squared)

private theorem unaryUnitCells_length
    (units : Nat) :
    (unaryUnitCells units).length = 2 * units := by
  induction units with
  | zero =>
      rfl
  | succ units ih =>
      simp only [unaryUnitCells, List.length_cons, ih]
      omega

private theorem inputMissingReferenceFinish_bound
    (used remaining : Nat)
    (between : List WorkSymbol) :
    inputMissingReferenceSteps
        used remaining between 0 ≤
      16 *
        (inputFailureFootprint
          used remaining between 0 [] + 1) := by
  unfold inputMissingReferenceSteps
  unfold missingEndTailSteps
  rw [guardedCleanupExplicitSteps_eq]
  unfold missingEndScan missingEndEraseWord
  unfold inputFailureFootprint inputReferenceFootprint
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length, natCells_length,
    pushCrossed_length, pushCleanupScan_length]
  omega

private theorem inputMissingReferenceExhausted_bound
    (used units : Nat)
    (between : List WorkSymbol) :
    inputMissingReferenceSteps
        used 0 between (units + 1) ≤
      16 *
        (inputFailureFootprint
          used 0 between (units + 1) [] + 1) := by
  simp only [inputMissingReferenceSteps]
  unfold inputReferenceExhaustedSteps
  rw [guardedCleanupSteps_eq]
  unfold inputFailureFootprint inputReferenceFootprint
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    borrowedCountCells_length, natCells_length,
    pushCrossed_length, unaryUnitCells_length]
  omega

private theorem inputMissingReferenceSteps_linear_bound
    (used remaining units : Nat)
    (between : List WorkSymbol) :
    inputMissingReferenceSteps
        used remaining between units ≤
      16 * (units + 1) *
        (inputFailureFootprint
          used remaining between units [] + 1) := by
  induction units generalizing used remaining between with
  | zero =>
      have base :=
        inputMissingReferenceFinish_bound
          used remaining between
      simpa using base
  | succ units ih =>
      cases remaining with
      | zero =>
          have base :=
            inputMissingReferenceExhausted_bound
              used units between
          have factor :
              16 *
                    (inputFailureFootprint
                      used 0 between (units + 1) [] + 1) ≤
                16 * ((units + 1) + 1) *
                    (inputFailureFootprint
                      used 0 between (units + 1) [] + 1) := by
            have oneLe : 1 ≤ (units + 1) + 1 := by
              omega
            have scaled :=
              Nat.mul_le_mul_right
                (inputFailureFootprint
                  used 0 between (units + 1) [] + 1)
                oneLe
            have outer :=
              Nat.mul_le_mul_left 16 scaled
            simpa [Nat.mul_assoc] using outer
          exact (by
            simpa using Nat.le_trans base factor)
      | succ remaining =>
          have atom :=
            inputBoundFailureConsume_bound
              used remaining units between []
          have atomWide :
              inputReferenceConsumeUnitSteps
                  used remaining between ≤
                16 *
                  (inputFailureFootprint
                    used (remaining + 1) between
                    (units + 1) [] + 1) := by
            omega
          have tail :=
            ih (used + 1) remaining
              (between ++ [cell00, cell01])
          rw [inputFailureFootprint_step
            used remaining units between []] at tail
          have combined :=
            Nat.add_le_add atomWide tail
          have costEq :
              16 *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (units + 1) [] + 1) +
                  16 * (units + 1) *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (units + 1) [] + 1) =
                16 * ((units + 1) + 1) *
                  (inputFailureFootprint
                    used (remaining + 1) between
                    (units + 1) [] + 1) := by
            calc
              _ =
                  (16 + 16 * (units + 1)) *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (units + 1) [] + 1) := by
                rw [Nat.add_mul]
              _ = _ := by
                apply congrArg (fun coefficient =>
                  coefficient *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (units + 1) [] + 1))
                rw [Nat.mul_add, Nat.mul_one]
                exact Nat.add_comm _ _
          rw [costEq] at combined
          change
            inputReferenceConsumeUnitSteps
                  used remaining between +
                inputMissingReferenceSteps
                  (used + 1) remaining
                  (between ++ [cell00, cell01])
                  units ≤
              16 * ((units + 1) + 1) *
                (inputFailureFootprint
                  used (remaining + 1) between
                  (units + 1) [] + 1)
          exact combined

private theorem inputMissingReferenceSteps_square_bound
    (used remaining units : Nat)
    (between : List WorkSymbol) :
    inputMissingReferenceSteps
        used remaining between units ≤
      16 *
        ((inputFailureFootprint
            used remaining between units [] + 1) *
          (inputFailureFootprint
            used remaining between units [] + 1)) := by
  have run :=
    inputMissingReferenceSteps_linear_bound
      used remaining units between
  have unitsLe :
      units + 1 ≤
        inputFailureFootprint
          used remaining between units [] + 1 := by
    unfold inputFailureFootprint
    unfold inputReferenceFootprint
    simp only [List.length_append, List.length_cons,
      List.length_nil, countCells_length,
      natCells_length]
    omega
  have scaled :=
    Nat.mul_le_mul_left 16 unitsLe
  have squared :=
    Nat.mul_le_mul_right
      (inputFailureFootprint
        used remaining between units [] + 1)
      scaled
  exact Nat.le_trans run (by
    simpa [Nat.mul_assoc] using squared)

private theorem referenceWrongTokenSteps_bound
    (parsedPrefix : List WorkSymbol)
    (token : Token) (suffixCells : List WorkSymbol) :
    referenceWrongTokenSteps
        parsedPrefix token suffixCells ≤
      4 *
        (parsedPrefix.length +
          (tokenCells token).length +
          suffixCells.length + 1) := by
  cases token <;>
    simp only [referenceWrongTokenSteps]
  all_goals
    first
    | exact Nat.zero_le _
    | (rw [guardedCleanupSteps_eq]
       simp only [List.length_append, List.length_cons,
         List.length_nil, pushCrossed_length,
         tokenCells_length]
       omega)

private theorem inputWrongReferenceFinish_bound
    (used remaining : Nat)
    (between : List WorkSymbol)
    (token : Token) (suffix : List Token) :
    inputWrongReferenceSteps
        used remaining between 0 token suffix ≤
      16 *
        (inputFailureFootprint
          used remaining between 0
            (packedTokenCells suffix) + 1) := by
  have run :=
    referenceWrongTokenSteps_bound
      ([cell00, cell00] ++
        countCells used remaining ++ between)
      token (packedTokenCells suffix)
  unfold inputWrongReferenceSteps
  unfold inputFailureFootprint inputReferenceFootprint
  simp only [List.length_append, List.length_cons,
    List.length_nil, natCells_length,
    tokenCells_length] at run ⊢
  omega

private theorem inputWrongReferenceExhausted_bound
    (used units : Nat)
    (between : List WorkSymbol)
    (token : Token) (suffix : List Token) :
    inputWrongReferenceSteps
        used 0 between (units + 1) token suffix ≤
      16 *
        (inputFailureFootprint
          used 0 between (units + 1)
            (packedTokenCells suffix) + 1) := by
