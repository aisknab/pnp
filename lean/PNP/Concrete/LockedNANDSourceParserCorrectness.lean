        (packedTokenCells tokens ++ after).length := by
    simp
  have cubeBound :=
    failureSpanCube_mono_work lengthBound
  exact Nat.le_trans base
    (by
      simpa [tokens] using
        Nat.mul_le_mul_left 192 cubeBound)

private theorem outputsEndWrongTokenWork_launch
    (parsedPrefix : List WorkSymbol)
    (token : Token) (after : List WorkSymbol)
    (notOutputsEnd : token ≠ .outputsEnd) :
    BoundaryCleanupLaunch State.outputsEndFirst
      parsedPrefix (tokenCells token ++ after) := by
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq : tokenCells token = [current, next])
      (notExpected : current ≠ cell10) :
      BoundaryCleanupLaunch State.outputsEndFirst
        parsedPrefix (tokenCells token ++ after) := by
