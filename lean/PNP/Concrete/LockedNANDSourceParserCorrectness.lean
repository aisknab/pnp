private theorem malformedInputCountCells_shape
    (units : Nat) (token : Token) (suffix : List Token) :
    packedTokenCells
        (.version0 ::
          (List.replicate units .unit ++ token :: suffix)) =
      ([cell00, cell00] ++ unaryUnitCells units) ++
        tokenCells token ++ packedTokenCells suffix := by
  change
    [cell00, cell00] ++
        packedTokenCells
          (List.replicate units .unit ++ token :: suffix) =
      ([cell00, cell00] ++ unaryUnitCells units) ++
        tokenCells token ++ packedTokenCells suffix
  rw [packedTokenCells_append,
    packedTokenCells_replicate_unit]
  simp [packedTokenCells, List.append_assoc]

private theorem inputCountTokenFailure_exact
    {tokens : List Token}
    (failure : NatTokenFailure tokens) :
    ∃ steps final,
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells
                (.version0 :: tokens)))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases failure with
  | missingEnd units =>
      simpa [packedTokenCells, tokenCells,
        packedTokenCells_replicate_unit,
        List.append_assoc] using
        (inputCountMissingEnd_exact units)
  | wrongToken units token suffix notUnit notNatEnd =>
      let allTokens : List Token :=
        .version0 ::
          (List.replicate units .unit ++ token :: suffix)
      let parsedCells : List WorkSymbol :=
        [cell00, cell00] ++ unaryUnitCells units
      let suffixCells := packedTokenCells suffix
      let initial :=
        workStartConfiguration machine
          (WorkTape.ofSymbols
            (packedTokenCells allTokens))
      have wordShape :=
        malformedInputCountCells_shape
          units token suffix
      have prefixRun :
          workRunExact? machine (4 + 2 * units)
              initial =
            some
              (configAtWord State.inputCountFirst
                (pushCrossed parsedCells [] ++ [leftGuard])
                (tokenCells token ++ suffixCells)) := by
        dsimp [initial, allTokens, parsedCells, suffixCells]
        rw [wordShape]
        change
          workRunExact? machine (4 + 2 * units)
              (workStartConfiguration machine
                (WorkTape.ofSymbols
                  (([cell00, cell00] ++
                      unaryUnitCells units) ++
                    tokenCells token ++
                    packedTokenCells suffix))) =
            some
              (configAtWord State.inputCountFirst
                (pushCrossed
                    ([cell00, cell00] ++
                      unaryUnitCells units) [] ++
                  [leftGuard])
                (tokenCells token ++
                  packedTokenCells suffix))
        simpa only [List.append_assoc] using
          (inputCountUnitsPrefix_exact units
            (tokenCells token ++ packedTokenCells suffix))
      cases token with
      | version0 =>
          have failed :=
            inputCountSecondFailure_exact
              parsedCells cell00 suffixCells
              (by decide) (by decide)
          have launch :=
            exactRun_add (4 + 2 * units) 2
              _ _ _ prefixRun failed
          have shape :
              packedTokenCells allTokens =
                (parsedCells ++ [cell00]) ++
                  cell00 :: suffixCells := by
            simpa [allTokens, parsedCells,
              suffixCells, tokenCells,
              List.append_assoc] using wordShape
          simpa [allTokens, initial] using
            (packedExplicitFailure_exact
              allTokens
              (parsedCells ++ [cell00])
              cell00 suffixCells initial
              (4 + 2 * units + 2)
              shape launch)
      | unit =>
          exact False.elim (notUnit rfl)
      | natEnd =>
          exact False.elim (notNatEnd rfl)
      | input =>
          have failed :=
            inputCountSecondFailure_exact
              parsedCells cell11 suffixCells
              (by decide) (by decide)
          have launch :=
            exactRun_add (4 + 2 * units) 2
              _ _ _ prefixRun failed
          have shape :
              packedTokenCells allTokens =
                (parsedCells ++ [cell00]) ++
                  cell11 :: suffixCells := by
            simpa [allTokens, parsedCells,
              suffixCells, tokenCells,
              List.append_assoc] using wordShape
          simpa [allTokens, initial] using
            (packedExplicitFailure_exact
              allTokens
              (parsedCells ++ [cell00])
              cell11 suffixCells initial
              (4 + 2 * units + 2)
              shape launch)
      | constantFalse =>
          have failed :=
            inputCountFirstFailure_exact
              parsedCells cell01
              (cell00 :: suffixCells) (by decide)
          have launch :=
            exactRun_add (4 + 2 * units) 1
              _ _ _ prefixRun failed
          have shape :
              packedTokenCells allTokens =
                parsedCells ++
                  cell01 :: cell00 :: suffixCells := by
            simpa [allTokens, parsedCells,
              suffixCells, tokenCells,
              List.append_assoc] using wordShape
          simpa [allTokens, initial] using
            (packedExplicitFailure_exact
              allTokens parsedCells cell01
              (cell00 :: suffixCells) initial
              (4 + 2 * units + 1)
              shape launch)
      | constantTrue =>
          have failed :=
            inputCountFirstFailure_exact
              parsedCells cell01
              (cell01 :: suffixCells) (by decide)
          have launch :=
            exactRun_add (4 + 2 * units) 1
              _ _ _ prefixRun failed
          have shape :
              packedTokenCells allTokens =
                parsedCells ++
                  cell01 :: cell01 :: suffixCells := by
            simpa [allTokens, parsedCells,
              suffixCells, tokenCells,
              List.append_assoc] using wordShape
          simpa [allTokens, initial] using
            (packedExplicitFailure_exact
              allTokens parsedCells cell01
              (cell01 :: suffixCells) initial
              (4 + 2 * units + 1)
              shape launch)
      | gate =>
          have failed :=
            inputCountFirstFailure_exact
              parsedCells cell01
              (cell10 :: suffixCells) (by decide)
          have launch :=
            exactRun_add (4 + 2 * units) 1
              _ _ _ prefixRun failed
          have shape :
              packedTokenCells allTokens =
                parsedCells ++
                  cell01 :: cell10 :: suffixCells := by
            simpa [allTokens, parsedCells,
              suffixCells, tokenCells,
              List.append_assoc] using wordShape
          simpa [allTokens, initial] using
            (packedExplicitFailure_exact
              allTokens parsedCells cell01
              (cell10 :: suffixCells) initial
              (4 + 2 * units + 1)
              shape launch)
      | gateEnd =>
          have failed :=
            inputCountFirstFailure_exact
              parsedCells cell01
              (cell11 :: suffixCells) (by decide)
          have launch :=
            exactRun_add (4 + 2 * units) 1
              _ _ _ prefixRun failed
          have shape :
              packedTokenCells allTokens =
                parsedCells ++
                  cell01 :: cell11 :: suffixCells := by
            simpa [allTokens, parsedCells,
              suffixCells, tokenCells,
              List.append_assoc] using wordShape
          simpa [allTokens, initial] using
            (packedExplicitFailure_exact
              allTokens parsedCells cell01
              (cell11 :: suffixCells) initial
              (4 + 2 * units + 1)
              shape launch)
      | programEnd =>
          have failed :=
            inputCountFirstFailure_exact
              parsedCells cell10
              (cell00 :: suffixCells) (by decide)
          have launch :=
            exactRun_add (4 + 2 * units) 1
              _ _ _ prefixRun failed
          have shape :
              packedTokenCells allTokens =
                parsedCells ++
                  cell10 :: cell00 :: suffixCells := by
            simpa [allTokens, parsedCells,
              suffixCells, tokenCells,
              List.append_assoc] using wordShape
          simpa [allTokens, initial] using
            (packedExplicitFailure_exact
              allTokens parsedCells cell10
              (cell00 :: suffixCells) initial
              (4 + 2 * units + 1)
              shape launch)
      | outputsEnd =>
          have failed :=
            inputCountFirstFailure_exact
              parsedCells cell10
              (cell01 :: suffixCells) (by decide)
          have launch :=
            exactRun_add (4 + 2 * units) 1
              _ _ _ prefixRun failed
          have shape :
              packedTokenCells allTokens =
                parsedCells ++
                  cell10 :: cell01 :: suffixCells := by
            simpa [allTokens, parsedCells,
              suffixCells, tokenCells,
              List.append_assoc] using wordShape
          simpa [allTokens, initial] using
            (packedExplicitFailure_exact
              allTokens parsedCells cell10
              (cell01 :: suffixCells) initial
              (4 + 2 * units + 1)
              shape launch)
      | threshold =>
          have failed :=
            inputCountFirstFailure_exact
              parsedCells cell10
              (cell10 :: suffixCells) (by decide)
          have launch :=
            exactRun_add (4 + 2 * units) 1
              _ _ _ prefixRun failed
          have shape :
              packedTokenCells allTokens =
                parsedCells ++
                  cell10 :: cell10 :: suffixCells := by
            simpa [allTokens, parsedCells,
              suffixCells, tokenCells,
              List.append_assoc] using wordShape
          simpa [allTokens, initial] using
            (packedExplicitFailure_exact
              allTokens parsedCells cell10
              (cell10 :: suffixCells) initial
              (4 + 2 * units + 1)
              shape launch)
      | instanceEnd =>
          have failed :=
            inputCountFirstFailure_exact
              parsedCells cell10
              (cell11 :: suffixCells) (by decide)
          have launch :=
            exactRun_add (4 + 2 * units) 1
              _ _ _ prefixRun failed
          have shape :
              packedTokenCells allTokens =
                parsedCells ++
                  cell10 :: cell11 :: suffixCells := by
            simpa [allTokens, parsedCells,
              suffixCells, tokenCells,
              List.append_assoc] using wordShape
          simpa [allTokens, initial] using
            (packedExplicitFailure_exact
              allTokens parsedCells cell10
              (cell11 :: suffixCells) initial
              (4 + 2 * units + 1)
              shape launch)

/-! ### Missing gate-count terminators -/

private theorem gateCountMissingEnd_failure_exact
    (crossed : List WorkSymbol) :
    workRunExact? machine 1
        (configAtWord State.gateCountFirst
          (crossed ++ [leftGuard]) []) =
      some
        (cleanupSeekConfiguration
          [] (missingEndScan crossed) []) := by
  change
    (match workStep? machine
        (configAtWord State.gateCountFirst
          (crossed ++ [leftGuard]) []) with
     | none => none
     | some next => some next) =
      some
        (cleanupSeekConfiguration
          [] (missingEndScan crossed) [])
  set_option maxRecDepth 100000 in
    rfl

private theorem gateCountMissingEnd_exact
    (inputs units : Nat) :
    ∃ steps final,
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              ([cell00, cell00] ++
                natCells inputs ++
                unaryUnitCells units))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let prefixTokens :=
    Token.version0 ::
      (encodeNatTokens inputs ++
        List.replicate units Token.unit)
  let prefixCells :=
    [cell00, cell00] ++
      natCells inputs ++ unaryUnitCells units
  let crossed := pushCrossed prefixCells []
  have prefixCellsEq :
      packedTokenCells prefixTokens = prefixCells := by
    change
      [cell00, cell00] ++
          packedTokenCells
            (encodeNatTokens inputs ++
              List.replicate units Token.unit) =
        [cell00, cell00] ++
          natCells inputs ++ unaryUnitCells units
    rw [packedTokenCells_append,
      packedTokenCells_encodeNatTokens,
      packedTokenCells_replicate_unit]
    simp
  have noGuard :
      ∀ symbol, symbol ∈ prefixCells →
        symbol ≠ leftGuard := by
    intro symbol member
    exact packedTokenCells_no_leftGuard
      prefixTokens symbol
      (by rw [prefixCellsEq]; exact member)
  have nonblank :
      ∀ symbol, symbol ∈ prefixCells →
        symbol ≠ cellBlank := by
    intro symbol member
    exact packedTokenCells_no_blank
      prefixTokens symbol
      (by rw [prefixCellsEq]; exact member)
  have crossedEq :
      crossed = pushCrossed prefixCells [] := by
    rfl
  have crossedCore :
      crossed =
        pushCrossed (unaryUnitCells units)
          (pushCrossed (natCells inputs)
            [cell00, cell00]) := by
    simp [crossed, prefixCells,
      pushCrossed_append, pushCrossed]
  have crossedGuard :
      pushCrossed (unaryUnitCells units)
          (pushCrossed (natCells inputs)
            [cell00, cell00, leftGuard]) =
        crossed ++ [leftGuard] := by
    change
      pushCrossed (unaryUnitCells units)
          (pushCrossed (natCells inputs)
            ([cell00, cell00] ++ [leftGuard])) =
        crossed ++ [leftGuard]
    rw [pushCrossed_append_suffix,
      pushCrossed_append_suffix]
    rw [← crossedCore]
  have boot :=
    bootVersion_exact
      (natCells inputs ++ unaryUnitCells units)
  have throughInput :=
    inputCountValue_exact inputs
      [cell00, cell00, leftGuard]
      (unaryUnitCells units)
  have throughHeader :=
    exactRun_add 4 (2 * (inputs + 1))
      _ _ _ boot throughInput
  have throughUnits :
      workRunExact? machine (2 * units)
          (configAtWord State.gateCountFirst
            (pushCrossed (natCells inputs)
              [cell00, cell00, leftGuard])
            (unaryUnitCells units)) =
        some
          (configAtWord State.gateCountFirst
            (pushCrossed (unaryUnitCells units)
              (pushCrossed (natCells inputs)
                [cell00, cell00, leftGuard]))
            []) := by
    simpa using
      (gateCountUnits_exact units
        (pushCrossed (natCells inputs)
          [cell00, cell00, leftGuard]) [])
  rw [crossedGuard] at throughUnits
  have throughCounts :=
    exactRun_add
      (4 + 2 * (inputs + 1))
      (2 * units)
      _ _ _ throughHeader throughUnits
  have failure :=
    gateCountMissingEnd_failure_exact crossed
  have tail :=
    missingEndTail_exact
      State.gateCountFirst prefixCells crossed
      crossedEq noGuard nonblank failure
  let steps :=
    (4 + 2 * (inputs + 1) + 2 * units) +
      missingEndTailSteps crossed
  let final :=
    cleanupExplicitRejectConfiguration
      [] (missingEndEraseWord crossed) []
  refine ⟨steps, final, ?_, rfl, ?_⟩
  · change
      workRunExact? machine
          ((4 + 2 * (inputs + 1) + 2 * units) +
            missingEndTailSteps crossed)
          (workStartConfiguration machine
            (WorkTape.ofSymbols prefixCells)) =
        some final
    exact exactRun_add
      (4 + 2 * (inputs + 1) + 2 * units)
      (missingEndTailSteps crossed)
      _ _ _ throughCounts tail
  · rfl

private theorem gateCountUnitsPrefix_exact
    (inputs units : Nat) (suffix : List WorkSymbol) :
    let parsedCells :=
      [cell00, cell00] ++ natCells inputs ++
        unaryUnitCells units
    workRunExact? machine
        (4 + 2 * (inputs + 1) + 2 * units)
        (workStartConfiguration machine
          (WorkTape.ofSymbols (parsedCells ++ suffix))) =
      some
        (configAtWord State.gateCountFirst
          (pushCrossed parsedCells [] ++ [leftGuard])
          suffix) := by
  dsimp only
  have boot :=
    bootVersion_exact
      (natCells inputs ++
        unaryUnitCells units ++ suffix)
  have throughInput :=
    inputCountValue_exact inputs
      [cell00, cell00, leftGuard]
      (unaryUnitCells units ++ suffix)
  have throughInput' :
      workRunExact? machine (2 * (inputs + 1))
          (configAtWord State.inputCountFirst
            [cell00, cell00, leftGuard]
            ((natCells inputs ++
              unaryUnitCells units) ++ suffix)) =
        some
          (configAtWord State.gateCountFirst
            (pushCrossed (natCells inputs)
              [cell00, cell00, leftGuard])
            (unaryUnitCells units ++ suffix)) := by
    simpa [List.append_assoc] using throughInput
  have throughHeader :=
    exactRun_add 4 (2 * (inputs + 1))
      _ _ _ boot throughInput'
  have throughUnits :
      workRunExact? machine (2 * units)
          (configAtWord State.gateCountFirst
            (pushCrossed (natCells inputs)
              [cell00, cell00, leftGuard])
            (unaryUnitCells units ++ suffix)) =
        some
          (configAtWord State.gateCountFirst
            (pushCrossed (unaryUnitCells units)
              (pushCrossed (natCells inputs)
                [cell00, cell00, leftGuard]))
            suffix) := by
    simpa using
      (gateCountUnits_exact units
        (pushCrossed (natCells inputs)
          [cell00, cell00, leftGuard])
        suffix)
  have all :=
    exactRun_add
      (4 + 2 * (inputs + 1))
      (2 * units)
      _ _ _ throughHeader throughUnits
  have endpointEq :
      pushCrossed (unaryUnitCells units)
          (pushCrossed (natCells inputs)
            [cell00, cell00, leftGuard]) =
        pushCrossed
            ([cell00, cell00] ++ natCells inputs ++
              unaryUnitCells units) [] ++
          [leftGuard] := by
    have combinedEq :
        pushCrossed
            ([cell00, cell00] ++ natCells inputs ++
              unaryUnitCells units) [] =
          pushCrossed (unaryUnitCells units)
            (pushCrossed (natCells inputs)
              [cell00, cell00]) := by
      calc
        _ =
            pushCrossed
              (natCells inputs ++ unaryUnitCells units)
              (pushCrossed [cell00, cell00] []) :=
          pushCrossed_append
            [cell00, cell00]
            (natCells inputs ++ unaryUnitCells units) []
        _ =
            pushCrossed (unaryUnitCells units)
              (pushCrossed (natCells inputs)
                (pushCrossed [cell00, cell00] [])) :=
          pushCrossed_append
            (natCells inputs) (unaryUnitCells units)
            (pushCrossed [cell00, cell00] [])
        _ =
            pushCrossed (unaryUnitCells units)
              (pushCrossed (natCells inputs)
                [cell00, cell00]) := by
          rfl
    calc
      pushCrossed (unaryUnitCells units)
          (pushCrossed (natCells inputs)
            [cell00, cell00, leftGuard]) =
          pushCrossed (unaryUnitCells units)
              (pushCrossed (natCells inputs)
                [cell00, cell00] ++
              [leftGuard]) := by
            exact congrArg
              (pushCrossed (unaryUnitCells units))
              (pushCrossed_append_suffix
                (natCells inputs)
                [cell00, cell00] [leftGuard])
      _ =
          pushCrossed (unaryUnitCells units)
              (pushCrossed (natCells inputs)
                [cell00, cell00]) ++
            [leftGuard] :=
        pushCrossed_append_suffix
          (unaryUnitCells units)
          (pushCrossed (natCells inputs)
            [cell00, cell00])
          [leftGuard]
      _ =
          pushCrossed
              ([cell00, cell00] ++ natCells inputs ++
                unaryUnitCells units) [] ++
            [leftGuard] := by
        rw [combinedEq]
  rw [endpointEq] at all
  simpa [List.append_assoc] using all

