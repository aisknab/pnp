          have all :=
            exactRun_add
              (leftSteps + rightSteps) endSteps
              _ _ _ throughRight endRun
          have localBound :
              (leftSteps + rightSteps) + endSteps ≤
                256 *
                  failureSpanSquare
                    (grammarWorkFailureSpan
                      inputs done (remaining + 1)
                      word) := by
            omega
          refine
            ⟨(leftSteps + rightSteps) + endSteps,
              final,
              grammarSingleGateBound256
                remaining _ _ localBound,
              ?_, finalState, outputEmpty⟩
          simpa [word, List.append_assoc] using all

