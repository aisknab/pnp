private theorem rawIllFormed_bounded_exact
    (raw : RawCircuit)
    (illFormed : raw.wellFormed = false) :
    ∃ steps final,
      steps ≤ validWorkBound (encodeCircuit raw).length ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (rawInputWorkTape
              (encodeCircuit raw))) =
        some final ∧
      machine.isHalted final = true ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases raw with
  | mk inputs gates output =>
      let raw : RawCircuit :=
        { inputCount := inputs
          gates := gates
          output := output }
      cases gatesEq :
          rawGatesWellFormed inputs 0 gates with
      | false =>
          let suffix :=
            .programEnd ::
              (encodeSourceTokens output ++
                [.outputsEnd, .instanceEnd])
          have result :=
            circuitInvalidGates_bounded_exact
              inputs gates suffix gatesEq
          have tokensEq :
              circuitGatesPrefixTokens inputs gates ++ suffix =
                encodeCircuitTokens raw := by
            unfold raw suffix
            unfold circuitGatesPrefixTokens
              circuitHeaderTokens encodeCircuitTokens
            simp only [List.cons_append,
              List.nil_append, List.append_assoc]
          rw [tokensEq] at result
          rcases result with
            ⟨steps, final, bound, run,
              finalState, outputEmpty⟩
          refine
            ⟨steps, final,
              Nat.le_trans bound ?_, ?_,
              rejectState_isHalted final finalState,
              finalState, outputEmpty⟩
          · unfold encodeCircuit
            exact
              circuitFailureEnvelope_le_validWorkBound_encodeTokens
                (encodeCircuitTokens raw)
          · rw [rawInputWorkTape_encodeCircuit]
            rw [← packedTokenCells_encodeCircuitTokens]
            exact run
      | true =>
          have outputEq :
              output.wellFormed inputs gates.length = false := by
            simp [RawCircuit.wellFormed,
              gatesEq] at illFormed
            exact illFormed
          have result :=
            circuitInvalidOutput_bounded_exact
              inputs gates output
              [.outputsEnd, .instanceEnd]
              outputEq
          have tokensEq :
              circuitOutputPrefixTokens
                    inputs gates output ++
                  [.outputsEnd, .instanceEnd] =
                encodeCircuitTokens raw := by
            unfold raw
            unfold circuitOutputPrefixTokens
              circuitGatesPrefixTokens
              circuitHeaderTokens encodeCircuitTokens
            simp only [List.cons_append,
              List.nil_append, List.append_assoc]
          rw [tokensEq] at result
          rcases result with
            ⟨steps, final, bound, run,
              finalState, outputEmpty⟩
          refine
            ⟨steps, final,
              Nat.le_trans bound ?_, ?_,
              rejectState_isHalted final finalState,
              finalState, outputEmpty⟩
          · unfold encodeCircuit
            exact
              circuitFailureEnvelope_le_validWorkBound_encodeTokens
                (encodeCircuitTokens raw)
          · rw [rawInputWorkTape_encodeCircuit]
            rw [← packedTokenCells_encodeCircuitTokens]
            exact run

/-- Every successfully decoded but intrinsically ill-formed strict-v0 source
halts at rejection within the advertised cubic work schedule and exposes no
output bytes. -/
theorem illFormed_exact
    (bits : BitString) (raw : RawCircuit)
    (decoded : decodeCircuit bits = some raw)
    (illFormed : raw.wellFormed = false) :
    ∃ steps final,
      steps ≤ validWorkBound bits.length ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (rawInputWorkTape bits)) =
        some final ∧
      machine.isHalted final = true ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  have encoded :=
    encodeCircuit_eq_of_decodeCircuit_eq_some
      bits raw decoded
  rw [← encoded]
  exact rawIllFormed_bounded_exact raw illFormed

private theorem tokenBits_eq_of_ofBits_eq_some
    (first second third fourth : Bool)
    (token : Token)
    (decoded :
      Token.ofBits first second third fourth =
        some token) :
    token.bits = [first, second, third, fourth] := by
  cases first <;> cases second <;>
    cases third <;> cases fourth <;>
    cases token <;> first | rfl | contradiction

private theorem encodeTokens_eq_of_decodeTokens_eq_some
    (bits : BitString) (tokens : List Token)
    (decoded : decodeTokens bits = some tokens) :
    encodeTokens tokens = bits := by
  induction tokens generalizing bits with
  | nil =>
      cases bits with
      | nil =>
          rfl
      | cons first afterFirst =>
          cases afterFirst with
          | nil =>
              simp [decodeTokens] at decoded
          | cons second afterSecond =>
              cases afterSecond with
              | nil =>
                  simp [decodeTokens] at decoded
              | cons third afterThird =>
                  cases afterThird with
                  | nil =>
                      simp [decodeTokens] at decoded
                  | cons fourth rest =>
                      simp only [decodeTokens] at decoded
                      cases tokenEq :
                          Token.ofBits first second
                            third fourth with
                      | none =>
                          rw [tokenEq] at decoded
                          contradiction
                      | some token =>
                          cases restEq : decodeTokens rest with
                          | none =>
                              rw [tokenEq, restEq] at decoded
                              contradiction
                          | some decodedRest =>
                              rw [tokenEq, restEq] at decoded
                              have impossible :
                                  token :: decodedRest = [] :=
                                Option.some.inj decoded
                              contradiction
  | cons token rest ih =>
      cases bits with
      | nil =>
          simp [decodeTokens] at decoded
      | cons first afterFirst =>
          cases afterFirst with
          | nil =>
              contradiction
          | cons second afterSecond =>
              cases afterSecond with
              | nil =>
                  contradiction
              | cons third afterThird =>
                  cases afterThird with
                  | nil =>
                      contradiction
                  | cons fourth suffix =>
                      simp only [decodeTokens] at decoded
                      cases tokenEq :
                          Token.ofBits first second
                            third fourth with
                      | none =>
                          rw [tokenEq] at decoded
                          contradiction
                      | some decodedToken =>
                          cases suffixEq :
                              decodeTokens suffix with
                          | none =>
                              rw [tokenEq, suffixEq] at decoded
                              contradiction
                          | some decodedRest =>
                              rw [tokenEq, suffixEq] at decoded
                              have decodedEq :
                                  decodedToken :: decodedRest =
                                    token :: rest :=
                                Option.some.inj decoded
                              have headEq :
                                  decodedToken = token :=
                                (List.cons.inj decodedEq).1
                              have tailEq :
                                  decodedRest = rest :=
                                (List.cons.inj decodedEq).2
                              subst decodedToken
                              subst decodedRest
                              have tokenBits :=
                                tokenBits_eq_of_ofBits_eq_some
                                  first second third fourth
                                  token tokenEq
                              have suffixBits :=
                                ih suffix suffixEq
                              simp only [encodeTokens]
                              rw [tokenBits, suffixBits]
                              rfl

private theorem alignedMalformed_bounded_exact
    (bits : BitString) (tokens : List Token)
    (tokenDecoded :
      decodeTokens bits = some tokens)
    (grammarMalformed :
      decodeCircuitTokens tokens = none) :
    ∃ steps final,
      steps ≤ validWorkBound bits.length ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (rawInputWorkTape bits)) =
        some final ∧
      machine.isHalted final = true ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  have failure :=
    (decodeCircuitTokens_eq_none_iff_failure
      tokens).mp grammarMalformed
  rcases circuitTokenFailure_bounded_exact failure with
    ⟨steps, final, bound, run,
      finalState, outputEmpty⟩
  have bitsEq :=
    encodeTokens_eq_of_decodeTokens_eq_some
      bits tokens tokenDecoded
  refine
    ⟨steps, final, ?_, ?_,
      rejectState_isHalted final finalState,
      finalState, outputEmpty⟩
  · exact Nat.le_trans bound (by
      rw [← bitsEq]
      exact
        circuitFailureEnvelope_le_validWorkBound_encodeTokens
          tokens)
  · unfold rawInputWorkTape
    rw [← bitsEq, pack_encodeTokens]
    exact run

/-- Every source that fails strict-v0 circuit decoding halts at rejection
within the advertised cubic work schedule and exposes no output bytes. -/
theorem malformed_exact
    (bits : BitString)
    (malformed : decodeCircuit bits = none) :
    ∃ steps final,
      steps ≤ validWorkBound bits.length ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (rawInputWorkTape bits)) =
        some final ∧
      machine.isHalted final = true ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases tokenEq : decodeTokens bits with
  | none =>
      have framingFailure :=
        (decodeTokens_eq_none_iff_failure
          bits).mp tokenEq
      rcases
          framingMalformed_bounded_exact
            bits framingFailure with
        ⟨steps, final, bound, run,
          finalState, outputEmpty⟩
      exact
        ⟨steps, final, bound, run,
          rejectState_isHalted final finalState,
          finalState, outputEmpty⟩
  | some tokens =>
      have grammarMalformed :
          decodeCircuitTokens tokens = none := by
        unfold decodeCircuit at malformed
        rw [tokenEq] at malformed
        exact malformed
      exact
        alignedMalformed_bounded_exact
          bits tokens tokenEq grammarMalformed

private theorem reject_accept_iff_not_valid
    (bits : BitString) (final : WorkConfiguration)
    (finalState : final.state = State.reject)
    (invalid : ¬ ValidEncodedCircuit bits) :
    final.state = State.accept ↔
      ValidEncodedCircuit bits := by
  constructor
  · intro accepts
    rw [finalState] at accepts
    contradiction
  · intro valid
    exact False.elim (invalid valid)

private theorem rejectedOutput_eq_validatedSourceBytes
    (bits : BitString) (final : WorkConfiguration)
    (outputEmpty :
      (encodeWorkTape final.tape).outputBits = [])
    (invalid : ¬ ValidEncodedCircuit bits) :
    (encodeWorkTape final.tape).outputBits =
      validatedSourceBytes bits := by
  rw [outputEmpty,
    validatedSourceBytes_of_not_valid invalid]

private theorem wellFormed_allInput_exact
    (bits : BitString) (raw : RawCircuit)
    (decoded : decodeCircuit bits = some raw)
    (wellFormed : raw.wellFormed = true) :
    ∃ steps final,
      steps ≤ validWorkBound bits.length ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (rawInputWorkTape bits)) =
        some final ∧
      machine.isHalted final = true ∧
      (final.state = State.accept ↔
        ValidEncodedCircuit bits) ∧
      (encodeWorkTape final.tape).outputBits =
        validatedSourceBytes bits := by
  have encoded :=
    encodeCircuit_eq_of_decodeCircuit_eq_some
      bits raw decoded
  rcases wellFormed_exact raw wellFormed with
    ⟨steps, bound, run⟩
  have valid : ValidEncodedCircuit bits :=
    (decodeElaboratedCircuit_exists_iff bits).mpr
      ⟨raw, decoded, wellFormed⟩
  refine
    ⟨steps, validFinalConfiguration raw,
      ?_, ?_,
      validFinalConfiguration_isHalted raw,
      ?_, ?_⟩
  · rw [← encoded]
    exact bound
  · rw [← encoded]
    exact run
  · constructor
    · intro _
      exact valid
    · intro _
      simpa [machine] using
        (validFinalConfiguration_state raw)
  · change
      (encodeWorkTape (acceptedTape raw)).outputBits =
        validatedSourceBytes bits
    rw [acceptedTape_outputBits raw, encoded,
      validatedSourceBytes_of_valid valid]

private theorem illFormed_allInput_exact
    (bits : BitString) (raw : RawCircuit)
    (decoded : decodeCircuit bits = some raw)
    (illFormed : raw.wellFormed = false) :
    ∃ steps final,
      steps ≤ validWorkBound bits.length ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (rawInputWorkTape bits)) =
        some final ∧
      machine.isHalted final = true ∧
      (final.state = State.accept ↔
        ValidEncodedCircuit bits) ∧
      (encodeWorkTape final.tape).outputBits =
        validatedSourceBytes bits := by
  rcases illFormed_exact
      bits raw decoded illFormed with
    ⟨steps, final, bound, run, halted,
      finalState, outputEmpty⟩
  have invalid : ¬ ValidEncodedCircuit bits := by
    intro valid
    rcases valid with ⟨packed, elaborated⟩
    unfold decodeElaboratedCircuit at elaborated
    rw [decoded] at elaborated
    have impossible :
        raw.wellFormed = true :=
      (RawCircuit.elaborate_exists_iff_wellFormed
        raw).mp ⟨packed, elaborated⟩
    rw [illFormed] at impossible
    contradiction
  exact
    ⟨steps, final, bound, run, halted,
      reject_accept_iff_not_valid
        bits final finalState invalid,
      rejectedOutput_eq_validatedSourceBytes
        bits final outputEmpty invalid⟩

/-- The strict-v0 parser has one exact, polynomially bounded outcome on
every raw bitstring: accept precisely the valid encodings and preserve
exactly their source bytes; otherwise reject and clear the output. -/
theorem allInput_exact
    (bits : BitString) :
    ∃ steps final,
      steps ≤ validWorkBound bits.length ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (rawInputWorkTape bits)) =
        some final ∧
      machine.isHalted final = true ∧
      (final.state = State.accept ↔
        ValidEncodedCircuit bits) ∧
      (encodeWorkTape final.tape).outputBits =
        validatedSourceBytes bits := by
  cases decoded : decodeCircuit bits with
  | none =>
      rcases malformed_exact bits decoded with
        ⟨steps, final, bound, run, halted,
          finalState, outputEmpty⟩
      have invalid : ¬ ValidEncodedCircuit bits := by
        intro valid
        rcases valid with ⟨packed, elaborated⟩
        unfold decodeElaboratedCircuit at elaborated
        rw [decoded] at elaborated
        contradiction
      exact
        ⟨steps, final, bound, run, halted,
          reject_accept_iff_not_valid
            bits final finalState invalid,
          rejectedOutput_eq_validatedSourceBytes
            bits final outputEmpty invalid⟩
  | some raw =>
      cases wellFormed : raw.wellFormed with
      | false =>
          exact
            illFormed_allInput_exact
              bits raw decoded wellFormed
      | true =>
          exact
            wellFormed_allInput_exact
              bits raw decoded wellFormed

end PNP.Concrete.LockedNAND.SourceParser
