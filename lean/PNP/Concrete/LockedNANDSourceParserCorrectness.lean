private theorem ordinaryCell_not_leftGuard
    {symbol : WorkSymbol}
    (ordinary : ordinaryCell symbol) :
    symbol ≠ leftGuard := by
  rcases ordinary with h | h | h | h | h | h <;>
    subst symbol <;> decide

private theorem ordinaryCell_not_blank
    {symbol : WorkSymbol}
    (ordinary : ordinaryCell symbol) :
    symbol ≠ cellBlank := by
  rcases ordinary with h | h | h | h | h | h <;>
    subst symbol <;> decide

private theorem tokenCells_ordinary
    (token : Token) (symbol : WorkSymbol)
    (member : symbol ∈ tokenCells token) :
    ordinaryCell symbol := by
  cases token <;>
    simp [tokenCells, ordinaryCell] at member ⊢ <;>
    rcases member with rfl | rfl <;>
    simp

private theorem packedTokenCells_ordinary
    (tokens : List Token) (symbol : WorkSymbol)
    (member : symbol ∈ packedTokenCells tokens) :
    ordinaryCell symbol := by
  induction tokens with
  | nil =>
      contradiction
  | cons token rest ih =>
      simp only [packedTokenCells,
        List.mem_append] at member
      rcases member with inToken | inRest
      · exact tokenCells_ordinary token symbol inToken
      · exact ih inRest

private theorem ordinaryCell_cell00 :
    ordinaryCell cell00 :=
  Or.inl rfl

private theorem ordinaryCell_cell01 :
    ordinaryCell cell01 :=
  Or.inr (Or.inl rfl)

private theorem ordinaryCell_countMark :
    ordinaryCell countMark :=
  Or.inr (Or.inr (Or.inl rfl))

private theorem ordinaryCell_gateMark :
    ordinaryCell gateMark :=
  Or.inr (Or.inr (Or.inr (Or.inl rfl)))

private theorem ordinaryCell_cell10 :
    ordinaryCell cell10 :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))

private theorem ordinaryCell_cell11 :
    ordinaryCell cell11 :=
  Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))

private theorem ordinaryCells_append
    {first second : List WorkSymbol}
    (firstOrdinary :
      ∀ symbol, symbol ∈ first → ordinaryCell symbol)
    (secondOrdinary :
      ∀ symbol, symbol ∈ second → ordinaryCell symbol) :
    ∀ symbol, symbol ∈ first ++ second →
      ordinaryCell symbol := by
  intro symbol member
  simp only [List.mem_append] at member
  exact member.elim
    (firstOrdinary symbol)
    (secondOrdinary symbol)

private theorem natCells_allOrdinary
    (value : Nat) :
    ∀ symbol, symbol ∈ natCells value →
      ordinaryCell symbol := by
  induction value with
  | zero =>
      intro symbol member
      simp only [natCells, List.mem_cons,
        List.not_mem_nil] at member
      rcases member with rfl | rfl | impossible
      · exact ordinaryCell_cell00
      · exact ordinaryCell_cell10
      · contradiction
  | succ value ih =>
      intro symbol member
      simp only [natCells, List.mem_cons] at member
      rcases member with rfl | rfl | inRest
      · exact ordinaryCell_cell00
      · exact ordinaryCell_cell01
      · exact ih symbol inRest

private theorem countCells_allOrdinary
    (used remaining : Nat) :
    ∀ symbol, symbol ∈ countCells used remaining →
      ordinaryCell symbol := by
  induction used with
  | zero =>
      exact natCells_allOrdinary remaining
  | succ used ih =>
      intro symbol member
      simp only [countCells, List.mem_cons] at member
      rcases member with rfl | rfl | inRest
      · exact ordinaryCell_cell00
      · exact ordinaryCell_countMark
      · exact ih symbol inRest

private theorem ordinaryExplicitFailure_exact
    (parsedPrefix : List WorkSymbol)
    (current : WorkSymbol) (rest : List WorkSymbol)
    (initial : WorkConfiguration) (launchSteps : Nat)
    (ordinary :
      ∀ symbol,
        symbol ∈ parsedPrefix ++ current :: rest →
          ordinaryCell symbol)
    (launch :
      workRunExact? machine launchSteps initial =
        some
          (cleanupSeekConfiguration
            [] (current :: pushCrossed parsedPrefix []) rest)) :
    ∃ steps final,
      workRunExact? machine steps initial = some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let scan := current :: pushCrossed parsedPrefix []
  have forwardEq :
      pushCleanupScan scan rest =
        parsedPrefix ++ current :: rest := by
    exact explicitFailureForward_eq
      parsedPrefix current rest
  have noGuard :
      ∀ symbol, symbol ∈ scan →
        symbol ≠ leftGuard := by
    intro symbol member
    apply ordinaryCell_not_leftGuard
    apply ordinary symbol
    have forwardMember :
        symbol ∈ pushCleanupScan scan rest :=
      (pushCleanupScan_mem_iff scan rest symbol).mpr
        (Or.inl member)
    rwa [forwardEq] at forwardMember
  have nonblank :
      ∀ symbol,
        symbol ∈ pushCleanupScan scan rest →
          symbol ≠ cellBlank := by
    intro symbol member
    apply ordinaryCell_not_blank
    apply ordinary symbol
    rwa [forwardEq] at member
  have cleanup :=
    guardedCleanupFinite_exact
      [] scan rest noGuard nonblank
  let steps :=
    launchSteps + guardedCleanupSteps scan rest
  let final :=
    cleanupRejectConfiguration [] scan rest []
  refine ⟨steps, final, ?_, rfl, ?_⟩
  · exact exactRun_add launchSteps
      (guardedCleanupSteps scan rest)
      _ _ _ launch cleanup
  · exact cleanupRejectConfiguration_output_empty
      [] scan rest

private theorem guardedConfig_eq_crossed
    (state : Nat) (parsedPrefix word : List WorkSymbol) :
    guardedConfig state parsedPrefix word =
      configAtWord state
        (pushCrossed parsedPrefix [] ++ [leftGuard])
        word := by
  unfold guardedConfig
  simpa using congrArg
    (fun left => configAtWord state left word)
    (pushCrossed_append_suffix
      parsedPrefix [] [leftGuard])

