  rcases List.mem_append.mp member with
    inPrefix | inTail
  · exact packedTokenCells_allOrdinary
      tokens symbol inPrefix
  · exact malformedWorkTail_allOrdinary
      malformed symbol inTail

private theorem packedCircuitGatesPrefixTokens_append
    (inputs : Nat) (gates : List RawGate)
    (tokens : List Token) :
    packedTokenCells
        (circuitGatesPrefixTokens inputs gates ++ tokens) =
      [cell00, cell00] ++ natCells inputs ++
        natCells gates.length ++ gateListCells gates ++
        packedTokenCells tokens := by
  have headerCells :
      packedTokenCells
          (circuitHeaderTokens inputs gates.length) =
        [cell00, cell00] ++ natCells inputs ++
          natCells gates.length := by
    simpa [packedTokenCells] using
      (packedCircuitHeaderTokens_append
        inputs gates.length [])
  unfold circuitGatesPrefixTokens
  rw [packedTokenCells_append,
    packedTokenCells_append,
    packedTokenCells_encodeGateListTokens,
