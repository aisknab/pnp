                  · exact ordinaryCell_cell11
                  · contradiction
                · exact packedTokenCells_ordinary tokens) with
        ⟨steps, final, bound, run,
          finalState, output⟩
      have boundCanonical :
          steps ≤
            32 *
              failureSpanSquare
