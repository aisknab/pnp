    3

private theorem grammarGateDecrement_exact
    (firstWas01 : Bool) (inputs : Nat)
    (done : List RawGate) (remaining : Nat)
    (current : WorkSymbol) (rest : List WorkSymbol) :
    workRunExact? machine
        (grammarGateSourceLaunchSteps
          inputs done remaining)
        (guardedConfig State.gateStart
          (grammarGatePrefix
            inputs done (remaining + 1))
          (firstSourceCell firstWas01 ::
            current :: rest)) =
      some
        (guardedConfig
          (afterFirstSourceState
            firstWas01 .gateLeft)
          (sourceContextPrefix
              inputs (done.length + 1)
              remaining done [] ++
            [firstSourceCell firstWas01])
          (current :: rest)) := by
  let logicalPrefix :=
    grammarGatePrefix
      inputs done (remaining + 1)
  have launch :=
    grammarGateStartLaunch_exact
      firstWas01 logicalPrefix current rest
  have backward :=
    grammarGateSeekGuard_scan_exact
      firstWas01 logicalPrefix
      (cursorMark :: current :: rest)
      (grammarGatePrefix_allOrdinary
        inputs done (remaining + 1))
  have guard :=
    grammarGateSeekGuard_finish_exact
      firstWas01
      (logicalPrefix ++
        cursorMark :: current :: rest)
  rcases
      grammarGateForward_exact firstWas01
        inputs done remaining current rest with
    ⟨forwardSteps, forwardStepsEq, forward⟩
  have throughBackward :=
    exactRun_add 1 logicalPrefix.length
      _ _ _ launch backward
  have throughGuard :=
    exactRun_add
      (1 + logicalPrefix.length) 1
      _ _ _ throughBackward guard
  have all :=
    exactRun_add
      ((1 + logicalPrefix.length) + 1)
      forwardSteps _ _ _ throughGuard forward
  rw [forwardStepsEq] at all
  have costEq :
      ((1 + logicalPrefix.length) + 1) +
          (logicalPrefix.length + 1) =
        2 * logicalPrefix.length + 3 := by
    omega
  rw [costEq] at all
  unfold grammarGateSourceLaunchSteps
  rw [←
    grammarGateParsingPrefix_eq_sourceContext
      inputs done remaining]
  simpa [logicalPrefix] using all

private theorem exactRun_cancel_first
    (steps : Nat)
    (initial middle final : WorkConfiguration)
    (positive : 0 < steps)
    (first :
      workStep? machine initial = some middle)
    (run :
      workRunExact? machine steps initial =
        some final) :
    ∃ tailSteps,
      steps = tailSteps + 1 ∧
      workRunExact? machine tailSteps middle =
        some final := by
  cases steps with
  | zero =>
      exact (Nat.not_lt_zero 0 positive).elim
  | succ tailSteps =>
      refine
        ⟨tailSteps, (Nat.add_one tailSteps).symm, ?_⟩
      change
        (match workStep? machine initial with
         | none => none
         | some next =>
             workRunExact? machine tailSteps next) =
          some final at run
      rw [first] at run
      exact run

private theorem sourceTokenFailure_afterFirst_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    {tokens : List Token}
    (failure : SourceTokenFailure tokens)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (beforeNoGateMark :
      ∀ symbol, symbol ∈ before →
        symbol ≠ gateMark)
    (firstWas01 : Bool) (rest : List WorkSymbol)
    (packed :
      packedTokenCells tokens =
        firstSourceCell firstWas01 :: rest) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    ∃ steps final,
      steps ≤
          2 +
            16 *
              failureSpanSquare
                (sourceTokenFailureSpan
                  inputs gateCountUsed gateCountRemaining
                  priorGates before tokens) ∧
      workRunExact? machine steps
          (guardedConfig
            (afterFirstSourceState
              firstWas01 continuation)
            (context ++
              [firstSourceCell firstWas01])
            rest) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  rcases
      sourceTokenFailure_bounded_exact continuation
        inputs gateCountUsed gateCountRemaining
        priorGates before failure
        beforeOrdinary beforeNoGateMark with
    ⟨fullSteps, final, fullBound, fullRun,
      finalState, output⟩
  rw [packed] at fullRun
  have first :=
    sourceFirstRemainder_exact
      continuation firstWas01 context rest
  have firstStep :
      workStep? machine
          (guardedConfig
            (State.sourceStart continuation)
            context
            (firstSourceCell firstWas01 :: rest)) =
        some
          (guardedConfig
            (afterFirstSourceState
              firstWas01 continuation)
            (context ++
              [firstSourceCell firstWas01])
            rest) := by
    cases continuation <;> cases firstWas01 <;>
      unfold guardedConfig <;>
      rw [pushCrossed_append] <;> rfl
  have positive : 0 < fullSteps := by
    cases fullSteps with
    | zero =>
        have initialEq :
            guardedConfig
                (State.sourceStart continuation)
                context
                (firstSourceCell
                  firstWas01 :: rest) =
              final :=
          Option.some.inj fullRun
        have stateEq :
            State.sourceStart continuation =
              final.state := by
          simpa [guardedConfig, configAtWord] using
            congrArg (fun config => config.state)
              initialEq
        have notReject :
            State.sourceStart continuation ≠
              State.reject := by
          cases continuation <;> decide
        exact False.elim
          (notReject (stateEq.trans finalState))
    | succ tailSteps =>
        omega
  rcases
      exactRun_cancel_first fullSteps
        (guardedConfig
          (State.sourceStart continuation)
          context
          (firstSourceCell firstWas01 :: rest))
        (guardedConfig
          (afterFirstSourceState
            firstWas01 continuation)
          (context ++
            [firstSourceCell firstWas01])
          rest)
        final positive firstStep fullRun with
    ⟨tailSteps, stepsEq, tail⟩
  exact
    ⟨tailSteps, final,
      Nat.le_trans (by omega) fullBound, tail,
      finalState, output⟩

