    gateFailureFootprint
        (gateReferenceHeader
          inputs gateCountUsed gateCountRemaining)
        [] priorGates
        (gateSourceFailureBetween before)
        index suffix =
      sourceFailureSpan inputs gateCountUsed
        gateCountRemaining priorGates before
        (.gate index) suffix := by
  unfold gateFailureFootprint
  unfold gateReferenceFootprint
  unfold gateSourceFailureBetween
  unfold sourceFailureSpan sourceSpan
  unfold sourceContextPrefix
  simp only [borrowedGateListCells,
    List.length_append, List.length_cons,
    List.length_nil, sourceCells]
  omega

private theorem sourceBoundFailureRemainder_bounded_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    (source : RawSource) (suffix : List WorkSymbol)
    (failure :
      SourceBoundFailure
        inputs priorGates.length source)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (beforeNoGateMark :
      ∀ symbol, symbol ∈ before →
        symbol ≠ gateMark)
    (suffixOrdinary :
      ∀ symbol, symbol ∈ suffix →
        ordinaryCell symbol) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    ∃ steps final,
      steps ≤
          1 +
            16 *
              ((sourceFailureSpan
                    inputs gateCountUsed
                    gateCountRemaining priorGates
                    before source suffix + 1) *
                (sourceFailureSpan
                    inputs gateCountUsed
                    gateCountRemaining priorGates
                    before source suffix + 1)) ∧
      workRunExact? machine steps
          (guardedConfig
            (afterFirstSourceState
              (sourceFirstWas01 source) continuation)
            (context ++
              [firstSourceCell
                (sourceFirstWas01 source)])
            (sourceRemainderCells source ++ suffix)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  cases failure with
  | input index outOfRange =>
      let between :=
        inputSourceFailureBetween
          gateCountUsed gateCountRemaining
          priorGates before
      have betweenOrdinary :
          ∀ symbol, symbol ∈ between →
            ordinaryCell symbol := by
        unfold between inputSourceFailureBetween
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact countCells_allOrdinary
                gateCountUsed gateCountRemaining
            · exact markedGateListCells_allOrdinary
                priorGates
          · exact beforeOrdinary
        · intro symbol member
          simp only [List.mem_cons,
            List.not_mem_nil] at member
          rcases member with rfl | rfl | impossible
          · exact ordinaryCell_cell00
          · exact ordinaryCell_cell11
          · contradiction
      have range : inputs ≤ index := by
        omega
      have launch :=
        sourceInputRemainderTag_exact
          continuation (context ++ [cell00])
          (natCells index ++ suffix)
      have launchCanonical :
          workRunExact? machine 1
              (guardedConfig
                (afterFirstSourceState
                  (sourceFirstWas01
                    (.input index)) continuation)
                (context ++
                  [firstSourceCell
                    (sourceFirstWas01
                      (.input index))])
                (sourceRemainderCells
                    (.input index) ++ suffix)) =
            some
              (guardedConfig
                (State.indexFirst .input continuation)
                (context ++ [cell00, cell11])
                (natCells index ++ suffix)) := by
        simpa [sourceFirstWas01, firstSourceCell,
          afterFirstSourceState, sourceRemainderCells,
          List.append_assoc] using launch
      rcases
          inputBoundFailure_exact
            continuation 0 inputs index between suffix
            betweenOrdinary suffixOrdinary range with
        ⟨final, tail, finalState, output⟩
      have tailCanonical :
          workRunExact? machine
              (inputBoundFailureSteps
                0 inputs between index suffix)
              (guardedConfig
                (State.indexFirst .input continuation)
                (context ++ [cell00, cell11])
                (natCells index ++ suffix)) =
            some final := by
        simpa [inputReferenceConfiguration,
          context, sourceContextPrefix,
          gateReferenceHeader, between,
          inputSourceFailureBetween,
          countCells, List.append_assoc] using tail
      have all :=
        exactRun_add 1
          (inputBoundFailureSteps
            0 inputs between index suffix)
          _ _ _ launchCanonical tailCanonical
      have scheduleBound :=
        inputBoundFailureSteps_square_bound
          0 inputs index between suffix
      rw [inputSourceFailureFootprint_eq
        inputs gateCountUsed gateCountRemaining
        priorGates before suffix index] at scheduleBound
      refine
        ⟨1 + inputBoundFailureSteps
            0 inputs between index suffix,
          final, ?_, all, finalState, output⟩
      omega
  | gate index outOfRange =>
      let header :=
        gateReferenceHeader
          inputs gateCountUsed gateCountRemaining
      let between := gateSourceFailureBetween before
      have headerOrdinary :
          ∀ symbol, symbol ∈ header →
            ordinaryCell symbol :=
        gateReferenceHeader_allOrdinary
          inputs gateCountUsed gateCountRemaining
      have headerNoGateMark :
          ∀ symbol, symbol ∈ header →
            symbol ≠ gateMark :=
        gateReferenceHeader_no_gateMark
          inputs gateCountUsed gateCountRemaining
      have betweenOrdinary :
          ∀ symbol, symbol ∈ between →
            ordinaryCell symbol := by
        unfold between gateSourceFailureBetween
        apply ordinaryCells_append
        · exact beforeOrdinary
        · intro symbol member
          simp only [List.mem_cons,
            List.not_mem_nil] at member
          rcases member with rfl | rfl | impossible
          · exact ordinaryCell_cell01
          · exact ordinaryCell_cell10
          · contradiction
      have betweenNoGateMark :
          ∀ symbol, symbol ∈ between →
            symbol ≠ gateMark := by
        intro symbol member
        unfold between gateSourceFailureBetween at member
        rcases List.mem_append.mp member with
            inBefore | inTag
        · exact beforeNoGateMark symbol inBefore
        · simp only [List.mem_cons,
            List.not_mem_nil] at inTag
          rcases inTag with rfl | rfl | impossible
          · decide
          · decide
          · contradiction
      have range : priorGates.length ≤ index := by
        omega
      have launch :=
        sourceGateRemainderTag_exact
          continuation (context ++ [cell01])
          (natCells index ++ suffix)
      have launchCanonical :
          workRunExact? machine 1
              (guardedConfig
                (afterFirstSourceState
                  (sourceFirstWas01
                    (.gate index)) continuation)
                (context ++
                  [firstSourceCell
                    (sourceFirstWas01
                      (.gate index))])
                (sourceRemainderCells
                    (.gate index) ++ suffix)) =
            some
              (guardedConfig
                (State.indexFirst
                  .priorGate continuation)
                (context ++ [cell01, cell10])
                (natCells index ++ suffix)) := by
        simpa [sourceFirstWas01, firstSourceCell,
          afterFirstSourceState, sourceRemainderCells,
          List.append_assoc] using launch
      rcases
          gateBoundFailure_exact
            continuation header [] priorGates
            between index suffix headerOrdinary
            headerNoGateMark betweenOrdinary
            betweenNoGateMark suffixOrdinary range with
        ⟨final, tail, finalState, output⟩
      have tailCanonical :
          workRunExact? machine
              (gateBoundFailureSteps
                header [] priorGates between
                index suffix)
              (guardedConfig
                (State.indexFirst
                  .priorGate continuation)
                (context ++ [cell01, cell10])
                (natCells index ++ suffix)) =
            some final := by
        simpa [gateReferenceConfiguration,
          context, sourceContextPrefix,
          header, between,
          gateSourceFailureBetween,
          borrowedGateListCells,
          List.append_assoc] using tail
      have all :=
        exactRun_add 1
          (gateBoundFailureSteps
            header [] priorGates between
            index suffix)
          _ _ _ launchCanonical tailCanonical
      have scheduleBound :=
        gateBoundFailureSteps_square_bound
          header [] priorGates between index suffix
      rw [gateSourceFailureFootprint_eq
        inputs gateCountUsed gateCountRemaining
        priorGates before suffix index] at scheduleBound
      refine
        ⟨1 + gateBoundFailureSteps
            header [] priorGates between
            index suffix,
          final, ?_, all, finalState, output⟩
      omega

private theorem sourceBoundFailure_bounded_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    (source : RawSource) (suffix : List WorkSymbol)
    (failure :
      SourceBoundFailure
        inputs priorGates.length source)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (beforeNoGateMark :
      ∀ symbol, symbol ∈ before →
        symbol ≠ gateMark)
    (suffixOrdinary :
      ∀ symbol, symbol ∈ suffix →
        ordinaryCell symbol) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    ∃ steps final,
      steps ≤
          2 +
            16 *
              ((sourceFailureSpan
                    inputs gateCountUsed
                    gateCountRemaining priorGates
                    before source suffix + 1) *
                (sourceFailureSpan
                    inputs gateCountUsed
                    gateCountRemaining priorGates
                    before source suffix + 1)) ∧
      workRunExact? machine steps
          (guardedConfig
            (State.sourceStart continuation)
            context (sourceCells source ++ suffix)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  have first :=
    sourceFirstRemainder_exact
      continuation (sourceFirstWas01 source)
      context (sourceRemainderCells source ++ suffix)
  have firstCanonical :
      workRunExact? machine 1
          (guardedConfig
            (State.sourceStart continuation)
            context (sourceCells source ++ suffix)) =
        some
          (guardedConfig
            (afterFirstSourceState
              (sourceFirstWas01 source) continuation)
            (context ++
              [firstSourceCell
                (sourceFirstWas01 source)])
            (sourceRemainderCells source ++ suffix)) := by
    cases source with
    | input index =>
        simpa [sourceCells, sourceFirstWas01,
          firstSourceCell, sourceRemainderCells,
          List.append_assoc] using first
    | constant value =>
        cases value <;>
          simpa [sourceCells, sourceFirstWas01,
            firstSourceCell, sourceRemainderCells,
            List.append_assoc] using first
    | gate index =>
        simpa [sourceCells, sourceFirstWas01,
          firstSourceCell, sourceRemainderCells,
          List.append_assoc] using first
  rcases
      sourceBoundFailureRemainder_bounded_exact
        continuation inputs gateCountUsed
        gateCountRemaining priorGates before
        source suffix failure beforeOrdinary
        beforeNoGateMark suffixOrdinary with
    ⟨steps, final, stepsBound, tail,
      finalState, output⟩
  have all :=
    exactRun_add 1 steps
      _ _ _ firstCanonical tail
  refine
    ⟨1 + steps, final, ?_,
      all, finalState, output⟩
  omega

private def failureSpanSquare (span : Nat) : Nat :=
  (span + 1) * (span + 1)

private theorem one_le_failureSpanSquare
    (span : Nat) :
    1 ≤ failureSpanSquare span := by
  have positive : 1 ≤ span + 1 := by
    omega
  have product :=
    Nat.mul_le_mul_left (span + 1) positive
  exact Nat.le_trans positive (by
    simpa [failureSpanSquare] using product)

private theorem failureSpanSquare_mono
    {left right : Nat} (bound : left ≤ right) :
    failureSpanSquare left ≤
      failureSpanSquare right := by
  have successorBound : left + 1 ≤ right + 1 := by
    omega
  unfold failureSpanSquare
  exact Nat.mul_le_mul successorBound successorBound

private def sourceTokenFailureSpan
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    (tokens : List Token) : Nat :=
  (sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before).length +
    (packedTokenCells tokens).length + 2

private theorem linear_failure_le_square
    (steps span : Nat)
    (linear : steps ≤ 4 * (span + 1)) :
    steps ≤ 16 * failureSpanSquare span := by
  have widened :
      steps ≤ 16 * (span + 1) := by
    exact Nat.le_trans linear (by omega)
  have positive : 1 ≤ span + 1 := by
    omega
  have squareBase :
      span + 1 ≤ failureSpanSquare span := by
    simpa [failureSpanSquare] using
      Nat.mul_le_mul_left (span + 1) positive
  exact Nat.le_trans widened
    (Nat.mul_le_mul_left 16 squareBase)

private theorem sourceMissingTokenSteps_linear_bound
    (context : List WorkSymbol) :
    missingEndTailSteps
        (pushCrossed context []) ≤
      4 * ((context.length + 2) + 1) := by
  unfold missingEndTailSteps
  rw [guardedCleanupExplicitSteps_eq]
  unfold missingEndScan missingEndEraseWord
  simp only [List.length_cons, List.length_nil,
    pushCrossed_length, pushCleanupScan_length]
  omega

private theorem sourceWrongTokenSteps_linear_bound
    (context : List WorkSymbol)
    (token : Token) (suffixCells : List WorkSymbol) :
    sourceWrongTokenSteps context token suffixCells ≤
      4 *
        ((context.length + (tokenCells token).length +
          suffixCells.length + 2) + 1) := by
  cases token <;>
    simp only [sourceWrongTokenSteps]
  all_goals
    first
    | exact Nat.zero_le _
    | (rw [guardedCleanupSteps_eq]
       simp only [List.length_append, List.length_cons,
         List.length_nil, pushCrossed_length,
         tokenCells_length]
       omega)

private theorem inputMissingSourceFootprint_le
    (inputs gateCountUsed gateCountRemaining units : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol) :
    inputFailureFootprint 0 inputs
        (inputSourceFailureBetween
          gateCountUsed gateCountRemaining
          priorGates before)
        units [] ≤
      sourceTokenFailureSpan
        inputs gateCountUsed gateCountRemaining
        priorGates before
        (.input :: List.replicate units .unit) := by
  unfold inputFailureFootprint inputReferenceFootprint
  unfold inputSourceFailureBetween
  unfold sourceTokenFailureSpan sourceContextPrefix
  unfold gateReferenceHeader
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    natCells_length, packedTokenCells_length,
    List.length_replicate]
  omega

private theorem inputWrongSourceFootprint_le
    (inputs gateCountUsed gateCountRemaining units : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    (token : Token) (suffix : List Token) :
    inputFailureFootprint 0 inputs
        (inputSourceFailureBetween
          gateCountUsed gateCountRemaining
          priorGates before)
        units (packedTokenCells suffix) ≤
      sourceTokenFailureSpan
        inputs gateCountUsed gateCountRemaining
        priorGates before
        (.input ::
          (List.replicate units .unit ++
            token :: suffix)) := by
  unfold inputFailureFootprint inputReferenceFootprint
  unfold inputSourceFailureBetween
  unfold sourceTokenFailureSpan sourceContextPrefix
  unfold gateReferenceHeader
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    natCells_length, packedTokenCells_length,
    List.length_replicate]
  omega

private theorem gateMissingSourceFootprint_le
    (inputs gateCountUsed gateCountRemaining units : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol) :
    gateFailureFootprint
        (gateReferenceHeader
          inputs gateCountUsed gateCountRemaining)
        [] priorGates
        (gateSourceFailureBetween before)
        units [] ≤
      sourceTokenFailureSpan
        inputs gateCountUsed gateCountRemaining
        priorGates before
        (.gate :: List.replicate units .unit) := by
  unfold gateFailureFootprint gateReferenceFootprint
  unfold gateSourceFailureBetween
  unfold sourceTokenFailureSpan sourceContextPrefix
  simp only [borrowedGateListCells,
    List.length_append, List.length_cons,
    List.length_nil, natCells_length,
    packedTokenCells_length, List.length_replicate]
  omega

private theorem gateWrongSourceFootprint_le
    (inputs gateCountUsed gateCountRemaining units : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    (token : Token) (suffix : List Token) :
    gateFailureFootprint
        (gateReferenceHeader
          inputs gateCountUsed gateCountRemaining)
        [] priorGates
        (gateSourceFailureBetween before)
        units (packedTokenCells suffix) ≤
      sourceTokenFailureSpan
        inputs gateCountUsed gateCountRemaining
        priorGates before
        (.gate ::
          (List.replicate units .unit ++
            token :: suffix)) := by
  unfold gateFailureFootprint gateReferenceFootprint
  unfold gateSourceFailureBetween
  unfold sourceTokenFailureSpan sourceContextPrefix
  simp only [borrowedGateListCells,
    List.length_append, List.length_cons,
    List.length_nil, natCells_length,
    packedTokenCells_length, List.length_replicate]
  omega

private theorem sourceTokenFailure_bounded_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    {tokens : List Token}
    (failure : SourceTokenFailure tokens)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (beforeNoGateMark :
      ∀ symbol, symbol ∈ before →
        symbol ≠ gateMark) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    ∃ steps final,
      steps ≤
          2 +
            16 *
              failureSpanSquare
                (sourceTokenFailureSpan
                  inputs gateCountUsed gateCountRemaining
                  priorGates before tokens) ∧
      workRunExact? machine steps
          (guardedConfig
            (State.sourceStart continuation)
            context (packedTokenCells tokens)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  have contextOrdinary :
      ∀ symbol, symbol ∈ context →
        ordinaryCell symbol := by
    exact sourceContextPrefix_allOrdinary
      inputs gateCountUsed gateCountRemaining
      priorGates before beforeOrdinary
  cases failure with
  | missing =>
      let crossed := pushCrossed context []
      let final :=
        cleanupExplicitRejectConfiguration
          [] (missingEndEraseWord crossed) []
      have run :=
        sourceMissingToken_exact
          continuation context contextOrdinary
      have linear :=
        sourceMissingTokenSteps_linear_bound context
      have scheduleBound :=
        linear_failure_le_square
          (missingEndTailSteps
            (pushCrossed context []))
          (context.length + 2) linear
      refine
        ⟨missingEndTailSteps crossed, final,
          ?_, ?_, rfl, ?_⟩
      · have spanEq :
            sourceTokenFailureSpan
                inputs gateCountUsed gateCountRemaining
                priorGates before [] =
              context.length + 2 := by
          simp [sourceTokenFailureSpan,
            context, packedTokenCells]
        rw [spanEq]
        dsimp [crossed]
        omega
      · simpa [context, crossed, final,
          packedTokenCells] using run
      · rfl
  | wrongHead token suffix
      notInput notFalse notTrue notGate =>
      have run :=
        sourceWrongTokenCost_exact
          continuation context contextOrdinary
          token suffix notInput notFalse notTrue notGate
      rcases run with
        ⟨final, trace, finalState, output⟩
      have linear :=
        sourceWrongTokenSteps_linear_bound
          context token (packedTokenCells suffix)
      have scheduleBound :=
        linear_failure_le_square
          (sourceWrongTokenSteps context token
            (packedTokenCells suffix))
          (context.length + (tokenCells token).length +
            (packedTokenCells suffix).length + 2)
          linear
      refine
        ⟨sourceWrongTokenSteps context token
            (packedTokenCells suffix),
          final, ?_, trace, finalState, output⟩
      have spanEq :
          sourceTokenFailureSpan
              inputs gateCountUsed gateCountRemaining
              priorGates before (token :: suffix) =
            context.length + (tokenCells token).length +
              (packedTokenCells suffix).length + 2 := by
        simp [sourceTokenFailureSpan, context,
          packedTokenCells, List.length_append,
          Nat.add_assoc]
      rw [spanEq]
      omega
  | inputIndex failure =>
      let between :=
        inputSourceFailureBetween
          gateCountUsed gateCountRemaining
          priorGates before
      have betweenOrdinary :
          ∀ symbol, symbol ∈ between →
            ordinaryCell symbol := by
        unfold between inputSourceFailureBetween
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact countCells_allOrdinary
                gateCountUsed gateCountRemaining
            · exact markedGateListCells_allOrdinary
                priorGates
          · exact beforeOrdinary
        · intro symbol member
          simp only [List.mem_cons,
            List.not_mem_nil] at member
          rcases member with rfl | rfl | impossible
          · exact ordinaryCell_cell00
          · exact ordinaryCell_cell11
          · contradiction
      cases failure with
      | missingEnd units =>
          let indexTail := unaryUnitCells units
          have launch :=
            sourceInputTag_exact
              continuation context indexTail
          have launchCanonical :
              workRunExact? machine 2
                  (guardedConfig
                    (State.sourceStart continuation)
                    context
                    (packedTokenCells
                      (.input ::
                        List.replicate units .unit))) =
                some
                  (guardedConfig
                    (State.indexFirst .input continuation)
                    (context ++ [cell00, cell11])
                    indexTail) := by
            simpa [indexTail, packedTokenCells,
              tokenCells,
              packedTokenCells_replicate_unit] using launch
          rcases
              inputMissingReference_exact
                continuation 0 inputs units between
                betweenOrdinary with
            ⟨final, tail, finalState, output⟩
          have tailCanonical :
              workRunExact? machine
                  (inputMissingReferenceSteps
                    0 inputs between units)
                  (guardedConfig
                    (State.indexFirst .input continuation)
                    (context ++ [cell00, cell11])
                    indexTail) =
                some final := by
            simpa [context, sourceContextPrefix,
              gateReferenceHeader, between,
              inputSourceFailureBetween,
              countCells, indexTail,
              List.append_assoc] using tail
          have all :=
            exactRun_add 2
              (inputMissingReferenceSteps
                0 inputs between units)
              _ _ _ launchCanonical tailCanonical
          have referenceBound :=
            inputMissingReferenceSteps_square_bound
              0 inputs units between
          have footprintLe :=
            inputMissingSourceFootprint_le
              inputs gateCountUsed gateCountRemaining
              units priorGates before
          have squareLe :=
            failureSpanSquare_mono footprintLe
          have tailBound :=
            Nat.le_trans referenceBound
              (Nat.mul_le_mul_left 16 squareLe)
          refine
            ⟨2 + inputMissingReferenceSteps
                0 inputs between units,
              final, ?_, ?_, finalState, output⟩
          · exact Nat.add_le_add_left tailBound 2
          · simpa [between, context] using all
      | wrongToken units token suffix
          notUnit notNatEnd =>
          let indexTail :=
            malformedNatTailCells units token suffix
          have packedEq :
              packedTokenCells
                  (List.replicate units .unit ++
                    token :: suffix) =
                indexTail := by
            rw [packedTokenCells_append,
              packedTokenCells_replicate_unit]
            simp [indexTail, malformedNatTailCells,
              packedTokenCells, tokenCells]
          have launch :=
            sourceInputTag_exact
              continuation context indexTail
          have launchCanonical :
              workRunExact? machine 2
                  (guardedConfig
                    (State.sourceStart continuation)
                    context
                    (packedTokenCells
                      (.input ::
                        (List.replicate units .unit ++
                          token :: suffix)))) =
                some
                  (guardedConfig
                    (State.indexFirst .input continuation)
                    (context ++ [cell00, cell11])
                    indexTail) := by
            simpa [packedTokenCells, tokenCells,
              packedEq] using launch
          rcases
              inputWrongReference_exact
                continuation 0 inputs units between
                token suffix betweenOrdinary
                notUnit notNatEnd with
            ⟨final, tail, finalState, output⟩
          have tailCanonical :
              workRunExact? machine
                  (inputWrongReferenceSteps
                    0 inputs between units token suffix)
                  (guardedConfig
                    (State.indexFirst .input continuation)
                    (context ++ [cell00, cell11])
                    indexTail) =
                some final := by
            simpa [context, sourceContextPrefix,
              gateReferenceHeader, between,
              inputSourceFailureBetween,
              countCells, indexTail,
              List.append_assoc] using tail
          have all :=
            exactRun_add 2
              (inputWrongReferenceSteps
                0 inputs between units token suffix)
              _ _ _ launchCanonical tailCanonical
          have referenceBound :=
            inputWrongReferenceSteps_square_bound
              0 inputs units between token suffix
          have footprintLe :=
            inputWrongSourceFootprint_le
              inputs gateCountUsed gateCountRemaining
              units priorGates before token suffix
          have squareLe :=
            failureSpanSquare_mono footprintLe
          have tailBound :=
            Nat.le_trans referenceBound
              (Nat.mul_le_mul_left 16 squareLe)
          refine
            ⟨2 + inputWrongReferenceSteps
                0 inputs between units token suffix,
              final, ?_, ?_, finalState, output⟩
          · exact Nat.add_le_add_left tailBound 2
          · simpa [between, context] using all
  | gateIndex failure =>
      let header :=
        gateReferenceHeader
          inputs gateCountUsed gateCountRemaining
      let between := gateSourceFailureBetween before
      have headerOrdinary :
          ∀ symbol, symbol ∈ header →
            ordinaryCell symbol := by
        exact gateReferenceHeader_allOrdinary
          inputs gateCountUsed gateCountRemaining
      have headerNoGateMark :
          ∀ symbol, symbol ∈ header →
            symbol ≠ gateMark := by
        exact gateReferenceHeader_no_gateMark
          inputs gateCountUsed gateCountRemaining
      have betweenOrdinary :
          ∀ symbol, symbol ∈ between →
            ordinaryCell symbol := by
        unfold between gateSourceFailureBetween
        apply ordinaryCells_append
        · exact beforeOrdinary
        · intro symbol member
          simp only [List.mem_cons,
            List.not_mem_nil] at member
          rcases member with rfl | rfl | impossible
          · exact ordinaryCell_cell01
          · exact ordinaryCell_cell10
          · contradiction
      have betweenNoGateMark :
          ∀ symbol, symbol ∈ between →
            symbol ≠ gateMark := by
        intro symbol member
        unfold between gateSourceFailureBetween at member
        rcases List.mem_append.mp member with
            inBefore | inTag
        · exact beforeNoGateMark symbol inBefore
        · simp only [List.mem_cons,
            List.not_mem_nil] at inTag
          rcases inTag with rfl | rfl | impossible
          · decide
          · decide
          · contradiction
      cases failure with
      | missingEnd units =>
          let indexTail := unaryUnitCells units
          have launch :=
            sourceGateTag_exact
              continuation context indexTail
          have launchCanonical :
              workRunExact? machine 2
                  (guardedConfig
                    (State.sourceStart continuation)
                    context
                    (packedTokenCells
                      (.gate ::
                        List.replicate units .unit))) =
                some
                  (guardedConfig
                    (State.indexFirst
                      .priorGate continuation)
                    (context ++ [cell01, cell10])
                    indexTail) := by
            simpa [indexTail, packedTokenCells,
              tokenCells,
              packedTokenCells_replicate_unit] using launch
          rcases
              gateMissingReference_exact
                continuation header [] priorGates
                between units headerOrdinary
                headerNoGateMark betweenOrdinary
                betweenNoGateMark with
            ⟨final, tail, finalState, output⟩
          have tailCanonical :
              workRunExact? machine
                  (gateMissingReferenceSteps
                    header [] priorGates between units)
                  (guardedConfig
                    (State.indexFirst
                      .priorGate continuation)
                    (context ++ [cell01, cell10])
                    indexTail) =
                some final := by
            simpa [context, sourceContextPrefix,
              header, between,
              gateSourceFailureBetween,
              borrowedGateListCells,
              indexTail, List.append_assoc] using tail
          have all :=
            exactRun_add 2
              (gateMissingReferenceSteps
                header [] priorGates between units)
              _ _ _ launchCanonical tailCanonical
          have referenceBound :=
            gateMissingReferenceSteps_square_bound
              header [] priorGates between units
          have footprintLe :=
            gateMissingSourceFootprint_le
              inputs gateCountUsed gateCountRemaining
              units priorGates before
          have squareLe :=
            failureSpanSquare_mono footprintLe
          have tailBound :=
            Nat.le_trans referenceBound
              (Nat.mul_le_mul_left 16 squareLe)
          refine
            ⟨2 + gateMissingReferenceSteps
                header [] priorGates between units,
              final, ?_, ?_, finalState, output⟩
          · exact Nat.add_le_add_left tailBound 2
          · simpa [header, between, context] using all
      | wrongToken units token suffix
          notUnit notNatEnd =>
          let indexTail :=
            malformedNatTailCells units token suffix
          have packedEq :
              packedTokenCells
                  (List.replicate units .unit ++
                    token :: suffix) =
                indexTail := by
            rw [packedTokenCells_append,
              packedTokenCells_replicate_unit]
            simp [indexTail, malformedNatTailCells,
              packedTokenCells, tokenCells]
          have launch :=
            sourceGateTag_exact
              continuation context indexTail
          have launchCanonical :
              workRunExact? machine 2
                  (guardedConfig
                    (State.sourceStart continuation)
                    context
                    (packedTokenCells
                      (.gate ::
                        (List.replicate units .unit ++
                          token :: suffix)))) =
                some
                  (guardedConfig
                    (State.indexFirst
                      .priorGate continuation)
                    (context ++ [cell01, cell10])
                    indexTail) := by
            simpa [packedTokenCells, tokenCells,
              packedEq] using launch
          rcases
              gateWrongReference_exact
                continuation header [] priorGates
                between units token suffix
                headerOrdinary headerNoGateMark
                betweenOrdinary betweenNoGateMark
                notUnit notNatEnd with
            ⟨final, tail, finalState, output⟩
          have tailCanonical :
              workRunExact? machine
                  (gateWrongReferenceSteps
                    header [] priorGates between
                    units token suffix)
                  (guardedConfig
                    (State.indexFirst
                      .priorGate continuation)
                    (context ++ [cell01, cell10])
                    indexTail) =
                some final := by
            simpa [context, sourceContextPrefix,
              header, between,
              gateSourceFailureBetween,
              borrowedGateListCells,
              indexTail, List.append_assoc] using tail
          have all :=
            exactRun_add 2
              (gateWrongReferenceSteps
                header [] priorGates between
                units token suffix)
              _ _ _ launchCanonical tailCanonical
          have referenceBound :=
            gateWrongReferenceSteps_square_bound
              header [] priorGates between
              units token suffix
          have footprintLe :=
            gateWrongSourceFootprint_le
              inputs gateCountUsed gateCountRemaining
              units priorGates before token suffix
          have squareLe :=
            failureSpanSquare_mono footprintLe
          have tailBound :=
            Nat.le_trans referenceBound
              (Nat.mul_le_mul_left 16 squareLe)
          refine
            ⟨2 + gateWrongReferenceSteps
                header [] priorGates between
                units token suffix,
              final, ?_, ?_, finalState, output⟩
          · exact Nat.add_le_add_left tailBound 2
          · simpa [header, between, context] using all

private def decodedGateFailureSpan
    (inputs : Nat) (done : List RawGate)
    (gate : RawGate) (todo : List RawGate)
    (after : List WorkSymbol) : Nat :=
  gateWorkspace inputs done (gate :: todo) +
    after.length

private theorem gateLeftFailureSpan_eq
    (inputs : Nat) (done : List RawGate)
    (gate : RawGate) (todo : List RawGate)
    (after : List WorkSymbol) :
    sourceFailureSpan inputs (done.length + 1)
        todo.length done [] gate.left
        (sourceCells gate.right ++
          [cell01, cell11] ++
          gateListCells todo ++ after) =
      decodedGateFailureSpan
        inputs done gate todo after := by
  unfold sourceFailureSpan sourceSpan
  unfold sourceContextPrefix gateReferenceHeader
  unfold decodedGateFailureSpan gateWorkspace
  unfold gatePrefix
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    markedGateListCells_length, gateListCells,
    gateCells, natCells_length]
  omega

private theorem gateRightFailureSpan_eq
    (inputs : Nat) (done : List RawGate)
    (gate : RawGate) (todo : List RawGate)
    (after : List WorkSymbol) :
    sourceFailureSpan inputs (done.length + 1)
        todo.length done (sourceCells gate.left)
        gate.right
        ([cell01, cell11] ++
          gateListCells todo ++ after) =
      decodedGateFailureSpan
        inputs done gate todo after := by
  unfold sourceFailureSpan sourceSpan
  unfold sourceContextPrefix gateReferenceHeader
  unfold decodedGateFailureSpan gateWorkspace
  unfold gatePrefix
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    markedGateListCells_length, gateListCells,
    gateCells, natCells_length]
  omega

private theorem gateSourceLaunchSteps_bound
    (inputs : Nat) (done : List RawGate)
    (gate : RawGate) (todo : List RawGate)
    (after : List WorkSymbol) :
    gateSourceLaunchSteps inputs done gate todo ≤
      8 *
        failureSpanSquare
          (decodedGateFailureSpan
            inputs done gate todo after) := by
  let span :=
    decodedGateFailureSpan
      inputs done gate todo after
  have prefixLe :
      (gatePrefix inputs done (gate :: todo)).length ≤
        span := by
    unfold span decodedGateFailureSpan gateWorkspace
    omega
  have positive : 1 ≤ span + 1 := by
    omega
  have squareBase :
      span + 1 ≤ failureSpanSquare span := by
    simpa [failureSpanSquare] using
      Nat.mul_le_mul_left (span + 1) positive
  change
    gateSourceLaunchSteps inputs done gate todo ≤
      8 * failureSpanSquare span
  unfold gateSourceLaunchSteps
  omega

private theorem decodedGateBoundFailure_bounded_exact
    (inputs : Nat) (done : List RawGate)
    (gate : RawGate) (todo : List RawGate)
    (after : List WorkSymbol)
    (failure :
      GateBoundFailure inputs done.length gate)
    (afterOrdinary :
      ∀ symbol, symbol ∈ after →
        ordinaryCell symbol) :
    ∃ steps final,
      steps ≤
          64 *
            failureSpanSquare
              (decodedGateFailureSpan
                inputs done gate todo after) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (gatePrefix inputs done (gate :: todo))
            (gateCells gate ++
              gateListCells todo ++ after)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases failure with
  | left left right sourceFailure =>
      let currentGate : RawGate :=
        { left := left, right := right }
      let sourceSuffix :=
        sourceCells right ++ [cell01, cell11] ++
          gateListCells todo ++ after
      have sourceSuffixOrdinary :
          ∀ symbol, symbol ∈ sourceSuffix →
            ordinaryCell symbol := by
        unfold sourceSuffix
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact sourceCells_allOrdinary right
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with
                  rfl | rfl | impossible
              · exact ordinaryCell_cell01
              · exact ordinaryCell_cell11
              · contradiction
          · exact gateListCells_allOrdinary todo
        · exact afterOrdinary
      have launch :=
        gateLeftRemainder_exact
          inputs done currentGate todo after
      rcases
          sourceBoundFailureRemainder_bounded_exact
            .gateLeft inputs (done.length + 1)
            todo.length done [] left sourceSuffix
            sourceFailure
            (by intro symbol member; contradiction)
            (by intro symbol member; contradiction)
            sourceSuffixOrdinary with
        ⟨tailSteps, final, tailBound, tail,
          finalState, output⟩
      dsimp [currentGate, sourceSuffix] at launch tail
      have tailCanonical :
          workRunExact? machine tailSteps
              (guardedConfig
                (afterFirstSourceState
                  (sourceFirstWas01 left) .gateLeft)
                (sourceContextPrefix inputs
                    (done.length + 1) todo.length
                    done [] ++
                  [firstSourceCell
                    (sourceFirstWas01 left)])
                (sourceRemainderCells left ++
                  sourceCells right ++
                  [cell01, cell11] ++
                  gateListCells todo ++ after)) =
            some final := by
        simpa only [List.append_assoc] using tail
      have all :=
        exactRun_add
          (gateSourceLaunchSteps
            inputs done currentGate todo)
          tailSteps _ _ _ launch tailCanonical
      have launchBound :=
        gateSourceLaunchSteps_bound
          inputs done currentGate todo after
      have spanEq :=
        gateLeftFailureSpan_eq
          inputs done currentGate todo after
      have tailBoundCanonical :
          tailSteps ≤
            1 +
              16 *
                failureSpanSquare
                  (decodedGateFailureSpan
                    inputs done currentGate todo after) := by
        rw [← spanEq]
        simpa [failureSpanSquare, currentGate,
          sourceSuffix, List.append_assoc] using tailBound
      have one :=
        one_le_failureSpanSquare
          (decodedGateFailureSpan
            inputs done currentGate todo after)
      refine
        ⟨gateSourceLaunchSteps
            inputs done currentGate todo + tailSteps,
          final, ?_, ?_, finalState, output⟩
      · dsimp [currentGate] at launchBound tailBoundCanonical one ⊢
        omega
      · simpa [currentGate, sourceSuffix] using all
  | right left right leftValid sourceFailure =>
      let currentGate : RawGate :=
        { left := left, right := right }
      let leftSuffix :=
        sourceCells right ++ [cell01, cell11] ++
          gateListCells todo ++ after
      let rightSuffix :=
        [cell01, cell11] ++
          gateListCells todo ++ after
      have leftSuffixOrdinary :
          ∀ symbol, symbol ∈ leftSuffix →
            ordinaryCell symbol := by
        unfold leftSuffix
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · apply ordinaryCells_append
            · exact sourceCells_allOrdinary right
            · intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with
                  rfl | rfl | impossible
              · exact ordinaryCell_cell01
              · exact ordinaryCell_cell11
              · contradiction
          · exact gateListCells_allOrdinary todo
        · exact afterOrdinary
      have rightSuffixOrdinary :
          ∀ symbol, symbol ∈ rightSuffix →
            ordinaryCell symbol := by
        unfold rightSuffix
        apply ordinaryCells_append
        · apply ordinaryCells_append
          · intro symbol member
            simp only [List.mem_cons,
              List.not_mem_nil] at member
            rcases member with
                rfl | rfl | impossible
            · exact ordinaryCell_cell01
            · exact ordinaryCell_cell11
            · contradiction
          · exact gateListCells_allOrdinary todo
        · exact afterOrdinary
      have launch :=
        gateLeftRemainder_exact
          inputs done currentGate todo after
      have leftRun :=
        sourceRemainder_exact
          .gateLeft inputs (done.length + 1)
          todo.length done [] left leftSuffix
          (by intro symbol member; contradiction)
          (by intro symbol member; contradiction)
          leftValid
      rcases
          sourceBoundFailure_bounded_exact
            .gateRight inputs (done.length + 1)
            todo.length done (sourceCells left)
            right rightSuffix sourceFailure
            (sourceCells_allOrdinary left)
            (sourceCells_no_gateMark left)
            rightSuffixOrdinary with
        ⟨tailSteps, final, tailBound, tail,
          finalState, output⟩
      dsimp [currentGate, leftSuffix,
        rightSuffix] at launch leftRun tail
      have leftRunCanonical :
          workRunExact? machine
              (sourceRemainderSteps
                inputs (done.length + 1)
                todo.length done [] left)
              (guardedConfig
                (afterFirstSourceState
                  (sourceFirstWas01 left) .gateLeft)
                (sourceContextPrefix inputs
                    (done.length + 1) todo.length
                    done [] ++
                  [firstSourceCell
                    (sourceFirstWas01 left)])
                (sourceRemainderCells left ++
                  sourceCells right ++
                  [cell01, cell11] ++
                  gateListCells todo ++ after)) =
            some
              (guardedConfig
                (State.sourceStart .gateRight)
                (sourceContextPrefix inputs
                    (done.length + 1) todo.length
                    done [] ++
                  sourceCells left)
                (sourceCells right ++
                  [cell01, cell11] ++
                  gateListCells todo ++ after)) := by
        simpa [sourceDoneState,
          List.append_assoc] using leftRun
      have tailCanonical :
          workRunExact? machine tailSteps
              (guardedConfig
                (State.sourceStart .gateRight)
                (sourceContextPrefix inputs
                    (done.length + 1) todo.length
                    done [] ++
                  sourceCells left)
                (sourceCells right ++
                  [cell01, cell11] ++
                  gateListCells todo ++ after)) =
            some final := by
        simpa [sourceContextPrefix,
          List.append_assoc] using tail
      have throughLeft :=
        exactRun_add
          (gateSourceLaunchSteps
            inputs done currentGate todo)
          (sourceRemainderSteps
            inputs (done.length + 1)
            todo.length done [] left)
          _ _ _ launch leftRunCanonical
      have all :=
        exactRun_add
          (gateSourceLaunchSteps
              inputs done currentGate todo +
            sourceRemainderSteps
              inputs (done.length + 1)
              todo.length done [] left)
          tailSteps _ _ _ throughLeft tailCanonical
      have launchBound :=
        gateSourceLaunchSteps_bound
          inputs done currentGate todo after
      have leftScheduleBound :=
        sourceRemainderSteps_bound
          inputs (done.length + 1) todo.length
          done [] left
      have leftSpanBound :
          sourceSpan inputs (done.length + 1)
              todo.length done [] left ≤
            decodedGateFailureSpan
              inputs done currentGate todo after := by
        dsimp [currentGate]
        unfold sourceSpan sourceContextPrefix
        unfold gateReferenceHeader
        unfold decodedGateFailureSpan gateWorkspace
        unfold gatePrefix
        simp only [List.length_append, List.length_cons,
          List.length_nil, countCells_length,
          markedGateListCells_length,
          gateListCells, gateCells, natCells_length]
        omega
      have leftSquareBound :=
        failureSpanSquare_mono leftSpanBound
      have leftBound :
          sourceRemainderSteps
                inputs (done.length + 1)
                todo.length done [] left ≤
            1 +
              8 *
                failureSpanSquare
                  (decodedGateFailureSpan
                    inputs done currentGate todo after) := by
        exact Nat.le_trans leftScheduleBound
          (Nat.add_le_add_left
            (Nat.mul_le_mul_left 8 leftSquareBound) 1)
      have spanEq :=
        gateRightFailureSpan_eq
          inputs done currentGate todo after
      have tailBoundCanonical :
          tailSteps ≤
            2 +
              16 *
                failureSpanSquare
                  (decodedGateFailureSpan
                    inputs done currentGate todo after) := by
        rw [← spanEq]
        simpa [failureSpanSquare, currentGate,
          rightSuffix, List.append_assoc] using tailBound
      have one :=
        one_le_failureSpanSquare
          (decodedGateFailureSpan
            inputs done currentGate todo after)
      refine
        ⟨(gateSourceLaunchSteps
              inputs done currentGate todo +
            sourceRemainderSteps
              inputs (done.length + 1)
              todo.length done [] left) +
            tailSteps,
          final, ?_, ?_, finalState, output⟩
      · dsimp [currentGate] at launchBound leftBound tailBoundCanonical one ⊢
        omega
      · simpa [currentGate, leftSuffix, rightSuffix,
          sourceContextPrefix,
          List.append_assoc] using all

private def decodedGateListFailureSpan
    (inputs : Nat) (done gates : List RawGate)
    (after : List WorkSymbol) : Nat :=
  gateWorkspace inputs done gates + after.length

private theorem decodedGateListFailureSpan_step
    (inputs : Nat) (done : List RawGate)
    (gate : RawGate) (rest : List RawGate)
    (after : List WorkSymbol) :
    decodedGateListFailureSpan
        inputs done (gate :: rest) after =
      decodedGateListFailureSpan
        inputs (done ++ [gate]) rest after := by
  unfold decodedGateListFailureSpan
  rw [gateWorkspace_step]

private theorem decodedGateListBoundFailure_bounded_exact
    (inputs priorGates : Nat)
    (done gates : List RawGate)
    (after : List WorkSymbol)
    (doneLength : done.length = priorGates)
    (failure :
      GateListBoundFailure inputs priorGates gates)
    (afterOrdinary :
      ∀ symbol, symbol ∈ after →
        ordinaryCell symbol) :
    ∃ steps final,
      steps ≤
          gates.length *
            (64 *
              failureSpanSquare
                (decodedGateListFailureSpan
                  inputs done gates after)) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (gatePrefix inputs done gates)
            (gateListCells gates ++ after)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  induction failure generalizing done with
  | head priorGates gate rest gateFailure =>
      have gateFailureCanonical :
          GateBoundFailure inputs done.length gate := by
        simpa [doneLength] using gateFailure
      rcases
          decodedGateBoundFailure_bounded_exact
            inputs done gate rest after
            gateFailureCanonical afterOrdinary with
        ⟨steps, final, bound, run,
          finalState, output⟩
      have boundCanonical :
          steps ≤
            64 *
              failureSpanSquare
                (decodedGateListFailureSpan
                  inputs done (gate :: rest) after) := by
        simpa [decodedGateFailureSpan,
          decodedGateListFailureSpan] using bound
      refine
        ⟨steps, final, ?_, ?_, finalState, output⟩
      · simp only [List.length_cons]
        rw [Nat.succ_mul]
        omega
      · simpa [gateListCells,
          List.append_assoc] using run
  | rest priorGates gate remaining
      gateValid restFailure ih =>
      have gateValidCanonical :
          gate.wellFormed inputs done.length = true := by
        simpa [doneLength] using gateValid
      have first :=
        gate_exact inputs done gate remaining
          after gateValidCanonical
      have nextDoneLength :
          (done ++ [gate]).length =
            priorGates + 1 := by
        simp [List.length_append, doneLength]
      rcases ih (done ++ [gate]) nextDoneLength with
        ⟨tailSteps, final, tailBound, tail,
          finalState, output⟩
      have spanEq :=
        decodedGateListFailureSpan_step
          inputs done gate remaining after
      rw [← spanEq] at tailBound
      have workspaceLe :
          gateWorkspace inputs done
              (gate :: remaining) ≤
            decodedGateListFailureSpan
              inputs done (gate :: remaining) after := by
        unfold decodedGateListFailureSpan
        omega
      have squareLe :=
        failureSpanSquare_mono workspaceLe
      have headSchedule :=
        gateSteps_bound inputs done gate remaining
      have headScheduleCanonical :
          gateSteps inputs done gate remaining ≤
            64 *
              failureSpanSquare
                (gateWorkspace inputs done
                  (gate :: remaining)) := by
        simpa [failureSpanSquare] using headSchedule
      have headBound :
          gateSteps inputs done gate remaining ≤
            64 *
              failureSpanSquare
                (decodedGateListFailureSpan
                  inputs done (gate :: remaining) after) :=
        Nat.le_trans headScheduleCanonical
          (Nat.mul_le_mul_left 64 squareLe)
      have all :=
        exactRun_add
          (gateSteps inputs done gate remaining)
          tailSteps _ _ _ first tail
      refine
        ⟨gateSteps inputs done gate remaining +
            tailSteps,
          final, ?_, ?_, finalState, output⟩
      · simp only [List.length_cons]
        calc
          gateSteps inputs done gate remaining +
                tailSteps ≤
              64 *
                  failureSpanSquare
                    (decodedGateListFailureSpan
                      inputs done
                        (gate :: remaining) after) +
                remaining.length *
                  (64 *
                    failureSpanSquare
                      (decodedGateListFailureSpan
                        inputs done
                          (gate :: remaining) after)) :=
            Nat.add_le_add headBound tailBound
          _ = Nat.succ remaining.length *
                (64 *
                  failureSpanSquare
                    (decodedGateListFailureSpan
                      inputs done
                        (gate :: remaining) after)) := by
            simp [Nat.succ_mul, Nat.add_comm]
      · simpa [gateListCells,
          List.append_assoc] using all

/-! ### Gate launch over an arbitrary grammar suffix -/

private def grammarGatePrefix
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) : List WorkSymbol :=
  [cell00, cell00] ++
    natCells inputs ++
    countCells done.length remaining ++
    markedGateListCells done

private def grammarGateParsingPrefix
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) : List WorkSymbol :=
  [cell00, cell00] ++
    natCells inputs ++
    countCells (done.length + 1) remaining ++
    markedGateListCells done

private theorem grammarGateParsingPrefix_eq_sourceContext
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) :
    grammarGateParsingPrefix inputs done remaining =
      sourceContextPrefix inputs (done.length + 1)
        remaining done [] := by
  simp [grammarGateParsingPrefix,
    sourceContextPrefix, gateReferenceHeader]

private theorem grammarCountCells_eq_borrowed_append
    (used remaining : Nat) :
    countCells used remaining =
      borrowedCountCells used ++ natCells remaining := by
  induction used with
  | zero =>
      rfl
  | succ used ih =>
      change
        cell00 :: countMark :: countCells used remaining =
          cell00 :: countMark ::
            (borrowedCountCells used ++ natCells remaining)
      rw [ih]

private theorem grammarCountCells_succ_remaining
    (used remaining : Nat) :
    countCells used (remaining + 1) =
      borrowedCountCells used ++
        cell00 :: cell01 :: natCells remaining := by
  rw [grammarCountCells_eq_borrowed_append]
  simp [natCells]

private theorem grammarGatePrefix_allOrdinary
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) :
    ∀ symbol,
      symbol ∈ grammarGatePrefix
          inputs done remaining →
        ordinaryCell symbol := by
  unfold grammarGatePrefix
  rw [List.append_assoc, List.append_assoc]
  apply ordinaryCells_append
  · intro symbol member
    simp only [List.mem_cons,
      List.not_mem_nil] at member
    rcases member with rfl | rfl | impossible
    · exact ordinaryCell_cell00
    · exact ordinaryCell_cell00
    · contradiction
  apply ordinaryCells_append
  · exact natCells_allOrdinary inputs
  apply ordinaryCells_append
  · exact countCells_allOrdinary
      done.length remaining
  · exact markedGateListCells_allOrdinary done

private theorem grammarPushCrossed_eq_reverse_append
    (word left : List WorkSymbol) :
    pushCrossed word left = word.reverse ++ left := by
  induction word generalizing left with
  | nil =>
      rfl
  | cons symbol rest ih =>
      rw [pushCrossed, ih]
      simp

private theorem grammarPushCrossed_reverse
    (word right : List WorkSymbol) :
    pushCrossed word.reverse right =
      word ++ right := by
  rw [grammarPushCrossed_eq_reverse_append,
    List.reverse_reverse]

private theorem grammarGuardedMoveLeft_after_write
    (guardedPrefix : List WorkSymbol)
    (head write : WorkSymbol)
    (suffix : List WorkSymbol) :
    ((tapeAtWord
        (pushCrossed guardedPrefix [leftGuard])
        (head :: suffix)).write write).moveLeft =
      tapeAtLeftWord (write :: suffix)
        (guardedPrefix.reverse ++ [leftGuard]) := by
  rw [grammarPushCrossed_eq_reverse_append]
  cases guardedPrefix.reverse <;> rfl

private theorem grammarExactRun_one
    (initial final : WorkConfiguration)
    (step :
      workStep? machine initial = some final) :
    workRunExact? machine 1 initial =
      some final := by
  change
    (match workStep? machine initial with
     | none => none
     | some next => some next) = some final
  rw [step]

private theorem grammarScanRight_exact
    (state : Nat) (Allowed : WorkSymbol → Prop)
    (step : ∀ left head suffix,
      Allowed head →
      workStep? machine
          (configAtWord state left (head :: suffix)) =
        some
          (configAtWord state (head :: left) suffix))
    (word suffix left : List WorkSymbol)
    (allowed :
      ∀ symbol, symbol ∈ word → Allowed symbol) :
    workRunExact? machine word.length
        (configAtWord state left (word ++ suffix)) =
      some
        (configAtWord state
          (pushCrossed word left) suffix) := by
  induction word generalizing left with
  | nil =>
      rfl
  | cons head rest ih =>
      have headAllowed :
          Allowed head :=
        allowed head (List.Mem.head rest)
      have restAllowed :
          ∀ symbol, symbol ∈ rest →
            Allowed symbol := by
        intro symbol member
        exact allowed symbol
          (List.Mem.tail head member)
      change
        (match workStep? machine
            (configAtWord state left
              (head :: (rest ++ suffix))) with
         | none => none
         | some next =>
             workRunExact? machine rest.length next) =
          some
            (configAtWord state
              (pushCrossed (head :: rest) left)
              suffix)
