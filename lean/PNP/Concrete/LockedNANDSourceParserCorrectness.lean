    grammarGatePrefix
      inputs done (remaining + 1)
  have launch :=
    grammarGateStartLaunchWord_exact
      firstWas01 logicalPrefix word
  have backward :=
    grammarGateSeekGuard_scan_exact
      firstWas01 logicalPrefix
      (cursorMark :: word)
      (grammarGatePrefix_allOrdinary
        inputs done (remaining + 1))
  have guard :=
    grammarGateSeekGuard_finish_exact
      firstWas01
      (logicalPrefix ++ cursorMark :: word)
  rcases
      grammarGateForwardWord_exact firstWas01
        inputs done remaining word with
    ⟨forwardSteps, forwardStepsEq, forward⟩
  have throughBackward :=
    exactRun_add 1 logicalPrefix.length
      _ _ _ launch backward
  have throughGuard :=
    exactRun_add
      (1 + logicalPrefix.length) 1
      _ _ _ throughBackward guard
  have all :=
    exactRun_add
      ((1 + logicalPrefix.length) + 1)
      forwardSteps _ _ _ throughGuard forward
  rw [forwardStepsEq] at all
  have costEq :
      ((1 + logicalPrefix.length) + 1) +
          (logicalPrefix.length + 1) =
        2 * logicalPrefix.length + 3 := by
    omega
  rw [costEq] at all
  unfold grammarGateSourceLaunchSteps
  rw [←
    grammarGateParsingPrefix_eq_sourceContext
      inputs done remaining]
  simpa [logicalPrefix] using all

private theorem grammarGateExhaustedForwardWord_exact
    (firstWas01 : Bool) (inputs : Nat)
    (done : List RawGate)
