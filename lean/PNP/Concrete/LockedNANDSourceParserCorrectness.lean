private theorem prefixBoundaryCleanup_bounded_exact
    (wholeWord parsedPrefix tail : List WorkSymbol)
    (state : Nat) (initial : WorkConfiguration)
    (prefixSteps : Nat)
    (wholeShape :
      wholeWord = parsedPrefix ++ tail)
    (prefixOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol)
    (tailSourcePacked :
      ∀ symbol, symbol ∈ tail →
        SourcePackedCell symbol)
    (tailNonempty : tail ≠ [])
    (prefixRun :
      workRunExact? machine prefixSteps initial =
        some
          (guardedConfig state parsedPrefix tail))
    (prefixLinear :
      prefixSteps ≤ 8 * (wholeWord.length + 1))
    (launch :
      BoundaryCleanupLaunch state parsedPrefix tail) :
    ∃ steps final,
      steps ≤ rawFailureEnvelope wholeWord ∧
      workRunExact? machine steps initial =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  rcases
      boundaryCleanupLaunch_square_bounded_exact
        state parsedPrefix tail prefixOrdinary
        tailSourcePacked tailNonempty launch with
    ⟨tailSteps, final, tailBound,
      tailRun, finalState, outputEmpty⟩
  have tailBound' :
      tailSteps ≤
        16 * failureSpanSquare wholeWord.length := by
    rw [wholeShape]
    exact tailBound
  have successorLeSquare :
      wholeWord.length + 1 ≤
        failureSpanSquare wholeWord.length := by
    have positive : 1 ≤ wholeWord.length + 1 := by
      omega
    simpa [failureSpanSquare] using
      Nat.mul_le_mul_left
        (wholeWord.length + 1) positive
  have prefixSquare :
      prefixSteps ≤
        8 * failureSpanSquare wholeWord.length :=
    Nat.le_trans prefixLinear
      (Nat.mul_le_mul_left 8 successorLeSquare)
  have combinedSquare :
      prefixSteps + tailSteps ≤
        24 * failureSpanSquare wholeWord.length := by
    omega
  have squareLeCube :
      failureSpanSquare wholeWord.length ≤
        failureSpanCube wholeWord.length := by
    have positive : 1 ≤ wholeWord.length + 1 := by
      omega
    have scaled :=
      Nat.mul_le_mul_right
        (failureSpanSquare wholeWord.length)
        positive
    simpa [failureSpanCube] using scaled
  have combinedCube :
      24 * failureSpanSquare wholeWord.length ≤
        24 * failureSpanCube wholeWord.length :=
    Nat.mul_le_mul_left 24 squareLeCube
  have coefficient :
      24 * failureSpanCube wholeWord.length ≤
        2048 * failureSpanCube wholeWord.length := by
    omega
  have all :=
    exactRun_add prefixSteps tailSteps
      _ _ _ prefixRun tailRun
  exact
    ⟨prefixSteps + tailSteps, final,
      Nat.le_trans combinedSquare
        (Nat.le_trans combinedCube (by
          simpa [rawFailureEnvelope] using coefficient)),
      all, finalState, outputEmpty⟩

private theorem failureSpanCube_mono_work
    {smaller larger : Nat}
    (bound : smaller ≤ larger) :
    failureSpanCube smaller ≤
      failureSpanCube larger := by
  have successor :
      smaller + 1 ≤ larger + 1 := by
    omega
  have square :=
    Nat.mul_le_mul successor successor
  have cube :=
    Nat.mul_le_mul successor square
  simpa [failureSpanCube, failureSpanSquare,
    Nat.mul_assoc] using cube

private theorem cubicPrefixBoundaryCleanup_bounded_exact
    (wholeWord parsedPrefix tail : List WorkSymbol)
    (state : Nat) (initial : WorkConfiguration)
    (prefixSteps prefixCoefficient : Nat)
    (wholeLength :
      wholeWord.length =
        (parsedPrefix ++ tail).length)
    (prefixOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol)
    (tailSourcePacked :
      ∀ symbol, symbol ∈ tail →
        SourcePackedCell symbol)
    (tailNonempty : tail ≠ [])
    (prefixRun :
      workRunExact? machine prefixSteps initial =
        some
          (guardedConfig state parsedPrefix tail))
    (prefixCubic :
      prefixSteps ≤
        prefixCoefficient *
          failureSpanCube wholeWord.length)
    (coefficientBound :
      prefixCoefficient + 16 ≤ 2048)
    (launch :
      BoundaryCleanupLaunch state parsedPrefix tail) :
    ∃ steps final,
      steps ≤ rawFailureEnvelope wholeWord ∧
      workRunExact? machine steps initial =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  rcases
      boundaryCleanupLaunch_square_bounded_exact
        state parsedPrefix tail prefixOrdinary
        tailSourcePacked tailNonempty launch with
    ⟨tailSteps, final, tailSquare,
      tailRun, finalState, outputEmpty⟩
  have tailSquare' :
      tailSteps ≤
        16 *
          failureSpanSquare wholeWord.length := by
    rw [wholeLength]
    exact tailSquare
  have squareCube :=
    failureSpanSquare_le_cube
      wholeWord.length
  have tailCubic :
      tailSteps ≤
        16 *
          failureSpanCube wholeWord.length :=
