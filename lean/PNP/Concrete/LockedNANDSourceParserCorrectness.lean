  simpa [prefixTokens, parsedPrefix] using combined

private theorem circuitOutputThroughOutputsEndWordSteps_bound
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource) (after : List WorkSymbol) :
    let tokens :=
      circuitOutputPrefixTokens inputs gates output ++
        [.outputsEnd]
    circuitOutputPrefixSteps inputs gates output + 2 ≤
      194 *
        failureSpanCube
          (packedTokenCells tokens ++ after).length := by
