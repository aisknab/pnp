    packedCircuitGatesPrefixTokens_append
      inputs gates
      (.programEnd ::
        (encodeSourceTokens output ++ tokens))
  have cellsEqCanonical :
      packedTokenCells allTokens =
        [cell00, cell00] ++ natCells inputs ++
          natCells gates.length ++ gateListCells gates ++
          cell10 :: cell00 :: sourceCells output ++
          packedTokenCells tokens := by
    dsimp [allTokens]
    unfold circuitOutputPrefixTokens
    simpa [packedTokenCells, tokenCells,
      packedTokenCells_append,
      packedTokenCells_encodeSourceTokens,
      List.append_assoc] using cellsEq
  have sourceSpanBound :
      sourceSpan inputs 0 gates.length gates
          [cell10, cell00] output ≤ span := by
    unfold sourceSpan sourceContextPrefix
      gateReferenceHeader span circuitTokenFailureSpan
    rw [cellsEqCanonical]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      countCells_length, natCells_length,
      markedGateListCells_length]
    omega
  have sourceSquareBound :=
    failureSpanSquare_mono sourceSpanBound
  have sourceBoundRaw :=
    sourceSteps_bound inputs 0 gates.length gates
      [cell10, cell00] output
  have sourceBound :
      outputSteps ≤
        10 * failureSpanCube span := by
    have squareCube :=
      failureSpanSquare_le_cube span
    have oneCube :
        1 ≤ failureSpanCube span :=
      Nat.le_trans
        (one_le_failureSpanSquare span)
        squareCube
    have squareCanonical :
        failureSpanSquare
            (sourceSpan inputs 0 gates.length gates
