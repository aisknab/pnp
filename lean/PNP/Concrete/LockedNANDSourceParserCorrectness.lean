  have spanLe :=
    grammarRightSourceFailureSpan_le
      inputs done remaining left right suffix
  have squareLe :=
    failureSpanSquare_mono spanLe
  have canonicalBound :
      steps ≤
        2 +
          16 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1)
                (sourceCells left ++
                  sourceCells right ++ suffix)) := by
    exact Nat.le_trans bound
      (Nat.add_le_add_left
        (Nat.mul_le_mul_left 16 squareLe) 2)
  have one :=
    one_le_failureSpanSquare
      (grammarWorkFailureSpan
        inputs done (remaining + 1)
        (sourceCells left ++
          sourceCells right ++ suffix))
  refine
    ⟨steps, final, ?_, run,
