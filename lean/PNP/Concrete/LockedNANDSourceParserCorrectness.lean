        ordinaryCell symbol)
    (prefixRun :
      workRunExact? machine prefixSteps initial =
        some
          (guardedConfig state parsedCells
            (tokenCells token ++
              (packedTokenCells suffix ++ workTail))))
    (firstFailure :
      ∀ (current : WorkSymbol)
        (rest : List WorkSymbol),
        current ≠ cell00 →
        workRunExact? machine 1
            (guardedConfig state parsedCells
              (current :: rest)) =
          some
            (cleanupSeekConfiguration
              [] (current ::
                pushCrossed parsedCells []) rest))
    (secondFailure :
      ∀ (current : WorkSymbol)
        (rest : List WorkSymbol),
        current ≠ cell01 →
        current ≠ cell10 →
        workRunExact? machine 2
            (guardedConfig state parsedCells
              (cell00 :: current :: rest)) =
          some
            (cleanupSeekConfiguration
              []
              (current ::
                pushCrossed
                  (parsedCells ++ [cell00]) [])
              rest))
    (notUnit : token ≠ .unit)
    (notNatEnd : token ≠ .natEnd)
    (prefixLinear :
      prefixSteps + 2 ≤
        8 * (word.length + 1)) :
    ∃ steps final,
      steps ≤ rawFailureEnvelope word ∧
      workRunExact? machine steps initial =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
