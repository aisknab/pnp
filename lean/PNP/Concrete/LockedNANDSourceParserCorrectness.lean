private theorem boundaryCleanupLaunch_bounded_exact
    (state : Nat)
    (parsedPrefix word : List WorkSymbol)
    (prefixOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol)
    (wordSourcePacked :
      ∀ symbol, symbol ∈ word →
        SourcePackedCell symbol)
