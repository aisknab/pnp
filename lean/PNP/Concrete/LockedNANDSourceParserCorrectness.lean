private theorem sourceHeadTokenFailure_exact
    (continuation : SourceContinuation)
    (parsedPrefix : List WorkSymbol)
    (parsedOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol)
    (token : Token) (suffix : List Token)
    (notInput : token ≠ .input)
    (notFalse : token ≠ .constantFalse)
    (notTrue : token ≠ .constantTrue)
    (notGate : token ≠ .gate) :
    ∃ steps final,
      workRunExact? machine steps
          (guardedConfig
            (State.sourceStart continuation)
            parsedPrefix
            (packedTokenCells (token :: suffix))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let suffixCells := packedTokenCells suffix
  let initial :=
    guardedConfig (State.sourceStart continuation)
      parsedPrefix (packedTokenCells (token :: suffix))
  have fullOrdinary :
      ∀ symbol,
        symbol ∈
            parsedPrefix ++
              packedTokenCells (token :: suffix) →
          ordinaryCell symbol := by
    intro symbol member
    simp only [List.mem_append] at member
    rcases member with inPrefix | inTokens
    · exact parsedOrdinary symbol inPrefix
    · exact packedTokenCells_ordinary
        (token :: suffix) symbol inTokens
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq : tokenCells token = [current, next])
      (not00Cell : current ≠ cell00)
      (not01Cell : current ≠ cell01) :
      ∃ steps final,
        workRunExact? machine steps initial = some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have failed :=
      sourceStartFirstFailure_exact
        continuation parsedPrefix current
        (next :: suffixCells)
        not00Cell not01Cell
    have launch :
        workRunExact? machine 1 initial =
          some
            (cleanupSeekConfiguration
              [] (current :: pushCrossed parsedPrefix [])
              (next :: suffixCells)) := by
      simpa [initial, suffixCells,
        packedTokenCells, cellsEq] using failed
    have ordinary :
        ∀ symbol,
          symbol ∈
              parsedPrefix ++
                current :: next :: suffixCells →
            ordinaryCell symbol := by
      intro symbol member
      apply fullOrdinary symbol
      simpa [suffixCells, packedTokenCells,
        cellsEq] using member
    exact ordinaryExplicitFailure_exact
      parsedPrefix current (next :: suffixCells)
      initial 1 ordinary launch
  have rejectAfter00
      (current : WorkSymbol)
      (cellsEq : tokenCells token = [cell00, current])
      (not11Cell : current ≠ cell11) :
      ∃ steps final,
        workRunExact? machine steps initial = some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have failed :=
      sourceAfter00Failure_exact
        continuation parsedPrefix current
        suffixCells not11Cell
    have launch :
        workRunExact? machine 2 initial =
          some
            (cleanupSeekConfiguration
              []
              (current ::
                pushCrossed
                  (parsedPrefix ++ [cell00]) [])
              suffixCells) := by
      simpa [initial, suffixCells,
        packedTokenCells, cellsEq] using failed
    have ordinary :
        ∀ symbol,
          symbol ∈
              (parsedPrefix ++ [cell00]) ++
                current :: suffixCells →
            ordinaryCell symbol := by
      intro symbol member
      apply fullOrdinary symbol
      simpa [suffixCells, packedTokenCells,
        cellsEq, List.append_assoc] using member
    exact ordinaryExplicitFailure_exact
      (parsedPrefix ++ [cell00]) current suffixCells
      initial 2 ordinary launch
  have rejectAfter01
      (current : WorkSymbol)
      (cellsEq : tokenCells token = [cell01, current])
      (not00Cell : current ≠ cell00)
      (not01Cell : current ≠ cell01)
      (not10Cell : current ≠ cell10) :
      ∃ steps final,
        workRunExact? machine steps initial = some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have failed :=
      sourceAfter01Failure_exact
        continuation parsedPrefix current suffixCells
        not00Cell not01Cell not10Cell
    have launch :
        workRunExact? machine 2 initial =
          some
            (cleanupSeekConfiguration
              []
              (current ::
                pushCrossed
                  (parsedPrefix ++ [cell01]) [])
              suffixCells) := by
      simpa [initial, suffixCells,
        packedTokenCells, cellsEq] using failed
    have ordinary :
        ∀ symbol,
          symbol ∈
              (parsedPrefix ++ [cell01]) ++
                current :: suffixCells →
            ordinaryCell symbol := by
      intro symbol member
      apply fullOrdinary symbol
      simpa [suffixCells, packedTokenCells,
        cellsEq, List.append_assoc] using member
    exact ordinaryExplicitFailure_exact
      (parsedPrefix ++ [cell01]) current suffixCells
      initial 2 ordinary launch
  cases token with
  | version0 =>
      simpa [initial] using
        (rejectAfter00 cell00 rfl (by decide))
  | unit =>
      simpa [initial] using
        (rejectAfter00 cell01 rfl (by decide))
  | natEnd =>
      simpa [initial] using
        (rejectAfter00 cell10 rfl (by decide))
  | input =>
      exact False.elim (notInput rfl)
  | constantFalse =>
      exact False.elim (notFalse rfl)
  | constantTrue =>
      exact False.elim (notTrue rfl)
  | gate =>
      exact False.elim (notGate rfl)
  | gateEnd =>
      simpa [initial] using
        (rejectAfter01 cell11 rfl
          (by decide) (by decide) (by decide))
  | programEnd =>
      simpa [initial] using
        (rejectFirst cell10 cell00 rfl
          (by decide) (by decide))
  | outputsEnd =>
      simpa [initial] using
        (rejectFirst cell10 cell01 rfl
          (by decide) (by decide))
  | threshold =>
      simpa [initial] using
        (rejectFirst cell10 cell10 rfl
          (by decide) (by decide))
  | instanceEnd =>
      simpa [initial] using
        (rejectFirst cell10 cell11 rfl
          (by decide) (by decide))

