private theorem circuitTokenFailureWithFramingTail_bounded_exact
    {tokens : List Token}
    (failure : CircuitTokenFailure tokens)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    let word :=
      packedTokenCells tokens ++ workTail
    ∃ steps final,
      steps ≤ rawFailureEnvelope word ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols word)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases failure with
  | missingVersion =>
      simpa [packedTokenCells] using
        (missingVersionWithFramingTail_bounded_exact
          malformed)
  | wrongVersion token suffix notVersion =>
      exact
        wrongVersionWithFramingTail_bounded_exact
          token suffix notVersion malformed
  | inputCount failure =>
      exact
        circuitInputCountFailureWithFramingTail_bounded_exact
          failure malformed
  | gateCount inputs failure =>
      exact
        circuitGateCountFailureWithFramingTail_bounded_exact
          inputs failure malformed
  | gates inputs gateCount failure =>
      exact
        circuitGatesFailureWithFramingTail_bounded_exact
          inputs gateCount failure malformed
  | missingProgramEnd inputs gates =>
      exact
        circuitMissingProgramEndWithFramingTail_bounded_exact
          inputs gates malformed
  | wrongProgramEnd inputs gates token suffix
      notProgramEnd =>
      exact
        circuitWrongProgramEndWithFramingTail_bounded_exact
          inputs gates token suffix
          notProgramEnd malformed
  | output inputs gates failure =>
      exact
        circuitOutputFailureWithFramingTail_bounded_exact
          inputs gates failure malformed
  | missingOutputsEnd inputs gates output =>
      exact
        circuitMissingOutputsEndFailureWithFramingTail_bounded_exact
          inputs gates output malformed
  | wrongOutputsEnd inputs gates output
      token suffix notOutputsEnd =>
      exact
        circuitWrongOutputsEndFailureWithFramingTail_bounded_exact
          inputs gates output token suffix
          notOutputsEnd malformed
  | missingInstanceEnd inputs gates output =>
      exact
        circuitMissingInstanceEndFailureWithFramingTail_bounded_exact
          inputs gates output malformed
  | wrongInstanceEnd inputs gates output
      token suffix notInstanceEnd =>
      exact
        circuitWrongInstanceEndFailureWithFramingTail_bounded_exact
          inputs gates output token suffix
          notInstanceEnd malformed
  | trailingToken inputs gates output token suffix =>
      exact
        circuitTrailingTokenFailureWithFramingTail_bounded_exact
          inputs gates output token suffix malformed

private theorem decodedCircuitTokens_eq_canonical
    (tokens : List Token) (raw : RawCircuit)
    (decoded :
      decodeCircuitTokens tokens = some raw) :
    encodeCircuitTokens raw = tokens := by
  have decodedBits :
      decodeCircuit (encodeTokens tokens) =
        some raw := by
    simp [decodeCircuit, decodeTokens_encodeTokens,
      decoded]
  have encodedBits :=
    encodeCircuit_eq_of_decodeCircuit_eq_some
      (encodeTokens tokens) raw decodedBits
  have decodedEncoded :=
    congrArg decodeTokens encodedBits
  simpa [encodeCircuit,
    decodeTokens_encodeTokens] using decodedEncoded

private theorem encodedCircuitInvalidGatesWithFramingTail_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource)
    (gatesInvalid :
      rawGatesWellFormed inputs 0 gates = false)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
