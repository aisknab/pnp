            calc
              leftSteps + rightSteps ≤
                  32 *
                      failureSpanSquare
                        (grammarTokenFailureSpan
                          inputs done (remaining + 1)
                          (encodeSourceTokens left ++
                            encodeSourceTokens right ++
                            .gateEnd :: tokens)) +
                    32 *
                      failureSpanSquare
                        (grammarTokenFailureSpan
                          inputs done (remaining + 1)
                          (encodeSourceTokens left ++
                            encodeSourceTokens right ++
                            .gateEnd :: tokens)) :=
                Nat.add_le_add
                  leftBoundCanonical
