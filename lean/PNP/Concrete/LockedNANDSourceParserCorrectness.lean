private theorem circuitProgramPrefixSteps_bound
    (inputs : Nat) (gates : List RawGate)
    (tokens : List Token) :
    let allTokens :=
      circuitGatesPrefixTokens inputs gates ++
        .programEnd :: tokens
    ((2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates) +
        programEndSteps inputs gates ≤
      160 *
        failureSpanCube
          (circuitTokenFailureSpan allTokens) := by
  dsimp only
  let allTokens :=
    circuitGatesPrefixTokens inputs gates ++
      .programEnd :: tokens
  let wordSpan := circuitTokenFailureSpan allTokens
  have gatesBound :
      (2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates ≤
        128 * failureSpanCube wordSpan := by
    simpa [allTokens, wordSpan] using
      (circuitValidGatesSteps_bound
        inputs gates (.programEnd :: tokens))
  have cellsEq :=
    packedCircuitGatesPrefixTokens_append
      inputs gates (.programEnd :: tokens)
  have programLinear :
      programEndSteps inputs gates ≤
        16 * (wordSpan + 1) := by
    unfold programEndSteps
    unfold gatePrefix
    unfold wordSpan circuitTokenFailureSpan
    dsimp [allTokens]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length, countCells_length,
      markedGateListCells_length,
      packedTokenCells, tokenCells]
    omega
  have programBound :
      programEndSteps inputs gates ≤
        16 * failureSpanCube wordSpan :=
    Nat.le_trans programLinear
      (Nat.mul_le_mul_left 16
        (failureSpanSucc_le_cube wordSpan))
  have combined :=
    Nat.add_le_add gatesBound programBound
  calc
    ((2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates) +
        programEndSteps inputs gates ≤
      128 * failureSpanCube wordSpan +
        16 * failureSpanCube wordSpan :=
      combined
    _ = 144 * failureSpanCube wordSpan := by
      omega
    _ ≤ 160 * failureSpanCube wordSpan :=
      Nat.mul_le_mul_right
        (failureSpanCube wordSpan)
        (show 144 ≤ 160 by omega)
    _ = 160 *
        failureSpanCube
          (circuitTokenFailureSpan allTokens) := by
      rfl

private theorem circuitOutputFailure_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    {tokens : List Token}
    (failure : SourceTokenFailure tokens) :
    let allTokens :=
      circuitGatesPrefixTokens inputs gates ++
        .programEnd :: tokens
    ∃ steps final,
      steps ≤ circuitFailureEnvelope allTokens ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells allTokens))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let allTokens :=
    circuitGatesPrefixTokens inputs gates ++
      .programEnd :: tokens
  cases gatesEq :
      rawGatesWellFormed inputs 0 gates with
  | false =>
      simpa [allTokens, List.append_assoc] using
        (circuitInvalidGates_bounded_exact
          inputs gates (.programEnd :: tokens)
          gatesEq)
  | true =>
      let prefixSteps :=
        ((2 * inputs + 2 * gates.length + 8) +
            gatesSteps inputs [] gates) +
          programEndSteps inputs gates
      have prefixRun :
          workRunExact? machine prefixSteps
              (workStartConfiguration machine
                (WorkTape.ofSymbols
                  (packedTokenCells allTokens))) =
            some
              (guardedConfig
                (State.sourceStart .output)
                (sourceContextPrefix
                  inputs 0 gates.length gates
                  [cell10, cell00])
                (packedTokenCells tokens)) := by
        simpa [allTokens, prefixSteps] using
          (circuitProgramPrefix_exact
            inputs gates tokens gatesEq)
      have beforeOrdinary :
          ∀ symbol,
            symbol ∈ [cell10, cell00] →
              ordinaryCell symbol := by
        intro symbol member
        simp only [List.mem_cons,
          List.not_mem_nil] at member
        rcases member with rfl | rfl | impossible
        · exact ordinaryCell_cell10
        · exact ordinaryCell_cell00
        · contradiction
      have beforeNoGateMark :
          ∀ symbol,
            symbol ∈ [cell10, cell00] →
              symbol ≠ gateMark := by
        intro symbol member
        simp only [List.mem_cons,
          List.not_mem_nil] at member
        rcases member with rfl | rfl | impossible
        · decide
        · decide
        · contradiction
      rcases
          sourceTokenFailure_bounded_exact
            .output inputs 0 gates.length gates
            [cell10, cell00] failure
            beforeOrdinary beforeNoGateMark with
        ⟨tailSteps, final, tailBound, tail,
          finalState, output⟩
      have all :=
        exactRun_add prefixSteps tailSteps
          _ _ _ prefixRun tail
      have prefixBound :
          prefixSteps ≤
            160 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) := by
        simpa [allTokens, prefixSteps] using
          (circuitProgramPrefixSteps_bound
            inputs gates tokens)
      let inner :=
        sourceTokenFailureSpan
          inputs 0 gates.length gates
          [cell10, cell00] tokens
      have cellsEq :=
        packedCircuitGatesPrefixTokens_append
          inputs gates (.programEnd :: tokens)
      have innerBound :
          inner ≤
            circuitTokenFailureSpan allTokens + 2 := by
        unfold inner sourceTokenFailureSpan
        unfold sourceContextPrefix gateReferenceHeader
        unfold circuitTokenFailureSpan
        dsimp [allTokens]
        rw [cellsEq]
        simp only [List.length_append,
          List.length_cons, List.length_nil,
          countCells_length, natCells_length,
          markedGateListCells_length,
          packedTokenCells, tokenCells]
        omega
      have squareBound :=
        shiftedSquare_le_nineCube
          inner (circuitTokenFailureSpan allTokens)
          innerBound
      have cubePositive :
          1 ≤
            failureSpanCube
              (circuitTokenFailureSpan allTokens) :=
        Nat.le_trans
          (one_le_failureSpanSquare
            (circuitTokenFailureSpan allTokens))
          (failureSpanSquare_le_cube
            (circuitTokenFailureSpan allTokens))
      have tailBoundCanonical :
          tailSteps ≤
            2 + 16 * failureSpanSquare inner := by
        simpa [inner] using tailBound
      have tailCube :
          tailSteps ≤
            146 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) := by
        have scaled :=
          Nat.mul_le_mul_left 16 squareBound
        calc
          tailSteps ≤
              2 + 16 * failureSpanSquare inner :=
            tailBoundCanonical
          _ ≤
              2 + 16 *
                (9 *
                  failureSpanCube
                    (circuitTokenFailureSpan allTokens)) :=
            Nat.add_le_add_left scaled 2
          _ ≤
              146 *
                failureSpanCube
                  (circuitTokenFailureSpan allTokens) := by
            omega
      have combined :=
        Nat.add_le_add prefixBound tailCube
      have scheduleBound :
          prefixSteps + tailSteps ≤
            circuitFailureEnvelope allTokens := by
        calc
          prefixSteps + tailSteps ≤
              160 *
                  failureSpanCube
                    (circuitTokenFailureSpan allTokens) +
                146 *
                  failureSpanCube
                    (circuitTokenFailureSpan allTokens) :=
            combined
          _ = 306 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) := by
            omega
          _ ≤ 1024 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) :=
            Nat.mul_le_mul_right
              (failureSpanCube
                (circuitTokenFailureSpan allTokens))
              (show 306 ≤ 1024 by omega)
          _ = circuitFailureEnvelope allTokens := by
            rfl
      refine
        ⟨prefixSteps + tailSteps, final,
          scheduleBound, all, finalState, output⟩

private theorem circuitWrongProgramEnd_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    (token : Token) (suffix : List Token)
    (notProgramEnd : token ≠ .programEnd) :
  ∃ steps final,
    steps ≤ circuitFailureEnvelope
      (circuitGatesPrefixTokens inputs gates ++ token :: suffix) ∧
