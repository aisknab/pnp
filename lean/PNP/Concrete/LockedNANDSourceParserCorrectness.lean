private def grammarGateExhaustedForwardSteps
    (inputs : Nat) (done : List RawGate) : Nat :=
  ((2 + 2 * (inputs + 1)) +
    2 * done.length) + 2

private theorem grammarGateExhaustedForward_exact
    (firstWas01 : Bool) (inputs : Nat)
    (done : List RawGate)
    (current : WorkSymbol) (rest : List WorkSymbol) :
    let parsedPrefix :=
      [cell00, cell00] ++
        natCells inputs ++
        borrowedCountCells done.length
    let suffix :=
      markedGateListCells done ++
        cursorMark :: current :: rest
    workRunExact? machine
        (grammarGateExhaustedForwardSteps
          inputs done)
        (configAtWord
          (State.gateDecrementVersionFirst firstWas01)
          [leftGuard]
          (grammarGatePrefix inputs done 0 ++
            cursorMark :: current :: rest)) =
      some
        (cleanupSeekConfiguration
          []
          (cell10 :: cell00 ::
            pushCrossed parsedPrefix [])
          suffix) := by
  dsimp only
  let parsedPrefix :=
    [cell00, cell00] ++
      natCells inputs ++
      borrowedCountCells done.length
  let suffix :=
    markedGateListCells done ++
      cursorMark :: current :: rest
  let afterHeader :=
    countCells done.length 0 ++
      markedGateListCells done ++
      cursorMark :: current :: rest
  have version :=
    grammarGateVersion_exact firstWas01
      [leftGuard]
      (natCells inputs ++ afterHeader)
  have input :=
    grammarGateInput_exact firstWas01 inputs
      (cell00 :: cell00 :: [leftGuard])
      afterHeader
  have count :=
    grammarGateCountBorrowedPrefix_exact
      firstWas01 done.length
      (pushCrossed (natCells inputs)
        (cell00 :: cell00 :: [leftGuard]))
      (cell00 :: cell10 :: suffix)
  have countCanonical :
      workRunExact? machine (2 * done.length)
          (configAtWord
            (State.gateDecrementCountFirst firstWas01)
            (pushCrossed (natCells inputs)
              (cell00 :: cell00 :: [leftGuard]))
            afterHeader) =
        some
          (configAtWord
            (State.gateDecrementCountFirst firstWas01)
            (pushCrossed
              (borrowedCountCells done.length)
              (pushCrossed (natCells inputs)
                (cell00 :: cell00 :: [leftGuard])))
            (cell00 :: cell10 :: suffix)) := by
    simpa [grammarCountCells_eq_borrowed_append,
      natCells, suffix, afterHeader,
      List.append_assoc] using count
  have leftEq :
      pushCrossed
          (borrowedCountCells done.length)
          (pushCrossed (natCells inputs)
            (cell00 :: cell00 :: [leftGuard])) =
        pushCrossed parsedPrefix [leftGuard] := by
    unfold parsedPrefix
    rw [pushCrossed_append, pushCrossed_append]
    rfl
  have exhausted :=
    grammarGateCountExhaustedFailure_exact
      firstWas01 parsedPrefix suffix
  rw [← leftEq] at exhausted
  have throughInput :=
    exactRun_add 2 (2 * (inputs + 1))
      _ _ _ version input
  have throughCount :=
    exactRun_add
      (2 + 2 * (inputs + 1))
      (2 * done.length)
      _ _ _ throughInput countCanonical
  have all :=
    exactRun_add
      ((2 + 2 * (inputs + 1)) +
        2 * done.length)
      2 _ _ _ throughCount exhausted
  simpa [grammarGateExhaustedForwardSteps,
    grammarGatePrefix,
    grammarCountCells_eq_borrowed_append,
    natCells, parsedPrefix, suffix, afterHeader,
    List.append_assoc] using all

private theorem grammarGateExhausted_exact
    (firstWas01 : Bool) (inputs : Nat)
    (done : List RawGate)
    (current : WorkSymbol) (rest : List WorkSymbol)
    (_wordNoGuard :
      ∀ symbol, symbol ∈ current :: rest →
        symbol ≠ leftGuard)
    (wordNoBlank :
      ∀ symbol, symbol ∈ current :: rest →
        symbol ≠ cellBlank) :
    ∃ steps final,
      steps ≤
          64 *
            failureSpanSquare
              ((grammarGatePrefix inputs done 0).length +
                (firstSourceCell firstWas01 ::
                  current :: rest).length + 2) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix inputs done 0)
            (firstSourceCell firstWas01 ::
              current :: rest)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let logicalPrefix :=
    grammarGatePrefix inputs done 0
  let parsedPrefix :=
    [cell00, cell00] ++
      natCells inputs ++
      borrowedCountCells done.length
  let suffix :=
    markedGateListCells done ++
      cursorMark :: current :: rest
  let scan :=
    cell10 :: cell00 ::
      pushCrossed parsedPrefix []
  let right := suffix
  have launch :=
    grammarGateStartLaunch_exact firstWas01
      logicalPrefix current rest
  have backward :=
    grammarGateSeekGuard_scan_exact
      firstWas01 logicalPrefix
      (cursorMark :: current :: rest)
      (grammarGatePrefix_allOrdinary
        inputs done 0)
  have guard :=
    grammarGateSeekGuard_finish_exact
      firstWas01
      (logicalPrefix ++
        cursorMark :: current :: rest)
  let forwardSteps :=
    grammarGateExhaustedForwardSteps inputs done
  have forward :=
    grammarGateExhaustedForward_exact
      firstWas01 inputs done current rest
  have throughBackward :=
    exactRun_add 1 logicalPrefix.length
      _ _ _ launch backward
  have throughGuard :=
    exactRun_add
      (1 + logicalPrefix.length) 1
      _ _ _ throughBackward guard
  have throughFailure :=
    exactRun_add
      ((1 + logicalPrefix.length) + 1)
      forwardSteps _ _ _ throughGuard forward
  have scanNoGuard :
      ∀ symbol, symbol ∈ scan →
        symbol ≠ leftGuard := by
    intro symbol member
    unfold scan at member
    simp only [List.mem_cons] at member
    rcases member with rfl | rfl | inCrossed
    · decide
    · decide
    · apply ordinaryCell_not_leftGuard
      have inParsed :
          symbol ∈ parsedPrefix := by
        rw [grammarPushCrossed_eq_reverse_append]
          at inCrossed
        simpa using inCrossed
      unfold parsedPrefix at inParsed
      rcases List.mem_append.mp inParsed with
          inLeading | inBorrowed
      · rcases List.mem_append.mp inLeading with
            inVersion | inInputs
        · simp only [List.mem_cons,
            List.not_mem_nil] at inVersion
          rcases inVersion with
              rfl | rfl | impossible
          · exact ordinaryCell_cell00
          · exact ordinaryCell_cell00
          · contradiction
        · exact natCells_allOrdinary
            inputs symbol inInputs
      · exact borrowedCountCells_allOrdinary
          done.length symbol inBorrowed
  have rightNoBlank :
      ∀ symbol, symbol ∈ right →
        symbol ≠ cellBlank := by
    intro symbol member
    unfold right suffix at member
    simp only [List.mem_cons,
      List.mem_append] at member
    rcases member with inMarked | rfl | inWord
    · exact ordinaryCell_not_blank
        (markedGateListCells_allOrdinary
          done symbol inMarked)
    · decide
    · exact wordNoBlank symbol (by
        simpa using inWord)
  have forwardNoBlank :
      ∀ symbol,
        symbol ∈ pushCleanupScan scan right →
          symbol ≠ cellBlank := by
    intro symbol member
    have split :=
      (pushCleanupScan_mem_iff
        scan right symbol).mp member
    rcases split with inScan | inRight
    · unfold scan at inScan
      simp only [List.mem_cons] at inScan
      rcases inScan with rfl | rfl | inCrossed
      · decide
      · decide
      · apply ordinaryCell_not_blank
        have inParsed :
            symbol ∈ parsedPrefix := by
          rw [grammarPushCrossed_eq_reverse_append]
            at inCrossed
          simpa using inCrossed
        unfold parsedPrefix at inParsed
        rcases List.mem_append.mp inParsed with
            inLeading | inBorrowed
        · rcases List.mem_append.mp inLeading with
              inVersion | inInputs
          · simp only [List.mem_cons,
              List.not_mem_nil] at inVersion
            rcases inVersion with
                rfl | rfl | impossible
            · exact ordinaryCell_cell00
            · exact ordinaryCell_cell00
            · contradiction
          · exact natCells_allOrdinary
              inputs symbol inInputs
        · exact borrowedCountCells_allOrdinary
            done.length symbol inBorrowed
    · exact rightNoBlank symbol inRight
  have cleanup :=
    guardedCleanupFinite_exact
      [] scan right scanNoGuard forwardNoBlank
  let final :=
    cleanupRejectConfiguration [] scan right []
  let span :=
    logicalPrefix.length +
      (firstSourceCell firstWas01 ::
        current :: rest).length + 2
  have linear :
      (((1 + logicalPrefix.length) + 1) +
          forwardSteps) +
          guardedCleanupSteps scan right ≤
        32 * (span + 1) := by
    rw [guardedCleanupSteps_eq]
    unfold span logicalPrefix forwardSteps
    unfold grammarGateExhaustedForwardSteps
    unfold scan right suffix parsedPrefix
    unfold grammarGatePrefix
    simp only [List.length_append, List.length_cons,
      List.length_nil, natCells_length,
      borrowedCountCells_length, countCells_length,
      markedGateListCells_length,
      pushCrossed_length]
    omega
  have positive : 1 ≤ span + 1 := by
    omega
  have squareBase :
      span + 1 ≤ failureSpanSquare span := by
    simpa [failureSpanSquare] using
      Nat.mul_le_mul_left (span + 1) positive
  have scheduleBound :
      (((1 + logicalPrefix.length) + 1) +
          forwardSteps) +
          guardedCleanupSteps scan right ≤
        64 * failureSpanSquare span := by
    exact Nat.le_trans linear
      (Nat.le_trans
        (Nat.mul_le_mul_right (span + 1)
          (show 32 ≤ 64 by omega))
        (Nat.mul_le_mul_left 64 squareBase))
  refine
    ⟨((1 + logicalPrefix.length) + 1) +
        forwardSteps +
        guardedCleanupSteps scan right,
      final, ?_, ?_, rfl, ?_⟩
  · simpa [span, logicalPrefix] using scheduleBound
  · have all :=
      exactRun_add
        (((1 + logicalPrefix.length) + 1) +
          forwardSteps)
        (guardedCleanupSteps scan right)
        _ _ _ throughFailure cleanup
    simpa [logicalPrefix, final,
      scan, right, suffix, parsedPrefix] using all
  · exact cleanupRejectConfiguration_output_empty
      [] scan right

