private theorem grammarGateMalformedTail_bounded_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    ∃ steps final,
      steps ≤
          128 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done remaining workTail) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix inputs done remaining)
            workTail) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases malformed with
  | reserved third fourth suffix =>
      let word :=
        cell11 ::
          boolPairWorkCell third fourth ::
            packedRawBits suffix
      have launch :
          BoundaryCleanupLaunch State.gateStart
            (grammarGatePrefix inputs done remaining)
            word := by
        apply boundaryCleanupLaunch_immediate
        exact grammarGateStartCell11Failure_exact
          (grammarGatePrefix inputs done remaining)
          (boolPairWorkCell third fourth ::
            packedRawBits suffix)
      have run :=
        grammarGateBoundaryCleanup_bounded_exact
          inputs done remaining word
          (by
            intro symbol member
            exact
              (MalformedWorkTail.reserved
                third fourth suffix).allSourcePacked
                symbol (by
                  simpa [word, cell11_eq_oneOne]
                    using member))
          (by simp [word]) launch
      simpa [word, cell11_eq_oneOne] using run
  | trailingOne bit =>
      let word := [danglingWorkCell bit]
      have launch :
          BoundaryCleanupLaunch State.gateStart
            (grammarGatePrefix inputs done remaining)
            word := by
        apply boundaryCleanupLaunch_immediate
        exact grammarGateStartDanglingFailure_exact
          (grammarGatePrefix inputs done remaining) bit
      have run :=
        grammarGateBoundaryCleanup_bounded_exact
          inputs done remaining word
          (by
            intro symbol member
            exact
              (MalformedWorkTail.trailingOne bit).allSourcePacked
                symbol (by simpa [word] using member))
          (by simp [word]) launch
      simpa [word] using run
  | trailingTwo first second =>
      cases first <;> cases second
      · simpa [boolPairWorkCell_false_false_eq,
          firstSourceCell] using
          (grammarGateSourceEOF_bounded_exact
            false inputs done remaining)
      · simpa [boolPairWorkCell_false_true_eq,
          firstSourceCell] using
          (grammarGateSourceEOF_bounded_exact
            true inputs done remaining)
      · let word := [cell10]
        have launch :
            BoundaryCleanupLaunch State.gateStart
              (grammarGatePrefix
                inputs done remaining)
              word := by
          dsimp [word]
          apply boundaryCleanupLaunch_eof_rewritten
          · exact cursorMark_cleanupSafe
          · simpa [pushCrossed_append,
              pushCrossed] using
              grammarGateStartProgramEOFFailure_exact
                (grammarGatePrefix
                  inputs done remaining)
        have run :=
          grammarGateBoundaryCleanup_bounded_exact
            inputs done remaining word
            (by
              intro symbol member
              exact
                (MalformedWorkTail.trailingTwo
                  true false).allSourcePacked
                  symbol (by
                    simpa [word,
                      boolPairWorkCell_true_false_eq]
                      using member))
            (by simp [word]) launch
        simpa [word,
          boolPairWorkCell_true_false_eq] using run
      · let word := [cell11]
        have launch :
            BoundaryCleanupLaunch State.gateStart
              (grammarGatePrefix
                inputs done remaining)
              word := by
          dsimp [word]
          apply boundaryCleanupLaunch_immediate
          exact grammarGateStartCell11Failure_exact
            (grammarGatePrefix
              inputs done remaining) []
        have run :=
          grammarGateBoundaryCleanup_bounded_exact
            inputs done remaining word
            (by
              intro symbol member
              exact
                (MalformedWorkTail.trailingTwo
                  true true).allSourcePacked
                  symbol (by
                    simpa [word,
                      boolPairWorkCell_true_true_eq]
                      using member))
            (by simp [word]) launch
        simpa [word,
          boolPairWorkCell_true_true_eq] using run
  | trailingThree first second third =>
      cases first <;> cases second
      · simpa [boolPairWorkCell_false_false_eq,
          firstSourceCell] using
          (grammarGateSourceDangling_bounded_exact
            false inputs done remaining third)
      · simpa [boolPairWorkCell_false_true_eq,
          firstSourceCell] using
          (grammarGateSourceDangling_bounded_exact
            true inputs done remaining third)
      · let word :=
          [cell10, danglingWorkCell third]
        have mismatch :=
          grammarProgramSecondFailure_exact
            (grammarGatePrefix
              inputs done remaining)
            (danglingWorkCell third) []
            (by cases third <;> decide)
        have launch :
            BoundaryCleanupLaunch State.gateStart
              (grammarGatePrefix
                inputs done remaining)
              word := by
          dsimp [word]
          apply boundaryCleanupLaunch_afterOne_rewritten
          · exact cursorMark_cleanupSafe
          · simpa [pushCrossed_append,
              pushCrossed] using mismatch
        have run :=
          grammarGateBoundaryCleanup_bounded_exact
            inputs done remaining word
            (by
              intro symbol member
              exact
                (MalformedWorkTail.trailingThree
                  true false third).allSourcePacked
                  symbol (by
                    simpa [word,
                      boolPairWorkCell_true_false_eq]
                      using member))
            (by simp [word]) launch
        simpa [word,
          boolPairWorkCell_true_false_eq] using run
      · let word :=
          [cell11, danglingWorkCell third]
        have launch :
            BoundaryCleanupLaunch State.gateStart
              (grammarGatePrefix
                inputs done remaining)
              word := by
          dsimp [word]
          apply boundaryCleanupLaunch_immediate
          exact grammarGateStartCell11Failure_exact
            (grammarGatePrefix
              inputs done remaining)
            [danglingWorkCell third]
        have run :=
          grammarGateBoundaryCleanup_bounded_exact
            inputs done remaining word
            (by
              intro symbol member
              exact
                (MalformedWorkTail.trailingThree
                  true true third).allSourcePacked
                  symbol (by
                    simpa [word,
                      boolPairWorkCell_true_true_eq]
                      using member))
            (by simp [word]) launch
        simpa [word,
          boolPairWorkCell_true_true_eq] using run

private theorem sourceTokenFailureWithFramingTail_afterFirst_exact
    (continuation : SourceContinuation)
    (inputs gateCountUsed gateCountRemaining : Nat)
    (priorGates : List RawGate)
    (before : List WorkSymbol)
    {tokens : List Token}
    (failure : SourceTokenFailure tokens)
    (beforeOrdinary :
      ∀ symbol, symbol ∈ before →
        ordinaryCell symbol)
    (beforeNoGateMark :
      ∀ symbol, symbol ∈ before →
        symbol ≠ gateMark)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail)
    (firstWas01 : Bool) (rest : List WorkSymbol)
    (packed :
      packedTokenCells tokens ++ workTail =
        firstSourceCell firstWas01 :: rest) :
    let context :=
      sourceContextPrefix
        inputs gateCountUsed gateCountRemaining
        priorGates before
    let word :=
      packedTokenCells tokens ++ workTail
    ∃ steps final,
      steps ≤
          128 *
            failureSpanSquare
              (sourceWorkFailureSpan
                inputs gateCountUsed gateCountRemaining
                priorGates before word) ∧
      workRunExact? machine steps
          (guardedConfig
            (afterFirstSourceState
              firstWas01 continuation)
            (context ++
              [firstSourceCell firstWas01])
            rest) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let context :=
    sourceContextPrefix
      inputs gateCountUsed gateCountRemaining
      priorGates before
  let word :=
    packedTokenCells tokens ++ workTail
  rcases
      sourceTokenFailureWithFramingTail_bounded_exact
        continuation inputs gateCountUsed
        gateCountRemaining priorGates before
        failure beforeOrdinary beforeNoGateMark
        malformed with
    ⟨fullSteps, final, fullBound, fullRun,
      finalState, outputEmpty⟩
  have fullRunCanonical :
      workRunExact? machine fullSteps
          (guardedConfig
            (State.sourceStart continuation)
            context
            (firstSourceCell firstWas01 :: rest)) =
        some final := by
    rw [← packed]
    simpa [context, word] using fullRun
  have first :=
    sourceFirstRemainder_exact
      continuation firstWas01 context rest
  have firstStep :
      workStep? machine
          (guardedConfig
            (State.sourceStart continuation)
            context
            (firstSourceCell firstWas01 :: rest)) =
        some
          (guardedConfig
            (afterFirstSourceState
              firstWas01 continuation)
            (context ++
              [firstSourceCell firstWas01])
            rest) := by
    cases continuation <;> cases firstWas01 <;>
      unfold guardedConfig <;>
      rw [pushCrossed_append] <;> rfl
  have positive : 0 < fullSteps := by
    cases fullSteps with
    | zero =>
        have initialEq :
            guardedConfig
                (State.sourceStart continuation)
                context
                (firstSourceCell firstWas01 :: rest) =
              final :=
          Option.some.inj fullRunCanonical
        have stateEq :
            State.sourceStart continuation =
              final.state := by
          simpa [guardedConfig, configAtWord] using
            congrArg (fun config => config.state)
              initialEq
        have notReject :
            State.sourceStart continuation ≠
              State.reject := by
          cases continuation <;> decide
        exact False.elim
          (notReject (stateEq.trans finalState))
    | succ tailSteps =>
        omega
  rcases
      exactRun_cancel_first fullSteps
        (guardedConfig
          (State.sourceStart continuation)
          context
          (firstSourceCell firstWas01 :: rest))
        (guardedConfig
          (afterFirstSourceState
            firstWas01 continuation)
          (context ++
            [firstSourceCell firstWas01])
          rest)
        final positive firstStep fullRunCanonical with
    ⟨tailSteps, stepsEq, tail⟩
  refine
    ⟨tailSteps, final, ?_, ?_,
      finalState, outputEmpty⟩
  · have tailLe : tailSteps ≤ fullSteps := by
      omega
    exact Nat.le_trans tailLe
      (by simpa [word] using fullBound)
  · simpa [context] using tail

private theorem grammarSourceWorkSpan_eq
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (word : List WorkSymbol) :
    sourceWorkFailureSpan
        inputs (done.length + 1) remaining
        done [] word =
      grammarWorkFailureSpan
        inputs done (remaining + 1) word := by
  unfold sourceWorkFailureSpan
    grammarWorkFailureSpan
  unfold sourceContextPrefix gateReferenceHeader
    grammarGatePrefix
  simp only [List.length_append,
    List.length_cons, List.length_nil,
    countCells_length, natCells_length]
  omega

private theorem grammarGateLeftFailureWithFramingTail_bounded_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat)
    {tokens : List Token}
    (failure : SourceTokenFailure tokens)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    let word :=
      packedTokenCells tokens ++ workTail
    ∃ steps final,
      steps ≤
          256 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1) word) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done (remaining + 1))
            word) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let logicalPrefix :=
    grammarGatePrefix
      inputs done (remaining + 1)
  let word :=
    packedTokenCells tokens ++ workTail
  have consume
      (firstWas01 : Bool)
      (current : WorkSymbol) (rest : List WorkSymbol)
      (packed :
        word =
          firstSourceCell firstWas01 ::
            current :: rest) :
      ∃ steps final,
        steps ≤
            256 *
              failureSpanSquare
                (grammarWorkFailureSpan
                  inputs done (remaining + 1) word) ∧
        workRunExact? machine steps
            (guardedConfig State.gateStart
              logicalPrefix word) =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    let launchSteps :=
      grammarGateSourceLaunchSteps
        inputs done remaining
    have launch :=
      grammarGateDecrementWord_exact
        firstWas01 inputs done remaining
        (current :: rest)
    rcases
        sourceTokenFailureWithFramingTail_afterFirst_exact
          .gateLeft inputs (done.length + 1)
          remaining done [] failure
          (by
            intro symbol member
            contradiction)
          (by
            intro symbol member
            contradiction)
          malformed firstWas01 (current :: rest)
          (by simpa [word] using packed) with
      ⟨tailSteps, final, tailBound, tail,
        finalState, outputEmpty⟩
    have spanEq :=
      grammarSourceWorkSpan_eq
        inputs done remaining word
    rw [spanEq] at tailBound
    have launchBound :
        launchSteps ≤
          8 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1) word) := by
      simpa [launchSteps] using
        (grammarGateSourceLaunchSteps_work_bound
          inputs done remaining word)
    have all :=
      exactRun_add launchSteps tailSteps
        _ _ _ (by
          simpa [launchSteps] using launch)
        tail
    have combined :=
      Nat.add_le_add launchBound tailBound
    refine
      ⟨launchSteps + tailSteps,
        final, ?_, ?_, finalState, outputEmpty⟩
    · exact Nat.le_trans combined (by omega)
    · rw [packed]
      simpa [logicalPrefix, launchSteps] using all
  cases failure with
  | missing =>
      rcases
          grammarGateMalformedTail_bounded_exact
            inputs done (remaining + 1)
            malformed with
        ⟨steps, final, bound, run,
          finalState, outputEmpty⟩
      refine
        ⟨steps, final, ?_, ?_,
          finalState, outputEmpty⟩
      · simpa [word, packedTokenCells] using
          Nat.le_trans bound (by omega)
      · simpa [logicalPrefix, word,
          packedTokenCells] using run
  | wrongHead token suffix
      notInput notFalse notTrue notGate =>
      let after :=
        packedTokenCells suffix ++ workTail
      cases token with
      | version0 =>
          apply consume false cell00 after
          simp [word, after, packedTokenCells,
            tokenCells, firstSourceCell]
      | unit =>
          apply consume false cell01 after
          simp [word, after, packedTokenCells,
            tokenCells, firstSourceCell]
      | natEnd =>
          apply consume false cell10 after
          simp [word, after, packedTokenCells,
            tokenCells, firstSourceCell]
      | input =>
          exact False.elim (notInput rfl)
      | constantFalse =>
          exact False.elim (notFalse rfl)
      | constantTrue =>
          exact False.elim (notTrue rfl)
      | gate =>
          exact False.elim (notGate rfl)
      | gateEnd =>
          apply consume true cell11 after
          simp [word, after, packedTokenCells,
            tokenCells, firstSourceCell]
      | programEnd =>
          have restNoBlank :
              ∀ symbol, symbol ∈ after →
                symbol ≠ cellBlank := by
            intro symbol member
            rcases List.mem_append.mp member with
                inTokens | inTail
            · exact ordinaryCell_not_blank
                (packedTokenCells_allOrdinary
                  suffix symbol inTokens)
            · exact malformed.nonblank symbol inTail
          rcases
              grammarProgramPremature_exact
                inputs done remaining after
                restNoBlank with
            ⟨steps, final, bound, run,
              finalState, outputEmpty⟩
          refine
            ⟨steps, final, ?_, ?_,
              finalState, outputEmpty⟩
          · have boundCanonical :
                steps ≤
                  64 *
                    failureSpanSquare
                      (grammarWorkFailureSpan
                        inputs done (remaining + 1)
                        (cell10 :: cell00 :: after)) := by
              simpa [grammarWorkFailureSpan] using bound
            have wordEq :
                word = cell10 :: cell00 :: after := by
              simp [word, after, packedTokenCells,
                tokenCells]
            have wordEqCanonical :
                packedTokenCells
                    (.programEnd :: suffix) ++ workTail =
                  cell10 :: cell00 :: after := by
              simpa [word] using wordEq
            rw [wordEqCanonical]
            exact Nat.le_trans boundCanonical (by omega)
          · simpa [logicalPrefix, word, after,
              packedTokenCells, tokenCells,
              List.append_assoc] using run
      | outputsEnd =>
          rcases
              grammarGateStartProgramMismatch_exact
                inputs done (remaining + 1) cell01
                after (by decide)
                (by
                  intro symbol member
                  simp only [List.mem_cons] at member
                  rcases member with rfl | inAfter
                  · exact ordinaryCell_cell01
                  · rcases List.mem_append.mp inAfter with
                      inTokens | inTail
                    · exact packedTokenCells_allOrdinary
                        suffix symbol inTokens
                    · exact malformedWorkTail_allOrdinary
                        malformed symbol inTail) with
            ⟨steps, final, bound, run,
              finalState, outputEmpty⟩
          refine
            ⟨steps, final, ?_, ?_,
              finalState, outputEmpty⟩
          · have wordEq :
                word = cell10 :: cell01 :: after := by
              simp [word, after, packedTokenCells,
                tokenCells]
            have wordEqCanonical :
                packedTokenCells
                    (.outputsEnd :: suffix) ++ workTail =
                  cell10 :: cell01 :: after := by
              simpa [word] using wordEq
            rw [wordEqCanonical]
            have boundCanonical :
                steps ≤
                  16 *
                    failureSpanSquare
                      (grammarWorkFailureSpan
                        inputs done (remaining + 1)
                        (cell10 :: cell01 :: after)) := by
              simpa [grammarWorkFailureSpan] using bound
            exact Nat.le_trans boundCanonical (by omega)
          · simpa [logicalPrefix, word, after,
              packedTokenCells, tokenCells,
              List.append_assoc] using run
      | threshold =>
          rcases
              grammarGateStartProgramMismatch_exact
                inputs done (remaining + 1) cell10
                after (by decide)
                (by
                  intro symbol member
                  simp only [List.mem_cons] at member
                  rcases member with rfl | inAfter
                  · exact ordinaryCell_cell10
                  · rcases List.mem_append.mp inAfter with
                      inTokens | inTail
                    · exact packedTokenCells_allOrdinary
                        suffix symbol inTokens
                    · exact malformedWorkTail_allOrdinary
                        malformed symbol inTail) with
            ⟨steps, final, bound, run,
              finalState, outputEmpty⟩
          refine
            ⟨steps, final, ?_, ?_,
              finalState, outputEmpty⟩
          · have wordEq :
                word = cell10 :: cell10 :: after := by
              simp [word, after, packedTokenCells,
                tokenCells]
            have wordEqCanonical :
                packedTokenCells
                    (.threshold :: suffix) ++ workTail =
                  cell10 :: cell10 :: after := by
              simpa [word] using wordEq
            rw [wordEqCanonical]
            have boundCanonical :
                steps ≤
                  16 *
                    failureSpanSquare
                      (grammarWorkFailureSpan
                        inputs done (remaining + 1)
                        (cell10 :: cell10 :: after)) := by
              simpa [grammarWorkFailureSpan] using bound
            exact Nat.le_trans boundCanonical (by omega)
          · simpa [logicalPrefix, word, after,
              packedTokenCells, tokenCells,
              List.append_assoc] using run
      | instanceEnd =>
          rcases
              grammarGateStartProgramMismatch_exact
                inputs done (remaining + 1) cell11
                after (by decide)
                (by
                  intro symbol member
                  simp only [List.mem_cons] at member
                  rcases member with rfl | inAfter
                  · exact ordinaryCell_cell11
                  · rcases List.mem_append.mp inAfter with
                      inTokens | inTail
                    · exact packedTokenCells_allOrdinary
                        suffix symbol inTokens
                    · exact malformedWorkTail_allOrdinary
                        malformed symbol inTail) with
            ⟨steps, final, bound, run,
              finalState, outputEmpty⟩
          refine
            ⟨steps, final, ?_, ?_,
              finalState, outputEmpty⟩
          · have wordEq :
                word = cell10 :: cell11 :: after := by
              simp [word, after, packedTokenCells,
                tokenCells]
            have wordEqCanonical :
                packedTokenCells
                    (.instanceEnd :: suffix) ++ workTail =
                  cell10 :: cell11 :: after := by
              simpa [word] using wordEq
            rw [wordEqCanonical]
            have boundCanonical :
                steps ≤
                  16 *
                    failureSpanSquare
                      (grammarWorkFailureSpan
                        inputs done (remaining + 1)
                        (cell10 :: cell11 :: after)) := by
              simpa [grammarWorkFailureSpan] using bound
            exact Nat.le_trans boundCanonical (by omega)
          · simpa [logicalPrefix, word, after,
              packedTokenCells, tokenCells,
              List.append_assoc] using run
  | inputIndex natFailure =>
      cases natFailure with
      | missingEnd units =>
          apply consume false cell11
            (unaryUnitCells units ++ workTail)
          simp [word, packedTokenCells, tokenCells,
            packedTokenCells_replicate_unit,
            firstSourceCell]
      | wrongToken units token suffix
          notUnit notNatEnd =>
          apply consume false cell11
            (malformedNatTailCells
              units token suffix ++ workTail)
          rw [show word =
              packedTokenCells
                    (.input ::
                      (List.replicate units .unit ++
                        token :: suffix)) ++
                  workTail by rfl]
          rw [packedTokenCells]
          rw [packedTokenCells_append,
            packedTokenCells_replicate_unit]
          simp [malformedNatTailCells,
            packedTokenCells, tokenCells,
            firstSourceCell, List.append_assoc]
  | gateIndex natFailure =>
      cases natFailure with
      | missingEnd units =>
          apply consume true cell10
            (unaryUnitCells units ++ workTail)
          simp [word, packedTokenCells, tokenCells,
            packedTokenCells_replicate_unit,
            firstSourceCell]
      | wrongToken units token suffix
          notUnit notNatEnd =>
          apply consume true cell10
            (malformedNatTailCells
              units token suffix ++ workTail)
          rw [show word =
              packedTokenCells
                    (.gate ::
                      (List.replicate units .unit ++
                        token :: suffix)) ++
                  workTail by rfl]
          rw [packedTokenCells]
          rw [packedTokenCells_append,
            packedTokenCells_replicate_unit]
          simp [malformedNatTailCells,
            packedTokenCells, tokenCells,
            firstSourceCell, List.append_assoc]

private theorem grammarSingleGateBound256
    (count span steps : Nat)
    (bound :
      steps ≤ 256 * failureSpanSquare span) :
    steps ≤
      (count + 1) *
        (256 * failureSpanSquare span) := by
  have factor : 1 ≤ count + 1 := by
    omega
  have scaled :=
    Nat.mul_le_mul_left
      (256 * failureSpanSquare span) factor
  exact Nat.le_trans bound (by
    simpa [Nat.mul_comm] using scaled)

private theorem grammarRecursiveGateBound256
    (count span headSteps tailSteps : Nat)
    (headBound :
      headSteps ≤ 256 * failureSpanSquare span)
    (tailBound :
      tailSteps ≤
        count * (256 * failureSpanSquare span)) :
    headSteps + tailSteps ≤
      (count + 1) *
        (256 * failureSpanSquare span) := by
  calc
    headSteps + tailSteps ≤
        256 * failureSpanSquare span +
          count * (256 * failureSpanSquare span) :=
      Nat.add_le_add headBound tailBound
    _ = (count + 1) *
          (256 * failureSpanSquare span) := by
      rw [Nat.add_mul]
      simp [Nat.add_comm]

private theorem grammarRightSourceWorkSpan_eq
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (left : RawSource)
    (suffix : List WorkSymbol) :
    sourceWorkFailureSpan
        inputs (done.length + 1) remaining
        done (sourceCells left) suffix =
      grammarWorkFailureSpan
        inputs done (remaining + 1)
        (sourceCells left ++ suffix) := by
  unfold sourceWorkFailureSpan
    grammarWorkFailureSpan
  unfold sourceContextPrefix gateReferenceHeader
    grammarGatePrefix
  simp only [List.length_append,
    List.length_cons, List.length_nil,
    countCells_length, natCells_length]
  omega

private theorem grammarNGatesRightFailureWithFramingTail_bounded_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (left : RawSource)
    {tokens : List Token}
    (failure : SourceTokenFailure tokens)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    let suffix :=
      packedTokenCells tokens ++ workTail
    let word :=
      sourceCells left ++ suffix
    ∃ steps final,
      steps ≤
          (remaining + 1) *
            (256 *
              failureSpanSquare
                (grammarWorkFailureSpan
                  inputs done (remaining + 1)
                  word)) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done (remaining + 1))
            word) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let suffix :=
    packedTokenCells tokens ++ workTail
  let word :=
    sourceCells left ++ suffix
  cases leftEq :
      left.wellFormed inputs done.length with
  | false =>
      have sourceFailure :=
        (source_wellFormed_false_iff_failure
          inputs done.length left).mp leftEq
      have suffixOrdinary :
          ∀ symbol, symbol ∈ suffix →
            ordinaryCell symbol := by
        intro symbol member
        exact
          tokenPrefixMalformedWord_allOrdinary
            tokens malformed symbol
            (by simpa [suffix] using member)
      rcases
          grammarGateLeftBoundFailure_bounded_exact
            inputs done remaining left suffix
            sourceFailure suffixOrdinary with
        ⟨steps, final, bound, run,
          finalState, outputEmpty⟩
      have boundCanonical :
          steps ≤
            32 *
              failureSpanSquare
                (grammarWorkFailureSpan
                  inputs done (remaining + 1)
                  word) := by
        simpa [word] using bound
      have localBound :
          steps ≤
            256 *
              failureSpanSquare
                (grammarWorkFailureSpan
                  inputs done (remaining + 1)
                  word) := by
        exact Nat.le_trans boundCanonical (by omega)
      refine
        ⟨steps, final,
          grammarSingleGateBound256
            remaining _ _ localBound,
          ?_, finalState, outputEmpty⟩
      simpa [word] using run
  | true =>
      rcases
          grammarGateLeftValid_exact
            inputs done remaining left suffix
            leftEq with
        ⟨leftSteps, leftBound, leftRun⟩
      rcases
          sourceTokenFailureWithFramingTail_bounded_exact
            .gateRight inputs (done.length + 1)
            remaining done (sourceCells left)
            failure
            (sourceCells_allOrdinary left)
            (sourceCells_no_gateMark left)
            malformed with
        ⟨rightSteps, final, rightBound, rightRun,
          finalState, outputEmpty⟩
      have leftBoundCanonical :
          leftSteps ≤
            32 *
              failureSpanSquare
                (grammarWorkFailureSpan
                  inputs done (remaining + 1)
                  word) := by
        simpa [word] using leftBound
      have spanEq :=
        grammarRightSourceWorkSpan_eq
          inputs done remaining left suffix
      rw [spanEq] at rightBound
      have rightBoundCanonical :
          rightSteps ≤
            128 *
              failureSpanSquare
                (grammarWorkFailureSpan
                  inputs done (remaining + 1)
                  word) := by
        simpa [word, suffix] using rightBound
      have all :=
        exactRun_add leftSteps rightSteps
          _ _ _ leftRun
          (by simpa [suffix] using rightRun)
      have localBound :
          leftSteps + rightSteps ≤
            256 *
              failureSpanSquare
                (grammarWorkFailureSpan
                  inputs done (remaining + 1)
                  word) := by
        omega
      refine
        ⟨leftSteps + rightSteps,
          final,
          grammarSingleGateBound256
            remaining _ _ localBound,
          ?_, finalState, outputEmpty⟩
      simpa [word] using all

private theorem grammarGateEndBoundaryCleanup_bounded_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (left right : RawSource)
    (word : List WorkSymbol)
    (wordSourcePacked :
      ∀ symbol, symbol ∈ word →
        SourcePackedCell symbol)
    (wordNonempty : word ≠ [])
    (launch :
      BoundaryCleanupLaunch State.gateEndFirst
        (sourceContextPrefix
          inputs (done.length + 1)
          remaining done
          (sourceCells left ++
            sourceCells right))
        word) :
    ∃ steps final,
      steps ≤
          128 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1)
                (sourceCells left ++
                  sourceCells right ++ word)) ∧
      workRunExact? machine steps
          (guardedConfig State.gateEndFirst
            (sourceContextPrefix
              inputs (done.length + 1)
              remaining done
              (sourceCells left ++
                sourceCells right))
            word) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let parsedPrefix :=
    sourceContextPrefix
      inputs (done.length + 1)
      remaining done
      (sourceCells left ++ sourceCells right)
  have parsedOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol := by
    exact sourceContextPrefix_allOrdinary
      inputs (done.length + 1)
      remaining done
      (sourceCells left ++ sourceCells right)
      (by
        apply ordinaryCells_append
        · exact sourceCells_allOrdinary left
        · exact sourceCells_allOrdinary right)
  rcases
      boundaryCleanupLaunch_square_bounded_exact
        State.gateEndFirst parsedPrefix word
        parsedOrdinary wordSourcePacked
        wordNonempty
        (by simpa [parsedPrefix] using launch) with
    ⟨steps, final, bound, run,
      finalState, outputEmpty⟩
  have lengthLe :
      (parsedPrefix ++ word).length ≤
        grammarWorkFailureSpan
          inputs done (remaining + 1)
          (sourceCells left ++
            sourceCells right ++ word) := by
    have spanEq :=
      grammarGateEndWorkSpan_eq
        inputs done remaining left right word
    dsimp [parsedPrefix]
    rw [← spanEq]
    simp only [List.length_append]
    omega
  have squareLe :=
    failureSpanSquare_mono lengthLe
  have scaled :=
    Nat.mul_le_mul_left 16 squareLe
  refine
    ⟨steps, final, ?_, ?_,
      finalState, outputEmpty⟩
  · exact Nat.le_trans bound
      (Nat.le_trans scaled (by omega))
  · simpa [parsedPrefix] using run

private theorem grammarGateEndWrongTokenWork_launch
    (parsedPrefix : List WorkSymbol)
    (token : Token) (after : List WorkSymbol)
    (notGateEnd : token ≠ .gateEnd) :
    BoundaryCleanupLaunch State.gateEndFirst
      parsedPrefix (tokenCells token ++ after) := by
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq : tokenCells token = [current, next])
      (notExpected : current ≠ cell01) :
      BoundaryCleanupLaunch State.gateEndFirst
        parsedPrefix (tokenCells token ++ after) := by
    rw [cellsEq]
    apply boundaryCleanupLaunch_immediate
    simpa using
      grammarGateEndFirstFailure_exact
        parsedPrefix current
        (next :: after) notExpected
  have rejectSecond
      (current : WorkSymbol)
      (cellsEq :
        tokenCells token = [cell01, current])
      (notExpected : current ≠ cell11) :
      BoundaryCleanupLaunch State.gateEndFirst
        parsedPrefix (tokenCells token ++ after) := by
    rw [cellsEq]
    apply boundaryCleanupLaunch_afterOne_rewritten
      (stored := gateMark)
    · constructor <;> decide
    · simpa using
        grammarGateEndSecondFailure_exact
          parsedPrefix current after notExpected
  cases token with
  | version0 =>
      exact rejectFirst cell00 cell00 rfl (by decide)
  | unit =>
      exact rejectFirst cell00 cell01 rfl (by decide)
  | natEnd =>
      exact rejectFirst cell00 cell10 rfl (by decide)
  | input =>
      exact rejectFirst cell00 cell11 rfl (by decide)
  | constantFalse =>
      exact rejectSecond cell00 rfl (by decide)
  | constantTrue =>
      exact rejectSecond cell01 rfl (by decide)
  | gate =>
      exact rejectSecond cell10 rfl (by decide)
  | gateEnd =>
      exact False.elim (notGateEnd rfl)
  | programEnd =>
      exact rejectFirst cell10 cell00 rfl (by decide)
  | outputsEnd =>
      exact rejectFirst cell10 cell01 rfl (by decide)
  | threshold =>
      exact rejectFirst cell10 cell10 rfl (by decide)
  | instanceEnd =>
      exact rejectFirst cell10 cell11 rfl (by decide)

