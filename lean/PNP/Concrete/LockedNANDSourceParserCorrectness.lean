private theorem circuitOutputPackedPrefixWordSteps_bound
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource) (after : List WorkSymbol) :
    circuitOutputPrefixSteps inputs gates output ≤
      192 *
        failureSpanCube
          (packedTokenCells
              (circuitOutputPrefixTokens
                inputs gates output) ++
            after).length := by
  let tokens :=
    circuitOutputPrefixTokens inputs gates output
  have base :
      circuitOutputPrefixSteps inputs gates output ≤
        192 *
          failureSpanCube
            (circuitTokenFailureSpan tokens) := by
    simpa [tokens, circuitOutputPrefixSteps] using
      (circuitOutputPrefixSteps_bound
