  let parsedPrefix :=
    [cell00, cell00] ++
      natCells inputs ++
      borrowedCountCells done.length
  let suffix :=
    markedGateListCells done ++
      cursorMark :: word
  let afterHeader :=
    countCells done.length 0 ++
      markedGateListCells done ++
