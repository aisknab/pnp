        tokenCells token = [current, next])
      (wrong : current ≠ cell00) :
      ∃ steps final,
        steps ≤ rawFailureEnvelope word ∧
        workRunExact? machine steps initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have prefixRun' := prefixRun
    rw [cellsEq] at prefixRun'
    have failed :=
      firstFailure current
        (next :: suffixCells) wrong
    have launch :=
      exactRun_add prefixSteps 1
        _ _ _ prefixRun' failed
    have shape :
        word =
          parsedCells ++ current ::
            next :: suffixCells := by
      have shaped := wordShape
      rw [cellsEq] at shaped
      simpa [suffixCells,
        List.append_assoc] using shaped
    exact
      wordExplicitFailure_raw_bounded_exact
        word parsedCells current
        (next :: suffixCells) initial
        (prefixSteps + 1) shape
        wordOrdinary launch (by omega)
  have rejectSecond
      (current : WorkSymbol)
      (cellsEq :
        tokenCells token = [cell00, current])
