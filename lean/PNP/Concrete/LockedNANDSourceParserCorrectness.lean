private theorem grammarGateEndMissing_exact
    (parsedPrefix : List WorkSymbol)
    (parsedOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol) :
    ∃ steps final,
      steps ≤
          16 *
            failureSpanSquare
              (parsedPrefix.length + 2) ∧
      workRunExact? machine steps
          (guardedConfig State.gateEndFirst
            parsedPrefix []) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let crossed := pushCrossed parsedPrefix []
  have initialEq :
      guardedConfig State.gateEndFirst
          parsedPrefix [] =
        configAtWord State.gateEndFirst
          (crossed ++ [leftGuard]) [] := by
    simpa [crossed] using
      guardedConfig_eq_crossed
        State.gateEndFirst parsedPrefix []
  have failure :=
    grammarGateEndMissingLaunch_exact crossed
  have tail :=
    missingEndTail_exact
      State.gateEndFirst parsedPrefix crossed rfl
      (by
        intro symbol member
        exact ordinaryCell_not_leftGuard
          (parsedOrdinary symbol member))
      (by
        intro symbol member
        exact ordinaryCell_not_blank
          (parsedOrdinary symbol member))
      failure
  let final :=
    cleanupExplicitRejectConfiguration
      [] (missingEndEraseWord crossed) []
  have linear :=
    sourceMissingTokenSteps_linear_bound parsedPrefix
  have scheduleBound :=
    linear_failure_le_square
      (missingEndTailSteps
        (pushCrossed parsedPrefix []))
      (parsedPrefix.length + 2) linear
  refine
    ⟨missingEndTailSteps crossed,
      final, ?_, ?_, rfl, ?_⟩
  · simpa [crossed] using scheduleBound
  · rw [initialEq]
    simpa [final] using tail
  · rfl

private theorem grammarGateEndWrongToken_exact
    (parsedPrefix : List WorkSymbol)
    (parsedOrdinary :
      ∀ symbol, symbol ∈ parsedPrefix →
        ordinaryCell symbol)
    (token : Token) (suffix : List Token)
    (notGateEnd : token ≠ .gateEnd) :
    ∃ steps final,
      steps ≤
          16 *
            failureSpanSquare
              (parsedPrefix.length +
                (packedTokenCells
                  (token :: suffix)).length + 2) ∧
      workRunExact? machine steps
          (guardedConfig State.gateEndFirst
            parsedPrefix
            (packedTokenCells
              (token :: suffix))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let suffixCells := packedTokenCells suffix
  let initial :=
    guardedConfig State.gateEndFirst
      parsedPrefix
      (packedTokenCells (token :: suffix))
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq : tokenCells token = [current, next])
      (notExpected : current ≠ cell01) :
      ∃ steps final,
        steps ≤
            16 *
              failureSpanSquare
                (parsedPrefix.length +
                  (packedTokenCells
                    (token :: suffix)).length + 2) ∧
        workRunExact? machine steps initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have launch :=
      grammarGateEndFirstFailure_exact
        parsedPrefix current
        (next :: suffixCells) notExpected
    have ordinary :
        ∀ symbol,
          symbol ∈
              parsedPrefix ++
                current :: next :: suffixCells →
            ordinaryCell symbol := by
      intro symbol member
      rcases List.mem_append.mp member with
          inPrefix | inTokens
      · exact parsedOrdinary symbol inPrefix
      · exact packedTokenCells_ordinary
          (token :: suffix) symbol (by
            simpa [packedTokenCells, cellsEq,
              suffixCells] using inTokens)
    have result :=
      ordinaryExplicitFailureRun_exact
        parsedPrefix current
        (next :: suffixCells)
        initial 1 ordinary
        (by
          simpa [initial, suffixCells,
            packedTokenCells, cellsEq] using launch)
    let scan :=
      current :: pushCrossed parsedPrefix []
    let final :=
      cleanupRejectConfiguration
        [] scan (next :: suffixCells) []
    have linear :
        1 + guardedCleanupSteps
              scan (next :: suffixCells) ≤
          4 *
            ((parsedPrefix.length +
              (packedTokenCells
                (token :: suffix)).length + 2) + 1) := by
      rw [guardedCleanupSteps_eq]
      simp only [scan, List.length_cons,
        pushCrossed_length, List.length_nil]
      simp [suffixCells, packedTokenCells,
        cellsEq, Nat.add_assoc]
      omega
    have scheduleBound :=
      linear_failure_le_square
        (1 + guardedCleanupSteps
          scan (next :: suffixCells))
        (parsedPrefix.length +
          (packedTokenCells
            (token :: suffix)).length + 2)
        linear
    refine
      ⟨1 + guardedCleanupSteps
          scan (next :: suffixCells),
        final, ?_, ?_, rfl, ?_⟩
    · exact scheduleBound
    · simpa [scan, final] using result
    · exact cleanupRejectConfiguration_output_empty
        [] scan (next :: suffixCells)
  have rejectSecond
      (current : WorkSymbol)
      (cellsEq :
        tokenCells token = [cell01, current])
      (notExpected : current ≠ cell11) :
      ∃ steps final,
        steps ≤
            16 *
              failureSpanSquare
                (parsedPrefix.length +
                  (packedTokenCells
                    (token :: suffix)).length + 2) ∧
        workRunExact? machine steps initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have launch :=
      grammarGateEndSecondFailure_exact
        parsedPrefix current suffixCells notExpected
    have ordinary :
        ∀ symbol,
          symbol ∈
              (parsedPrefix ++ [gateMark]) ++
                current :: suffixCells →
            ordinaryCell symbol := by
      intro symbol member
      rcases List.mem_append.mp member with
          inPrefix | inTokens
      · rcases List.mem_append.mp inPrefix with
            inParsed | atMark
        · exact parsedOrdinary symbol inParsed
        · simp only [List.mem_cons,
            List.not_mem_nil] at atMark
          rcases atMark with rfl | impossible
          · exact ordinaryCell_gateMark
          · contradiction
      · have tokenOrdinary :
            ∀ found,
              found ∈ current :: suffixCells →
                ordinaryCell found := by
          intro found foundMember
          exact packedTokenCells_ordinary
            (token :: suffix) found (by
              have lifted :
                  found ∈
                    cell01 :: current :: suffixCells := by
                exact List.Mem.tail cell01 foundMember
              simpa [packedTokenCells, cellsEq,
                suffixCells] using lifted)
        exact tokenOrdinary symbol inTokens
    have result :=
      ordinaryExplicitFailureRun_exact
        (parsedPrefix ++ [gateMark])
        current suffixCells initial 2 ordinary
        (by
          simpa [initial, suffixCells,
            packedTokenCells, cellsEq] using launch)
    let scan :=
      current ::
        pushCrossed (parsedPrefix ++ [gateMark]) []
    let final :=
      cleanupRejectConfiguration
        [] scan suffixCells []
    have linear :
        2 + guardedCleanupSteps scan suffixCells ≤
          4 *
            ((parsedPrefix.length +
              (packedTokenCells
                (token :: suffix)).length + 2) + 1) := by
      rw [guardedCleanupSteps_eq]
      simp only [scan, List.length_cons,
        List.length_append, List.length_nil,
        pushCrossed_length]
      simp [suffixCells, packedTokenCells,
        cellsEq, Nat.add_assoc]
      omega
    have scheduleBound :=
      linear_failure_le_square
        (2 + guardedCleanupSteps scan suffixCells)
        (parsedPrefix.length +
          (packedTokenCells
            (token :: suffix)).length + 2)
        linear
    refine
      ⟨2 + guardedCleanupSteps scan suffixCells,
        final, ?_, ?_, rfl, ?_⟩
    · exact scheduleBound
    · simpa [scan, final] using result
    · exact cleanupRejectConfiguration_output_empty
        [] scan suffixCells
  cases token with
  | version0 =>
      exact rejectFirst cell00 cell00 rfl (by decide)
  | unit =>
      exact rejectFirst cell00 cell01 rfl (by decide)
  | natEnd =>
      exact rejectFirst cell00 cell10 rfl (by decide)
  | input =>
      exact rejectFirst cell00 cell11 rfl (by decide)
  | constantFalse =>
      exact rejectSecond cell00 rfl (by decide)
  | constantTrue =>
      exact rejectSecond cell01 rfl (by decide)
  | gate =>
      exact rejectSecond cell10 rfl (by decide)
  | gateEnd =>
      exact False.elim (notGateEnd rfl)
  | programEnd =>
      exact rejectFirst cell10 cell00 rfl (by decide)
  | outputsEnd =>
      exact rejectFirst cell10 cell01 rfl (by decide)
  | threshold =>
      exact rejectFirst cell10 cell10 rfl (by decide)
  | instanceEnd =>
      exact rejectFirst cell10 cell11 rfl (by decide)

private theorem grammarGateCountBorrowedPrefix_exact
    (firstWas01 : Bool) (used : Nat)
    (left suffix : List WorkSymbol) :
    workRunExact? machine (2 * used)
        (configAtWord
          (State.gateDecrementCountFirst firstWas01)
          left
          (borrowedCountCells used ++ suffix)) =
      some
        (configAtWord
          (State.gateDecrementCountFirst firstWas01)
          (pushCrossed
            (borrowedCountCells used) left)
          suffix) := by
  induction used generalizing left with
  | zero =>
      rfl
  | succ used ih =>
      have first :=
        grammarGateCountBorrowed_exact
          firstWas01 left
          (borrowedCountCells used ++ suffix)
      have tail :=
        ih (countMark :: cell00 :: left)
      have all :=
        exactRun_add 2 (2 * used)
          _ _ _ first tail
      simpa [borrowedCountCells,
        pushCrossed, Nat.mul_succ,
        Nat.add_comm, Nat.add_left_comm,
        Nat.add_assoc] using all

