          _ _ _ first tail
      simpa [borrowedCountCells,
        unaryUnitCells, pushCrossed,
        Nat.mul_succ, Nat.add_comm,
        Nat.add_left_comm, Nat.add_assoc] using all

set_option maxRecDepth 100000 in
private theorem grammarProgramCountRemainingFailure_exact
    (parsedPrefix suffix : List WorkSymbol) :
    workRunExact? machine 2
        (configAtWord State.programCountFirst
          (pushCrossed parsedPrefix [leftGuard])
          (cell00 :: cell01 :: suffix)) =
      some
        (cleanupSeekConfiguration
          []
          (cell01 :: cell00 ::
            pushCrossed parsedPrefix [])
          suffix) := by
  have crossedEq :
      pushCrossed parsedPrefix [leftGuard] =
        pushCrossed parsedPrefix [] ++
          [leftGuard] :=
    pushCrossed_append_suffix
      parsedPrefix [] [leftGuard]
  rw [crossedEq]
  cases pushCrossed parsedPrefix [] <;> rfl

private theorem grammarProgramPrematureForward_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat)
    (rest : List WorkSymbol) :
    let parsedPrefix :=
      [cell00, cell00] ++
        natCells inputs ++
        unaryUnitCells done.length
    let suffix :=
      natCells remaining ++
        markedGateListCells done ++
        cursorMark :: cell00 :: rest
    workRunExact? machine
        (((2 + 2 * (inputs + 1)) +
          2 * done.length) + 2)
          (configAtWord State.programSkipVersionFirst
            [leftGuard]
            (grammarGatePrefix
                inputs done (remaining + 1) ++
              cursorMark :: cell00 :: rest)) =
        some
          (cleanupSeekConfiguration
            []
            (cell01 :: cell00 ::
              pushCrossed parsedPrefix [])
            suffix) := by
  dsimp only
  let parsedPrefix :=
    [cell00, cell00] ++
      natCells inputs ++
      unaryUnitCells done.length
  let suffix :=
    natCells remaining ++
      markedGateListCells done ++
      cursorMark :: cell00 :: rest
  let afterHeader :=
    countCells done.length (remaining + 1) ++
      markedGateListCells done ++
      cursorMark :: cell00 :: rest
  have version :=
    grammarProgramVersion_exact
      [leftGuard] (natCells inputs ++ afterHeader)
  have input :=
    grammarProgramInput_exact inputs
      [cell00, cell00, leftGuard] afterHeader
  have count :=
    grammarProgramCountBorrowedPrefix_exact
      done.length
      (pushCrossed (natCells inputs)
        [cell00, cell00, leftGuard])
      (cell00 :: cell01 :: suffix)
  have countCanonical :
      workRunExact? machine (2 * done.length)
          (configAtWord State.programCountFirst
            (pushCrossed (natCells inputs)
              [cell00, cell00, leftGuard])
            afterHeader) =
        some
          (configAtWord State.programCountFirst
            (pushCrossed
              (unaryUnitCells done.length)
              (pushCrossed (natCells inputs)
                [cell00, cell00, leftGuard]))
            (cell00 :: cell01 :: suffix)) := by
    simpa [grammarCountCells_succ_remaining,
      suffix, afterHeader, List.append_assoc] using count
  have leftEq :
      pushCrossed (unaryUnitCells done.length)
          (pushCrossed (natCells inputs)
            [cell00, cell00, leftGuard]) =
        pushCrossed parsedPrefix [leftGuard] := by
    unfold parsedPrefix
    rw [pushCrossed_append, pushCrossed_append]
    rfl
  have failed :=
    grammarProgramCountRemainingFailure_exact
      parsedPrefix suffix
  rw [← leftEq] at failed
  have throughInput :=
    exactRun_add 2 (2 * (inputs + 1))
      _ _ _ version input
  have throughCount :=
    exactRun_add
      (2 + 2 * (inputs + 1))
      (2 * done.length)
      _ _ _ throughInput countCanonical
  have all :=
    exactRun_add
      ((2 + 2 * (inputs + 1)) +
        2 * done.length)
      2 _ _ _ throughCount failed
  simpa [grammarGatePrefix,
    grammarCountCells_succ_remaining,
    parsedPrefix, suffix, afterHeader,
    List.append_assoc] using all

private theorem grammarProgramPremature_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (rest : List WorkSymbol)
    (restNoBlank :
      ∀ symbol, symbol ∈ rest →
        symbol ≠ cellBlank) :
    ∃ steps final,
      steps ≤
          64 *
            failureSpanSquare
              ((grammarGatePrefix
                  inputs done (remaining + 1)).length +
                (cell10 :: cell00 :: rest).length + 2) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done (remaining + 1))
            (cell10 :: cell00 :: rest)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let logicalPrefix :=
    grammarGatePrefix
      inputs done (remaining + 1)
  let parsedPrefix :=
    [cell00, cell00] ++
      natCells inputs ++
      unaryUnitCells done.length
  let suffix :=
    natCells remaining ++
      markedGateListCells done ++
      cursorMark :: cell00 :: rest
  let scan :=
    cell01 :: cell00 ::
      pushCrossed parsedPrefix []
  let right := suffix
  have launch :=
    grammarProgramEndLaunch_exact
      logicalPrefix rest
  have cursorLeft :=
    grammarProgramSeekCursorLeft_exact
      (logicalPrefix.reverse ++ [leftGuard])
      (cell00 :: rest)
  have backward :=
    grammarProgramSeekGuard_scan_exact
      logicalPrefix
      (cursorMark :: cell00 :: rest)
      (grammarGatePrefix_allOrdinary
        inputs done (remaining + 1))
  have guard :=
    grammarProgramSeekGuard_finish_exact
      (logicalPrefix ++
        cursorMark :: cell00 :: rest)
  let forwardSteps :=
    ((2 + 2 * (inputs + 1)) +
      2 * done.length) + 2
  have forwardRaw :=
      grammarProgramPrematureForward_exact
        inputs done remaining rest
  have forward :
      workRunExact? machine forwardSteps
          (configAtWord State.programSkipVersionFirst
            [leftGuard]
            (grammarGatePrefix
                inputs done (remaining + 1) ++
              cursorMark :: cell00 :: rest)) =
        some
          (cleanupSeekConfiguration
            []
            (cell01 :: cell00 ::
              pushCrossed parsedPrefix [])
            suffix) := by
    simpa [forwardSteps, parsedPrefix, suffix] using
      forwardRaw
  have throughCursorLeft :=
    exactRun_add 2 1
      _ _ _ launch cursorLeft
  have throughBackward :=
    exactRun_add (2 + 1)
      logicalPrefix.length
      _ _ _ throughCursorLeft backward
  have throughGuard :=
    exactRun_add
      ((2 + 1) + logicalPrefix.length) 1
      _ _ _ throughBackward guard
  have throughFailure :=
    exactRun_add
      (((2 + 1) + logicalPrefix.length) + 1)
      forwardSteps _ _ _ throughGuard forward
  have scanNoGuard :
      ∀ symbol, symbol ∈ scan →
        symbol ≠ leftGuard := by
    intro symbol member
    unfold scan at member
    simp only [List.mem_cons] at member
    rcases member with rfl | rfl | inCrossed
    · decide
    · decide
    · apply ordinaryCell_not_leftGuard
      have inParsed :
          symbol ∈ parsedPrefix := by
        rw [grammarPushCrossed_eq_reverse_append]
          at inCrossed
        simpa using inCrossed
      unfold parsedPrefix at inParsed
      rcases List.mem_append.mp inParsed with
          inLeading | inUnits
      · rcases List.mem_append.mp inLeading with
            inVersion | inInputs
        · simp only [List.mem_cons,
            List.not_mem_nil] at inVersion
          rcases inVersion with
              rfl | rfl | impossible
          · exact ordinaryCell_cell00
          · exact ordinaryCell_cell00
          · contradiction
        · exact natCells_allOrdinary
            inputs symbol inInputs
      · exact unaryUnitCells_allOrdinary
          done.length symbol inUnits
  have rightNoBlank :
      ∀ symbol, symbol ∈ right →
        symbol ≠ cellBlank := by
    intro symbol member
    unfold right suffix at member
    rcases List.mem_append.mp member with
        inLeading | inTail
    · rcases List.mem_append.mp inLeading with
          inRemaining | inMarked
      · exact ordinaryCell_not_blank
          (natCells_allOrdinary
            remaining symbol inRemaining)
      · exact ordinaryCell_not_blank
          (markedGateListCells_allOrdinary
            done symbol inMarked)
    · simp only [List.mem_cons] at inTail
      rcases inTail with rfl | rfl | inRest
      · decide
      · decide
      · exact restNoBlank symbol inRest
  have forwardNoBlank :
      ∀ symbol,
        symbol ∈ pushCleanupScan scan right →
          symbol ≠ cellBlank := by
    intro symbol member
    have split :=
      (pushCleanupScan_mem_iff
        scan right symbol).mp member
    rcases split with inScan | inRight
    · unfold scan at inScan
      simp only [List.mem_cons] at inScan
      rcases inScan with rfl | rfl | inCrossed
      · decide
      · decide
      · apply ordinaryCell_not_blank
        have inParsed :
            symbol ∈ parsedPrefix := by
          rw [grammarPushCrossed_eq_reverse_append]
            at inCrossed
          simpa using inCrossed
        unfold parsedPrefix at inParsed
        rcases List.mem_append.mp inParsed with
            inLeading | inUnits
        · rcases List.mem_append.mp inLeading with
              inVersion | inInputs
          · simp only [List.mem_cons,
              List.not_mem_nil] at inVersion
            rcases inVersion with
                rfl | rfl | impossible
            · exact ordinaryCell_cell00
            · exact ordinaryCell_cell00
            · contradiction
          · exact natCells_allOrdinary
              inputs symbol inInputs
        · exact unaryUnitCells_allOrdinary
            done.length symbol inUnits
    · exact rightNoBlank symbol inRight
  have cleanup :=
    guardedCleanupFinite_exact
      [] scan right scanNoGuard forwardNoBlank
  let final :=
    cleanupRejectConfiguration [] scan right []
  have linear :
      ((((2 + 1) + logicalPrefix.length) + 1) +
          forwardSteps) +
          guardedCleanupSteps scan right ≤
        32 *
          ((logicalPrefix.length +
            (cell10 :: cell00 :: rest).length + 2) + 1) := by
    rw [guardedCleanupSteps_eq]
    unfold logicalPrefix forwardSteps scan right
    unfold suffix parsedPrefix grammarGatePrefix
    simp only [List.length_append, List.length_cons,
      List.length_nil, natCells_length,
      unaryUnitCells_length, countCells_length,
      markedGateListCells_length,
      pushCrossed_length]
    omega
  have positive :
      1 ≤
        (logicalPrefix.length +
          (cell10 :: cell00 :: rest).length + 2) + 1 := by
    omega
  have squareBase :
      (logicalPrefix.length +
            (cell10 :: cell00 :: rest).length + 2) + 1 ≤
        failureSpanSquare
          (logicalPrefix.length +
            (cell10 :: cell00 :: rest).length + 2) := by
    simpa [failureSpanSquare] using
      Nat.mul_le_mul_left
        ((logicalPrefix.length +
          (cell10 :: cell00 :: rest).length + 2) + 1)
        positive
  have scheduleBound :
      ((((2 + 1) + logicalPrefix.length) + 1) +
          forwardSteps) +
          guardedCleanupSteps scan right ≤
        64 *
          failureSpanSquare
            (logicalPrefix.length +
              (cell10 :: cell00 :: rest).length + 2) := by
    exact Nat.le_trans linear
      (Nat.le_trans
        (by
          exact Nat.mul_le_mul_right
            ((logicalPrefix.length +
              (cell10 :: cell00 :: rest).length + 2) + 1)
            (by omega))
        (Nat.mul_le_mul_left 64 squareBase))
  refine
    ⟨((((2 + 1) + logicalPrefix.length) + 1) +
        forwardSteps) +
        guardedCleanupSteps scan right,
      final, ?_, ?_, rfl, ?_⟩
  · simpa [logicalPrefix] using scheduleBound
  · have all :=
      exactRun_add
        ((((2 + 1) + logicalPrefix.length) + 1) +
          forwardSteps)
        (guardedCleanupSteps scan right)
        _ _ _ throughFailure cleanup
    simpa [logicalPrefix, final,
      scan, right, suffix,
      parsedPrefix] using all
  · exact cleanupRejectConfiguration_output_empty
      [] scan right

/-! ### Bounded token-grammar gate failures -/

private def grammarTokenFailureSpan
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (tokens : List Token) : Nat :=
  (grammarGatePrefix inputs done remaining).length +
    (packedTokenCells tokens).length + 2

private theorem grammarSourceTokenSpan_eq
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (tokens : List Token) :
    sourceTokenFailureSpan
        inputs (done.length + 1) remaining
        done [] tokens =
      grammarTokenFailureSpan
        inputs done (remaining + 1) tokens := by
  unfold sourceTokenFailureSpan
  unfold grammarTokenFailureSpan
  unfold sourceContextPrefix gateReferenceHeader
  unfold grammarGatePrefix
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    natCells_length]
  omega

private theorem grammarGateSourceLaunchSteps_bound
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (tokens : List Token) :
    grammarGateSourceLaunchSteps
        inputs done remaining ≤
      8 *
        failureSpanSquare
          (grammarTokenFailureSpan
            inputs done (remaining + 1) tokens) := by
  let span :=
    grammarTokenFailureSpan
      inputs done (remaining + 1) tokens
  have prefixLe :
      (grammarGatePrefix
          inputs done (remaining + 1)).length ≤
        span := by
    unfold span grammarTokenFailureSpan
    omega
  have positive : 1 ≤ span + 1 := by
    omega
  have squareBase :
      span + 1 ≤ failureSpanSquare span := by
    simpa [failureSpanSquare] using
      Nat.mul_le_mul_left (span + 1) positive
  have linear :
      grammarGateSourceLaunchSteps
          inputs done remaining ≤
        8 * (span + 1) := by
    unfold grammarGateSourceLaunchSteps
    omega
  exact Nat.le_trans linear
    (Nat.mul_le_mul_left 8 squareBase)

private theorem grammarGateLeftTokenFailure_bounded_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) {tokens : List Token}
    (failure : SourceTokenFailure tokens) :
    ∃ steps final,
      steps ≤
          64 *
            failureSpanSquare
              (grammarTokenFailureSpan
                inputs done (remaining + 1) tokens) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done (remaining + 1))
            (packedTokenCells tokens)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let logicalPrefix :=
    grammarGatePrefix
      inputs done (remaining + 1)
  have consume
      (firstWas01 : Bool)
      (current : WorkSymbol) (rest : List WorkSymbol)
      (packed :
        packedTokenCells tokens =
          firstSourceCell firstWas01 ::
            current :: rest) :
      ∃ steps final,
        steps ≤
            64 *
              failureSpanSquare
                (grammarTokenFailureSpan
                  inputs done (remaining + 1) tokens) ∧
        workRunExact? machine steps
            (guardedConfig State.gateStart
              logicalPrefix
              (packedTokenCells tokens)) =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have launch :=
      grammarGateDecrement_exact
        firstWas01 inputs done remaining
        current rest
    rcases
        sourceTokenFailure_afterFirst_exact
          .gateLeft inputs (done.length + 1)
          remaining done [] failure
          (by intro symbol member; contradiction)
          (by intro symbol member; contradiction)
          firstWas01 (current :: rest) packed with
      ⟨tailSteps, final, tailBound, tail,
        finalState, output⟩
    have all :=
      exactRun_add
        (grammarGateSourceLaunchSteps
          inputs done remaining)
        tailSteps _ _ _ launch tail
    have launchBound :=
      grammarGateSourceLaunchSteps_bound
        inputs done remaining tokens
    have spanEq :=
      grammarSourceTokenSpan_eq
        inputs done remaining tokens
    rw [spanEq] at tailBound
    have one :=
      one_le_failureSpanSquare
        (grammarTokenFailureSpan
          inputs done (remaining + 1) tokens)
    refine
      ⟨grammarGateSourceLaunchSteps
            inputs done remaining +
          tailSteps,
        final, ?_, ?_, finalState, output⟩
    · omega
    · rw [packed]
      simpa [logicalPrefix] using all
  cases failure with
  | missing =>
      rcases
          grammarGateStartMissing_exact
            inputs done (remaining + 1) with
        ⟨steps, final, bound, run,
          finalState, output⟩
      refine
        ⟨steps, final, ?_, ?_, finalState, output⟩
      · have one :=
          one_le_failureSpanSquare
            (grammarTokenFailureSpan
              inputs done (remaining + 1) [])
        simpa [grammarTokenFailureSpan,
          packedTokenCells] using
            Nat.le_trans bound (by omega)
      · simpa [logicalPrefix,
          packedTokenCells] using run
  | wrongHead token suffix
      notInput notFalse notTrue notGate =>
      cases token with
      | version0 =>
          apply consume false cell00
            (packedTokenCells suffix)
          simp [packedTokenCells, tokenCells,
            firstSourceCell]
      | unit =>
          apply consume false cell01
            (packedTokenCells suffix)
          simp [packedTokenCells, tokenCells,
            firstSourceCell]
      | natEnd =>
          apply consume false cell10
            (packedTokenCells suffix)
          simp [packedTokenCells, tokenCells,
            firstSourceCell]
      | input =>
          exact False.elim (notInput rfl)
      | constantFalse =>
          exact False.elim (notFalse rfl)
      | constantTrue =>
          exact False.elim (notTrue rfl)
      | gate =>
          exact False.elim (notGate rfl)
      | gateEnd =>
          apply consume true cell11
            (packedTokenCells suffix)
          simp [packedTokenCells, tokenCells,
            firstSourceCell]
      | programEnd =>
          rcases
              grammarProgramPremature_exact
                inputs done remaining
                (packedTokenCells suffix)
                (by
                  intro symbol member
                  exact ordinaryCell_not_blank
                    (packedTokenCells_ordinary
                      suffix symbol member)) with
            ⟨steps, final, bound, run,
              finalState, output⟩
          refine
            ⟨steps, final, ?_, ?_,
              finalState, output⟩
          · simpa [grammarTokenFailureSpan,
              packedTokenCells, tokenCells,
              List.length_append,
              Nat.add_assoc] using bound
          · simpa [logicalPrefix,
              packedTokenCells, tokenCells] using run
      | outputsEnd =>
          rcases
              grammarGateStartProgramMismatch_exact
                inputs done (remaining + 1) cell01
                (packedTokenCells suffix)
                (by decide)
                (by
                  intro symbol member
                  simp only [List.mem_cons] at member
                  rcases member with rfl | inRest
                  · exact ordinaryCell_cell01
                  · exact packedTokenCells_ordinary
                      suffix symbol inRest) with
            ⟨steps, final, bound, run,
              finalState, output⟩
          refine
            ⟨steps, final, ?_, ?_,
              finalState, output⟩
          · have boundCanonical :
                steps ≤
                  16 *
                    failureSpanSquare
                      (grammarTokenFailureSpan
                        inputs done (remaining + 1)
                        (.outputsEnd :: suffix)) := by
              simpa [grammarTokenFailureSpan,
                packedTokenCells, tokenCells,
                List.length_append,
                Nat.add_assoc] using bound
            exact Nat.le_trans boundCanonical (by omega)
          · simpa [logicalPrefix,
              packedTokenCells, tokenCells] using run
      | threshold =>
          rcases
              grammarGateStartProgramMismatch_exact
                inputs done (remaining + 1) cell10
                (packedTokenCells suffix)
                (by decide)
                (by
                  intro symbol member
                  simp only [List.mem_cons] at member
                  rcases member with rfl | inRest
                  · exact ordinaryCell_cell10
                  · exact packedTokenCells_ordinary
                      suffix symbol inRest) with
            ⟨steps, final, bound, run,
              finalState, output⟩
          refine
            ⟨steps, final, ?_, ?_,
              finalState, output⟩
          · have boundCanonical :
                steps ≤
                  16 *
                    failureSpanSquare
                      (grammarTokenFailureSpan
                        inputs done (remaining + 1)
                        (.threshold :: suffix)) := by
              simpa [grammarTokenFailureSpan,
                packedTokenCells, tokenCells,
                List.length_append,
                Nat.add_assoc] using bound
            exact Nat.le_trans boundCanonical (by omega)
          · simpa [logicalPrefix,
              packedTokenCells, tokenCells] using run
      | instanceEnd =>
          rcases
              grammarGateStartProgramMismatch_exact
                inputs done (remaining + 1) cell11
                (packedTokenCells suffix)
                (by decide)
                (by
                  intro symbol member
                  simp only [List.mem_cons] at member
                  rcases member with rfl | inRest
                  · exact ordinaryCell_cell11
                  · exact packedTokenCells_ordinary
                      suffix symbol inRest) with
            ⟨steps, final, bound, run,
              finalState, output⟩
          refine
            ⟨steps, final, ?_, ?_,
              finalState, output⟩
          · have boundCanonical :
                steps ≤
                  16 *
                    failureSpanSquare
                      (grammarTokenFailureSpan
                        inputs done (remaining + 1)
                        (.instanceEnd :: suffix)) := by
              simpa [grammarTokenFailureSpan,
                packedTokenCells, tokenCells,
                List.length_append,
                Nat.add_assoc] using bound
            exact Nat.le_trans boundCanonical (by omega)
          · simpa [logicalPrefix,
              packedTokenCells, tokenCells] using run
  | inputIndex natFailure =>
      cases natFailure with
      | missingEnd units =>
          apply consume false cell11
            (unaryUnitCells units)
          simp [packedTokenCells, tokenCells,
            packedTokenCells_replicate_unit,
            firstSourceCell]
      | wrongToken units token suffix
          notUnit notNatEnd =>
          apply consume false cell11
            (malformedNatTailCells
              units token suffix)
          rw [packedTokenCells]
          rw [packedTokenCells_append,
            packedTokenCells_replicate_unit]
          simp [malformedNatTailCells,
            packedTokenCells, tokenCells,
            firstSourceCell]
  | gateIndex natFailure =>
      cases natFailure with
      | missingEnd units =>
          apply consume true cell10
            (unaryUnitCells units)
          simp [packedTokenCells, tokenCells,
            packedTokenCells_replicate_unit,
            firstSourceCell]
      | wrongToken units token suffix
          notUnit notNatEnd =>
          apply consume true cell10
            (malformedNatTailCells
              units token suffix)
          rw [packedTokenCells]
          rw [packedTokenCells_append,
            packedTokenCells_replicate_unit]
          simp [malformedNatTailCells,
            packedTokenCells, tokenCells,
            firstSourceCell]

private def grammarWorkFailureSpan
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (word : List WorkSymbol) : Nat :=
  (grammarGatePrefix inputs done remaining).length +
    word.length + 2

private theorem grammarTokenFailureSpan_eq_work
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (tokens : List Token) :
    grammarTokenFailureSpan
        inputs done remaining tokens =
      grammarWorkFailureSpan
        inputs done remaining
        (packedTokenCells tokens) := by
  rfl

private theorem grammarSourceCells_eq_full
    (source : RawSource) :
    sourceCells source =
      firstSourceCell (sourceFirstWas01 source) ::
        sourceSecondCell source ::
          sourceAfterSecondCells source := by
  cases source with
  | input index =>
      rfl
  | constant value =>
      cases value <;> rfl
  | gate index =>
      rfl

private theorem grammarSourceRemainderCells_eq_full
    (source : RawSource) :
    sourceRemainderCells source =
      sourceSecondCell source ::
        sourceAfterSecondCells source := by
  cases source with
  | input index =>
      rfl
  | constant value =>
      cases value <;> rfl
  | gate index =>
      rfl

private theorem grammarGateSourceLaunchSteps_work_bound
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (word : List WorkSymbol) :
    grammarGateSourceLaunchSteps
        inputs done remaining ≤
      8 *
        failureSpanSquare
          (grammarWorkFailureSpan
            inputs done (remaining + 1) word) := by
  let span :=
    grammarWorkFailureSpan
      inputs done (remaining + 1) word
  have prefixLe :
      (grammarGatePrefix
          inputs done (remaining + 1)).length ≤
        span := by
    unfold span grammarWorkFailureSpan
    omega
  have positive : 1 ≤ span + 1 := by
    omega
  have squareBase :
      span + 1 ≤ failureSpanSquare span := by
    simpa [failureSpanSquare] using
      Nat.mul_le_mul_left (span + 1) positive
  have linear :
      grammarGateSourceLaunchSteps
          inputs done remaining ≤
        8 * (span + 1) := by
    unfold grammarGateSourceLaunchSteps
    omega
  exact Nat.le_trans linear
    (Nat.mul_le_mul_left 8 squareBase)

private theorem grammarLeftSourceSpan_le
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (source : RawSource)
    (suffix : List WorkSymbol) :
    sourceSpan inputs (done.length + 1)
        remaining done [] source ≤
      grammarWorkFailureSpan
        inputs done (remaining + 1)
        (sourceCells source ++ suffix) := by
  unfold sourceSpan sourceContextPrefix
  unfold grammarWorkFailureSpan grammarGatePrefix
  unfold gateReferenceHeader
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    natCells_length]
  omega

private theorem grammarLeftSourceFailureSpan_le
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (source : RawSource)
    (suffix : List WorkSymbol) :
    sourceFailureSpan inputs (done.length + 1)
        remaining done [] source suffix ≤
      grammarWorkFailureSpan
        inputs done (remaining + 1)
        (sourceCells source ++ suffix) := by
  unfold sourceFailureSpan sourceSpan
  unfold sourceContextPrefix gateReferenceHeader
  unfold grammarWorkFailureSpan grammarGatePrefix
  simp only [List.length_append, List.length_cons,
    List.length_nil, countCells_length,
    natCells_length]
  omega

private theorem grammarGateLeftValid_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (source : RawSource)
    (suffix : List WorkSymbol)
    (wellFormed :
      source.wellFormed inputs done.length = true) :
    ∃ steps,
      steps ≤
          32 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1)
                (sourceCells source ++ suffix)) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done (remaining + 1))
            (sourceCells source ++ suffix)) =
        some
          (guardedConfig
            (State.sourceStart .gateRight)
            (sourceContextPrefix
              inputs (done.length + 1)
              remaining done
              (sourceCells source))
            suffix) := by
  let word := sourceCells source ++ suffix
  have launch :=
    grammarGateDecrement_exact
      (sourceFirstWas01 source)
      inputs done remaining
      (sourceSecondCell source)
      (sourceAfterSecondCells source ++ suffix)
  have launchCanonical :
      workRunExact? machine
          (grammarGateSourceLaunchSteps
            inputs done remaining)
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done (remaining + 1))
            word) =
        some
          (guardedConfig
            (afterFirstSourceState
              (sourceFirstWas01 source) .gateLeft)
            (sourceContextPrefix
                inputs (done.length + 1)
                remaining done [] ++
              [firstSourceCell
                (sourceFirstWas01 source)])
            (sourceRemainderCells source ++ suffix)) := by
    simpa [word, grammarSourceCells_eq_full,
      grammarSourceRemainderCells_eq_full,
      List.append_assoc]
      using launch
  have sourceRun :=
    sourceRemainder_exact
      .gateLeft inputs (done.length + 1)
      remaining done [] source suffix
      (by intro symbol member; contradiction)
      (by intro symbol member; contradiction)
      wellFormed
  have all :=
    exactRun_add
      (grammarGateSourceLaunchSteps
        inputs done remaining)
      (sourceRemainderSteps
        inputs (done.length + 1)
        remaining done [] source)
      _ _ _ launchCanonical sourceRun
  have launchBound :=
    grammarGateSourceLaunchSteps_work_bound
      inputs done remaining word
  have sourceBound :=
    sourceRemainderSteps_bound
      inputs (done.length + 1)
      remaining done [] source
  have spanLe :=
    grammarLeftSourceSpan_le
      inputs done remaining source suffix
  have squareLe :=
    failureSpanSquare_mono spanLe
  have sourceBoundCanonical :
      sourceRemainderSteps
            inputs (done.length + 1)
            remaining done [] source ≤
        1 +
          8 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1) word) := by
    exact Nat.le_trans sourceBound
      (Nat.add_le_add_left
        (Nat.mul_le_mul_left 8 squareLe) 1)
  have one :=
    one_le_failureSpanSquare
      (grammarWorkFailureSpan
        inputs done (remaining + 1) word)
  refine
    ⟨grammarGateSourceLaunchSteps
          inputs done remaining +
        sourceRemainderSteps
          inputs (done.length + 1)
          remaining done [] source,
      ?_, ?_⟩
  · dsimp [word] at launchBound sourceBoundCanonical one ⊢
    omega
  · simpa [word, sourceDoneState,
      sourceContextPrefix,
      List.append_assoc] using all

private theorem grammarGateLeftBoundFailure_bounded_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (source : RawSource)
    (suffix : List WorkSymbol)
    (failure :
      SourceBoundFailure inputs done.length source)
    (suffixOrdinary :
      ∀ symbol, symbol ∈ suffix →
        ordinaryCell symbol) :
    ∃ steps final,
      steps ≤
          32 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1)
                (sourceCells source ++ suffix)) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done (remaining + 1))
            (sourceCells source ++ suffix)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let word := sourceCells source ++ suffix
  have launch :=
    grammarGateDecrement_exact
      (sourceFirstWas01 source)
      inputs done remaining
      (sourceSecondCell source)
      (sourceAfterSecondCells source ++ suffix)
  have launchCanonical :
      workRunExact? machine
          (grammarGateSourceLaunchSteps
            inputs done remaining)
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done (remaining + 1))
            word) =
        some
          (guardedConfig
            (afterFirstSourceState
              (sourceFirstWas01 source) .gateLeft)
            (sourceContextPrefix
                inputs (done.length + 1)
                remaining done [] ++
              [firstSourceCell
                (sourceFirstWas01 source)])
            (sourceRemainderCells source ++ suffix)) := by
    simpa [word, grammarSourceCells_eq_full,
      grammarSourceRemainderCells_eq_full,
      List.append_assoc]
      using launch
  rcases
      sourceBoundFailureRemainder_bounded_exact
        .gateLeft inputs (done.length + 1)
        remaining done [] source suffix
        failure
        (by intro symbol member; contradiction)
        (by intro symbol member; contradiction)
        suffixOrdinary with
    ⟨tailSteps, final, tailBound, tail,
      finalState, output⟩
  have all :=
    exactRun_add
      (grammarGateSourceLaunchSteps
        inputs done remaining)
      tailSteps _ _ _ launchCanonical tail
  have launchBound :=
    grammarGateSourceLaunchSteps_work_bound
      inputs done remaining word
  have spanLe :=
    grammarLeftSourceFailureSpan_le
      inputs done remaining source suffix
  have squareLe :=
    failureSpanSquare_mono spanLe
  have tailBoundCanonical :
      tailSteps ≤
        1 +
          16 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1) word) := by
    exact Nat.le_trans tailBound
      (Nat.add_le_add_left
        (Nat.mul_le_mul_left 16 squareLe) 1)
  have one :=
    one_le_failureSpanSquare
      (grammarWorkFailureSpan
        inputs done (remaining + 1) word)
  refine
    ⟨grammarGateSourceLaunchSteps
          inputs done remaining +
        tailSteps,
      final, ?_, ?_, finalState, output⟩
  · dsimp [word] at launchBound tailBoundCanonical one ⊢
    omega
  · simpa [word] using all

private theorem grammarNatCells_no_countMark
    (value : Nat) :
    ∀ symbol, symbol ∈ natCells value →
      symbol ≠ countMark := by
  induction value with
  | zero =>
      intro symbol member
      simp only [natCells, List.mem_cons,
        List.not_mem_nil] at member
      rcases member with rfl | rfl | impossible
      · decide
      · decide
      · contradiction
  | succ value ih =>
      intro symbol member
      simp only [natCells, List.mem_cons] at member
      rcases member with rfl | rfl | inRest
      · decide
      · decide
      · exact ih symbol inRest

private theorem grammarSourceCells_no_countMark
    (source : RawSource) :
    ∀ symbol, symbol ∈ sourceCells source →
      symbol ≠ countMark := by
  cases source with
  | input index =>
      intro symbol member
      simp only [sourceCells, List.mem_cons] at member
      rcases member with rfl | rfl | inIndex
      · decide
      · decide
      · exact grammarNatCells_no_countMark
          index symbol inIndex
  | constant value =>
      cases value <;>
        intro symbol member <;>
        simp only [sourceCells, List.mem_cons,
          List.not_mem_nil] at member <;>
        rcases member with rfl | rfl | impossible
      · decide
      · decide
      · contradiction
      · decide
      · decide
      · contradiction
  | gate index =>
      intro symbol member
      simp only [sourceCells, List.mem_cons] at member
      rcases member with rfl | rfl | inIndex
      · decide
      · decide
      · exact grammarNatCells_no_countMark
          index symbol inIndex

