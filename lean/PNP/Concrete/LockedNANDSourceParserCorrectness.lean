        steps ≤ rawFailureEnvelope word ∧
        workRunExact? machine steps initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have prefixRun' := prefixRun
    rw [cellsEq] at prefixRun'
    have failed :=
      secondFailure current suffixCells
        notUnitCell notEndCell
    have launch :=
      exactRun_add prefixSteps 2
        _ _ _ prefixRun' failed
    have shape :
        word =
          (parsedCells ++ [cell00]) ++
            current :: suffixCells := by
      have shaped := wordShape
      rw [cellsEq] at shaped
      simpa [suffixCells,
        List.append_assoc] using shaped
    exact
      wordExplicitFailure_raw_bounded_exact
        word (parsedCells ++ [cell00])
        current suffixCells initial
        (prefixSteps + 2) shape
        wordOrdinary launch prefixLinear
  cases token with
  | version0 =>
      exact rejectSecond cell00 rfl
        (by decide) (by decide)
  | unit =>
      exact False.elim (notUnit rfl)
  | natEnd =>
      exact False.elim (notNatEnd rfl)
  | input =>
