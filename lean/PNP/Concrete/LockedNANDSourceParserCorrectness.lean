    (((2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates) +
        programEndSteps inputs gates) +
      sourceSteps inputs 0 gates.length gates
        [cell10, cell00] output =
        programSteps + outputSteps := rfl
    _ ≤
        160 * failureSpanCube span +
          10 * failureSpanCube span := combined
    _ = 170 * failureSpanCube span := by omega
    _ ≤ 192 * failureSpanCube span :=
      Nat.mul_le_mul_right
        (failureSpanCube span)
        (show 170 ≤ 192 by omega)
    _ = 192 *
        failureSpanCube
          (circuitTokenFailureSpan allTokens) := rfl

private theorem circuitInvalidOutput_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource) (tokens : List Token)
    (outputInvalid :
      output.wellFormed inputs gates.length = false) :
    let allTokens :=
      circuitOutputPrefixTokens inputs gates output ++ tokens
    ∃ steps final,
      steps ≤ circuitFailureEnvelope allTokens ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells allTokens))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let allTokens :=
    circuitOutputPrefixTokens inputs gates output ++ tokens
  cases gatesEq :
      rawGatesWellFormed inputs 0 gates with
  | false =>
      simpa [allTokens, circuitOutputPrefixTokens,
        List.append_assoc] using
        (circuitInvalidGates_bounded_exact
          inputs gates
          (.programEnd ::
            (encodeSourceTokens output ++ tokens))
          gatesEq)
  | true =>
      let prefixSteps :=
        ((2 * inputs + 2 * gates.length + 8) +
            gatesSteps inputs [] gates) +
          programEndSteps inputs gates
      have prefixRun :
          workRunExact? machine prefixSteps
              (workStartConfiguration machine
                (WorkTape.ofSymbols
                  (packedTokenCells allTokens))) =
            some
              (guardedConfig
                (State.sourceStart .output)
                (sourceContextPrefix
                  inputs 0 gates.length gates
                  [cell10, cell00])
                (sourceCells output ++
                  packedTokenCells tokens)) := by
        simpa [allTokens, prefixSteps,
          circuitOutputPrefixTokens,
          packedTokenCells_append,
          packedTokenCells_encodeSourceTokens,
          List.append_assoc] using
          (circuitProgramPrefix_exact
            inputs gates
            (encodeSourceTokens output ++ tokens)
            gatesEq)
      have prefixBound :
          prefixSteps ≤
            160 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) := by
        simpa [allTokens, prefixSteps,
          circuitOutputPrefixTokens,
          List.append_assoc] using
          (circuitProgramPrefixSteps_bound
            inputs gates
            (encodeSourceTokens output ++ tokens))
      have failure :=
        (source_wellFormed_false_iff_failure
          inputs gates.length output).mp outputInvalid
      rcases
          sourceBoundFailure_bounded_exact
            .output inputs 0 gates.length gates
            [cell10, cell00] output
            (packedTokenCells tokens)
            failure
            (by
              intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | rfl | impossible
              · exact ordinaryCell_cell10
              · exact ordinaryCell_cell00
              · contradiction)
            (by
              intro symbol member
              simp only [List.mem_cons,
                List.not_mem_nil] at member
              rcases member with rfl | rfl | impossible
              · decide
              · decide
              · contradiction)
            (packedTokenCells_allOrdinary tokens) with
        ⟨tailSteps, final, tailBound,
          tailRun, finalState, outputEmpty⟩
      have all :=
        exactRun_add prefixSteps tailSteps
          _ _ _ prefixRun tailRun
      have cellsEq :=
        packedCircuitGatesPrefixTokens_append
          inputs gates
          (.programEnd ::
            (encodeSourceTokens output ++ tokens))
      have cellsEqCanonical :
          packedTokenCells allTokens =
            [cell00, cell00] ++ natCells inputs ++
              natCells gates.length ++ gateListCells gates ++
              cell10 :: cell00 :: sourceCells output ++
              packedTokenCells tokens := by
        dsimp [allTokens]
        unfold circuitOutputPrefixTokens
        simpa [packedTokenCells, tokenCells,
          packedTokenCells_append,
          packedTokenCells_encodeSourceTokens,
          List.append_assoc] using cellsEq
      have failureSpanBound :
          sourceFailureSpan inputs 0 gates.length
              gates [cell10, cell00] output
              (packedTokenCells tokens) ≤
            circuitTokenFailureSpan allTokens := by
        unfold sourceFailureSpan sourceSpan
          sourceContextPrefix gateReferenceHeader
          circuitTokenFailureSpan
        rw [cellsEqCanonical]
        simp only [List.length_append,
          List.length_cons, List.length_nil,
          countCells_length, natCells_length,
          markedGateListCells_length]
        omega
      have squareBound :=
        failureSpanSquare_mono failureSpanBound
      have squareCube :=
        failureSpanSquare_le_cube
          (circuitTokenFailureSpan allTokens)
      have tailCube :
          tailSteps ≤
            18 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) := by
        have canonical :
            tailSteps ≤
              2 +
                16 *
                  failureSpanSquare
                    (sourceFailureSpan
                      inputs 0 gates.length gates
                      [cell10, cell00] output
                      (packedTokenCells tokens)) := by
          simpa [failureSpanSquare] using tailBound
        have lifted :=
          Nat.le_trans squareBound squareCube
        have scaled :=
          Nat.mul_le_mul_left 16 lifted
        have oneCube :
            1 ≤
              failureSpanCube
                (circuitTokenFailureSpan allTokens) :=
          Nat.le_trans
            (one_le_failureSpanSquare
              (circuitTokenFailureSpan allTokens))
            squareCube
        omega
      have combined :=
        Nat.add_le_add prefixBound tailCube
      have scheduleBound :
          prefixSteps + tailSteps ≤
            circuitFailureEnvelope allTokens := by
        calc
          prefixSteps + tailSteps ≤
              160 *
                  failureSpanCube
                    (circuitTokenFailureSpan allTokens) +
                18 *
                  failureSpanCube
                    (circuitTokenFailureSpan allTokens) :=
            combined
          _ = 178 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) := by
            omega
          _ ≤ 1024 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) :=
            Nat.mul_le_mul_right
              (failureSpanCube
                (circuitTokenFailureSpan allTokens))
              (show 178 ≤ 1024 by omega)
          _ = circuitFailureEnvelope allTokens := rfl
      exact
        ⟨prefixSteps + tailSteps, final,
          scheduleBound, all, finalState, outputEmpty⟩

