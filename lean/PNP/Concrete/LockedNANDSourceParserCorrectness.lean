  change
    rawRejectOutcome
      (packedTokenCells
          (encodeCircuitTokens
            { inputCount := inputs
              gates := gates
              output := output }) ++
        workTail)
  have tokensEq :
      encodeCircuitTokens
          { inputCount := inputs
            gates := gates
            output := output } =
        circuitGatesPrefixTokens inputs gates ++
          (.programEnd ::
            (encodeSourceTokens output ++
              [.outputsEnd, .instanceEnd])) := by
    simp [encodeCircuitTokens,
      circuitGatesPrefixTokens,
      circuitHeaderTokens,
      List.append_assoc]
  have wordEq :
      packedTokenCells
            (encodeCircuitTokens
              { inputCount := inputs
                gates := gates
                output := output }) ++
          workTail =
        packedTokenCells
            (circuitGatesPrefixTokens inputs gates ++
              (.programEnd ::
                (encodeSourceTokens output ++
                  [.outputsEnd, .instanceEnd]))) ++
          workTail :=
    congrArg
      (fun current =>
        packedTokenCells current ++ workTail)
      tokensEq
  apply rawRejectOutcome_transport wordEq
  rcases
      circuitInvalidGatesWithFramingTail_bounded_exact
      inputs gates
      (.programEnd ::
        (encodeSourceTokens output ++
          [.outputsEnd, .instanceEnd]))
      gatesInvalid malformed with
    ⟨steps, final, bound, run,
