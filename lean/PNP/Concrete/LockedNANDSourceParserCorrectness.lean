private theorem grammarGateRightValid_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat)
    (left right : RawSource)
    (suffix : List WorkSymbol)
    (wellFormed :
      right.wellFormed inputs done.length = true) :
    ∃ steps,
      steps ≤
          16 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1)
                (sourceCells left ++
                  sourceCells right ++ suffix)) ∧
      workRunExact? machine steps
          (guardedConfig
            (State.sourceStart .gateRight)
            (sourceContextPrefix
              inputs (done.length + 1)
              remaining done (sourceCells left))
            (sourceCells right ++ suffix)) =
        some
          (guardedConfig State.gateEndFirst
            (sourceContextPrefix
              inputs (done.length + 1)
              remaining done
              (sourceCells left ++
                sourceCells right))
            suffix) := by
  have run :=
    source_exact
      .gateRight inputs (done.length + 1)
      remaining done (sourceCells left)
      right suffix
      (sourceCells_allOrdinary left)
      (grammarSourceCells_no_countMark left)
      wellFormed
  have scheduleBound :=
    sourceSteps_bound
      inputs (done.length + 1)
      remaining done (sourceCells left) right
  have spanLe :=
    grammarRightSourceSpan_le
      inputs done remaining left right suffix
  have squareLe :=
    failureSpanSquare_mono spanLe
  have canonicalBound :
      sourceSteps inputs (done.length + 1)
            remaining done (sourceCells left) right ≤
        2 +
          8 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done (remaining + 1)
                (sourceCells left ++
                  sourceCells right ++ suffix)) := by
    exact Nat.le_trans scheduleBound
      (Nat.add_le_add_left
        (Nat.mul_le_mul_left 8 squareLe) 2)
  have one :=
    one_le_failureSpanSquare
      (grammarWorkFailureSpan
        inputs done (remaining + 1)
        (sourceCells left ++
          sourceCells right ++ suffix))
  refine
    ⟨sourceSteps inputs (done.length + 1)
        remaining done (sourceCells left) right,
      ?_, ?_⟩
  · omega
  · simpa [sourceDoneState, sourceContextPrefix,
      List.append_assoc] using run

private theorem grammarGateRightBoundFailure_bounded_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat)
    (left right : RawSource)
    (suffix : List WorkSymbol)
