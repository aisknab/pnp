private theorem grammarGateStartProgramMismatch_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat)
    (current : WorkSymbol) (rest : List WorkSymbol)
    (notExpected : current ≠ cell00)
    (wordOrdinary :
      ∀ symbol, symbol ∈ current :: rest →
        ordinaryCell symbol) :
    ∃ steps final,
      steps ≤
          16 *
            failureSpanSquare
              ((grammarGatePrefix
                  inputs done remaining).length +
                (cell10 :: current :: rest).length + 2) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done remaining)
            (cell10 :: current :: rest)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let logicalPrefix :=
    grammarGatePrefix
      inputs done remaining
  let parsedPrefix :=
    logicalPrefix ++ [cursorMark]
  let scan :=
    current :: pushCrossed parsedPrefix []
  let initial :=
    guardedConfig State.gateStart logicalPrefix
      (cell10 :: current :: rest)
  let final :=
    cleanupRejectConfiguration [] scan rest []
  have launchRaw :=
    grammarProgramSecondFailure_exact
      logicalPrefix current rest notExpected
  have launch :
      workRunExact? machine 2 initial =
        some
          (cleanupSeekConfiguration
            [] scan rest) := by
    simpa [initial, scan, parsedPrefix,
      pushCrossed_append, pushCrossed] using launchRaw
  have safe :
      ∀ symbol,
        symbol ∈ parsedPrefix ++ current :: rest →
          cleanupSafeCell symbol := by
    intro symbol member
    rcases List.mem_append.mp member with
        inPrefix | inWord
    · rcases List.mem_append.mp inPrefix with
          inLogical | atCursor
      · exact ordinaryCell_cleanupSafe
          (grammarGatePrefix_allOrdinary
            inputs done remaining
            symbol inLogical)
      · simp only [List.mem_cons,
          List.not_mem_nil] at atCursor
        rcases atCursor with rfl | impossible
        · exact cursorMark_cleanupSafe
        · contradiction
    · exact ordinaryCell_cleanupSafe
        (wordOrdinary symbol inWord)
  have cleanupRaw :=
    safeGuardedCleanup_exact
      parsedPrefix current rest safe
  have cleanupInitialEq :
      guardedConfig State.cleanupSeekGuard
          parsedPrefix (current :: rest) =
        cleanupSeekConfiguration [] scan rest := by
    rw [guardedConfig_eq_crossed]
    simp [scan, cleanupSeekConfiguration,
      configAtWord, tapeAtWord]
  have cleanup :
      workRunExact? machine
          (guardedCleanupSteps scan rest)
          (cleanupSeekConfiguration [] scan rest) =
        some final := by
    rw [← cleanupInitialEq]
    simpa [scan, parsedPrefix, final] using cleanupRaw
  have run :=
    exactRun_add 2
      (guardedCleanupSteps scan rest)
      _ _ _ launch cleanup
  have linear :
      2 + guardedCleanupSteps scan rest ≤
        4 *
          ((logicalPrefix.length +
            (cell10 :: current :: rest).length + 2) + 1) := by
    rw [guardedCleanupSteps_eq]
    simp only [scan, parsedPrefix,
      List.length_append, List.length_cons,
      List.length_nil, pushCrossed_length]
    omega
  have scheduleBound :=
    linear_failure_le_square
      (2 + guardedCleanupSteps scan rest)
      (logicalPrefix.length +
        (cell10 :: current :: rest).length + 2)
      linear
  refine
    ⟨2 + guardedCleanupSteps scan rest,
      final, ?_, ?_, rfl, ?_⟩
  · simpa [logicalPrefix] using scheduleBound
  · simpa [final, scan] using run
  · exact cleanupRejectConfiguration_output_empty
      [] scan rest

