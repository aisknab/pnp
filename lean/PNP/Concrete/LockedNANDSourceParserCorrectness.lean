        (packedTokenCells
          (circuitGatesPrefixTokens inputs gates ++ token :: suffix)))) =
      some final ∧
    final.state = State.reject ∧
    (encodeWorkTape final.tape).outputBits = [] := by
  cases gatesEq : rawGatesWellFormed inputs 0 gates with
  | false =>
      simpa using
        (circuitInvalidGates_bounded_exact
          inputs gates (token :: suffix) gatesEq)
  | true =>
      let allTokens :=
        circuitGatesPrefixTokens inputs gates ++ token :: suffix
      let prefixSteps :=
        (2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates
      let inner :=
        (grammarGatePrefix inputs gates 0).length +
          (packedTokenCells (token :: suffix)).length + 2
      have prefixRun :
          workRunExact? machine prefixSteps
            (workStartConfiguration machine
              (WorkTape.ofSymbols (packedTokenCells allTokens))) =
          some (guardedConfig State.gateStart
            (grammarGatePrefix inputs gates 0)
            (packedTokenCells (token :: suffix))) := by
        simpa [allTokens, prefixSteps, gatePrefix,
          grammarGatePrefix] using
          (circuitValidGates_exact
            inputs gates (token :: suffix) gatesEq)
      have prefixBound :
          prefixSteps ≤ 128 * failureSpanCube
            (circuitTokenFailureSpan allTokens) := by
        simpa [allTokens, prefixSteps] using
          (circuitValidGatesSteps_bound
            inputs gates (token :: suffix))
      have cellsEq :=
        packedCircuitGatesPrefixTokens_append
          inputs gates (token :: suffix)
      have innerBound :
          inner ≤ circuitTokenFailureSpan allTokens + 2 := by
        unfold inner circuitTokenFailureSpan
        dsimp [allTokens]
        rw [cellsEq]
        unfold grammarGatePrefix
        simp only [List.length_append, List.length_cons,
          List.length_nil, natCells_length, countCells_length,
          markedGateListCells_length]
        omega
      have finish
          (tailSteps : Nat) (final : WorkConfiguration)
          (tailBound :
            tailSteps ≤ 64 * failureSpanSquare inner)
          (tailRun :
            workRunExact? machine tailSteps
              (guardedConfig State.gateStart
                (grammarGatePrefix inputs gates 0)
                (packedTokenCells (token :: suffix))) =
              some final)
          (finalState : final.state = State.reject)
          (output : (encodeWorkTape final.tape).outputBits = []) :
          ∃ steps final,
            steps ≤ circuitFailureEnvelope allTokens ∧
            workRunExact? machine steps
              (workStartConfiguration machine
                (WorkTape.ofSymbols (packedTokenCells allTokens))) =
              some final ∧ final.state = State.reject ∧
            (encodeWorkTape final.tape).outputBits = [] := by
        have squareBound := shiftedSquare_le_nineCube
          inner (circuitTokenFailureSpan allTokens) innerBound
        have tailCube :
            tailSteps ≤ 576 * failureSpanCube
              (circuitTokenFailureSpan allTokens) := by
          calc
            tailSteps ≤ 64 * failureSpanSquare inner := tailBound
            _ ≤ 64 * (9 * failureSpanCube
                (circuitTokenFailureSpan allTokens)) :=
              Nat.mul_le_mul_left 64 squareBound
            _ = 576 * failureSpanCube
                (circuitTokenFailureSpan allTokens) := by omega
        have combined := Nat.add_le_add prefixBound tailCube
        have schedule :
            prefixSteps + tailSteps ≤
              circuitFailureEnvelope allTokens := by
          calc
            prefixSteps + tailSteps ≤
                128 * failureSpanCube
                    (circuitTokenFailureSpan allTokens) +
                  576 * failureSpanCube
                    (circuitTokenFailureSpan allTokens) :=
              combined
            _ = 704 * failureSpanCube
                (circuitTokenFailureSpan allTokens) := by omega
            _ ≤ 1024 * failureSpanCube
                (circuitTokenFailureSpan allTokens) :=
              Nat.mul_le_mul_right
                (failureSpanCube
                  (circuitTokenFailureSpan allTokens))
                (show 704 ≤ 1024 by omega)
            _ = circuitFailureEnvelope allTokens := rfl
        exact
          ⟨prefixSteps + tailSteps, final, schedule,
            exactRun_add prefixSteps tailSteps _ _ _
              prefixRun tailRun,
            finalState, output⟩
      have wordOrdinary (current : WorkSymbol)
          (currentOrdinary : ordinaryCell current) :
          ∀ symbol,
            symbol ∈ current :: packedTokenCells suffix →
              ordinaryCell symbol := by
        intro symbol member
        simp only [List.mem_cons] at member
        rcases member with rfl | inRest
        · exact currentOrdinary
        · exact packedTokenCells_allOrdinary
            suffix symbol inRest
      have exhaust (firstWas01 : Bool)
          (current : WorkSymbol)
          (currentOrdinary : ordinaryCell current)
          (shape : tokenCells token =
            [firstSourceCell firstWas01, current]) :
          ∃ steps final,
            steps ≤ circuitFailureEnvelope allTokens ∧
            workRunExact? machine steps
              (workStartConfiguration machine
                (WorkTape.ofSymbols (packedTokenCells allTokens))) =
              some final ∧ final.state = State.reject ∧
            (encodeWorkTape final.tape).outputBits = [] := by
        rcases grammarGateExhausted_exact firstWas01 inputs gates
            current (packedTokenCells suffix)
            (fun symbol member => ordinaryCell_not_leftGuard
              (wordOrdinary current currentOrdinary symbol member))
            (fun symbol member => ordinaryCell_not_blank
              (wordOrdinary current currentOrdinary symbol member)) with
          ⟨tailSteps, final, tailBound, tailRun,
            finalState, output⟩
        apply finish tailSteps final
        · simpa [inner, packedTokenCells, shape] using tailBound
        · simpa [packedTokenCells, shape] using tailRun
        · exact finalState
        · exact output
      have mismatch (current : WorkSymbol)
          (currentOrdinary : ordinaryCell current)
          (shape : tokenCells token = [cell10, current])
          (notExpected : current ≠ cell00) :
          ∃ steps final,
            steps ≤ circuitFailureEnvelope allTokens ∧
            workRunExact? machine steps
              (workStartConfiguration machine
                (WorkTape.ofSymbols (packedTokenCells allTokens))) =
              some final ∧ final.state = State.reject ∧
            (encodeWorkTape final.tape).outputBits = [] := by
        rcases grammarGateStartProgramMismatch_exact
            inputs gates 0 current (packedTokenCells suffix)
            notExpected
            (wordOrdinary current currentOrdinary) with
          ⟨tailSteps, final, tailBound16, tailRun,
            finalState, output⟩
        have tailBound64 :
            tailSteps ≤ 64 * failureSpanSquare inner := by
          have canonical :
              tailSteps ≤ 16 * failureSpanSquare inner := by
            simpa [inner, packedTokenCells, shape] using tailBound16
          omega
        apply finish tailSteps final tailBound64
        · simpa [packedTokenCells, shape] using tailRun
        · exact finalState
        · exact output
      cases token with
      | version0 =>
          exact exhaust false cell00 ordinaryCell_cell00 rfl
      | unit =>
          exact exhaust false cell01 ordinaryCell_cell01 rfl
      | natEnd =>
          exact exhaust false cell10 ordinaryCell_cell10 rfl
      | input =>
          exact exhaust false cell11 ordinaryCell_cell11 rfl
      | constantFalse =>
          exact exhaust true cell00 ordinaryCell_cell00 rfl
      | constantTrue =>
          exact exhaust true cell01 ordinaryCell_cell01 rfl
      | gate =>
          exact exhaust true cell10 ordinaryCell_cell10 rfl
      | gateEnd =>
          exact exhaust true cell11 ordinaryCell_cell11 rfl
      | programEnd =>
          exact False.elim (notProgramEnd rfl)
      | outputsEnd =>
          exact mismatch cell01 ordinaryCell_cell01 rfl (by decide)
      | threshold =>
          exact mismatch cell10 ordinaryCell_cell10 rfl (by decide)
      | instanceEnd =>
          exact mismatch cell11 ordinaryCell_cell11 rfl (by decide)

