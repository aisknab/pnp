private theorem grammarSingleGateBound
    (count span steps : Nat)
    (bound :
      steps ≤ 64 * failureSpanSquare span) :
    steps ≤
      (count + 1) *
        (128 * failureSpanSquare span) := by
  have widened :
      steps ≤ 128 * failureSpanSquare span := by
    exact Nat.le_trans bound (by omega)
  have factor : 1 ≤ count + 1 := by
    omega
  have scaled :=
    Nat.mul_le_mul_left
      (128 * failureSpanSquare span) factor
  exact Nat.le_trans widened (by
    simpa [Nat.mul_comm] using scaled)

private theorem grammarRecursiveGateBound
    (count span headSteps tailSteps : Nat)
    (headBound :
      headSteps ≤ 64 * failureSpanSquare span)
    (tailBound :
      tailSteps ≤
        count * (128 * failureSpanSquare span)) :
    headSteps + tailSteps ≤
      (count + 1) *
        (128 * failureSpanSquare span) := by
  have headWide :
      headSteps ≤
        128 * failureSpanSquare span := by
    exact Nat.le_trans headBound (by omega)
  calc
    headSteps + tailSteps ≤
        128 * failureSpanSquare span +
          count * (128 * failureSpanSquare span) :=
      Nat.add_le_add headWide tailBound
    _ = (count + 1) *
          (128 * failureSpanSquare span) := by
      rw [Nat.add_mul]
      simp [Nat.add_comm]

private theorem grammarNGatesRightFailure_bounded_exact
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) (left : RawSource)
    {tokens : List Token}
    (failure : SourceTokenFailure tokens) :
    ∃ steps final,
      steps ≤
          (remaining + 1) *
            (128 *
              failureSpanSquare
                (grammarTokenFailureSpan
                  inputs done (remaining + 1)
                  (encodeSourceTokens left ++ tokens))) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done (remaining + 1))
            (packedTokenCells
              (encodeSourceTokens left ++ tokens))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases leftEq :
      left.wellFormed inputs done.length with
  | false =>
      have sourceFailure :=
        (source_wellFormed_false_iff_failure
          inputs done.length left).mp leftEq
      rcases
          grammarGateLeftBoundFailure_bounded_exact
            inputs done remaining left
            (packedTokenCells tokens)
            sourceFailure
            (packedTokenCells_ordinary tokens) with
        ⟨steps, final, bound, run,
          finalState, output⟩
      have boundCanonical :
