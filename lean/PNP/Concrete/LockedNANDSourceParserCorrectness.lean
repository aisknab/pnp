private theorem grammarGateSourceEOF_bounded_exact
    (firstWas01 : Bool)
    (inputs : Nat) (done : List RawGate)
    (remaining : Nat) :
    ∃ steps final,
      steps ≤
          128 *
            failureSpanSquare
              (grammarWorkFailureSpan
                inputs done remaining
                [firstSourceCell firstWas01]) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix
              inputs done remaining)
            [firstSourceCell firstWas01]) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases remaining with
  | zero =>
      rcases
          grammarGateExhaustedWord_exact
            firstWas01 inputs done []
            (by
              intro symbol member
              contradiction)
            (by
              intro symbol member
              contradiction) with
        ⟨steps, final, bound, run,
          finalState, outputEmpty⟩
      refine
        ⟨steps, final, ?_, ?_,
          finalState, outputEmpty⟩
      · have boundCanonical :
            steps ≤
              64 *
                failureSpanSquare
                  (grammarWorkFailureSpan
                    inputs done 0
                    [firstSourceCell firstWas01]) := by
          simpa [grammarWorkFailureSpan,
            List.length_cons, List.length_nil] using bound
        exact Nat.le_trans boundCanonical (by omega)
      · simpa using run
  | succ remaining =>
      let parsedPrefix :=
        sourceContextPrefix
            inputs (done.length + 1)
            remaining done [] ++
          [firstSourceCell firstWas01]
      let outerSpan :=
        grammarWorkFailureSpan
          inputs done (remaining + 1)
          [firstSourceCell firstWas01]
      let launchSteps :=
        grammarGateSourceLaunchSteps
          inputs done remaining
      have launch :=
        grammarGateDecrementWord_exact
          firstWas01 inputs done remaining []
      rcases
          grammarAfterFirstEOF_bounded_exact
            firstWas01 inputs done remaining with
        ⟨tailSteps, final, tailBound, tail,
          finalState, outputEmpty⟩
      have tailCanonical :
          workRunExact? machine tailSteps
              (guardedConfig
                (afterFirstSourceState
                  firstWas01 .gateLeft)
                parsedPrefix []) =
            some final := by
        simpa [parsedPrefix] using tail
      have tailBoundCanonical :
          tailSteps ≤
            16 *
              failureSpanSquare
                (parsedPrefix.length + 2) := by
        simpa [parsedPrefix] using tailBound
      have tailSpanLe :
          parsedPrefix.length + 2 ≤ outerSpan := by
        dsimp [parsedPrefix, outerSpan]
        unfold grammarWorkFailureSpan
          grammarGatePrefix sourceContextPrefix
          gateReferenceHeader
        simp only [List.length_append,
          List.length_cons, List.length_nil,
          natCells_length, countCells_length,
          markedGateListCells_length]
        omega
      have tailSquareLe :=
        failureSpanSquare_mono tailSpanLe
      have tailBound' :=
        Nat.le_trans tailBoundCanonical
          (Nat.mul_le_mul_left 16 tailSquareLe)
      have launchBound :
          launchSteps ≤
            8 * failureSpanSquare outerSpan := by
        simpa [launchSteps, outerSpan] using
          (grammarGateSourceLaunchSteps_work_bound
            inputs done remaining
            [firstSourceCell firstWas01])
      have one :=
        one_le_failureSpanSquare outerSpan
      have all :=
        exactRun_add launchSteps tailSteps
          _ _ _ (by
            simpa [launchSteps] using launch)
          tailCanonical
      refine
        ⟨launchSteps + tailSteps, final,
          ?_, ?_, finalState, outputEmpty⟩
      · have combined :=
          Nat.add_le_add launchBound tailBound'
        have scheduleBound :
            launchSteps + tailSteps ≤
              128 *
                failureSpanSquare outerSpan :=
          Nat.le_trans combined (by omega)
        simpa [outerSpan] using scheduleBound
      · simpa [launchSteps, parsedPrefix] using all

