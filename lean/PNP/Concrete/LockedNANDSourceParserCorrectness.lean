private theorem rawFailureEnvelope_packedInputWord_le_validWorkBound
    (bits : BitString) :
    rawFailureEnvelope (packedInputWord bits) ≤
      validWorkBound bits.length := by
  have lengthBound :
      (packedInputWord bits).length ≤ bits.length := by
    rw [packedInputWord_eq_packedRawBits]
    exact packedRawBits_length_le bits
  have cubeBound :=
    failureSpanCube_mono_work lengthBound
  have scaled :=
    Nat.mul_le_mul_left 2048 cubeBound
  have coefficient :
      2048 * failureSpanCube bits.length ≤
        4096 * failureSpanCube bits.length :=
    Nat.mul_le_mul_right
      (failureSpanCube bits.length)
      (show 2048 ≤ 4096 by omega)
  calc
    rawFailureEnvelope (packedInputWord bits) =
        2048 *
          failureSpanCube
            (packedInputWord bits).length := rfl
    _ ≤
        2048 * failureSpanCube bits.length :=
      scaled
    _ ≤
        4096 * failureSpanCube bits.length :=
      coefficient
    _ = validWorkBound bits.length := by
      unfold failureSpanCube failureSpanSquare
        validWorkBound
      ac_rfl

