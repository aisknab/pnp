private theorem wordMissingEndAfterPrefix_bounded_exact
    (word : List WorkSymbol)
    (state : Nat) (prefixCells : List WorkSymbol)
    (initial : WorkConfiguration) (prefixSteps : Nat)
    (wordEq : word = prefixCells)
    (ordinary :
      ∀ symbol, symbol ∈ word →
        ordinaryCell symbol)
    (prefixRun :
      workRunExact? machine prefixSteps initial =
        some
          (configAtWord state
            (pushCrossed prefixCells [] ++
              [leftGuard]) []))
    (failure :
      workRunExact? machine 1
          (configAtWord state
            (pushCrossed prefixCells [] ++
              [leftGuard]) []) =
        some
          (cleanupSeekConfiguration
            [] (missingEndScan
              (pushCrossed prefixCells [])) [])) :
    ∃ steps final,
      steps ≤ prefixSteps + 4 * (word.length + 1) ∧
      workRunExact? machine steps initial =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let crossed := pushCrossed prefixCells []
  have prefixOrdinary :
      ∀ symbol, symbol ∈ prefixCells →
        ordinaryCell symbol := by
    intro symbol member
    apply ordinary symbol
    rwa [wordEq]
  have tail :=
    missingEndTail_exact state prefixCells crossed
      rfl
      (by
        intro symbol member
        exact ordinaryCell_not_leftGuard
          (prefixOrdinary symbol member))
      (by
        intro symbol member
        exact ordinaryCell_not_blank
          (prefixOrdinary symbol member))
      (by simpa [crossed] using failure)
  let final :=
    cleanupExplicitRejectConfiguration
      [] (missingEndEraseWord crossed) []
  have tailBound :
      missingEndTailSteps crossed ≤
        4 * (word.length + 1) := by
    have canonical :
        missingEndTailSteps crossed ≤
          4 * (prefixCells.length + 1) := by
      unfold missingEndTailSteps
      rw [guardedCleanupExplicitSteps_eq]
      unfold missingEndScan missingEndEraseWord
      simp only [crossed, List.length_cons,
        List.length_nil, pushCrossed_length,
        pushCleanupScan_length]
      omega
    rw [wordEq]
    exact canonical
  refine
    ⟨prefixSteps + missingEndTailSteps crossed,
      final, ?_, ?_, rfl, ?_⟩
  · omega
  · exact exactRun_add prefixSteps
      (missingEndTailSteps crossed)
      _ _ _ prefixRun (by
        simpa [final] using tail)
  · rfl

