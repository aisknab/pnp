private theorem inputWrongReferenceSteps_linear_bound
    (used remaining units : Nat)
    (between : List WorkSymbol)
    (token : Token) (suffix : List Token) :
    inputWrongReferenceSteps
        used remaining between units token suffix ≤
      16 * (units + 1) *
        (inputFailureFootprint
          used remaining between units
            (packedTokenCells suffix) + 1) := by
  induction units generalizing used remaining between with
  | zero =>
      have base :=
        inputWrongReferenceFinish_bound
          used remaining between token suffix
      simpa using base
  | succ units ih =>
      cases remaining with
      | zero =>
          have base :=
            inputWrongReferenceExhausted_bound
              used units between token suffix
          have factor :
              16 *
                    (inputFailureFootprint
                      used 0 between (units + 1)
                        (packedTokenCells suffix) + 1) ≤
                16 * ((units + 1) + 1) *
                    (inputFailureFootprint
                      used 0 between (units + 1)
                        (packedTokenCells suffix) + 1) := by
            have oneLe : 1 ≤ (units + 1) + 1 := by
              omega
            have scaled :=
              Nat.mul_le_mul_right
                (inputFailureFootprint
                  used 0 between (units + 1)
                    (packedTokenCells suffix) + 1)
                oneLe
            have outer :=
              Nat.mul_le_mul_left 16 scaled
            simpa [Nat.mul_assoc] using outer
          exact (by
            simpa using Nat.le_trans base factor)
      | succ remaining =>
          have atom :=
            inputBoundFailureConsume_bound
              used remaining units between
              (packedTokenCells suffix)
          have atomWide :
              inputReferenceConsumeUnitSteps
                  used remaining between ≤
                16 *
                  (inputFailureFootprint
                    used (remaining + 1) between
                    (units + 1)
                    (packedTokenCells suffix) + 1) := by
            omega
          have tail :=
            ih (used + 1) remaining
              (between ++ [cell00, cell01])
          rw [inputFailureFootprint_step
            used remaining units between
            (packedTokenCells suffix)] at tail
          have combined :=
            Nat.add_le_add atomWide tail
          have costEq :
              16 *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (units + 1)
                      (packedTokenCells suffix) + 1) +
                  16 * (units + 1) *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (units + 1)
                      (packedTokenCells suffix) + 1) =
                16 * ((units + 1) + 1) *
                  (inputFailureFootprint
                    used (remaining + 1) between
                    (units + 1)
                    (packedTokenCells suffix) + 1) := by
            calc
              _ =
                  (16 + 16 * (units + 1)) *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (units + 1)
                      (packedTokenCells suffix) + 1) := by
                rw [Nat.add_mul]
              _ = _ := by
                apply congrArg (fun coefficient =>
                  coefficient *
                    (inputFailureFootprint
                      used (remaining + 1) between
                      (units + 1)
                      (packedTokenCells suffix) + 1))
                rw [Nat.mul_add, Nat.mul_one]
                exact Nat.add_comm _ _
          rw [costEq] at combined
          change
            inputReferenceConsumeUnitSteps
                  used remaining between +
                inputWrongReferenceSteps
                  (used + 1) remaining
                  (between ++ [cell00, cell01])
                  units token suffix ≤
              16 * ((units + 1) + 1) *
                (inputFailureFootprint
                  used (remaining + 1) between
                  (units + 1)
                  (packedTokenCells suffix) + 1)
          exact combined

