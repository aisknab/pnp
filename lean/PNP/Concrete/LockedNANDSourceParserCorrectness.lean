  let afterOutputs :=
    parsedPrefix ++ [cell10, cell01]
  let delimiterPrefix :=
    afterOutputs ++ [cell10, cell11]
  let word :=
    packedTokenCells tokens ++ workTail
  let initial :=
    workStartConfiguration machine
      (WorkTape.ofSymbols word)
  let outputSteps :=
    circuitOutputPrefixSteps inputs gates output
  let prefixSteps := outputSteps + 4
  have wordShape :
      word =
        packedTokenCells prefixTokens ++
          cell10 :: cell01 ::
            cell10 :: cell11 :: workTail := by
    dsimp [word, tokens]
    rw [packedTokenCells_append]
    simp [packedTokenCells, tokenCells,
      List.append_assoc]
  have outputRun :
      workRunExact? machine outputSteps initial =
        some
          (guardedConfig State.outputsEndFirst
            parsedPrefix
            (cell10 :: cell01 ::
              cell10 :: cell11 :: workTail)) := by
    dsimp [outputSteps, initial]
    rw [wordShape]
    simpa [prefixTokens, parsedPrefix] using
      (circuitOutputPackedPrefixWord_exact
        inputs gates output
        (cell10 :: cell01 ::
          cell10 :: cell11 :: workTail)
        gatesValid outputValid)
  have outputsRun :=
    outputsEnd_exact parsedPrefix
      (cell10 :: cell11 :: workTail)
  have instanceRun :=
    instanceEnd_exact afterOutputs workTail
  have delimitersRun :
      workRunExact? machine 4
          (guardedConfig State.outputsEndFirst
            parsedPrefix
            (cell10 :: cell01 ::
              cell10 :: cell11 :: workTail)) =
        some
          (guardedConfig State.finalEOF
            delimiterPrefix workTail) := by
    have combined :=
      exactRun_add 2 2
        _ _ _ outputsRun instanceRun
    simpa [afterOutputs, delimiterPrefix] using combined
  have prefixRun :
      workRunExact? machine prefixSteps initial =
        some
          (guardedConfig State.finalEOF
            delimiterPrefix workTail) := by
    have combined :=
      exactRun_add outputSteps 4
        _ _ _ outputRun delimitersRun
    simpa [prefixSteps] using combined
  have outputBound :
      outputSteps ≤
        192 * failureSpanCube word.length := by
    have raw :=
      circuitOutputPackedPrefixWordSteps_bound
        inputs gates output
        (cell10 :: cell01 ::
          cell10 :: cell11 :: workTail)
    rw [wordShape]
    simpa [outputSteps] using raw
  have oneCube :
      1 ≤ failureSpanCube word.length := by
    exact Nat.le_trans
      (one_le_failureSpanSquare word.length)
      (failureSpanSquare_le_cube word.length)
  have delimiterBound :
      4 ≤
        4 * failureSpanCube word.length := by
    simpa using
      Nat.mul_le_mul_left 4 oneCube
  have prefixCubic :
      prefixSteps ≤
        196 * failureSpanCube word.length := by
    have combined :=
      Nat.add_le_add outputBound delimiterBound
    calc
      prefixSteps =
          outputSteps + 4 := rfl
      _ ≤
          192 * failureSpanCube word.length +
            4 * failureSpanCube word.length :=
        combined
      _ =
          196 * failureSpanCube word.length := by
        rw [show 196 = 192 + 4 by omega,
          Nat.add_mul]
  have prefixLength :
      (packedTokenCells prefixTokens).length =
        parsedPrefix.length := by
    dsimp [prefixTokens, parsedPrefix]
    exact
      packedCircuitOutputPrefixTokens_length_eq_parsed
        inputs gates output
  have wholeLength :
      word.length =
        (delimiterPrefix ++ workTail).length := by
    rw [wordShape]
    dsimp [delimiterPrefix, afterOutputs]
    simp only [List.length_append,
      List.length_cons, List.length_nil]
    omega
  have launch :=
    simpleMalformedBoundary_launch
      .finalEOF delimiterPrefix malformed
  apply
    cubicPrefixBoundaryCleanup_bounded_exact
      word delimiterPrefix workTail
      State.finalEOF initial
      prefixSteps 196 wholeLength
  · apply ordinaryCells_append
    · apply ordinaryCells_append
      · exact circuitOutputParsedPrefix_allOrdinary
          inputs gates output
      · intro symbol member
        simp only [List.mem_cons,
          List.not_mem_nil] at member
        rcases member with rfl | rfl | impossible
        · exact ordinaryCell_cell10
        · exact ordinaryCell_cell01
        · contradiction
    · intro symbol member
      simp only [List.mem_cons,
        List.not_mem_nil] at member
      rcases member with rfl | rfl | impossible
      · exact ordinaryCell_cell10
      · exact ordinaryCell_cell11
      · contradiction
  · exact malformed.allSourcePacked
  · exact malformed.nonempty
  · exact prefixRun
  · exact prefixCubic
  · omega
  · exact launch

private theorem trailingTokenWithFramingTail_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource)
    (token : Token) (suffix : List Token)
    (gatesValid :
      rawGatesWellFormed inputs 0 gates = true)
    (outputValid :
      output.wellFormed inputs gates.length = true)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    let tokens :=
      circuitOutputPrefixTokens inputs gates output ++
        [.outputsEnd, .instanceEnd, token] ++ suffix
    let word :=
      packedTokenCells tokens ++ workTail
    ∃ steps final,
      steps ≤ rawFailureEnvelope word ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols word)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let prefixTokens :=
    circuitOutputPrefixTokens inputs gates output
  let delimiterTokens :=
    prefixTokens ++ [.outputsEnd, .instanceEnd]
  let tokens := delimiterTokens ++ token :: suffix
  let parsedPrefix :=
    circuitOutputParsedPrefix inputs gates output
  let afterOutputs :=
    parsedPrefix ++ [cell10, cell01]
  let afterDelimiters :=
    afterOutputs ++ [cell10, cell11]
  let suffixCells :=
    packedTokenCells suffix ++ workTail
  let boundaryTail :=
    tokenCells token ++ suffixCells
  let word :=
    packedTokenCells tokens ++ workTail
  let initial :=
    workStartConfiguration machine
      (WorkTape.ofSymbols word)
  let prefixSteps :=
    circuitOutputPrefixSteps inputs gates output + 4
  have wordShape :
      word =
        packedTokenCells delimiterTokens ++
          boundaryTail := by
    dsimp [word, tokens, boundaryTail,
      suffixCells]
    rw [packedTokenCells_append]
    simp [packedTokenCells, List.append_assoc]
  have prefixRun :
      workRunExact? machine prefixSteps initial =
        some
          (guardedConfig State.finalEOF
            afterDelimiters boundaryTail) := by
    dsimp [prefixSteps, initial]
    rw [wordShape]
    simpa [delimiterTokens, prefixTokens,
      afterDelimiters, afterOutputs,
      parsedPrefix] using
      (circuitOutputThroughInstanceEndWord_exact
        inputs gates output boundaryTail
        gatesValid outputValid)
  have prefixCubic :
      prefixSteps ≤
        196 * failureSpanCube word.length := by
    have raw :=
      circuitOutputThroughInstanceEndWordSteps_bound
        inputs gates output boundaryTail
    rw [wordShape]
    simpa [prefixSteps, delimiterTokens,
      prefixTokens] using raw
  have baseLength :
      (packedTokenCells prefixTokens).length =
        parsedPrefix.length := by
    dsimp [prefixTokens, parsedPrefix]
    exact
      packedCircuitOutputPrefixTokens_length_eq_parsed
        inputs gates output
  have prefixLength :
      (packedTokenCells delimiterTokens).length =
        afterDelimiters.length := by
    dsimp [delimiterTokens, afterDelimiters,
      afterOutputs]
    rw [packedTokenCells_append]
    simp only [packedTokenCells, tokenCells,
      List.length_append, List.length_cons,
      List.length_nil]
    omega
  have wholeLength :
      word.length =
        (afterDelimiters ++ boundaryTail).length := by
    rw [wordShape]
    simp only [List.length_append]
    rw [prefixLength]
  have boundarySourcePacked :
      ∀ symbol, symbol ∈ boundaryTail →
        SourcePackedCell symbol := by
    intro symbol member
    apply
      tokenPrefixMalformedTail_allSourcePacked
        (token :: suffix) malformed symbol
    simpa [boundaryTail, suffixCells,
      packedTokenCells, List.append_assoc] using member
  have launch :=
    finalEOFTokenWork_launch
      afterDelimiters token suffixCells
  have prefixOrdinary :
      ∀ symbol, symbol ∈ afterDelimiters →
        ordinaryCell symbol := by
    apply ordinaryCells_append
    · apply ordinaryCells_append
      · exact circuitOutputParsedPrefix_allOrdinary
          inputs gates output
      · intro symbol member
        simp only [List.mem_cons,
          List.not_mem_nil] at member
        rcases member with rfl | rfl | impossible
        · exact ordinaryCell_cell10
        · exact ordinaryCell_cell01
        · contradiction
    · intro symbol member
      simp only [List.mem_cons,
        List.not_mem_nil] at member
      rcases member with rfl | rfl | impossible
      · exact ordinaryCell_cell10
      · exact ordinaryCell_cell11
      · contradiction
  have boundaryNonempty :
      boundaryTail ≠ [] := by
    intro empty
    have lengthEq := congrArg List.length empty
    dsimp [boundaryTail] at lengthEq
    simp only [List.length_append,
      tokenCells_length] at lengthEq
    omega
  have result :=
    cubicPrefixBoundaryCleanup_bounded_exact
      word afterDelimiters boundaryTail
      State.finalEOF initial
      prefixSteps 196 wholeLength
      prefixOrdinary boundarySourcePacked
      boundaryNonempty prefixRun prefixCubic
      (by omega) launch
  simpa [word, initial, tokens, delimiterTokens,
    prefixTokens, List.append_assoc] using result

