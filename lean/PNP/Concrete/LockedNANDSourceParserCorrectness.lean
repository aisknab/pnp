private theorem finalEOFTokenWork_launch
    (parsedPrefix : List WorkSymbol)
    (token : Token) (after : List WorkSymbol) :
    BoundaryCleanupLaunch State.finalEOF
      parsedPrefix (tokenCells token ++ after) := by
  have reject
      (current next : WorkSymbol)
      (cellsEq : tokenCells token = [current, next])
      (currentOrdinary : ordinaryCell current) :
      BoundaryCleanupLaunch State.finalEOF
        parsedPrefix (tokenCells token ++ after) := by
    rw [cellsEq]
    apply boundaryCleanupLaunch_immediate
    simpa using
      finalEOFFailure_exact
        parsedPrefix current (next :: after)
        (ordinaryCell_not_blank currentOrdinary)
  cases token with
  | version0 =>
      exact reject cell00 cell00 rfl
        ordinaryCell_cell00
  | unit =>
      exact reject cell00 cell01 rfl
        ordinaryCell_cell00
  | natEnd =>
      exact reject cell00 cell10 rfl
        ordinaryCell_cell00
  | input =>
      exact reject cell00 cell11 rfl
        ordinaryCell_cell00
  | constantFalse =>
      exact reject cell01 cell00 rfl
        ordinaryCell_cell01
  | constantTrue =>
      exact reject cell01 cell01 rfl
        ordinaryCell_cell01
  | gate =>
      exact reject cell01 cell10 rfl
        ordinaryCell_cell01
  | gateEnd =>
      exact reject cell01 cell11 rfl
        ordinaryCell_cell01
  | programEnd =>
      exact reject cell10 cell00 rfl
        ordinaryCell_cell10
  | outputsEnd =>
      exact reject cell10 cell01 rfl
        ordinaryCell_cell10
  | threshold =>
      exact reject cell10 cell10 rfl
        ordinaryCell_cell10
  | instanceEnd =>
      exact reject cell10 cell11 rfl
        ordinaryCell_cell10

private theorem circuitOutputThroughOutputsEndWord_exact
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource) (after : List WorkSymbol)
