private theorem circuitPostOutputFinish
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource) (tokens : List Token)
    (gatesValid :
      rawGatesWellFormed inputs 0 gates = true)
    (outputValid :
      output.wellFormed inputs gates.length = true)
    (tailSteps : Nat) (final : WorkConfiguration)
    (tailBound :
      tailSteps ≤
        64 *
          failureSpanSquare
            (postOutputSpan
              inputs gates output tokens))
    (tailRun :
      workRunExact? machine tailSteps
          (guardedConfig State.outputsEndFirst
            (circuitOutputParsedPrefix
              inputs gates output)
            (packedTokenCells tokens)) =
        some final)
    (finalState : final.state = State.reject)
    (outputEmpty :
      (encodeWorkTape final.tape).outputBits = []) :
    let allTokens :=
      circuitOutputPrefixTokens inputs gates output ++ tokens
    ∃ steps final,
      steps ≤ circuitFailureEnvelope allTokens ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells allTokens))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let allTokens :=
    circuitOutputPrefixTokens
      inputs gates output ++ tokens
  let prefixSteps :=
    circuitOutputPrefixSteps inputs gates output
  have prefixRun :
      workRunExact? machine prefixSteps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells allTokens))) =
        some
          (guardedConfig State.outputsEndFirst
            (circuitOutputParsedPrefix
              inputs gates output)
            (packedTokenCells tokens)) := by
    simpa [allTokens, prefixSteps,
      circuitOutputPrefixSteps,
      circuitOutputParsedPrefix] using
      (circuitOutputPrefix_exact
        inputs gates output tokens
        gatesValid outputValid)
  have prefixBound :
      prefixSteps ≤
        192 *
          failureSpanCube
            (circuitTokenFailureSpan allTokens) := by
    simpa [allTokens, prefixSteps,
      circuitOutputPrefixSteps] using
      (circuitOutputPrefixSteps_bound
        inputs gates output tokens)
  have all :=
    exactRun_add prefixSteps tailSteps
      _ _ _ prefixRun tailRun
  have cellsEq :=
    packedCircuitOutputPrefixTokens_append
      inputs gates output tokens
  have innerBound :
      postOutputSpan inputs gates output tokens ≤
        circuitTokenFailureSpan allTokens + 2 := by
    unfold postOutputSpan
      circuitOutputParsedPrefix
      circuitTokenFailureSpan
    dsimp [allTokens]
    rw [cellsEq]
    unfold sourceContextPrefix gateReferenceHeader
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      countCells_length, natCells_length,
      markedGateListCells_length]
    omega
  have squareBound :=
    shiftedSquare_le_nineCube
      (postOutputSpan inputs gates output tokens)
      (circuitTokenFailureSpan allTokens)
      innerBound
  have tailCube :
      tailSteps ≤
        576 *
          failureSpanCube
            (circuitTokenFailureSpan allTokens) := by
    calc
      tailSteps ≤
          64 *
            failureSpanSquare
              (postOutputSpan
                inputs gates output tokens) :=
        tailBound
      _ ≤
          64 *
            (9 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens)) :=
        Nat.mul_le_mul_left 64 squareBound
      _ = 576 *
          failureSpanCube
            (circuitTokenFailureSpan allTokens) := by
        omega
  have combined :=
    Nat.add_le_add prefixBound tailCube
  have scheduleBound :
      prefixSteps + tailSteps ≤
        circuitFailureEnvelope allTokens := by
    calc
      prefixSteps + tailSteps ≤
          192 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) +
            576 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) :=
        combined
      _ = 768 *
          failureSpanCube
            (circuitTokenFailureSpan allTokens) := by
        omega
      _ ≤ 1024 *
          failureSpanCube
            (circuitTokenFailureSpan allTokens) :=
        Nat.mul_le_mul_right
          (failureSpanCube
            (circuitTokenFailureSpan allTokens))
          (show 768 ≤ 1024 by omega)
      _ = circuitFailureEnvelope allTokens := rfl
  exact
    ⟨prefixSteps + tailSteps, final,
      scheduleBound, all, finalState, outputEmpty⟩

