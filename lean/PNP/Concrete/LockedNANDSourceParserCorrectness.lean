                  encodeSourceTokens right ++
                  .gateEnd :: tokens))
          have headBound :
              (leftSteps + rightSteps) + 2 ≤
                64 *
                  failureSpanSquare
                    (grammarTokenFailureSpan
                      inputs done (remaining + 1)
                      (encodeSourceTokens left ++
                        encodeSourceTokens right ++
                        .gateEnd :: tokens)) := by
            omega
          refine
            ⟨((leftSteps + rightSteps) + 2) +
                tailSteps,
              final, ?_, ?_, finalState, output⟩
          · exact grammarRecursiveGateBound
              remaining _ _ _ headBound tailBound
          · simpa [gate, tailCells,
              packedTokenCells_append,
              packedTokenCells_encodeSourceTokens,
              packedTokenCells, tokenCells,
              List.append_assoc] using all

private theorem grammarNGatesTokenFailure_bounded_exact
    (inputs : Nat) (done : List RawGate)
    {count : Nat} {tokens : List Token}
    (failure : NGatesTokenFailure count tokens) :
    ∃ steps final,
      steps ≤
          count *
            (128 *
              failureSpanSquare
                (grammarTokenFailureSpan
                  inputs done count tokens)) ∧
      workRunExact? machine steps
          (guardedConfig State.gateStart
            (grammarGatePrefix inputs done count)
            (packedTokenCells tokens)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  induction failure generalizing done with
  | left failure =>
      rcases
          grammarGateLeftTokenFailure_bounded_exact
            inputs done _ failure with
        ⟨steps, final, bound, run,
          finalState, output⟩
      refine
        ⟨steps, final, ?_,
          run, finalState, output⟩
      apply grammarSingleGateBound
      exact bound
  | right count left failure =>
      exact grammarNGatesRightFailure_bounded_exact
        inputs done count left failure
  | missingGateEnd count left right =>
      exact grammarNGatesMissingGateEnd_bounded_exact
        inputs done count left right
  | wrongGateEnd count left right token suffix
      notGateEnd =>
      exact grammarNGatesWrongGateEnd_bounded_exact
        inputs done count left right token suffix
        notGateEnd
  | rest count left right failure ih =>
      have tail :=
        ih
          (done ++
            [{ left := left, right := right }])
      exact grammarNGatesRest_bounded_exact
        inputs done count left right tail

/-! ### Whole-circuit grammar failure envelopes -/

private def failureSpanCube (span : Nat) : Nat :=
  (span + 1) * failureSpanSquare span

private def circuitTokenFailureSpan
    (tokens : List Token) : Nat :=
  (packedTokenCells tokens).length

private def circuitFailureEnvelope
    (tokens : List Token) : Nat :=
  1024 * failureSpanCube
    (circuitTokenFailureSpan tokens)

private theorem linearSchedule_le_circuitFailureEnvelope
    (tokens : List Token) (steps : Nat)
    (linear :
      steps ≤
        8 * (circuitTokenFailureSpan tokens + 1)) :
    steps ≤ circuitFailureEnvelope tokens := by
  let span := circuitTokenFailureSpan tokens
  have squarePositive :
      1 ≤ failureSpanSquare span :=
    one_le_failureSpanSquare span
  have spanLeCube :
      span + 1 ≤ failureSpanCube span := by
    have product :=
      Nat.mul_le_mul_left (span + 1) squarePositive
    simpa [failureSpanCube] using product
  have scaled :=
    Nat.mul_le_mul_left 8 spanLeCube
  have coefficient :
      8 * failureSpanCube span ≤
        1024 * failureSpanCube span := by
    omega
  exact Nat.le_trans linear
    (Nat.le_trans (by
      simpa [span] using scaled) (by
        simpa [circuitFailureEnvelope, span] using coefficient))

private theorem packedExplicitFailure_bounded_exact
    (tokens : List Token)
    (parsedPrefix : List WorkSymbol) (current : WorkSymbol)
    (rest : List WorkSymbol)
    (initial : WorkConfiguration) (launchSteps : Nat)
    (shape :
      packedTokenCells tokens =
        parsedPrefix ++ current :: rest)
    (launch :
      workRunExact? machine launchSteps initial =
        some
          (cleanupSeekConfiguration
            [] (current :: pushCrossed parsedPrefix []) rest)) :
    ∃ steps final,
      steps ≤
          launchSteps +
            2 * (packedTokenCells tokens).length + 2 ∧
      workRunExact? machine steps initial = some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let scan := current :: pushCrossed parsedPrefix []
  have forwardEq :
      pushCleanupScan scan rest =
        packedTokenCells tokens := by
    dsimp [scan]
    rw [explicitFailureForward_eq, ← shape]
  have noGuard :
      ∀ symbol, symbol ∈ scan →
        symbol ≠ leftGuard := by
    intro symbol member
    apply packedTokenCells_no_leftGuard tokens symbol
    have forwardMember :
        symbol ∈ pushCleanupScan scan rest :=
      (pushCleanupScan_mem_iff scan rest symbol).mpr
        (Or.inl member)
    rwa [forwardEq] at forwardMember
  have nonblank :
      ∀ symbol,
        symbol ∈ pushCleanupScan scan rest →
          symbol ≠ cellBlank := by
    intro symbol member
    apply packedTokenCells_no_blank tokens symbol
    rwa [forwardEq] at member
  have cleanup :=
    guardedCleanupFinite_exact
      [] scan rest noGuard nonblank
  have shapeLength :=
    congrArg List.length shape
  have cleanupBound :
      guardedCleanupSteps scan rest ≤
        2 * (packedTokenCells tokens).length + 2 := by
    rw [guardedCleanupSteps_eq]
    dsimp [scan]
    simp only [List.length_cons, pushCrossed_length,
      List.length_nil, List.length_append] at shapeLength ⊢
    omega
  let steps :=
    launchSteps + guardedCleanupSteps scan rest
  let final :=
    cleanupRejectConfiguration [] scan rest []
  refine
    ⟨steps, final, ?_, ?_, rfl, ?_⟩
  · dsimp [steps]
    omega
  · exact exactRun_add launchSteps
      (guardedCleanupSteps scan rest)
      _ _ _ launch cleanup
  · exact cleanupRejectConfiguration_output_empty
      [] scan rest

private theorem missingEndAfterPrefix_bounded_exact
    (tokens : List Token)
    (state : Nat) (prefixCells : List WorkSymbol)
    (initial : WorkConfiguration) (prefixSteps : Nat)
    (cellsEq :
      packedTokenCells tokens = prefixCells)
    (prefixRun :
      workRunExact? machine prefixSteps initial =
        some
          (configAtWord state
            (pushCrossed prefixCells [] ++ [leftGuard]) []))
    (failure :
      workRunExact? machine 1
          (configAtWord state
            (pushCrossed prefixCells [] ++ [leftGuard]) []) =
        some
          (cleanupSeekConfiguration
            []
            (missingEndScan
              (pushCrossed prefixCells []))
            [])) :
    ∃ steps final,
      steps ≤
          prefixSteps +
            4 * ((packedTokenCells tokens).length + 1) ∧
      workRunExact? machine steps initial = some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let crossed := pushCrossed prefixCells []
  have noGuard :
      ∀ symbol, symbol ∈ prefixCells →
        symbol ≠ leftGuard := by
    intro symbol member
    exact packedTokenCells_no_leftGuard
      tokens symbol (by rw [cellsEq]; exact member)
  have nonblank :
      ∀ symbol, symbol ∈ prefixCells →
        symbol ≠ cellBlank := by
    intro symbol member
    exact packedTokenCells_no_blank
      tokens symbol (by rw [cellsEq]; exact member)
  have tail :=
    missingEndTail_exact state prefixCells crossed
      rfl noGuard nonblank (by
        simpa [crossed] using failure)
  have cellsLength :=
    congrArg List.length cellsEq
  have tailBound :
      missingEndTailSteps crossed ≤
        4 * ((packedTokenCells tokens).length + 1) := by
    unfold missingEndTailSteps
    rw [guardedCleanupExplicitSteps_eq]
    unfold missingEndScan missingEndEraseWord
    rw [pushCleanupScan_length]
    dsimp [crossed]
    simp only [pushCrossed_length,
      List.length_nil, Nat.add_zero] at cellsLength ⊢
    omega
  let steps := prefixSteps + missingEndTailSteps crossed
  let final :=
    cleanupExplicitRejectConfiguration
      [] (missingEndEraseWord crossed) []
  refine
    ⟨steps, final, ?_, ?_, rfl, ?_⟩
  · dsimp [steps]
    omega
  · exact exactRun_add prefixSteps
      (missingEndTailSteps crossed)
      _ _ _ prefixRun tail
  · rfl

private theorem natWrongToken_bounded_exact
    (allTokens : List Token)
    (state : Nat) (parsedCells : List WorkSymbol)
    (token : Token) (suffix : List Token)
    (initial : WorkConfiguration) (prefixSteps : Nat)
    (wordShape :
      packedTokenCells allTokens =
        parsedCells ++ tokenCells token ++
          packedTokenCells suffix)
    (prefixRun :
      workRunExact? machine prefixSteps initial =
        some
          (configAtWord state
            (pushCrossed parsedCells [] ++ [leftGuard])
            (tokenCells token ++
              packedTokenCells suffix)))
    (firstFailure :
      ∀ (current : WorkSymbol) (rest : List WorkSymbol),
        current ≠ cell00 →
        workRunExact? machine 1
            (configAtWord state
              (pushCrossed parsedCells [] ++ [leftGuard])
              (current :: rest)) =
          some
            (cleanupSeekConfiguration
              [] (current :: pushCrossed parsedCells []) rest))
    (secondFailure :
      ∀ (current : WorkSymbol) (rest : List WorkSymbol),
        current ≠ cell01 →
        current ≠ cell10 →
        workRunExact? machine 2
            (configAtWord state
              (pushCrossed parsedCells [] ++ [leftGuard])
              (cell00 :: current :: rest)) =
          some
            (cleanupSeekConfiguration
              []
              (current ::
                pushCrossed (parsedCells ++ [cell00]) [])
              rest))
    (notUnit : token ≠ .unit)
    (notNatEnd : token ≠ .natEnd) :
    ∃ steps final,
      steps ≤
          prefixSteps + 2 +
            2 * (packedTokenCells allTokens).length + 2 ∧
      workRunExact? machine steps initial = some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let suffixCells := packedTokenCells suffix
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq :
        tokenCells token = [current, next])
      (wrong : current ≠ cell00) :
      ∃ steps final,
        steps ≤
            prefixSteps + 2 +
              2 * (packedTokenCells allTokens).length + 2 ∧
        workRunExact? machine steps initial = some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have prefixRun' := prefixRun
    rw [cellsEq] at prefixRun'
    have failed :=
      firstFailure current (next :: suffixCells) wrong
    have launch :=
      exactRun_add prefixSteps 1
        _ _ _ prefixRun' failed
    have shape :
        packedTokenCells allTokens =
          parsedCells ++ current :: next :: suffixCells := by
      have shaped := wordShape
      rw [cellsEq] at shaped
      simpa [suffixCells, List.append_assoc] using shaped
    rcases
        packedExplicitFailure_bounded_exact
          allTokens parsedCells current
          (next :: suffixCells) initial
          (prefixSteps + 1) shape launch with
      ⟨steps, final, bound, run,
        finalState, output⟩
    refine
      ⟨steps, final, ?_, run, finalState, output⟩
    omega
  have rejectSecond
      (current : WorkSymbol)
      (cellsEq :
        tokenCells token = [cell00, current])
      (notUnitCell : current ≠ cell01)
      (notEndCell : current ≠ cell10) :
      ∃ steps final,
        steps ≤
            prefixSteps + 2 +
              2 * (packedTokenCells allTokens).length + 2 ∧
        workRunExact? machine steps initial = some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have prefixRun' := prefixRun
    rw [cellsEq] at prefixRun'
    have failed :=
      secondFailure current suffixCells
        notUnitCell notEndCell
    have launch :=
      exactRun_add prefixSteps 2
        _ _ _ prefixRun' failed
    have shape :
        packedTokenCells allTokens =
          (parsedCells ++ [cell00]) ++
            current :: suffixCells := by
      have shaped := wordShape
      rw [cellsEq] at shaped
      simpa [suffixCells, List.append_assoc] using shaped
    exact
      packedExplicitFailure_bounded_exact
        allTokens (parsedCells ++ [cell00])
        current suffixCells initial
        (prefixSteps + 2) shape launch
  cases token with
  | version0 =>
      exact rejectSecond cell00 rfl
        (by decide) (by decide)
  | unit =>
      exact False.elim (notUnit rfl)
  | natEnd =>
      exact False.elim (notNatEnd rfl)
  | input =>
      exact rejectSecond cell11 rfl
        (by decide) (by decide)
  | constantFalse =>
      exact rejectFirst cell01 cell00 rfl (by decide)
  | constantTrue =>
      exact rejectFirst cell01 cell01 rfl (by decide)
  | gate =>
      exact rejectFirst cell01 cell10 rfl (by decide)
  | gateEnd =>
      exact rejectFirst cell01 cell11 rfl (by decide)
  | programEnd =>
      exact rejectFirst cell10 cell00 rfl (by decide)
  | outputsEnd =>
      exact rejectFirst cell10 cell01 rfl (by decide)
  | threshold =>
      exact rejectFirst cell10 cell10 rfl (by decide)
  | instanceEnd =>
      exact rejectFirst cell10 cell11 rfl (by decide)

private theorem circuitMissingVersion_bounded_exact :
    ∃ steps final,
      steps ≤ circuitFailureEnvelope [] ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells []))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  refine
    ⟨6, emptyRejectConfiguration, ?_, ?_, rfl, rfl⟩
  · exact by decide
  · simpa [packedTokenCells, rawInputWorkTape,
      packWorkSymbols] using emptyInput_exact

private theorem circuitWrongVersion_bounded_exact
    (token : Token) (suffix : List Token)
    (notVersion : token ≠ .version0) :
    ∃ steps final,
      steps ≤
          circuitFailureEnvelope (token :: suffix) ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells (token :: suffix)))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let tokens := token :: suffix
  let suffixCells := packedTokenCells suffix
  let initial :=
    workStartConfiguration machine
      (WorkTape.ofSymbols (packedTokenCells tokens))
  have wordShape :
      packedTokenCells tokens =
        tokenCells token ++ suffixCells := by
    rfl
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq :
        tokenCells token = [current, next])
      (wrong : current ≠ cell00) :
      ∃ steps final,
        steps ≤ circuitFailureEnvelope tokens ∧
        workRunExact? machine steps initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have shaped := wordShape
    rw [cellsEq] at shaped
    have boot :
        workRunExact? machine 2 initial =
          some
            (versionFirstConfiguration
              current (next :: suffixCells)) := by
      dsimp [initial]
      rw [shaped]
      exact bootInstallGuard_exact
        current (next :: suffixCells)
    have failed :=
      versionFirst_failure_exact
        current (next :: suffixCells) wrong
    have launch :=
      exactRun_add 2 1 _ _ _ boot failed
    have cleanup :=
      packedExplicitFailure_bounded_exact
        tokens [] current (next :: suffixCells)
        initial 3 (by
          simpa using shaped) launch
    rcases cleanup with
      ⟨steps, final, bound, run,
        finalState, output⟩
    refine
      ⟨steps, final,
        linearSchedule_le_circuitFailureEnvelope
          tokens steps ?_,
        run, finalState, output⟩
    unfold circuitTokenFailureSpan
    omega
  have rejectSecond
      (current : WorkSymbol)
      (cellsEq :
        tokenCells token = [cell00, current])
      (wrong : current ≠ cell00) :
      ∃ steps final,
        steps ≤ circuitFailureEnvelope tokens ∧
        workRunExact? machine steps initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have shaped := wordShape
    rw [cellsEq] at shaped
    have boot :
        workRunExact? machine 3 initial =
          some
            (versionSecondConfiguration
              current suffixCells) := by
      dsimp [initial]
      rw [shaped]
      exact bootVersionFirst_exact current suffixCells
    have failed :=
      versionSecond_failure_exact
        current suffixCells wrong
    have launch :=
      exactRun_add 3 1 _ _ _ boot failed
    have cleanup :=
      packedExplicitFailure_bounded_exact
        tokens [cell00] current suffixCells
        initial 4 (by
          simpa using shaped) launch
    rcases cleanup with
      ⟨steps, final, bound, run,
        finalState, output⟩
    refine
      ⟨steps, final,
        linearSchedule_le_circuitFailureEnvelope
          tokens steps ?_,
        run, finalState, output⟩
    unfold circuitTokenFailureSpan
    omega
  cases token with
  | version0 =>
      exact False.elim (notVersion rfl)
  | unit =>
      simpa [tokens, initial] using
        (rejectSecond cell01 rfl (by decide))
  | natEnd =>
      simpa [tokens, initial] using
        (rejectSecond cell10 rfl (by decide))
  | input =>
      simpa [tokens, initial] using
        (rejectSecond cell11 rfl (by decide))
  | constantFalse =>
      simpa [tokens, initial] using
        (rejectFirst cell01 cell00 rfl (by decide))
  | constantTrue =>
      simpa [tokens, initial] using
        (rejectFirst cell01 cell01 rfl (by decide))
  | gate =>
      simpa [tokens, initial] using
        (rejectFirst cell01 cell10 rfl (by decide))
  | gateEnd =>
      simpa [tokens, initial] using
        (rejectFirst cell01 cell11 rfl (by decide))
  | programEnd =>
      simpa [tokens, initial] using
        (rejectFirst cell10 cell00 rfl (by decide))
  | outputsEnd =>
      simpa [tokens, initial] using
        (rejectFirst cell10 cell01 rfl (by decide))
  | threshold =>
      simpa [tokens, initial] using
        (rejectFirst cell10 cell10 rfl (by decide))
  | instanceEnd =>
      simpa [tokens, initial] using
        (rejectFirst cell10 cell11 rfl (by decide))

private theorem circuitInputCountFailure_bounded_exact
    {tokens : List Token}
    (failure : NatTokenFailure tokens) :
    ∃ steps final,
      steps ≤
          circuitFailureEnvelope
            (.version0 :: tokens) ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells
                (.version0 :: tokens)))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases failure with
  | missingEnd units =>
      let allTokens : List Token :=
        .version0 ::
          List.replicate units .unit
      let prefixCells : List WorkSymbol :=
        [cell00, cell00] ++ unaryUnitCells units
      let initial :=
        workStartConfiguration machine
          (WorkTape.ofSymbols
            (packedTokenCells allTokens))
      have cellsEq :
          packedTokenCells allTokens =
            prefixCells := by
        dsimp [allTokens, prefixCells]
        simp [packedTokenCells, tokenCells,
          packedTokenCells_replicate_unit]
      have prefixRun :
          workRunExact? machine (4 + 2 * units)
              initial =
            some
              (configAtWord State.inputCountFirst
                (pushCrossed prefixCells [] ++
                  [leftGuard]) []) := by
        dsimp [initial]
        rw [cellsEq]
        simpa [prefixCells] using
          (inputCountUnitsPrefix_exact units [])
      have failureRun :
          workRunExact? machine 1
              (configAtWord State.inputCountFirst
                (pushCrossed prefixCells [] ++
                  [leftGuard]) []) =
            some
              (cleanupSeekConfiguration
                []
                (missingEndScan
                  (pushCrossed prefixCells []))
                []) := by
        dsimp [prefixCells]
        simpa [missingEndScan,
          pushCrossed_append, pushCrossed] using
          (inputCountMissingEnd_failure_exact units)
      rcases
          missingEndAfterPrefix_bounded_exact
            allTokens State.inputCountFirst prefixCells
            initial (4 + 2 * units) cellsEq
            prefixRun failureRun with
        ⟨steps, final, bound, run,
          finalState, output⟩
      have cellsLength :=
        congrArg List.length cellsEq
      refine
        ⟨steps, final,
          linearSchedule_le_circuitFailureEnvelope
            allTokens steps ?_,
          ?_, finalState, output⟩
      · unfold circuitTokenFailureSpan
        dsimp [prefixCells] at cellsLength
        simp only [unaryUnitCells_length] at cellsLength
        omega
      · simpa [allTokens, initial] using run
  | wrongToken units token suffix notUnit notNatEnd =>
      let allTokens : List Token :=
        .version0 ::
          (List.replicate units .unit ++
            token :: suffix)
      let parsedCells : List WorkSymbol :=
        [cell00, cell00] ++ unaryUnitCells units
      let initial :=
        workStartConfiguration machine
          (WorkTape.ofSymbols
            (packedTokenCells allTokens))
      let prefixSteps := 4 + 2 * units
      have wordShape :=
        malformedInputCountCells_shape
          units token suffix
      have prefixRun :
          workRunExact? machine prefixSteps initial =
            some
              (configAtWord State.inputCountFirst
                (pushCrossed parsedCells [] ++ [leftGuard])
                (tokenCells token ++
                  packedTokenCells suffix)) := by
        dsimp [prefixSteps, initial, allTokens,
          parsedCells]
        rw [wordShape]
        simpa [parsedCells, List.append_assoc] using
          (inputCountUnitsPrefix_exact units
            (tokenCells token ++
              packedTokenCells suffix))
      rcases
          natWrongToken_bounded_exact
            allTokens State.inputCountFirst
            parsedCells token suffix initial
            prefixSteps wordShape prefixRun
            (fun current rest wrong =>
              inputCountFirstFailure_exact
                parsedCells current rest wrong)
            (fun current rest notUnitCell notEndCell =>
              inputCountSecondFailure_exact
                parsedCells current rest
                notUnitCell notEndCell)
            notUnit notNatEnd with
        ⟨steps, final, bound, run,
          finalState, output⟩
      have wordLength :=
        congrArg List.length wordShape
      refine
        ⟨steps, final,
          linearSchedule_le_circuitFailureEnvelope
            allTokens steps ?_,
          ?_, finalState, output⟩
      · unfold circuitTokenFailureSpan
        dsimp [allTokens, parsedCells, prefixSteps]
          at bound wordLength ⊢
        simp only [packedTokenCells_length,
          List.length_append,
          List.length_cons,
          List.length_replicate,
          unaryUnitCells_length,
          tokenCells_length] at bound wordLength ⊢
        omega
      · simpa [allTokens, initial] using run

private theorem circuitGateCountFailure_bounded_exact
    (inputs : Nat) {tokens : List Token}
    (failure : NatTokenFailure tokens) :
    ∃ steps final,
      steps ≤
          circuitFailureEnvelope
            (.version0 ::
              (encodeNatTokens inputs ++ tokens)) ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells
                (.version0 ::
                  (encodeNatTokens inputs ++ tokens))))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases failure with
  | missingEnd units =>
      let allTokens : List Token :=
        .version0 ::
          (encodeNatTokens inputs ++
            List.replicate units .unit)
      let prefixCells : List WorkSymbol :=
        [cell00, cell00] ++ natCells inputs ++
          unaryUnitCells units
      let initial :=
        workStartConfiguration machine
          (WorkTape.ofSymbols
            (packedTokenCells allTokens))
      have cellsEq :
          packedTokenCells allTokens =
            prefixCells := by
        dsimp [allTokens, prefixCells]
        rw [packedTokenCells]
        rw [packedTokenCells_append,
          packedTokenCells_encodeNatTokens,
          packedTokenCells_replicate_unit]
        rfl
      have prefixRun :
          workRunExact? machine
              (4 + 2 * (inputs + 1) + 2 * units)
              initial =
            some
              (configAtWord State.gateCountFirst
                (pushCrossed prefixCells [] ++
                  [leftGuard]) []) := by
        dsimp [initial]
        rw [cellsEq]
        simpa [prefixCells, List.append_assoc] using
          (gateCountUnitsPrefix_exact
            inputs units [])
      have failureRun :=
        gateCountMissingEnd_failure_exact
          (pushCrossed prefixCells [])
      rcases
          missingEndAfterPrefix_bounded_exact
            allTokens State.gateCountFirst prefixCells
            initial
            (4 + 2 * (inputs + 1) + 2 * units)
            cellsEq prefixRun failureRun with
        ⟨steps, final, bound, run,
          finalState, output⟩
      have cellsLength :=
        congrArg List.length cellsEq
      refine
        ⟨steps, final,
          linearSchedule_le_circuitFailureEnvelope
            allTokens steps ?_,
          ?_, finalState, output⟩
      · unfold circuitTokenFailureSpan
        dsimp [prefixCells] at cellsLength
        simp only [List.length_append,
          natCells_length, unaryUnitCells_length]
            at cellsLength
        omega
      · simpa [allTokens, initial] using run
  | wrongToken units token suffix notUnit notNatEnd =>
      let allTokens : List Token :=
        .version0 ::
          (encodeNatTokens inputs ++
            List.replicate units .unit ++
            token :: suffix)
      let parsedCells : List WorkSymbol :=
        [cell00, cell00] ++ natCells inputs ++
          unaryUnitCells units
      let initial :=
        workStartConfiguration machine
          (WorkTape.ofSymbols
            (packedTokenCells allTokens))
      let prefixSteps :=
        4 + 2 * (inputs + 1) + 2 * units
      have wordShape :=
        malformedGateCountCells_shape
          inputs units token suffix
      have prefixRun :
          workRunExact? machine prefixSteps initial =
            some
              (configAtWord State.gateCountFirst
                (pushCrossed parsedCells [] ++ [leftGuard])
                (tokenCells token ++
                  packedTokenCells suffix)) := by
        dsimp [prefixSteps, initial, allTokens,
          parsedCells]
        rw [wordShape]
        simpa [parsedCells, List.append_assoc] using
          (gateCountUnitsPrefix_exact
            inputs units
            (tokenCells token ++
              packedTokenCells suffix))
      rcases
          natWrongToken_bounded_exact
            allTokens State.gateCountFirst
            parsedCells token suffix initial
            prefixSteps wordShape prefixRun
            (fun current rest wrong =>
              gateCountFirstFailure_exact
                parsedCells current rest wrong)
            (fun current rest notUnitCell notEndCell =>
              gateCountSecondFailure_exact
                parsedCells current rest
                notUnitCell notEndCell)
            notUnit notNatEnd with
        ⟨steps, final, bound, run,
          finalState, output⟩
      have wordLength :=
        congrArg List.length wordShape
      have envelope :=
        linearSchedule_le_circuitFailureEnvelope
          allTokens steps (by
            unfold circuitTokenFailureSpan
            dsimp [allTokens, parsedCells, prefixSteps]
              at bound wordLength ⊢
            simp only [packedTokenCells_length,
              List.length_append,
              List.length_cons,
              List.length_replicate,
              natCells_length, unaryUnitCells_length,
              tokenCells_length] at bound wordLength ⊢
            omega)
      refine
        ⟨steps, final, ?_, ?_,
          finalState, output⟩
      · simpa [allTokens, List.append_assoc] using
          envelope
      · simpa [allTokens, initial,
          List.append_assoc] using run

private theorem packedCircuitHeaderTokens_append
    (inputs gateCount : Nat) (tokens : List Token) :
    packedTokenCells
        (circuitHeaderTokens inputs gateCount ++ tokens) =
      [cell00, cell00] ++ natCells inputs ++
        natCells gateCount ++ packedTokenCells tokens := by
  unfold circuitHeaderTokens
  rw [packedTokenCells_append]
  change
    [cell00, cell00] ++
        packedTokenCells
          (encodeNatTokens inputs ++
            encodeNatTokens gateCount) ++
        packedTokenCells tokens =
      [cell00, cell00] ++ natCells inputs ++
        natCells gateCount ++ packedTokenCells tokens
  rw [packedTokenCells_append,
    packedTokenCells_encodeNatTokens,
    packedTokenCells_encodeNatTokens]
  simp [List.append_assoc]

set_option maxRecDepth 100000 in
private theorem circuitGateCountEnd_exact
    (parsed suffix : List WorkSymbol) :
    workRunExact? machine 2
        (configAtWord State.gateCountFirst
          (pushCrossed parsed [] ++ [leftGuard])
          (cell00 :: cell10 :: suffix)) =
      some
        (guardedConfig State.gateStart
          (parsed ++ [cell00, cell10]) suffix) := by
  rw [guardedConfig_eq_crossed]
  simp [pushCrossed_append, pushCrossed]
  rfl

private theorem circuitHeaderToGateStart_exact
    (inputs gateCount : Nat)
    (suffix : List WorkSymbol) :
    workRunExact? machine
        (2 * inputs + 2 * gateCount + 8)
        (workStartConfiguration machine
          (WorkTape.ofSymbols
            ([cell00, cell00] ++ natCells inputs ++
              natCells gateCount ++ suffix))) =
      some
        (guardedConfig State.gateStart
          (grammarGatePrefix inputs [] gateCount)
          suffix) := by
  let prefixCells :=
    [cell00, cell00] ++ natCells inputs ++
      unaryUnitCells gateCount
  have prefixRun :=
    gateCountUnitsPrefix_exact
      inputs gateCount (cell00 :: cell10 :: suffix)
  have ending :=
    circuitGateCountEnd_exact
      prefixCells suffix
  have all :=
    exactRun_add
      (4 + 2 * (inputs + 1) + 2 * gateCount)
      2 _ _ _ (by
        simpa [prefixCells] using prefixRun) ending
  have stepsEq :
      (4 + 2 * (inputs + 1) + 2 * gateCount) + 2 =
        2 * inputs + 2 * gateCount + 8 := by
    omega
  rw [stepsEq] at all
  simpa [prefixCells, grammarGatePrefix,
    countCells, markedGateListCells,
    natCells_eq_unaryUnitCells_append,
    pushCrossed_append, pushCrossed,
    List.append_assoc] using all

private theorem circuitCubicComposition_bound
    (tokens : List Token)
    (headerSteps tailSteps count span : Nat)
    (headerBound :
      headerSteps ≤
        8 * (circuitTokenFailureSpan tokens + 1))
    (countBound :
      count ≤ circuitTokenFailureSpan tokens + 1)
    (spanBound :
      span + 1 ≤
        2 * (circuitTokenFailureSpan tokens + 1))
    (tailBound :
      tailSteps ≤
        count * (128 * failureSpanSquare span)) :
    headerSteps + tailSteps ≤
      circuitFailureEnvelope tokens := by
  let wordSpan := circuitTokenFailureSpan tokens
  have squareRaw :=
    Nat.mul_le_mul spanBound spanBound
  have squareBound :
      failureSpanSquare span ≤
        4 * failureSpanSquare wordSpan := by
    calc
      failureSpanSquare span ≤
          (2 * (wordSpan + 1)) *
            (2 * (wordSpan + 1)) := by
        simpa [failureSpanSquare, wordSpan] using
          squareRaw
      _ =
          (2 * 2) *
            failureSpanSquare wordSpan := by
        unfold failureSpanSquare
        ac_rfl
      _ = 4 * failureSpanSquare wordSpan := by
        rfl
  have productRaw :=
    Nat.mul_le_mul countBound squareBound
  have productBound :
      count * failureSpanSquare span ≤
        4 * failureSpanCube wordSpan := by
    simpa [failureSpanCube, wordSpan,
      Nat.mul_assoc, Nat.mul_comm,
      Nat.mul_left_comm] using productRaw
  have scaled :=
    Nat.mul_le_mul_left 128 productBound
  have tailEnvelope :
      tailSteps ≤
        512 * failureSpanCube wordSpan := by
    calc
      tailSteps ≤
          count * (128 * failureSpanSquare span) :=
        tailBound
      _ = 128 *
          (count * failureSpanSquare span) := by
        ac_rfl
      _ ≤ 128 *
          (4 * failureSpanCube wordSpan) :=
        scaled
      _ = 512 * failureSpanCube wordSpan := by
        omega
  have squarePositive :
      1 ≤ failureSpanSquare wordSpan :=
    one_le_failureSpanSquare wordSpan
  have wordLeCube :
      wordSpan + 1 ≤
        failureSpanCube wordSpan := by
    have product :=
      Nat.mul_le_mul_left
        (wordSpan + 1) squarePositive
    simpa [failureSpanCube] using product
  have headerEnvelope :
      headerSteps ≤
        8 * failureSpanCube wordSpan :=
    Nat.le_trans
      (by simpa [wordSpan] using headerBound)
      (Nat.mul_le_mul_left 8 wordLeCube)
  have combined :=
    Nat.add_le_add headerEnvelope tailEnvelope
  calc
    headerSteps + tailSteps ≤
        8 * failureSpanCube wordSpan +
          512 * failureSpanCube wordSpan :=
      combined
    _ = 520 * failureSpanCube wordSpan := by
      omega
    _ ≤ 1024 * failureSpanCube wordSpan := by
      exact Nat.mul_le_mul_right
        (failureSpanCube wordSpan) (by omega)
    _ = circuitFailureEnvelope tokens := by
      rfl

private theorem circuitGatesFailure_bounded_exact
    (inputs gateCount : Nat)
    {tokens : List Token}
    (failure : NGatesTokenFailure gateCount tokens) :
    ∃ steps final,
      steps ≤
          circuitFailureEnvelope
            (circuitHeaderTokens
              inputs gateCount ++ tokens) ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells
                (circuitHeaderTokens
                  inputs gateCount ++ tokens)))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let allTokens :=
    circuitHeaderTokens inputs gateCount ++ tokens
  let suffixCells := packedTokenCells tokens
  let initial :=
    workStartConfiguration machine
      (WorkTape.ofSymbols (packedTokenCells allTokens))
  let headerSteps :=
    2 * inputs + 2 * gateCount + 8
  have cellsEq :=
    packedCircuitHeaderTokens_append
      inputs gateCount tokens
  have header :
      workRunExact? machine headerSteps initial =
        some
          (guardedConfig State.gateStart
            (grammarGatePrefix inputs [] gateCount)
            suffixCells) := by
    dsimp [headerSteps, initial, allTokens, suffixCells]
    rw [cellsEq]
    exact circuitHeaderToGateStart_exact
      inputs gateCount (packedTokenCells tokens)
  rcases
      grammarNGatesTokenFailure_bounded_exact
        inputs [] failure with
    ⟨tailSteps, final, tailBound, tail,
      finalState, output⟩
  have all :=
    exactRun_add headerSteps tailSteps
      _ _ _ header tail
  have spanEq :
      grammarTokenFailureSpan inputs [] gateCount tokens =
        (packedTokenCells allTokens).length + 2 := by
    unfold grammarTokenFailureSpan
      grammarGatePrefix
    dsimp [allTokens]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length, countCells_length,
      markedGateListCells]
    omega
  have headerBound :
      headerSteps ≤
        8 * (circuitTokenFailureSpan allTokens + 1) := by
    unfold circuitTokenFailureSpan
    dsimp [headerSteps, allTokens]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length]
    omega
  have countBound :
      gateCount ≤
        circuitTokenFailureSpan allTokens + 1 := by
    unfold circuitTokenFailureSpan
    dsimp [allTokens]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length]
    omega
  have spanBound :
      grammarTokenFailureSpan
            inputs [] gateCount tokens + 1 ≤
        2 * (circuitTokenFailureSpan allTokens + 1) := by
    rw [spanEq]
    unfold circuitTokenFailureSpan
    dsimp [allTokens]
    have headerPositive :
        1 ≤
          (packedTokenCells
            (circuitHeaderTokens
              inputs gateCount ++ tokens)).length := by
      rw [cellsEq]
      simp
    omega
  have scheduleBound :=
    circuitCubicComposition_bound
      allTokens headerSteps tailSteps gateCount
      (grammarTokenFailureSpan
        inputs [] gateCount tokens)
      headerBound countBound spanBound tailBound
  refine
    ⟨headerSteps + tailSteps, final, ?_, ?_,
      finalState, output⟩
  · simpa [allTokens] using scheduleBound
  · simpa [allTokens, initial] using all

private theorem packedTokenCells_allOrdinary
    (tokens : List Token) (symbol : WorkSymbol)
    (member : symbol ∈ packedTokenCells tokens) :
    ordinaryCell symbol := by
  induction tokens with
  | nil =>
      contradiction
  | cons token rest ih =>
      simp only [packedTokenCells,
        List.mem_append] at member
      rcases member with inToken | inRest
      · cases token <;>
          simp only [tokenCells, List.mem_cons,
            List.not_mem_nil] at inToken <;>
          rcases inToken with
            rfl | rfl | impossible <;>
          first
          | exact ordinaryCell_cell00
          | exact ordinaryCell_cell01
          | exact ordinaryCell_cell10
          | exact ordinaryCell_cell11
          | contradiction
      · exact ih inRest

private theorem packedTokenCells_allSourcePacked
    (tokens : List Token) (symbol : WorkSymbol)
    (member : symbol ∈ packedTokenCells tokens) :
    SourcePackedCell symbol := by
  apply packedRawBits_allSourcePacked
    (encodeTokens tokens) symbol
  change
    symbol ∈
      packWorkSymbols
        ((encodeTokens tokens).map TapeSymbol.ofBool)
  rw [pack_encodeTokens]
  exact member

private theorem tokenPrefixMalformedTail_allSourcePacked
    (tokens : List Token)
    {rawTail : BitString} {workTail : List WorkSymbol}
    (malformed : MalformedWorkTail rawTail workTail)
    (symbol : WorkSymbol)
    (member :
      symbol ∈ packedTokenCells tokens ++ workTail) :
    SourcePackedCell symbol := by
  rcases List.mem_append.mp member with
    inTokens | inTail
  · exact packedTokenCells_allSourcePacked
      tokens symbol inTokens
  · exact malformed.allSourcePacked
      symbol inTail

private theorem tokenPrefixMalformedWord_allOrdinary
    (tokens : List Token)
    {rawTail : BitString} {workTail : List WorkSymbol}
    (malformed : MalformedWorkTail rawTail workTail)
    (symbol : WorkSymbol)
    (member :
      symbol ∈ packedTokenCells tokens ++ workTail) :
