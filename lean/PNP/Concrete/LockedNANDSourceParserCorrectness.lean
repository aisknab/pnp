          simpa [word, List.append_assoc] using all
      | true =>
          rcases
              grammarGateRightValid_exact
                inputs done remaining left right
                workTail rightEq with
            ⟨rightSteps, rightBound, rightRun⟩
          have rightBoundCanonical :
              rightSteps ≤
                16 *
                  failureSpanSquare
                    (grammarWorkFailureSpan
                      inputs done (remaining + 1)
                      word) := by
            simpa [word, List.append_assoc] using
              rightBound
          rcases
              grammarGateEndMalformedTail_bounded_exact
                inputs done remaining left right
                malformed with
            ⟨endSteps, final, endBound, endRun,
              finalState, outputEmpty⟩
          have endBoundCanonical :
              endSteps ≤
                128 *
                  failureSpanSquare
                    (grammarWorkFailureSpan
                      inputs done (remaining + 1)
                      word) := by
            simpa [word, List.append_assoc] using
              endBound
          have throughRight :=
            exactRun_add leftSteps rightSteps
