private theorem circuitOutputPackedPrefixWord_exact
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource) (after : List WorkSymbol)
    (gatesValid :
      rawGatesWellFormed inputs 0 gates = true)
    (outputValid :
