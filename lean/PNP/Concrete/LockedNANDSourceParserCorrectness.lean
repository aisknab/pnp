      rawGatesWellFormed inputs 0 gates = true)
    (outputValid :
      output.wellFormed inputs gates.length = true) :
    let tokens :=
      circuitOutputPrefixTokens inputs gates output ++
        [.outputsEnd]
    workRunExact? machine
        (circuitOutputPrefixSteps
            inputs gates output + 2)
        (workStartConfiguration machine
          (WorkTape.ofSymbols
            (packedTokenCells tokens ++ after))) =
      some
        (guardedConfig State.instanceEndFirst
          (circuitOutputParsedPrefix
              inputs gates output ++
            [cell10, cell01])
          after) := by
  dsimp only
  let prefixTokens :=
    circuitOutputPrefixTokens inputs gates output
  let tokens := prefixTokens ++ [.outputsEnd]
  let parsedPrefix :=
    circuitOutputParsedPrefix inputs gates output
  have wordShape :
      packedTokenCells tokens ++ after =
        packedTokenCells prefixTokens ++
          cell10 :: cell01 :: after := by
    dsimp [tokens]
    rw [packedTokenCells_append]
    simp [packedTokenCells, tokenCells,
      List.append_assoc]
  have outputRun :=
    circuitOutputPackedPrefixWord_exact
      inputs gates output
      (cell10 :: cell01 :: after)
      gatesValid outputValid
  have delimiterRun :=
    outputsEnd_exact parsedPrefix after
  have combined :=
    exactRun_add
      (circuitOutputPrefixSteps
        inputs gates output)
      2 _ _ _ outputRun delimiterRun
