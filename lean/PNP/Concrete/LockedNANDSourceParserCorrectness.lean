      word =
        packedTokenCells prefixTokens ++
          cell10 :: cell01 :: after := by
    dsimp [word, tokens]
    rw [packedTokenCells_append]
    simp [packedTokenCells, tokenCells,
      List.append_assoc]
  have outputBound :
      circuitOutputPrefixSteps inputs gates output ≤
        192 * failureSpanCube word.length := by
    have raw :=
      circuitOutputPackedPrefixWordSteps_bound
        inputs gates output
        (cell10 :: cell01 :: after)
    rw [wordShape]
    simpa [prefixTokens] using raw
  have oneCube :
      1 ≤ failureSpanCube word.length := by
    exact Nat.le_trans
      (one_le_failureSpanSquare word.length)
      (failureSpanSquare_le_cube word.length)
  have delimiterBound :
      2 ≤ 2 * failureSpanCube word.length := by
    simpa using
      Nat.mul_le_mul_left 2 oneCube
  have combined :=
    Nat.add_le_add outputBound delimiterBound
  have canonical :
      circuitOutputPrefixSteps
            inputs gates output + 2 ≤
        194 * failureSpanCube word.length := by
    calc
      circuitOutputPrefixSteps
            inputs gates output + 2 ≤
          192 * failureSpanCube word.length +
            2 * failureSpanCube word.length :=
        combined
      _ = 194 * failureSpanCube word.length := by
        rw [show 194 = 192 + 2 by omega,
          Nat.add_mul]
  simpa [word, tokens] using canonical

