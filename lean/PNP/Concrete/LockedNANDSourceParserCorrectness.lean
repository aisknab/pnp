    current :: pushCrossed parsedPrefix []
  have ordinaryCanonical :
      ∀ symbol,
        symbol ∈ parsedPrefix ++ current :: rest →
          ordinaryCell symbol := by
    intro symbol member
    apply ordinary symbol
    rwa [shape]
  have run :=
    ordinaryExplicitFailureRun_exact
      parsedPrefix current rest initial
      launchSteps ordinaryCanonical launch
  let steps :=
    launchSteps +
      guardedCleanupSteps scan rest
  let final :=
    cleanupRejectConfiguration
      [] scan rest []
  have shapeLength :=
    congrArg List.length shape
  have cleanupBound :
      guardedCleanupSteps scan rest ≤
        2 * word.length + 2 := by
    rw [guardedCleanupSteps_eq]
    dsimp [scan]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      pushCrossed_length] at shapeLength ⊢
    omega
  refine
    ⟨steps, final, ?_, ?_, rfl, ?_⟩
  · dsimp [steps]
    omega
  · simpa [steps, scan, final] using run
  · exact cleanupRejectConfiguration_output_empty
      [] scan rest

private theorem wordExplicitFailure_raw_bounded_exact
    (word parsedPrefix : List WorkSymbol)
    (current : WorkSymbol) (rest : List WorkSymbol)
    (initial : WorkConfiguration) (launchSteps : Nat)
    (shape :
      word = parsedPrefix ++ current :: rest)
    (ordinary :
      ∀ symbol, symbol ∈ word →
        ordinaryCell symbol)
    (launch :
      workRunExact? machine launchSteps initial =
        some
          (cleanupSeekConfiguration
            [] (current ::
              pushCrossed parsedPrefix []) rest))
    (launchLinear :
      launchSteps ≤ 8 * (word.length + 1)) :
    ∃ steps final,
      steps ≤ rawFailureEnvelope word ∧
      workRunExact? machine steps initial =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  rcases
      wordExplicitFailure_bounded_exact
        word parsedPrefix current rest initial
        launchSteps shape ordinary launch with
    ⟨steps, final, bound, run,
      finalState, outputEmpty⟩
  have linear :
      steps ≤ 10 * (word.length + 1) := by
    omega
  have successorLeSquare :
      word.length + 1 ≤
        failureSpanSquare word.length := by
    have positive : 1 ≤ word.length + 1 := by
      omega
    simpa [failureSpanSquare] using
      Nat.mul_le_mul_left
        (word.length + 1) positive
  have square :
      steps ≤
        10 * failureSpanSquare word.length :=
    Nat.le_trans linear
      (Nat.mul_le_mul_left 10 successorLeSquare)
  have squareLeCube :
      failureSpanSquare word.length ≤
        failureSpanCube word.length := by
    have positive : 1 ≤ word.length + 1 := by
      omega
    have scaled :=
      Nat.mul_le_mul_right
        (failureSpanSquare word.length) positive
    simpa [failureSpanCube] using scaled
  have cube :
      10 * failureSpanSquare word.length ≤
        10 * failureSpanCube word.length :=
    Nat.mul_le_mul_left 10 squareLeCube
  have coefficient :
      10 * failureSpanCube word.length ≤
        2048 * failureSpanCube word.length := by
    omega
  exact
    ⟨steps, final,
      Nat.le_trans square
        (Nat.le_trans cube (by
          simpa [rawFailureEnvelope] using
            coefficient)),
      run, finalState, outputEmpty⟩

private theorem wrongVersionWithFramingTail_bounded_exact
    (token : Token) (suffix : List Token)
    (notVersion : token ≠ .version0)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    ∃ steps final,
      steps ≤
          rawFailureEnvelope
            (packedTokenCells (token :: suffix) ++
              workTail) ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells (token :: suffix) ++
                workTail))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  let tokens := token :: suffix
  let suffixCells :=
    packedTokenCells suffix ++ workTail
  let word :=
    packedTokenCells tokens ++ workTail
  let initial :=
    workStartConfiguration machine
      (WorkTape.ofSymbols word)
  have wordShape :
      word = tokenCells token ++ suffixCells := by
    dsimp [word, tokens, suffixCells]
    simp [packedTokenCells, List.append_assoc]
  have wordOrdinary :
      ∀ symbol, symbol ∈ word →
        ordinaryCell symbol := by
    intro symbol member
    exact tokenPrefixMalformedWord_allOrdinary
      tokens malformed symbol (by
        simpa [word] using member)
  have rejectFirst
      (current next : WorkSymbol)
      (cellsEq :
        tokenCells token = [current, next])
      (wrong : current ≠ cell00) :
      ∃ steps final,
        steps ≤ rawFailureEnvelope word ∧
        workRunExact? machine steps initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have shaped := wordShape
    rw [cellsEq] at shaped
    have boot :
        workRunExact? machine 2 initial =
          some
            (versionFirstConfiguration
              current (next :: suffixCells)) := by
      dsimp [initial]
      rw [shaped]
      exact bootInstallGuard_exact
        current (next :: suffixCells)
    have failed :=
      versionFirst_failure_exact
        current (next :: suffixCells) wrong
    have launch :=
      exactRun_add 2 1 _ _ _ boot failed
    exact
      wordExplicitFailure_raw_bounded_exact
        word [] current (next :: suffixCells)
        initial 3 (by simpa using shaped)
        wordOrdinary launch (by omega)
  have rejectSecond
      (current : WorkSymbol)
      (cellsEq :
        tokenCells token = [cell00, current])
      (wrong : current ≠ cell00) :
      ∃ steps final,
        steps ≤ rawFailureEnvelope word ∧
        workRunExact? machine steps initial =
          some final ∧
        final.state = State.reject ∧
        (encodeWorkTape final.tape).outputBits = [] := by
    have shaped := wordShape
    rw [cellsEq] at shaped
    have boot :
        workRunExact? machine 3 initial =
          some
            (versionSecondConfiguration
              current suffixCells) := by
      dsimp [initial]
      rw [shaped]
      exact bootVersionFirst_exact
        current suffixCells
    have failed :=
      versionSecond_failure_exact
        current suffixCells wrong
    have launch :=
      exactRun_add 3 1 _ _ _ boot failed
    exact
      wordExplicitFailure_raw_bounded_exact
        word [cell00] current suffixCells
        initial 4 (by simpa using shaped)
        wordOrdinary launch (by omega)
  cases token with
  | version0 =>
      exact False.elim (notVersion rfl)
  | unit =>
      simpa [tokens, word, initial] using
        (rejectSecond cell01 rfl (by decide))
  | natEnd =>
      simpa [tokens, word, initial] using
        (rejectSecond cell10 rfl (by decide))
  | input =>
      simpa [tokens, word, initial] using
        (rejectSecond cell11 rfl (by decide))
  | constantFalse =>
      simpa [tokens, word, initial] using
        (rejectFirst cell01 cell00 rfl (by decide))
  | constantTrue =>
      simpa [tokens, word, initial] using
        (rejectFirst cell01 cell01 rfl (by decide))
  | gate =>
      simpa [tokens, word, initial] using
        (rejectFirst cell01 cell10 rfl (by decide))
  | gateEnd =>
      simpa [tokens, word, initial] using
        (rejectFirst cell01 cell11 rfl (by decide))
  | programEnd =>
      simpa [tokens, word, initial] using
        (rejectFirst cell10 cell00 rfl (by decide))
  | outputsEnd =>
      simpa [tokens, word, initial] using
        (rejectFirst cell10 cell01 rfl (by decide))
  | threshold =>
      simpa [tokens, word, initial] using
        (rejectFirst cell10 cell10 rfl (by decide))
  | instanceEnd =>
      simpa [tokens, word, initial] using
        (rejectFirst cell10 cell11 rfl (by decide))

