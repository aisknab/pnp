          finalState, outputEmpty⟩

private theorem circuitWrongProgramEndWithFramingTail_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    (token : Token) (suffix : List Token)
    (notProgramEnd : token ≠ .programEnd)
    {rawTail : BitString}
    {workTail : List WorkSymbol}
    (malformed :
      MalformedWorkTail rawTail workTail) :
    let allTokens :=
      circuitGatesPrefixTokens inputs gates ++
        token :: suffix
    let word :=
      packedTokenCells allTokens ++ workTail
    ∃ steps final,
      steps ≤ rawFailureEnvelope word ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols word)) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let allTokens :=
    circuitGatesPrefixTokens inputs gates ++
      token :: suffix
  let after :=
    packedTokenCells suffix ++ workTail
  let boundaryTail :=
    packedTokenCells (token :: suffix) ++
      workTail
  let word :=
    packedTokenCells allTokens ++ workTail
  cases gatesEq :
      rawGatesWellFormed inputs 0 gates with
  | false =>
      simpa [allTokens, word] using
        (circuitInvalidGatesWithFramingTail_bounded_exact
          inputs gates (token :: suffix)
          gatesEq malformed)
  | true =>
      let prefixSteps :=
        (2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates
      have boundaryShape :
          boundaryTail =
            tokenCells token ++ after := by
        simp [boundaryTail, after,
          packedTokenCells, List.append_assoc]
      have wordShape :
          word =
            packedTokenCells
                (circuitGatesPrefixTokens
                  inputs gates) ++
              boundaryTail := by
        dsimp [word, allTokens, boundaryTail]
        rw [packedTokenCells_append]
        simp [List.append_assoc]
      have prefixRun :
          workRunExact? machine prefixSteps
              (workStartConfiguration machine
                (WorkTape.ofSymbols word)) =
            some
              (guardedConfig State.gateStart
                (grammarGatePrefix inputs gates 0)
                boundaryTail) := by
        rw [wordShape]
        simpa [prefixSteps, gatePrefix,
          grammarGatePrefix] using
          (circuitValidGatesPackedWord_exact
            inputs gates boundaryTail gatesEq)
      have prefixBound :
          prefixSteps ≤
            128 *
              failureSpanCube word.length := by
        have raw :=
          circuitValidGatesPackedWordSteps_bound
            inputs gates boundaryTail
        rw [wordShape]
        simpa [prefixSteps] using raw
      let inner :=
        grammarWorkFailureSpan
          inputs gates 0 boundaryTail
      have cellsEq :=
        packedCircuitGatesPrefixTokens_append
          inputs gates []
      have innerBound :
          inner ≤ word.length + 2 := by
        unfold inner grammarWorkFailureSpan
          grammarGatePrefix
        rw [wordShape]
        rw [show
            packedTokenCells
                  (circuitGatesPrefixTokens
                    inputs gates) =
              [cell00, cell00] ++ natCells inputs ++
                natCells gates.length ++
                gateListCells gates by
          simpa [packedTokenCells] using cellsEq]
        simp only [List.length_append,
          List.length_cons, List.length_nil,
          countCells_length, natCells_length,
          markedGateListCells_length]
        omega
      have squareCube :=
        shiftedSquare_le_nineCube
          inner word.length innerBound
      have finish
          (tailSteps : Nat)
          (final : WorkConfiguration)
          (tailBound :
            tailSteps ≤
              64 * failureSpanSquare inner)
          (tailRun :
            workRunExact? machine tailSteps
                (guardedConfig State.gateStart
                  (grammarGatePrefix inputs gates 0)
                  boundaryTail) =
              some final)
          (finalState :
            final.state = State.reject)
          (outputEmpty :
            (encodeWorkTape final.tape).outputBits = []) :
          ∃ steps final,
            steps ≤ rawFailureEnvelope word ∧
            workRunExact? machine steps
                (workStartConfiguration machine
                  (WorkTape.ofSymbols word)) =
              some final ∧
            final.state = State.reject ∧
            (encodeWorkTape final.tape).outputBits = [] := by
        have tailEnvelope :
            tailSteps ≤
              576 * failureSpanCube word.length := by
          exact Nat.le_trans tailBound
            (by
              have scaled :=
                Nat.mul_le_mul_left 64 squareCube
              calc
                64 * failureSpanSquare inner ≤
                    64 *
                      (9 *
                        failureSpanCube word.length) :=
                  scaled
                _ =
                    576 *
                      failureSpanCube word.length := by
                  omega)
        have combined :=
          Nat.add_le_add prefixBound tailEnvelope
        have scheduleBound :
            prefixSteps + tailSteps ≤
              rawFailureEnvelope word := by
          calc
            prefixSteps + tailSteps ≤
                128 * failureSpanCube word.length +
                  576 * failureSpanCube word.length :=
              combined
            _ =
                704 * failureSpanCube word.length := by
              omega
            _ ≤ 2048 * failureSpanCube word.length :=
              Nat.mul_le_mul_right
                (failureSpanCube word.length) (by omega)
            _ = rawFailureEnvelope word := by
              rfl
        exact
          ⟨prefixSteps + tailSteps, final,
            scheduleBound,
            exactRun_add prefixSteps tailSteps
              _ _ _ prefixRun tailRun,
            finalState, outputEmpty⟩
      have afterOrdinary
          (current : WorkSymbol)
          (currentOrdinary :
            ordinaryCell current) :
          ∀ symbol, symbol ∈ current :: after →
            ordinaryCell symbol := by
        intro symbol member
        simp only [List.mem_cons] at member
        rcases member with rfl | inAfter
        · exact currentOrdinary
        · exact
            tokenPrefixMalformedWord_allOrdinary
              suffix malformed symbol
              (by simpa [after] using inAfter)
      have exhaust
          (firstWas01 : Bool)
          (current : WorkSymbol)
          (currentOrdinary :
            ordinaryCell current)
          (shape :
            tokenCells token =
              [firstSourceCell firstWas01, current]) :
          ∃ steps final,
            steps ≤ rawFailureEnvelope word ∧
            workRunExact? machine steps
                (workStartConfiguration machine
                  (WorkTape.ofSymbols word)) =
              some final ∧
            final.state = State.reject ∧
            (encodeWorkTape final.tape).outputBits = [] := by
        rcases
            grammarGateExhausted_exact
              firstWas01 inputs gates current after
              (fun symbol member =>
                ordinaryCell_not_leftGuard
                  (afterOrdinary current
                    currentOrdinary symbol member))
              (fun symbol member =>
                ordinaryCell_not_blank
                  (afterOrdinary current
                    currentOrdinary symbol member)) with
          ⟨tailSteps, final, tailBound, tailRun,
            finalState, outputEmpty⟩
        have tailBoundCanonical :
            tailSteps ≤
              64 * failureSpanSquare inner := by
          unfold inner
          rw [boundaryShape, shape]
          simpa [grammarWorkFailureSpan] using
            tailBound
        apply finish tailSteps final
          tailBoundCanonical
        · rw [boundaryShape, shape]
          simpa using tailRun
        · exact finalState
        · exact outputEmpty
      have mismatch
          (current : WorkSymbol)
          (currentOrdinary :
            ordinaryCell current)
          (shape :
            tokenCells token = [cell10, current])
          (notExpected : current ≠ cell00) :
          ∃ steps final,
            steps ≤ rawFailureEnvelope word ∧
            workRunExact? machine steps
                (workStartConfiguration machine
                  (WorkTape.ofSymbols word)) =
              some final ∧
            final.state = State.reject ∧
            (encodeWorkTape final.tape).outputBits = [] := by
        rcases
            grammarGateStartProgramMismatch_exact
              inputs gates 0 current after
              notExpected
              (afterOrdinary current currentOrdinary) with
          ⟨tailSteps, final, tailBound, tailRun,
            finalState, outputEmpty⟩
        have tailBoundCanonical :
            tailSteps ≤
              64 * failureSpanSquare inner := by
          have canonical :
              tailSteps ≤
                16 * failureSpanSquare inner := by
            unfold inner
            rw [boundaryShape, shape]
            simpa [grammarWorkFailureSpan] using
              tailBound
          exact Nat.le_trans canonical (by omega)
        apply finish tailSteps final
          tailBoundCanonical
        · rw [boundaryShape, shape]
          simpa using tailRun
        · exact finalState
        · exact outputEmpty
      cases token with
      | version0 =>
          exact exhaust false cell00
            ordinaryCell_cell00 rfl
      | unit =>
          exact exhaust false cell01
            ordinaryCell_cell01 rfl
      | natEnd =>
          exact exhaust false cell10
            ordinaryCell_cell10 rfl
      | input =>
          exact exhaust false cell11
            ordinaryCell_cell11 rfl
      | constantFalse =>
          exact exhaust true cell00
            ordinaryCell_cell00 rfl
      | constantTrue =>
          exact exhaust true cell01
            ordinaryCell_cell01 rfl
      | gate =>
          exact exhaust true cell10
            ordinaryCell_cell10 rfl
      | gateEnd =>
          exact exhaust true cell11
            ordinaryCell_cell11 rfl
      | programEnd =>
          exact False.elim (notProgramEnd rfl)
      | outputsEnd =>
          exact mismatch cell01
            ordinaryCell_cell01 rfl (by decide)
      | threshold =>
          exact mismatch cell10
            ordinaryCell_cell10 rfl (by decide)
      | instanceEnd =>
          exact mismatch cell11
            ordinaryCell_cell11 rfl (by decide)

private theorem circuitOutputPrefixWord_exact
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource) (after : List WorkSymbol)
    (gatesValid :
      rawGatesWellFormed inputs 0 gates = true)
    (outputValid :
      output.wellFormed inputs gates.length = true) :
    workRunExact? machine
        (circuitOutputPrefixSteps inputs gates output)
        (workStartConfiguration machine
          (WorkTape.ofSymbols
            ([cell00, cell00] ++ natCells inputs ++
              natCells gates.length ++
              gateListCells gates ++
              [cell10, cell00] ++
              sourceCells output ++ after))) =
      some
        (guardedConfig State.outputsEndFirst
          (circuitOutputParsedPrefix
            inputs gates output)
          after) := by
  let programSteps :=
    ((2 * inputs + 2 * gates.length + 8) +
        gatesSteps inputs [] gates) +
      programEndSteps inputs gates
  let outputSteps :=
    sourceSteps inputs 0 gates.length gates
      [cell10, cell00] output
  have program :=
    circuitProgramPrefixWord_exact inputs gates
      (sourceCells output ++ after) gatesValid
  have outputRun :=
    source_exact .output inputs 0 gates.length
      gates [cell10, cell00] output after
      (by
        intro symbol member
        simp only [List.mem_cons,
          List.not_mem_nil] at member
        rcases member with rfl | rfl | impossible
        · exact ordinaryCell_cell10
        · exact ordinaryCell_cell00
        · contradiction)
      (by
        intro symbol member
        simp only [List.mem_cons,
          List.not_mem_nil] at member
        rcases member with rfl | rfl | impossible
        · decide
        · decide
        · contradiction)
      outputValid
  have all :=
    exactRun_add programSteps outputSteps
      _ _ _ (by
        simpa [programSteps,
          List.append_assoc] using program)
        outputRun
  simpa [programSteps, outputSteps,
    circuitOutputPrefixSteps,
    circuitOutputParsedPrefix,
    sourceDoneState, List.append_assoc] using all

private def circuitOutputRawPrefixCells
    (inputs : Nat) (gates : List RawGate)
    (output : RawSource) : List WorkSymbol :=
  [cell00, cell00] ++ natCells inputs ++
    natCells gates.length ++
    gateListCells gates ++
    [cell10, cell00] ++ sourceCells output

private theorem packedCircuitOutputPrefixTokens_eq_rawPrefixCells
