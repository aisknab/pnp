private theorem circuitValidGates_exact
    (inputs : Nat) (gates : List RawGate)
    (tokens : List Token)
    (gatesValid :
      rawGatesWellFormed inputs 0 gates = true) :
    let allTokens :=
      circuitGatesPrefixTokens inputs gates ++ tokens
    workRunExact? machine
        ((2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates)
        (workStartConfiguration machine
          (WorkTape.ofSymbols
            (packedTokenCells allTokens))) =
      some
        (guardedConfig State.gateStart
          (gatePrefix inputs gates [])
          (packedTokenCells tokens)) := by
  dsimp only
  let allTokens :=
    circuitGatesPrefixTokens inputs gates ++ tokens
  let after := packedTokenCells tokens
  have cellsEq :=
    packedCircuitGatesPrefixTokens_append
      inputs gates tokens
  have header :
      workRunExact? machine
          (2 * inputs + 2 * gates.length + 8)
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells allTokens))) =
        some
          (guardedConfig State.gateStart
            (gatePrefix inputs [] gates)
            (gateListCells gates ++ after)) := by
    dsimp [allTokens, after]
    rw [cellsEq]
    simpa [gatePrefix, grammarGatePrefix] using
      (circuitHeaderToGateStart_exact
        inputs gates.length
        (gateListCells gates ++
          packedTokenCells tokens))
  have gatesRun :=
    gates_exact inputs [] gates after gatesValid
  have all :=
    exactRun_add
      (2 * inputs + 2 * gates.length + 8)
      (gatesSteps inputs [] gates)
      _ _ _ header gatesRun
  simpa [allTokens, after] using all

private theorem failureSpanSquare_le_cube
    (span : Nat) :
    failureSpanSquare span ≤ failureSpanCube span := by
  have positive : 1 ≤ span + 1 := by
    omega
  have scaled :=
    Nat.mul_le_mul_right
      (failureSpanSquare span) positive
  simpa [failureSpanCube, Nat.mul_comm] using scaled

private theorem failureSpanSucc_le_cube
    (span : Nat) :
    span + 1 ≤ failureSpanCube span := by
  exact Nat.le_trans
    (by
      have positive : 1 ≤ span + 1 := by
        omega
      simpa [failureSpanSquare] using
        Nat.mul_le_mul_left (span + 1) positive)
    (failureSpanSquare_le_cube span)

private theorem circuitValidGatesSteps_bound
    (inputs : Nat) (gates : List RawGate)
    (tokens : List Token) :
    let allTokens :=
      circuitGatesPrefixTokens inputs gates ++ tokens
    (2 * inputs + 2 * gates.length + 8) +
        gatesSteps inputs [] gates ≤
      128 *
        failureSpanCube
          (circuitTokenFailureSpan allTokens) := by
  dsimp only
  let allTokens :=
    circuitGatesPrefixTokens inputs gates ++ tokens
  let wordSpan := circuitTokenFailureSpan allTokens
  let workspace := gateWorkspace inputs [] gates
  have cellsEq :=
    packedCircuitGatesPrefixTokens_append
      inputs gates tokens
  have workspaceEq :
      workspace + (packedTokenCells tokens).length =
        wordSpan := by
    unfold workspace wordSpan
    unfold circuitTokenFailureSpan gateWorkspace gatePrefix
    dsimp [allTokens]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length, countCells_length,
      markedGateListCells]
    omega
  have workspaceBound : workspace ≤ wordSpan := by
    omega
  have workspaceSucc :
      workspace + 1 ≤ wordSpan + 1 := by
    omega
  have squareBound :=
    Nat.mul_le_mul workspaceSucc workspaceSucc
  have countBound :
      gates.length ≤ wordSpan + 1 := by
    unfold wordSpan circuitTokenFailureSpan
    dsimp [allTokens]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length]
    omega
  have productBound :=
    Nat.mul_le_mul countBound squareBound
  have productCanonical :
      gates.length *
          ((workspace + 1) * (workspace + 1)) ≤
        failureSpanCube wordSpan := by
    simpa [failureSpanCube, failureSpanSquare,
      Nat.mul_assoc] using productBound
  have gatesBoundRaw :=
    gatesSteps_bound inputs [] gates
  have gatesBound :
      gatesSteps inputs [] gates ≤
        64 * failureSpanCube wordSpan := by
    calc
      gatesSteps inputs [] gates ≤
          gates.length *
            (64 *
              ((workspace + 1) *
                (workspace + 1))) := by
        simpa [workspace] using gatesBoundRaw
      _ = 64 *
          (gates.length *
            ((workspace + 1) *
              (workspace + 1))) := by
        ac_rfl
      _ ≤ 64 * failureSpanCube wordSpan :=
        Nat.mul_le_mul_left 64 productCanonical
  have headerLinear :
      2 * inputs + 2 * gates.length + 8 ≤
        8 * (wordSpan + 1) := by
    unfold wordSpan circuitTokenFailureSpan
    dsimp [allTokens]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length]
    omega
  have headerBound :
      2 * inputs + 2 * gates.length + 8 ≤
        8 * failureSpanCube wordSpan :=
    Nat.le_trans headerLinear
      (Nat.mul_le_mul_left 8
        (failureSpanSucc_le_cube wordSpan))
  have combined :=
    Nat.add_le_add headerBound gatesBound
  calc
    (2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates ≤
        8 * failureSpanCube wordSpan +
          64 * failureSpanCube wordSpan :=
      combined
    _ = 72 * failureSpanCube wordSpan := by
      omega
    _ ≤ 128 * failureSpanCube wordSpan :=
      Nat.mul_le_mul_right
        (failureSpanCube wordSpan)
        (show 72 ≤ 128 by omega)
    _ = 128 *
        failureSpanCube
          (circuitTokenFailureSpan allTokens) := by
      rfl

private theorem circuitInvalidGates_bounded_exact
    (inputs : Nat) (gates : List RawGate)
    (tokens : List Token)
    (gatesInvalid :
      rawGatesWellFormed inputs 0 gates = false) :
    let allTokens :=
      circuitGatesPrefixTokens inputs gates ++ tokens
    ∃ steps final,
      steps ≤ circuitFailureEnvelope allTokens ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells allTokens))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  dsimp only
  let allTokens :=
    circuitGatesPrefixTokens inputs gates ++ tokens
  let after := packedTokenCells tokens
  let headerSteps :=
    2 * inputs + 2 * gates.length + 8
  have cellsEq :=
    packedCircuitGatesPrefixTokens_append
      inputs gates tokens
  have header :
      workRunExact? machine headerSteps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells allTokens))) =
        some
          (guardedConfig State.gateStart
            (gatePrefix inputs [] gates)
            (gateListCells gates ++ after)) := by
    dsimp [headerSteps, allTokens, after]
    rw [cellsEq]
    simpa [gatePrefix, grammarGatePrefix] using
      (circuitHeaderToGateStart_exact
        inputs gates.length
        (gateListCells gates ++
          packedTokenCells tokens))
  have failure :=
    (rawGatesWellFormed_false_iff_failure
      inputs 0 gates).mp gatesInvalid
  have afterOrdinary :
      ∀ symbol, symbol ∈ after →
        ordinaryCell symbol := by
    intro symbol member
    exact packedTokenCells_allOrdinary
      tokens symbol member
  rcases
      decodedGateListBoundFailure_bounded_exact
        inputs 0 [] gates after rfl
        failure afterOrdinary with
    ⟨tailSteps, final, tailBound, tail,
      finalState, output⟩
  have all :=
    exactRun_add headerSteps tailSteps
      _ _ _ header tail
  let inner :=
    decodedGateListFailureSpan
      inputs [] gates after
  have innerEq :
      inner =
        circuitTokenFailureSpan allTokens := by
    unfold inner decodedGateListFailureSpan
      gateWorkspace gatePrefix
      circuitTokenFailureSpan
    dsimp [allTokens, after]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length, countCells_length,
      markedGateListCells]
    omega
  have headerBound :
      headerSteps ≤
        8 * (circuitTokenFailureSpan allTokens + 1) := by
    unfold headerSteps circuitTokenFailureSpan
    dsimp [allTokens]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length]
    omega
  have countBound :
      gates.length ≤
        circuitTokenFailureSpan allTokens + 1 := by
    unfold circuitTokenFailureSpan
    dsimp [allTokens]
    rw [cellsEq]
    simp only [List.length_append,
      List.length_cons, List.length_nil,
      natCells_length]
    omega
  have innerBound :
      inner + 1 ≤
        2 * (circuitTokenFailureSpan allTokens + 1) := by
    rw [innerEq]
    omega
  have tailBound128 :
      tailSteps ≤
        gates.length *
          (128 * failureSpanSquare inner) := by
    exact Nat.le_trans
      (by simpa [inner] using tailBound)
      (Nat.mul_le_mul_left gates.length
        (Nat.mul_le_mul_right
          (failureSpanSquare inner)
          (show 64 ≤ 128 by omega)))
  have scheduleBound :=
    circuitCubicComposition_bound
      allTokens headerSteps tailSteps gates.length
      inner headerBound countBound innerBound
      tailBound128
  refine
    ⟨headerSteps + tailSteps, final,
      scheduleBound, ?_, finalState, output⟩
  simpa [allTokens] using all

private theorem shiftedSquare_le_nineCube
    (inner span : Nat)
    (innerBound : inner ≤ span + 2) :
    failureSpanSquare inner ≤
      9 * failureSpanCube span := by
  have successorBound :
      inner + 1 ≤ 3 * (span + 1) := by
    omega
  have squareRaw :=
    Nat.mul_le_mul successorBound successorBound
  have squareBound :
      failureSpanSquare inner ≤
        9 * failureSpanSquare span := by
    calc
      failureSpanSquare inner ≤
          (3 * (span + 1)) *
            (3 * (span + 1)) := by
        simpa [failureSpanSquare] using squareRaw
      _ =
          (3 * 3) * failureSpanSquare span := by
        unfold failureSpanSquare
        ac_rfl
      _ = 9 * failureSpanSquare span := by
        rfl
  exact Nat.le_trans squareBound
    (Nat.mul_le_mul_left 9
      (failureSpanSquare_le_cube span))

private theorem circuitMissingProgramEnd_bounded_exact
    (inputs : Nat) (gates : List RawGate) :
    ∃ steps final,
      steps ≤
          circuitFailureEnvelope
            (circuitGatesPrefixTokens inputs gates) ∧
      workRunExact? machine steps
          (workStartConfiguration machine
            (WorkTape.ofSymbols
              (packedTokenCells
                (circuitGatesPrefixTokens
                  inputs gates)))) =
        some final ∧
      final.state = State.reject ∧
      (encodeWorkTape final.tape).outputBits = [] := by
  cases gatesEq :
      rawGatesWellFormed inputs 0 gates with
  | false =>
      simpa [packedTokenCells] using
        (circuitInvalidGates_bounded_exact
          inputs gates [] gatesEq)
  | true =>
      let allTokens :=
        circuitGatesPrefixTokens inputs gates
      let prefixSteps :=
        (2 * inputs + 2 * gates.length + 8) +
          gatesSteps inputs [] gates
      have prefixRun :
          workRunExact? machine prefixSteps
              (workStartConfiguration machine
                (WorkTape.ofSymbols
                  (packedTokenCells allTokens))) =
            some
              (guardedConfig State.gateStart
                (gatePrefix inputs gates []) []) := by
        simpa [allTokens, prefixSteps, packedTokenCells] using
          (circuitValidGates_exact
            inputs gates [] gatesEq)
      rcases
          grammarGateStartMissing_exact
            inputs gates 0 with
        ⟨tailSteps, final, tailBound, tail,
          finalState, output⟩
      have tailCanonical :
          workRunExact? machine tailSteps
              (guardedConfig State.gateStart
                (gatePrefix inputs gates []) []) =
            some final := by
        simpa [gatePrefix, grammarGatePrefix] using tail
      have all :=
        exactRun_add prefixSteps tailSteps
          _ _ _ prefixRun tailCanonical
      have prefixBound :
          prefixSteps ≤
            128 *
              failureSpanCube
                (circuitTokenFailureSpan allTokens) := by
        simpa [allTokens, prefixSteps, packedTokenCells] using
          (circuitValidGatesSteps_bound
            inputs gates [])
      let inner :=
        (grammarGatePrefix inputs gates 0).length + 2
      have cellsEq :=
        packedCircuitGatesPrefixTokens_append
          inputs gates []
      have cellsEqCanonical :
          packedTokenCells allTokens =
            [cell00, cell00] ++ natCells inputs ++
              natCells gates.length ++ gateListCells gates := by
        simpa [allTokens, packedTokenCells] using cellsEq
      have innerBound :
          inner ≤
            circuitTokenFailureSpan allTokens + 2 := by
        unfold inner circuitTokenFailureSpan
        rw [cellsEqCanonical]
        unfold grammarGatePrefix
        simp only [List.length_append,
          List.length_cons, List.length_nil,
          natCells_length, countCells_length,
          markedGateListCells_length]
        omega
      have squareBound :=
        shiftedSquare_le_nineCube
          inner (circuitTokenFailureSpan allTokens)
          innerBound
      have tailCube :
