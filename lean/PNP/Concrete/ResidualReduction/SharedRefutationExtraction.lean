import PNP.Concrete.ResidualReduction.SourceReductionChain
import PNP.Concrete.ResidualReduction.SharedRefutationAssembly
import PNP.Concrete.ResidualReduction.SharedRefutationTerminal

/-! Source-generated refutation extraction from the existing reduction history.
The reduction runs once. Its saved history is unwound from the actual terminal
contradiction, without a supplied old refutation or a repeated selector search.
A positive-dimensional stopped core still returns none. No all-input decision
or encoded-runtime theorem is asserted here. -/

namespace PNP.Concrete.ResidualReduction.SharedRefutationExtraction
open PNP.Concrete.ResidualReduction.FactoredContraction
open PNP.Concrete.ResidualReduction.SourceChain
open PNP.Concrete.ResidualReduction.SharedRefutationAssembly

def terminal : (d : Nat) → Family d → Option (Certificate d)
  | 0, F => if models F () then none else some (SharedRefutationTerminal.certificate F)
  | _ + 1, _ => none

/-- Dimension checks protect the executable replay interface. In the public
extractor these records are generated by reduce, not supplied by a caller. -/
def unwind {d : Nat} (seed : Certificate d) :
    (n : Nat) → List StepRecord → Option (Certificate n)
  | n, [] =>
    if same : d = n then some (same ▸ seed) else none
  | n, step :: rest =>
    if same : step.dimension + 1 = n then
      (unwind seed step.dimension rest).bind (fun p =>
        (liftRecorded step.source step.step p).map (fun q => same ▸ q))
    else none


/-- The linked-history hypothesis comes from the existing reducer's theorem.
This reconstruction theorem is independent of whether a selector can finish
every input. -/
theorem unwind_linked {n d : Nat} (F : Family n) (history : List StepRecord)
    (G : Family d) (linked : Linked F history G) (seed : Certificate d)
    (wellFormed : WellFormed G seed) (refutation : Refutes G seed) :
    ∃ q, unwind seed n history = some q ∧ WellFormed F q ∧ Refutes F q ∧
      q.1.length ≤ seed.1.length + (4 * F.length + 1) * history.length := by
  induction linked with
  | refl F =>
    refine ⟨seed, ?_, wellFormed, refutation, ?_⟩
    · simp only [unwind, ↓reduceDIte]
    · simp only [List.length_nil, Nat.mul_zero, Nat.add_zero, Nat.le_refl]
  | @step n d F s rest G selected linked ih =>
    obtain ⟨p, replayed, valid, refutes, oldGrowth⟩ := ih seed wellFormed refutation
    obtain ⟨q, lifted, newValid, implication, newGrowth⟩ :=
      liftRecorded_exists F s selected p valid
    refine ⟨q, ?_, newValid, implication refutes, ?_⟩
    · simp only [unwind, ↓reduceDIte, replayed, Option.bind, lifted, Option.map]
    · have count := (globalStep_sound F s selected).1
      rw [count] at oldGrowth
      simp only [List.length_cons, Nat.mul_add, Nat.mul_one]
      omega

theorem terminal_complete (d : Nat) (F : Family d)
    (falseVerdict : zeroVerdict d F = some false) :
    ∃ p, terminal d F = some p ∧ WellFormed F p ∧ Refutes F p ∧ p.1.length = 2 := by
  cases d with
  | zero =>
    have rejected : models F () = false := by
      simpa only [zeroVerdict, Option.some.injEq] using falseVerdict
    obtain ⟨count, valid, rootsCount, bounds⟩ := SharedRefutationTerminal.certificate_contract F
    refine ⟨SharedRefutationTerminal.certificate F, ?_, ⟨valid, bounds, rootsCount⟩, ?_, count⟩
    · simp only [terminal, rejected, Bool.false_eq_true, ↓reduceIte]
    · intro x
      cases x
      exact SharedRefutationTerminal.certificate_refutes F rejected
  | succ d => simp only [zeroVerdict, reduceCtorEq] at falseVerdict

theorem terminal_some_false (d : Nat) (F : Family d) (p : Certificate d)
    (accepted : terminal d F = some p) : zeroVerdict d F = some false := by
  cases d with
  | zero =>
    cases model : models F () with
    | false => simp only [zeroVerdict, model]
    | true =>
      simp only [terminal, model, ↓reduceIte, reduceCtorEq] at accepted
  | succ d => simp only [terminal, reduceCtorEq] at accepted

/-- This public construction takes only the original source family. -/
def extract {n : Nat} (F : Family n) : Option (Certificate n) :=
  let reduction := reduce n F
  (terminal reduction.dimension reduction.core).bind (fun seed =>
    unwind seed n reduction.history)

/-- Every false verdict of the existing partial reducer yields an actual
valid, compact, source-row refutation. This is relative extraction completeness,
not a theorem that the reducer decides every source family. -/
theorem extract_of_false_verdict {n : Nat} (F : Family n)
    (falseVerdict : verdict F = some false) :
    ∃ q, extract F = some q ∧ WellFormed F q ∧ Refutes F q ∧
      q.1.length ≤ 2 + (4 * F.length + 1) * n := by
  obtain ⟨seed, seeded, valid, refutes, seedSize⟩ :=
    terminal_complete (reduce n F).dimension (reduce n F).core falseVerdict
  obtain ⟨q, replayed, checked, original, growth⟩ :=
    unwind_linked F (reduce n F).history (reduce n F).core
      (reduce_trace_linked n F) seed valid refutes
  refine ⟨q, ?_, checked, original, ?_⟩
  · simp only [extract, seeded, Option.bind, replayed]
  · rw [seedSize] at growth
    have limit := Nat.mul_le_mul_left (4 * F.length + 1) (reduce_step_bound n F)
    omega

theorem extract_some_false_verdict {n : Nat} (F : Family n) (q : Certificate n)
    (accepted : extract F = some q) : verdict F = some false := by
  cases seeded : terminal (reduce n F).dimension (reduce n F).core with
  | none => simp only [extract, seeded, Option.bind, reduceCtorEq] at accepted
  | some seed =>
    exact terminal_some_false (reduce n F).dimension (reduce n F).core seed seeded

theorem extract_contract {n : Nat} (F : Family n) (q : Certificate n)
    (accepted : extract F = some q) :
    WellFormed F q ∧ Refutes F q ∧ q.1.length ≤ 2 + (4 * F.length + 1) * n := by
  obtain ⟨built, returned, valid, refutes, growth⟩ :=
    extract_of_false_verdict F (extract_some_false_verdict F q accepted)
  have same : built = q := Option.some.inj (returned.symm.trans accepted)
  cases same
  exact ⟨valid, refutes, growth⟩

theorem extract_unsatisfiable {n : Nat} (F : Family n) (q : Certificate n)
    (accepted : extract F = some q) : ¬ ∃ x, models F x = true :=
  verdict_false_sound F (extract_some_false_verdict F q accepted)

end PNP.Concrete.ResidualReduction.SharedRefutationExtraction
