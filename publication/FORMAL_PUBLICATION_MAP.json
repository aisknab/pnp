  "milestones": [
    {
      "id": "concrete-machine-cost-kernel",
      "title": "Concrete machine and cost kernel",
      "classification": "formalized-foundation-only",
      "scope": "Literal canonical paired input reaches an accepting representation under an exact quadratic raw-input-length polynomial. Separately, each n-step raw run lifts to exactly 3 * n successful work steps; each F-fuel run has an exact prefix of length k at most F; if it is designated halting, work fuel 3 * F and compiled fuel 18 * F reach its representation. An internal represented output handoff separately reaches Tape.handoffTarget in exactly 2 * n + 4 successful work steps and 12 * n + 24 compiled steps for logical output length n. The module proves injective state renaming preserves ordered first-match lookup, halt status, one-step execution, exact and at-most runs, start configurations, and bounded verdicts. The framer, lifted simulator, and internal handoff occupy three disjoint stage images, and one literal concatenated finite rule table has proved first-match lookup isolation in all three images. The existing exact stage-local traces survive those renamings.",
      "requiredTheorems": [
        "PNP.Concrete.BitString.decodePair_pair",
        "PNP.Concrete.NatPolynomial.eval_mono",
